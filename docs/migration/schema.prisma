// Prisma Schema for Arkan PostgreSQL Migration
// This schema defines the complete data model for the Arkan platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION & USER MANAGEMENT
// ============================================================================

model User {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  // Authentication & Identity
  email              String    @unique @db.VarChar(255)
  emailVerified      Boolean   @default(false) @map("email_verified")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  name               String    @db.VarChar(255)
  
  // Profile
  bio                String?   @db.Text
  profilePictureUrl  String?   @map("profile_picture_url") @db.Text
  
  // Authorization
  role               UserRole  @default(user)
  
  // Credits & Billing
  credits            Int       @default(0) // Check constraint handled by DB
  
  // Onboarding
  hasCompletedOnboarding Boolean @default(false) @map("has_completed_onboarding")
  
  // API Keys (encrypted)
  apiKeys            Json      @default("{}") @map("api_keys")
  
  // Timestamps
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  lastLoginAt        DateTime? @map("last_login_at")
  deletedAt          DateTime? @map("deleted_at")
  
  // Relations
  accounts           Account[]
  sessions           Session[]
  projects           Project[]
  transactions       Transaction[]
  agentGenerations   AgentGeneration[]
  creditLedger       CreditLedger[]
  indexedDocuments   IndexedDocument[]
  deviceTokens       DeviceToken[]
  notifications      Notification[]
  verifiedTransactions Transaction[] @relation("VerifiedBy")
  creditAdjustments  CreditLedger[]   @relation("PerformedBy")
  
  @@index([email])
  @@index([role])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("users")
}

enum UserRole {
  admin
  user
}

// NextAuth Account Model
model Account {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  type              String   @db.VarChar(50)
  provider          String   @db.VarChar(50)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  refreshToken      String?  @map("refresh_token") @db.Text
  accessToken       String?  @map("access_token") @db.Text
  expiresAt         Int?     @map("expires_at")
  tokenType         String?  @map("token_type") @db.VarChar(50)
  scope             String?  @db.Text
  idToken           String?  @map("id_token") @db.Text
  sessionState      String?  @map("session_state") @db.Text
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth Session Model
model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar(255)
  expires      DateTime
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([sessionToken])
  @@index([expires])
  @@map("sessions")
}

// NextAuth Verification Token Model
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  
  @@id([identifier, token])
  @@index([token])
  @@map("verification_tokens")
}

// ============================================================================
// PROJECTS & CONTENT
// ============================================================================

model Project {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  // Ownership
  userId      String    @map("user_id") @db.Uuid
  
  // Basic Metadata
  title       String    @db.VarChar(500)
  description String?   @db.Text
  projectType String?   @map("project_type") @db.VarChar(100)
  status      ProjectStatus @default(draft)
  
  // Flexible Content (JSONB)
  content     Json      @default("{}")
  meta        Json      @default("{}")
  settings    Json      @default("{}")
  
  // Cover/Logo
  logoUrl     String?   @map("logo_url") @db.Text
  coverPageData Json?   @map("cover_page_data")
  
  // Timestamps
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  lastAccessedAt DateTime? @map("last_accessed_at")
  deletedAt      DateTime? @map("deleted_at")
  
  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  indexedDocuments IndexedDocument[]
  
  @@index([userId])
  @@index([projectType])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  @@index([deletedAt])
  @@index([content], type: Gin)
  @@index([meta], type: Gin)
  @@map("projects")
}

enum ProjectStatus {
  draft
  in_progress
  completed
  archived
}

// ============================================================================
// FINANCIAL & TRANSACTIONS
// ============================================================================

model Transaction {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  // User & Plan
  userId    String    @map("user_id") @db.Uuid
  planId    String    @map("plan_id") @db.VarChar(100)
  planName  String    @map("plan_name") @db.VarChar(255)
  
  // Financial Data
  credits   Int       // Check constraint: credits > 0
  price     Decimal   @db.Decimal(10, 2) // Check constraint: price >= 0
  currency  String    @default("USD") @db.VarChar(3)
  
  // User Info Snapshot (for audit)
  userName  String    @map("user_name") @db.VarChar(255)
  userEmail String    @map("user_email") @db.VarChar(255)
  
  // Status
  status    TransactionStatus @default(pending)
  
  // Payment Proof
  proofUrl  String    @map("proof_url") @db.Text
  
  // Admin Actions
  adminNotes  String?   @map("admin_notes") @db.Text
  verifiedAt  DateTime? @map("verified_at")
  verifiedBy  String?   @map("verified_by") @db.Uuid
  
  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  
  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  verifier  User?     @relation("VerifiedBy", fields: [verifiedBy], references: [id])
  
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([verifiedBy])
  @@index([userId, status])
  @@map("transactions")
}

enum TransactionStatus {
  pending
  verified
  rejected
}

// Credit Ledger (Audit Trail)
model CreditLedger {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  // User
  userId          String   @map("user_id") @db.Uuid
  
  // Change Details
  amount          Int      // Positive for addition, negative for deduction
  balanceBefore   Int      @map("balance_before")
  balanceAfter    Int      @map("balance_after")
  
  // Reason & Source
  transactionType CreditTransactionType @map("transaction_type")
  referenceId     String?  @map("reference_id") @db.Uuid
  referenceType   String?  @map("reference_type") @db.VarChar(50)
  
  // Context
  description     String?  @db.Text
  performedBy     String?  @map("performed_by") @db.Uuid
  
  // Timestamp (immutable)
  createdAt       DateTime @default(now()) @map("created_at")
  
  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  performer       User?    @relation("PerformedBy", fields: [performedBy], references: [id])
  
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("credit_ledger")
}

enum CreditTransactionType {
  purchase
  gift
  deduction
  refund
  adjustment
}

// ============================================================================
// AI GENERATION LOGGING
// ============================================================================

model AgentGeneration {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  // User & Agent
  userId          String    @map("user_id") @db.Uuid
  agentId         String    @map("agent_id") @db.VarChar(100)
  agentName       String?   @map("agent_name") @db.VarChar(255)
  
  // Request Details
  flowName        String    @map("flow_name") @db.VarChar(100)
  inputData       Json?     @map("input_data")
  
  // Response
  outputData      Json?     @map("output_data")
  status          GenerationStatus @default(pending)
  errorMessage    String?   @map("error_message") @db.Text
  
  // Metrics
  tokensUsed      Int?      @map("tokens_used")
  executionTimeMs Int?      @map("execution_time_ms")
  creditsConsumed Int       @default(0) @map("credits_consumed")
  
  // Model Info
  modelName       String?   @map("model_name") @db.VarChar(100)
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")
  
  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([agentId])
  @@index([flowName])
  @@index([createdAt(sort: Desc)])
  @@index([userId, agentId, createdAt(sort: Desc)])
  @@index([status])
  @@map("agent_generations")
}

enum GenerationStatus {
  pending
  completed
  failed
}

// ============================================================================
// CONFIGURATION & TEMPLATES
// ============================================================================

model Feature {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  key         String   @unique @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  enabled     Boolean  @default(true)
  config      Json     @default("{}")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@index([key])
  @@index([enabled])
  @@map("features")
}

model AgentCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  key         String   @unique @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  icon        String?  @db.VarChar(100)
  orderIndex  Int      @default(0) @map("order_index")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  agents      Agent[]
  
  @@index([key])
  @@index([orderIndex])
  @@map("agent_categories")
}

model Agent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  key         String   @unique @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  categoryId  String?  @map("category_id") @db.Uuid
  config      Json     @default("{}")
  enabled     Boolean  @default(true)
  icon        String?  @db.VarChar(100)
  orderIndex  Int      @default(0) @map("order_index")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  category    AgentCategory? @relation(fields: [categoryId], references: [id])
  
  @@index([key])
  @@index([categoryId])
  @@index([enabled])
  @@index([orderIndex])
  @@map("agents")
}

model Section {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  key            String   @unique @db.VarChar(100)
  title          String   @db.VarChar(255)
  description    String?  @db.Text
  config         Json     @default("{}")
  promptTemplate String?  @map("prompt_template") @db.Text
  icon           String?  @db.VarChar(100)
  orderIndex     Int      @default(0) @map("order_index")
  enabled        Boolean  @default(true)
  
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  @@index([key])
  @@index([enabled])
  @@index([orderIndex])
  @@map("sections")
}

model Template {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  type         TemplateType
  key          String       @db.VarChar(100)
  name         String       @db.VarChar(255)
  description  String?      @db.Text
  config       Json         @default("{}")
  thumbnailUrl String?      @map("thumbnail_url") @db.Text
  enabled      Boolean      @default(true)
  isDefault    Boolean      @default(false) @map("is_default")
  orderIndex   Int          @default(0) @map("order_index")
  
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  
  @@unique([type, key])
  @@index([type])
  @@index([enabled])
  @@index([type, enabled])
  @@index([orderIndex])
  @@map("templates")
}

enum TemplateType {
  docx
  pptx
  report_style
}

model Setting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  key         String   @unique @db.VarChar(100)
  category    String   @default("general") @db.VarChar(50)
  value       Json
  description String?  @db.Text
  isPublic    Boolean  @default(false) @map("is_public")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@index([key])
  @@index([category])
  @@index([isPublic])
  @@map("settings")
}

// ============================================================================
// RAG SYSTEM & DOCUMENT INDEXING
// ============================================================================

model IndexedDocument {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  // Document Info
  filename         String    @db.VarChar(500)
  originalName     String    @map("original_name") @db.VarChar(500)
  fileType         String    @map("file_type") @db.VarChar(50)
  fileSize         BigInt?   @map("file_size")
  
  // RAG Integration
  vectorCount      Int       @default(0) @map("vector_count")
  collectionName   String    @default("documents") @map("collection_name") @db.VarChar(100)
  
  // Status
  status           IndexingStatus @default(pending)
  errorMessage     String?   @map("error_message") @db.Text
  
  // Ownership
  userId           String?   @map("user_id") @db.Uuid
  projectId        String?   @map("project_id") @db.Uuid
  
  // Metadata
  metadata         Json      @default("{}")
  
  // Processing Stats
  processingTimeMs Int?      @map("processing_time_ms")
  
  // Timestamps
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  indexedAt        DateTime? @map("indexed_at")
  
  // Relations
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  @@index([status])
  @@index([userId])
  @@index([projectId])
  @@index([createdAt(sort: Desc)])
  @@index([fileType])
  @@map("indexed_documents")
}

enum IndexingStatus {
  pending
  processing
  completed
  failed
}

// ============================================================================
// NOTIFICATIONS & DEVICES
// ============================================================================

model DeviceToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  userId     String    @map("user_id") @db.Uuid
  token      String    @unique @db.Text
  deviceType String?   @map("device_type") @db.VarChar(50)
  browser    String?   @db.VarChar(100)
  os         String?   @db.VarChar(100)
  isActive   Boolean   @default(true) @map("is_active")
  
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  lastUsedAt DateTime? @map("last_used_at")
  
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@index([isActive])
  @@map("device_tokens")
}

model Notification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  userId        String    @map("user_id") @db.Uuid
  type          String    @db.VarChar(50)
  title         String    @db.VarChar(255)
  message       String    @db.Text
  actionUrl     String?   @map("action_url") @db.Text
  actionLabel   String?   @map("action_label") @db.VarChar(100)
  isRead        Boolean   @default(false) @map("is_read")
  readAt        DateTime? @map("read_at")
  referenceId   String?   @map("reference_id") @db.Uuid
  referenceType String?   @map("reference_type") @db.VarChar(50)
  metadata      Json      @default("{}")
  
  createdAt     DateTime  @default(now()) @map("created_at")
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

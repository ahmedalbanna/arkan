rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuth() {
      return request.auth != null;
    }
    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isAuth() && userRole() == 'admin';
    }

    // Default deny all reads/writes unless explicitly allowed.
    match /{document=**} {
      allow read, write: if false;
    }

    // === USERS ===
    match /users/{userId} {
      // Allow users to read their own profile, and admins to read any.
      allow get: if isUser(userId) || isAdmin();
      // Allow users to create their own profile upon signup.
      allow create: if isUser(userId);
      // Allow users to update specific fields on their own profile.
      // Admins can update any field on any user's profile.
      allow update: if (isUser(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'profilePictureUrl', 'hasCompletedOnboarding', 'updatedAt', 'apiKeys']))
                    || isAdmin();
      // Only admins can delete users.
      allow delete: if isAdmin();
    }

    // === PROJECTS ===
    // Projects are now stored in a top-level collection.
    // The `meta.author` field stores the owner's UID.
    match /projects/{projectId} {
      // Allow users to read, create, update, and delete their own projects.
      allow read, create, update, delete: if isAuth() && request.resource.data.meta.author == request.auth.uid;
      // Allow a user to read a project if they are the author
      allow get: if isAuth() && resource.data.meta.author == request.auth.uid;
      // Allow an admin to read any project
      allow get: if isAdmin();
    }
    
    // === TEAMS ===
    match /teams/{teamId} {
      // Only team members can read team data.
      allow get: if isAuth() && teamId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teams;
      // Only team owners can update team details.
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid;
      // Only team owners can delete teams.
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    match /teams/{teamId}/members/{memberId} {
        // Allow team members to read member list.
        allow list: if isAuth() && teamId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teams;
        // Only team owners can add/remove members.
        allow write: if isAuth() && get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == request.auth.uid;
    }

    // === TRANSACTIONS ===
    match /transactions/{transactionId} {
      // Users can read their own transactions.
      allow get: if isAuth() && resource.data.userId == request.auth.uid;
      // Admins can read all transactions.
      allow list, get: if isAdmin();
      // Users can create their own transactions (payment requests).
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      // Only admins can update (verify/reject) transactions.
      allow update: if isAdmin();
    }
    
    // === AGENT GENERATIONS (LOGS) ===
    match /agent_generations/{logId} {
        // Users can read their own logs. Admins can read all.
        allow get: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
        // Admins can list all logs.
        allow list: if isAdmin();
        // Users can create their own logs.
        allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // === READ-ONLY PUBLIC DATA ===
    // These collections contain public configuration that all authenticated users need to read.
    match /features/{featureId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /agents/{agentId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    match /sections/{sectionId} {
        allow read: if isAuth();
        allow write: if isAdmin();
    }

    match /agent_categories/{categoryId} {
        allow read: if isAuth();
        allow write: if isAdmin();
    }
    
    match /templates/{type}/items/{templateId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
     match /templates/{type}/styles/{templateId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /settings/defaults {
      allow read: if true; // Publicly readable settings like bank info
      allow write: if isAdmin();
    }

    // Device tokens for push notifications
    match /deviceTokens/{userId} {
        allow read, write: if isUser(userId);
    }
    
    // === INDEXED DOCUMENTS (RAG System) ===
    // Admin-only collection for tracking uploaded documents
    match /indexed_documents/{docId} {
      // Only admins can read document tracking data
      allow read: if isAdmin();
      // Only admins (via server) can write
      allow write: if isAdmin();
    }
  }
}

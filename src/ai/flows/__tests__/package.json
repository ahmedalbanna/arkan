{
    "name": "arkan-ai-flows-tests",
    "version": "1.0.0",
    "description": "اختبارات شاملة لجميع الـ flows في نظام الذكاء الاصطناعي المحسن",
    "main": "index.js",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:unit": "jest --testPathPattern=unit",
        "test:integration": "jest --testPathPattern=integration",
        "test:academic": "jest --testPathPattern=academic",
        "test:analysis": "jest --testPathPattern=analysis",
        "test:content-generation": "jest --testPathPattern=content-generation",
        "test:document-processing": "jest --testPathPattern=document-processing",
        "test:text-processing": "jest --testPathPattern=text-processing",
        "test:visual": "jest --testPathPattern=visual",
        "test:unified": "jest --testPathPattern=unified",
        "test:registry": "jest --testPathPattern=registry"
    },
    "keywords": [
        "ai",
        "flows",
        "testing",
        "unit-tests",
        "integration-tests",
        "arkan",
        "ai-powered-flows"
    ],
    "author": "Arkan Team",
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "jest": "^29.5.0",
        "ts-jest": "^29.1.0",
        "typescript": "^5.0.0",
        "@types/node": "^20.0.0"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
            "**/__tests__/**/*.test.ts"
        ],
        "collectCoverageFrom": [
            "../**/*.ts",
            "!../**/*.d.ts",
            "!**/__tests__/**",
            "!**/node_modules/**"
        ],
        "coverageDirectory": "coverage",
        "coverageReporters": [
            "text",
            "lcov",
            "html"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 85,
                "functions": 85,
                "lines": 85,
                "statements": 85
            }
        },
        "testTimeout": 30000,
        "verbose": true,
        "setupFilesAfterEnv": [
            "<rootDir>/jest.setup.js"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/../../../$1"
        }
    }
}

{
    "name": "arkan-ai-core-tests",
    "version": "1.0.0",
    "description": "اختبارات شاملة لنظام الذكاء الاصطناعي المحسن في مشروع Arkan",
    "main": "index.js",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:unit": "jest --testPathPattern=unit",
        "test:integration": "jest --testPathPattern=integration",
        "test:context-analyzer": "jest --testPathPattern=context-analyzer",
        "test:model-selector": "jest --testPathPattern=adaptive-model-selector",
        "test:prompt-builder": "jest --testPathPattern=intelligent-prompt-builder",
        "test:quality-validator": "jest --testPathPattern=output-quality-validator",
        "test:improvement-engine": "jest --testPathPattern=iterative-improvement-engine",
        "test:performance-monitor": "jest --testPathPattern=performance-monitor",
        "test:error-handler": "jest --testPathPattern=ai-error-handler",
        "test:context-organizer": "jest --testPathPattern=context-organizer",
        "test:intelligent-system": "jest --testPathPattern=intelligent-ai-system",
        "test:integration": "jest --testPathPattern=integration"
    },
    "keywords": [
        "ai",
        "artificial-intelligence",
        "testing",
        "unit-tests",
        "integration-tests",
        "arkan",
        "document-generation",
        "ai-powered"
    ],
    "author": "Arkan Team",
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "jest": "^29.5.0",
        "ts-jest": "^29.1.0",
        "typescript": "^5.0.0"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
            "**/__tests__/**/*.test.ts"
        ],
        "collectCoverageFrom": [
            "**/*.ts",
            "!**/*.d.ts",
            "!**/__tests__/**",
            "!**/node_modules/**"
        ],
        "coverageDirectory": "coverage",
        "coverageReporters": [
            "text",
            "lcov",
            "html"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 80,
                "functions": 80,
                "lines": 80,
                "statements": 80
            }
        },
        "testTimeout": 30000,
        "verbose": true,
        "setupFilesAfterEnv": [
            "<rootDir>/jest.setup.js"
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/arkan/arkan.git"
    },
    "bugs": {
        "url": "https://github.com/arkan/arkan/issues"
    },
    "homepage": "https://github.com/arkan/arkan#readme"
}

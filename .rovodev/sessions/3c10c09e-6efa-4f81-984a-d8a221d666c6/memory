#### **C. Output Mapping**
```typescript
extractOutput(context: ExecutionContext, outputMapping?: Record<string, string>): any {
  if (outputMapping) {
    // Build output from mapping
    const output: any = {};
    for (const [outputKey, contextPath] of Object.entries(outputMapping)) {
      output[outputKey] = this.getVariable(context, contextPath);
    }
    return output;
  }
  
  // Default: return last step output
  return Array.from(context.stepResults.values()).pop()?.output || null;
}
```

**Use Cases:**

ribe(\"A map of all generated PlantUML diagrams.\").nullable(),\n 737     acceptanceCriteria: z.array(z.string()).describe(\"A list of acceptance criteria to evaluate the report against.\").nullable().optional(),\n 738 });\n 739 export type EvaluateReportInput = z.infer<typeof EvaluateReportInputSchema>;\n 740 \n 741 export const FeedbackItemSchema = z.object({\n 742     point: z.string().describe(\"A specific feedback point related to one of the acceptance criteria.\"),\n 743     status: FeedbackStatusSchema.describe(\"The status of the report regarding this feedback point.\"),\n 744     sectionKey: SectionNameSchema.optional().describe(\"The specific section key (e.g., 'introduction', 'systemDesign') this feedback point applies to. This is crucial for applying automated fixes.\"),\n 745     solution: z.string().optional().describe(\"A suggested prompt for an AI agent to fix the issue if status is 'Weak' or 'Not Present'. This prompt should be a clear, actionable command.\"),\n 746 });\n 747 \n 748 export const AIContentAnalysisSchema = z.object({\n 749     sectionName: z.string(),\n 750     aiContentScore: z.number().min(0).max(100),\n 751     analysis: z.string(),\n 752 });\n 753 \n 754 export const EvaluateReportOutputSchema = z.object({\n 755     evaluationScore: z.number().min(0).max(100).describe(\"A numerical score from 0 to 100 representing the report's quality against the criteria.\"),\n 756     feedback: z.array(FeedbackItemSchema).describe(\"A list of specific feedback points, including praise for met criteria and suggestions for areas of improvement, each with a status.\"),\n 757     summary: z.string().describe(\"A concise summary of the overall evaluation.\"),\n 758     aiContentAnalysis: z.array(AIContentAnalysisSchema).optional().describe(\"An analysis of each section for AI-generated content probability.\"),\n 759 });\n 760 export type EvaluateReportOutput = z.infer<typeof EvaluateReportOutputSchema>;\n 761 \n 762 // generate-toc.ts\n 763 export co
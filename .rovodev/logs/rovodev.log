Regex);\n  22 \n  23         let finalMarkdown = markdown;\n  24         // Only append footnotes if they aren\'t already in the markdown (to avoid duplicates for full exports)\n  25         if (footnoteDefinitions && footnoteDefinitions.length > 0) {\n  26             const existingFootnotes = markdown.match(footnoteRegex) || [];\n  27             const newFootnotes = footnoteDefinitions.filter(fn => !existingFootnotes.includes(fn));\n  28             \n  29             if (newFootnotes.length > 0) {\n  30                 finalMarkdown += \'\\n\\n\' + newFootnotes.join(\'\\n\');\n  31             }\n  32         }\n  33 \n  34         const pptxOptions: PptxConversionOptions = {\n  35             styles: options.styles as PptxConversionOptions[\'styles\'],\n  36             isRtl: options.isRtl,\n  37             includeToc: options.includeToc,\n  38         };\n  39 \n  40         const result = await convertMarkdownToPptx(finalMarkdown, project.name, pptxOptions);\n  41 \n  42         return result instanceof Blob ? result : new Blob([result as any], { \n  43             type: \'application/vnd.openxmlformats-officedocument.presentationml.presentation\' \n  44         });\n  45     }\n  46 \n  47     async exportFromMarkdown(markdown: string, fileName: string, options: ExportOptions): Promise<Blob | Buffer> {\n  48         const pptxOptions: PptxConversionOptions = {\n  49             styles: options.styles as PptxConversionOptions[\'styles\'],\n  50             isRtl: options.isRtl,\n  51             includeToc: options.includeToc,\n  52             title: fileName,\n  53         };\n  54 \n  55         const result = await convertMarkdownToPptx(markdown, fileName, pptxOptions);\n  56 \n  57         return result instanceof Blob ? result : new Blob([result as any], { \n  58             type: \'application/vnd.openxmlformats-officedocument.presentationml.presentation\' \n  59         });\n  60     }\n  61 \n  62     private generateMarkdownFromContent(content: Pr
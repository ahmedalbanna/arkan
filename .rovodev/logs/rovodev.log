/modules/templates/adapters/api-client/TemplateApiClient.ts`\n"}, "tool_call_id": "pyd_ai_c42af0e7aef0435e94ca7c3330544aa3", "id": null, "provider_name": "google-vertex", "provider_details": {"thought_signature": "ZTI0ODMwYTctNWNkNi00MmZlLTk5OGItZWU1MzllNzJiOWMz"}, "part_kind": "tool-call"}

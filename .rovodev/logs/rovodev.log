ion-500 ease-[0.22,1,0.36,1]',\n  50             isOpen && 'rotate-90 text-primary/60'\n  51           )}\n  52         />\n  53         \n  54         {/* Technical Label */}\n  55         <span className=\"text-[9px] font-black uppercase tracking-[0.3em] text-muted-foreground/70 flex-1 group-hover/section:text-primary/80 transition-colors\">\n  56           {title}\n  57         </span>\n  58 \n  59         {/* Action HUD / Status */}\n  60         {actions ? (\n  61             <div className=\"flex items-center gap-1 shrink-0 relative z-10\">\n  62                 {actions}\n  63             </div>\n  64         ) : (\n  65             <Binary className=\"h-2.5 w-2.5 text-muted-foreground/10 group-hover/section:text-primary/20 transition-colors\" />\n  66         )}\n  67       </button>\n  68 \n  69       {/* Animated Content Slot */}\n  70       <AnimatePresence initial={false}>\n  71         {isOpen && (\n  72           <motion.div\n  73             key=\"section-body\"\n  74             initial={{ height: 0, opacity: 0 }}\n  75             animate={{ height: 'auto', opacity: 1 }}\n  76             exit={{ height: 0, opacity: 0 }}\n  77             transition={{ duration: 0.5, ease: [0.22, 1, 0.36, 1] }}\n  78             className=\"overflow-hidden\"\n  79           >\n  80             <div className=\"p-5 flex flex-col gap-5 relative\">\n  81               {/* Subtle vertical architectural line */}\n  82               <div className=\"absolute left-3.5 inset-y-0 w-[1.5px] rounded-full bg-primary/5\" aria-hidden />\n  83               \n  84               <div className=\"relative z-10\">\n  85                 {children}\n  86               </div>\n  87             </div>\n  88           </motion.div>\n  89         )}\n  90       </AnimatePresence>\n  91     </div>\n  92   );\n  93 }\n  94 \n````"], "tool_call_id": "toolu_vrtx_017TpLuUJPMLvEgoFcGhkxZT", "metadata": null, "timestamp": "2026-04-08T00:55:06.632097+00:00", "part_kind": "tool-return"}

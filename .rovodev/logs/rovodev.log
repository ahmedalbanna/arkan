ess\', \'warning\', \'error\', \'alert\']).default(\'info\'),\n  28   link: z.string().optional(),\n  29 });\n  30 \n  31 type BatchNotificationValues = z.infer<typeof batchNotificationSchema>;\n  32 \n  33 import { Badge } from \'@/components/ui/badge\';\n  34 import { Separator } from \'@/components/ui/separator\';\n  35 import { cn } from \'@/infrastructure/utils/cn\';\n  36 import { DialogClose } from \'@/components/ui/dialog\';\n  37 \n  38 export function BatchNotificationDialog() {\n  39   const [isOpen, setIsOpen] = useState(false);\n  40   const { toast } = useToast();\n  41   const [isSubmitting, setIsSubmitting] = useState(false);\n  42 \n  43   const form = useForm<BatchNotificationValues>({\n  44     resolver: zodResolver(batchNotificationSchema),\n  45     defaultValues: {\n  46       title: \'\',\n  47       description: \'\',\n  48       type: \'info\',\n  49       link: \'\',\n  50     },\n  51   });\n  52 \n  53   const onSubmit = async (values: BatchNotificationValues) => {\n  54     setIsSubmitting(true);\n  55     try {\n  56       await apiService({\n  57         endpoint: \'/api/admin/notifications/batch\',\n  58         method: \'POST\',\n  59         data: values,\n  60       });\n  61 \n  62       toast({ title: \'Success\', description: \'Batch notification sent to all users.\' });\n  63       setIsOpen(false);\n  64       form.reset();\n  65     } catch (error: any) {\n  66       toast({ title: \'Error\', description: error.message || \'Failed to send batch notification\', variant: \'destructive\' });\n  67     } finally {\n  68       setIsSubmitting(false);\n  69     }\n  70   };\n  71 \n  72   return (\n  73     <Dialog open={isOpen} onOpenChange={setIsOpen}>\n  74       <DialogTrigger asChild>\n  75         <Button \n  76             variant="ghost" \n  77             size="sm"\n  78             className="h-8 gap-2 text-[10px] font-bold uppercase tracking-widest hover:bg-primary/5 hover:text-primary transition-all duration-300"\n  79 
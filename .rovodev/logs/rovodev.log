2026-01-26 04:15:22.674 | DEBUG    | Model response tool call: {"tool_name": "find_and_replace_code", "args": "{\"file_path\": \"src/app/api/notifications/mark-as-read/route.ts\", \"find\": \"// @ts-nocheck\\n// src/app/api/notifications/mark-as-read/route.ts\\nimport { NextResponse } from 'next/server';\\nimport { z } from 'zod';\\n\\nconst markAsReadSchema = z.object({\\n  notificationIds: z.array(z.string()).min(1),\\n});\\n\\nexport async function POST(request: Request) {\\n\\n    let authorization = request.headers.get('Authorization');\\n    if (!authorization?.startsWith('Bearer ')) {\\n        return NextResponse.json({ message: 'Unauthorized' }, { status: 401 });\\n    }\\n\\n    let token = authorization.substring(7);\\n    try {\\n        let decodedToken = await adminAuth.verifyIdToken(token, true);\\n        let userId = decodedToken.uid;\\n\\n        let body = await request.json();\\n        let validation = markAsReadSchema.safeParse(body);\\n\\n        if (!validation.success) {\\n            return NextResponse.json({ errors: validation.error.flatten().fieldErrors }, { status: 400 });\\n        }\\n\\n        let { notificationIds } = validation.data;\\n\\n        // Use the Admin SDK to interact with the Realtime Database\\n        let db = getDatabase();\\n        let updates: { [key: string]: any } = {};\\n        notificationIds.forEach(id => {\\n            updates[`/notifications/${userId}/${id}/isRead`] = true;\\n        });\\n\\n        await db.ref().update(updates);\\n\\n        return NextResponse.json({ message: 'Notifications marked as read.' }, { status: 200 });\\n\\n    } catch (error) {\\n        console.error('Error marking notifications as read:', error);\\n        return NextResponse.json({ message: 'An unexpected error occurred.' }, { status: 500 });\\n    }\\n}\", \"replace\": \"// @ts-nocheck\\n// src/app/api/notifications/mark-as-read/route.ts\\nimport { NextResponse } from 'next/server';\\nimport { z } from 'zod';\\nimport { auth } from '@/auth';\\nimport { db } from '@/db';\\nimport { notifications } from '@/db/schema';\\nimport { eq, inArray } from 'drizzle-orm';\\n\\nconst markAsReadSchema = z.object({\\n  notificationIds: z.array(z.number()).min(1),\\n});\\n\\nexport async function POST(request: Request) {\\n    try {\\n        const session = await auth();\\n        if (!session?.user?.id) {\\n            return NextResponse.json({ message: 'Unauthorized' }, { status: 401 });\\n        }\\n\\n        let body = await request.json();\\n        let validation = markAsReadSchema.safeParse(body);\\n\\n        if (!validation.success) {\\n            return NextResponse.json({ errors: validation.error.flatten().fieldErrors }, { status: 400 });\\n        }\\n\\n        let { notificationIds } = validation.data;\\n        const userId = parseInt(session.user.id);\\n\\n        // Update notifications in PostgreSQL to mark as read\\n        await db\\n            .update(notifications)\\n            .set({ read: true })\\n            .where(\\n                eq(notifications.userId, userId) && \\n                inArray(notifications.id, notificationIds)\\n            );\\n\\n        return NextResponse.json({ message: 'Notifications marked as read.' }, { status: 200 });\\n\\n    } catch (error) {\\n        console.error('Error marking notifications as read:', error);\\n        return NextResponse.json({ message: 'An unexpected error occurred.' }, { status: 500 });\\n    }\\n}\"}", "tool_call_id": "toolu_bdrk_01DNABowWyMW3aRWiRqMC3vG", "id": null, "provider_details": null, "part_kind": "tool-call"}

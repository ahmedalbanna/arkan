les/templates/adapters/hooks/use-docx-templates.ts`\\n- `src/modules/templates/adapters/hooks/use-pptx-templates.ts`\\n- `src/modules/templates/adapters/api-client/TemplateApiClient.ts`\\n"}', 'logfire.msg': 'running tool: exit_plan_mode', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span', 'logfire.exception.fingerprint': '53cc07e9ae7a54558ad13faf31fbedae46e2a124256a575ea513496853e48d14', 'logfire.level_num': 17}

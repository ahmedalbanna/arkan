erId\\n  99                     ? <ChapterGenerationHUD chapter={activeChapter} />\\n 100                     : <SectionGenerationHUD\\n 101                         section={activeSection}\\n 102                         selectedSectionIds={selectedSectionIds.length > 1 ? selectedSectionIds : undefined}\\n 103                     />,\\n 104             },\\n 105             {\\n 106                 key: \'global\',\\n 107                 title: \'Intelligence Matrix\',\\n 108                 icon: <SlidersHorizontal className=\\"h-4 w-4\\" />,\\n 109                 content: <GlobalIntelligenceHUD />,\\n 110             },\\n 111             {\\n 112                 key: \'chat\',\\n 113                 title: \'Project Consultant\',\\n 114                 icon: <MessageSquare className=\\"h-4 w-4\\" />,\\n 115                 content: <ProjectConsultantHUD isOpen={true} onClose={() => setActiveRightPanelKey(\'section\')} />,\\n 116             },\\n 117             {\\n 118                 key: \'snapshots\',\\n 119                 title: \'Temporal Snapshots\',\\n 120                 icon: <HistoryIcon className=\\"h-4 w-4\\" />,\\n 121                 content: <SnapshotHistoryPanel />,\\n 122             },\\n 123         ];\\n 124     }, [project, selectedSectionIds, activeChapterId, setActiveRightPanelKey]);\\n 125 \\n 126     return { leftPanels, rightPanels };\\n 127 }\\n 128 \\n````"]'}

alization();\n 101     const { toast } = useToast();\n 102     const { project, updateProject, selectedFileId, selectFile } = useBuilderStore();\n 103     \n 104     const [isLoading, setIsLoading] = useState(false);\n 105     const [textInput, setTextInput] = useState(\'\');\n 106     const [textFileName, setTextFileName] = useState(\'\');\n 107     const [searchQuery, setSearchQuery] = useState(\'\');\n 108     const [inspectItem, setInspectItem] = useState<{ fileName: string, content: string } | null>(null);\n 109 \n 110     const onDrop = useCallback((acceptedFiles: File[]) => {\n 111         setIsLoading(true);\n 112         acceptedFiles.forEach(file => {\n 113             const reader = new FileReader();\n 114             reader.onerror = () => toast({ title: t(\'builder.files.toasts.fileReadError\'), variant: \'destructive\' });\n 115             reader.onload = () => {\n 116                 const content = reader.result as string;\n 117                 updateProject(p => p.addExternalContext({ fileName: file.name, content, type: \'context\' }, uuidv4()));\n 118                 toast({ title: "Vector Integrated", description: `${file.name} successfully mapped to source core.` });\n 119             };\n 120             if (file.type.startsWith(\'text/\') || file.name.endsWith(\'.md\')) reader.readAsText(file);\n 121             else reader.readAsDataURL(file);\n 122         });\n 123         setIsLoading(false);\n 124     }, [updateProject, toast, t]);\n 125 \n 126     const { getRootProps, getInputProps, isDragActive } = useDropzone({\n 127         onDrop,\n 128         multiple: true,\n 129         accept: {\n 130             \'application/pdf\': [\'.pdf\'],\n 131             \'application/msword\': [\'.doc\'],\n 132             \'application/vnd.openxmlformats-officedocument.wordprocessingml.document\': [\'.docx\'],\n 133             \'text/plain\': [\'.txt\'],\n 134             \'text/markdown\': [\'.md\'],\n 135             \'image/jpeg\': [\'.jpeg\', \'.jpg\'],\n 136             \'image/png\': [\'.png\'],\n 137             \'image/webp\': [\'.webp\'],\n 138         }\n 139     });\n 140 \n 141     const handleAddPastedText = () => {\n 142         if (!textInput.trim() || !textFileName.trim()) return;\n 143         updateProject(p => p.addExternalContext({\n 144             fileName: `${textFileName.trim()}.md`,\n 145             content: textInput,\n 146             type: \'context\',\n 147         }, uuidv4()));\n 148         setTextInput(\'\');\n 149         setTextFileName(\'\');\n 150         toast({ title: "Logic Integrated", description: "Raw text node successfully synthesized." });\n 151     };\n 152 \n 153     const externalContext = project?.externalContext || [];\n 154     const filteredContext = useMemo(() => \n 155         externalContext.filter(item => item.fileName.toLowerCase().includes(searchQuery.toLowerCase())),\n 156     [externalContext, searchQuery]);\n 157 \n 158     const fileTypes: ExternalContextType[] = [\'context\', \'example\', \'question\', \'textbook\', \'guidelines\'];\n 159 \n 160     if (!project) return null;\n 161 \n 162     return (\n 163         <SidebarContainer\n 164             title="Context Dashboard"\n 165             icon={<LayoutGrid className="h-3.5 w-3.5" />}\n 166         >\n 167             <Tabs defaultValue="files" className="w-full flex flex-col gap-8 pt-2 animate-in fade-in slide-in-from-right-4 duration-500">\n 168                 <TabsList className="grid w-full grid-cols-2 h-11 rounded-2xl bg-muted/20 p-1 gap-1 border border-border/40 backdrop-blur-md">\n 169                     <TabsTrigger value="files" className="text-[10px] font-black uppercase tracking-[0.15em] data-[state=active]:bg-background data-[state=active]:text-primary data-[state=active]:shadow-lg px-2 transition-all rounded-xl">\n 170                         Source Core\n 171                     </TabsTrigger>\n 172                     <TabsTrigger value="analyst" className="gap-2 text-[10px] font-black uppercase tracking-[0.15em] data-[state=active]:bg-background data-[state=active]:text-primary data-[state=active]:shadow-lg px-2 transition-all rounded-xl">\n 173                         <AtomIcon className="h-3.5 w-3.5 shrink-0" />\n 174                         Analyst\n 175                     </TabsTrigger>\n 176                 </TabsList>\n 177 \n 178                 <TabsContent value="files" className="m-0 focus-visible:ring-0 flex flex-col gap-8">\n 179                     {/* Ingestion Matrix */}\n 180                     <div className="space-y-6 relative px-1">\n 181                         {/* Depth architectural line */}\n 182                         <div className="absolute left-[-1.25rem] top-0 bottom-0 w-px bg-gradient-to-b from-primary/30 via-primary/5 to-transparent" />\n 183 \n 184                         <Tabs defaultValue="upload" className="w-full">\n 185                             <TabsList className="grid w-full grid-cols-2 h-9 rounded-xl bg-muted/10 p-1 gap-1 border border-primary/5">\n 186                                 <TabsTrigger value="upload" className="text-[9px] font-black uppercase tracking-widest rounded-lg">Upload Matrix</TabsTrigger>\n 187                                 <TabsTrigger value="text" className="text-[9px] font-black uppercase tracking-widest rounded-lg">Raw Payloads</TabsTrigger>\n 188                             </TabsList>\n 189 \n 190                             <TabsContent value="upload" className="mt-5 m-0 focus-visible:ring-0">\n 191                                 <div {...getRootProps()} className={cn(\n 192                                     "border-2 border-dashed rounded-3xl p-8 text-center cursor-pointer transition-all duration-500 group bg-muted/5 shadow-inner relative overflow-hidden",\n 193                                     isDragActive ? "border-primary bg-primary/[0.03] ring-4 ring-primary/5" : "border-primary/10 hover:border-primary/30 hover:bg-muted/8"\n 194                                 )}>\n 195                                     <input {...getInputProps()} />\n 196                                     <div className="relative mx-auto h-12 w-12 mb-4">\n 197                                         {isLoading ? (\n 198                                             <Loader2 className="h-full w-full animate-spin text-primary/40" />\n 199                                         ) : (\n 200                                             <>\n 201                                                 <UploadCloud className={cn(\n 202                                                     "h-full w-full transition-all duration-500",\n 203                                                     isDragActive ? "text-primary scale-110" : "text-muted-foreground/40 group-hover:text-primary/60 group-hover:scale-105"\n 204                                                 )} />\n 205                                                 {!isDragActive && (\n 206                                                     <div className="absolute -bottom-1 -right-1 h-5 w-5 bg-background rounded-full border border-primary/20 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">\n 207                                                         <Plus className="h-3 w-3 text-primary" />\n 208                                                     </div>\n 209                                                 )}\n 210                                             </>\n 211                                         )}\n 212                                     </div>\n 213                                     <p className="text-[10px] font-black uppercase tracking-[0.2em]">{isDragActive ? "Infiltrate Files" : "Initialize Ingestion"}</p>\n 214                                     <p className="mt-1.5 text-[9px] text-muted-foreground italic font-medium opacity-40 uppercase tracking-widest">PDF, DOCX, MD, JPG Supported</p>\n 215                                 </div>\n 216                             </TabsContent>\n 217 \n 218                             <TabsContent value="text" className="mt-5 space-y-5 m-0 focus-visible:ring-0">\n 219                                 <div className="space-y-4">\n 220                                     <div className="space-y-2">\n 221                                         <Label className="text-[9px] font-black uppercase tracking-[0.2em] text-primary/40 px-1">Node Identifier</Label>\n 222                                         <Input value={textFileName} onChange={(e) => setTextFileName(e.target.value)} placeholder="VECTOR_LABEL..." className="h-10 text-[11px] font-bold bg-muted/5 border-primary/10 focus-visible:ring-primary/20 rounded-xl uppercase tracking-widest" />\n 223                                     </div>\n 224                                     <div className="space-y-2">\n 225                                         <Label className="text-[9px] font-black uppercase tracking-[0.2em] text-primary/40 px-1">Raw Payload</Label>\n 226                                         <Textarea value={textInput} onChange={(e) => setTextInput(e.target.value)} rows={5} placeholder="INPUT_DATA..." className="text-[11px] bg-muted/5 border-primary/10 focus-visible:ring-primary/20 rounded-2xl resize-none p-4 font-serif italic shadow-inner" />\n 227                                     </div>\n 228                                 </div>\n 229                                 <Button onClick={handleAddPastedText} disabled={!textInput.trim() || !textFileName.trim()} className="w-full h-11 text-[10px] font-black uppercase tracking-[0.2em] gap-2.5 shadow-xl shadow-primary/15 rounded-xl bg-primary hover:opacity-90 ring-1 ring-inset ring-white/20 transition-all">\n 230                                     <Plus className="h-4 w-4" />\n 231                                     Materialize Node\n 232                                 </Button>\n 233                             </TabsContent>\n 234                         </Tabs>\n 235 \n 236                         {/* Search & Filter Matrix */}\n 237                         <div className="relative group/search pt-2">\n 238                             <Input \n 239                                 value={searchQuery}\n 240                                 onChange={(e) => setSearchQuery(e.target.value)}\n 241                                 placeholder="SCAN SOURCE CORE..."\n 242                                 className="h-10 pl-10 pr-10 text-[10px] bg-muted/5 border-primary/5 focus-visible:border-primary/20 focus-visible:ring-primary/10 rounded-2xl transition-all uppercase font-bold tracking-widest placeholder:text-muted-foreground/30"\n 243                             />\n 244                             <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground/20 group-focus-within/search:text-primary transition-colors" />\n 245                             {searchQuery && (\n 246                                 <button onClick={() => setSearchQuery(\'\')} className="absolute right-3.5 top-1/2 -translate-y-1/2 hover:text-primary transition-colors text-muted-foreground/40">\n 247                                     <X className="h-4 w-4" />\n 248                                 </button>\n 249                             )}\n 250                         </div>\n 251 \n 252                         {/* Vector Stack */}\n 253                         <div className="space-y-4">\n 254                             <div className="flex items-center justify-between px-1">\n 255                                 <h3 className="text-[9px] font-black uppercase tracking-[0.3em] text-primary/60 flex items-center gap-2">\n 256                                     <Layers className="h-3 w-3" />\n 257                                     Integrated Vectors\n 258                                 </h3>\n 259                                 <Badge variant="outline" className="h-5 text-[9px] font-black border-primary/20 bg-primary/5 text-primary tabular-nums px-2.5 rounded-full shadow-inner ring-1 ring-inset ring-primary/10">\n 260                                     {externalContext.length} NODES\n 261                                 </Badge>\n 262                             </div>\n 263                             \n 264                             <div className="space-y-3">\n 265                                 {filteredContext.map((item, index) => (\n 266                                     <div key={item.id} className="space-y-2.5">\n 267                                         <FileNodeItem \n 268                                             item={item} \n 269                                             onView={() => setInspectItem(item)}\n 270                                             onDelete={() => updateProject(p => p.removeExternalContext(index))}\n 271                                             className={selectedFileId === item.id ? \'border-primary/30 bg-primary/[0.03] ring-1 ring-primary/10\' : \'\'}\n 272                                         />\n 273                                         <div className="flex items-center gap-2 pl-4">\n 274                                             <div className="h-px w-3 bg-primary/20" />\n 275                                             <Select \n 276                                                 value={item.type} \n 277                                                 onValueChange={(v: ExternalContextType) => updateProject(p => p.updateExternalContextType(index, v))}\n 278                                             >\n 279                                                 <SelectTrigger className="h-6 w-auto min-w-[100px] border-none bg-primary/5 hover:bg-primary/10 text-[8px] font-black uppercase tracking-widest text-primary/60 transition-all px-2.5 rounded-lg focus:ring-0">\n 280                                                     <SelectValue />\n 281                                                 </SelectTrigger>\n 282                                                 <SelectContent className="rounded-xl border-primary/10 shadow-2xl backdrop-blur-3xl">\n 283                                                     {fileTypes.map(t => (\n 284                                                         <SelectItem key={t} value={t} className="text-[9px] font-black uppercase tracking-widest py-2.5 cursor-pointer focus:bg-primary/5 focus:text-primary">\n 285                                                             {t}\n 286                                                         </SelectItem>\n 287                                                     ))}\n 288                                                 </SelectContent>\n 289                                             </Select>\n 290                                         </div>\n 291                                     </div>\n 292                                 ))}\n 293                                 \n 294                                 {filteredContext.length === 0 && (\n 295                                     <div className="flex flex-col items-center justify-center py-16 text-center space-y-4 opacity-30">\n 296                                         <div className="p-5 rounded-full bg-muted/20 border border-dashed border-muted-foreground/40">\n 297                                             <Database className="h-10 w-10 text-muted-foreground stroke-[1]" />\n 298                                         </div>\n 299                                         <p className="text-[10px] font-black uppercase tracking-[0.2em] px-10 leading-relaxed">No Intel Vectors Found</p>\n 300                                     </div>\n 301                                 )}\n 302                             </div>\n 303                         </div>\n 304                     </div>\n 305                 </TabsContent>\n 306 \n 307                 <TabsContent value="analyst" className="m-0 focus-visible:ring-0 min-h-0">\n 308                     <IntelligenceAnalyst />\n 309                 </TabsContent>\n 310             </Tabs>\n 311 \n 312             <ContextInspectorHUD \n 313                 item={inspectItem} \n 314                 isOpen={inspectItem !== null} \n 315                 onClose={() => setInspectItem(null)} \n 316             />\n 317 \n 318             {/* Stable Version Footer */}\n 319             <div className="absolute bottom-0 left-0 right-0 px-6 py-3 border-t border-primary/10 bg-background/40 backdrop-blur-xl flex items-center justify-between">\n 320                 <div className="flex items-center gap-2">\n 321                     <div className="h-1 w-1 rounded-full bg-primary/30" />\n 322                     <span className="text-[8px] font-black uppercase tracking-widest text-muted-foreground/40">Source Dashboard</span>\n 323                 </div>\n 324                 <span className="text-[8px] font-bold text-muted-foreground/20 tabular-nums">v2.1.4-STABLE</span>\n 325             </div>\n 326         </SidebarContainer>\n 327     );\n 328 }\n 329 \n````'}

lineVisible, setIsOutlineVisible] = useState(false);\n  const [viewMode, setViewMode] = useState<'edit' | 'preview'>('edit');\n  const { isSaving } = useSaveProject();\n  const builderPageLogic = useBuilderPageLogic(initialProject);\n  const { updateProject } = builderPageLogic;\n  const project = useBuilderStore(state => state.project);\n\n  const summarizeMutation = useWritingTool('summarize');\n  const expandMutation = useWritingTool('expand-text');\n  const rewriteMutation = useWritingTool('rewrite-text');\n\n  const rewriteStyles = useMemo(() => [\n    { label: 'Professional', style: 'professional' },\n    { label: 'Academic', style: 'academic' },\n    { label: 'Creative', style: 'creative' },\n    { label: 'Simple', style: 'simple' },\n    { label: 'Detailed', style: 'detailed' },\n  ], []);\n\n  useEffect(() => {\n    document.documentElement.style.setProperty('--zoom-scale', String(zoomLevel));\n    return () => {\n      document.documentElement.style.removeProperty('--zoom-scale');\n    };\n  }, [zoomLevel]);\n\n  const handleActiveSectionChange = useCallback((id: string | null, multiSelect?: boolean) => {\n    if (multiSelect && id) {\n      setSelectedSectionIds(prev => {\n        if (prev.includes(id)) {\n          return prev.filter(sid => sid !== id);\n        }\n        return [...prev, id];\n      });\n      setActiveChapterId(null);\n      return;\n    }\n\n    setSelectedSectionIds(id ? [id] : []);\n    if (id) setActiveChapterId(null);\n  }, []);\n\n  const handleActiveChapterChange = useCallback((id: string | null) => {\n    setActiveChapterId(id);\n    if (!id) {\n      setSelectedSectionIds([]);\n      return;\n    }\n\n    const chapter = builderPageLogic.project?.getChapter(id);\n    if (chapter) {\n      setSelectedSectionIds(chapter.sections.map(s => s.id));\n      return;\n    }\n\n    setSelectedSectionIds([]);\n  }, [builderPageLogic.project]);\n\n  const { leftPanels, rightPanels } = useSidebarPanels({\n    project: builderPageLogic.project,\n    selectedSectionIds,\n    activeChapterId,\n    onActiveSectionChange: handleActiveSectionChange,\n    onActiveChapterChange: handleActiveChapterChange,\n    setActiveRightPanelKey,\n  });\n\n  const handleMoveItem = useCallback((activeId: string, overId: string) => {\n    updateProject((p: any) => p.moveItem(activeId, overId));\n  }, [updateProject]);\n\n  const handleUpdateTitle = useCallback((id: string, newTitle: string, isChapter: boolean) => {\n    updateProject((p: any) => p.updateItemTitle(id, newTitle, isChapter));\n  }, [updateProject]);\n\n  const handleDeleteItem = useCallback((id: string, isChapter: boolean) => {\n    updateProject((p: any) => p.deleteItem(id, isChapter));\n  }, [updateProject]);\n\n  const handleAddChapter = useCallback(() => {\n    updateProject((p: any) => p.addChapter());\n  }, [updateProject]);\n\n  const handleAddSection = useCallback((chapterId: string) => {\n    updateProject((p: any) => p.addSection(chapterId));\n  }, [updateProject]);\n\n  const handleDuplicateItem = useCallback((id: string, isChapter: boolean) => {\n    updateProject((p: any) => p.duplicateItem(id, isChapter));\n  }, [updateProject]);\n\n  const handleUndo = useCallback(() => {\n    useBuilderStore.getState().undo();\n  }, []);\n\n  const handleCopyItem = useCallback((id: string, isChapter: boolean) => {\n    // Implement local storage or state based copy\n    localStorage.setItem('arkan_copied_item', JSON.stringify({ id, isChapter }));\n  }, []);\n\n  const handlePasteItem = useCallback((targetId: string, isChapter: boolean) => {\n    const copied = localStorage.getItem('arkan_copied_item');\n    if (copied) {\n      const { id, isChapter: copiedIsChapter } = JSON.parse(copied);\n      updateProject((p: any) => p.pasteItem(id, copiedIsChapter, targetId, isChapter));\n    }\n  }, [updateProject]);\n\n  const { saveProjectMutation } = useSaveProject();\n\n  const handleSave = useCallback(() => {\n    if (builderPageLogic.project) {\n      saveProjectMutation.mutate(builderPageLogic.project.toProperties());\n    }\n  }, [builderPageLogic.project, saveProjectMutation]);\n\n  const handleZoomIn = useCallback(() => {\n    setZoomLevel(prev => Math.min(prev + 0.1, 2));\n  }, []);\n\n  const handleZoomOut = useCallback(() => {\n    setZoomLevel(prev => Math.max(prev - 0.1, 0.5));\n  }, []);\n\n  const handleZoomReset = useCallback(() => {\n    setZoomLevel(1);\n  }, []);\n\n  const hasUnsavedChanges = useBuilderStore(state => state.hasUnsavedChanges);\n\n  return {\n    ...builderPageLogic,\n    activePanelKey,\n    setActivePanelKey,\n    activeRightPanelKey,\n    setActiveRightPanelKey,\n    isLeftPanelVisible,\n    isRightPanelVisible,\n    isSaving,\n    handleSave,\n    hasUnsavedChanges,\n    leftPanels,\n    rightPanels,\n    t,\n    locale,\n    isChatOpen,\n    setIsChatOpen,\n    zoomLevel,\n    setZoomLevel,\n    handleZoomIn,\n    handleZoomOut,\n    handleZoomReset,\n    selectedSectionIds,\n    setSelectedSectionIds,\n    handleActiveSectionChange,\n    handleActiveChapterChange,\n    activeChapterId,\n    setActiveChapterId,\n    isOutlineVisible,\n    setIsOutlineVisible,\n    viewMode,\n    setViewMode,\n    handleMoveItem,\n    handleUpdateTitle,\n    handleDeleteItem,\n    handleAddChapter,\n    handleAddSection,\n    handleDuplicateItem,\n    handleUndo,\n    handleCopyItem,\n    handlePasteItem,\n    summarizeMutation,\n    expandMutation,\n    rewriteMutation,\n    rewriteStyles,\n    syncProjectStructure: useBuilderStore.getState().syncProjectStructure,\n  };\n}\n", 'tool_response': 'Successfully replaced code in src/modules/ai-content/adapters/hooks/report-mode/useReportGenerator.ts:\n\n--- src/modules/ai-content/adapters/hooks/report-mode/useReportGenerator.ts\n+++ src/modules/ai-content/adapters/hooks/report-mode/useReportGenerator.ts\n@@ -162,7 +162,6 @@\n     isSaving,\n     handleSave,\n     hasUnsavedChanges,\n-    leftPanels,\n     rightPanels,\n     t,\n     locale,\n'}

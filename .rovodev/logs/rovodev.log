d parameters.\n  35  * \n  36  * DEFENSIVE MEASURES:\n  37  * 1. Prop Integrity: Handles null/empty chapters and project state gracefully.\n  38  * 2. Safe Reductions: Validates section arrays before calculating totals.\n  39  * 3. Execution Guard: Prevents triggering empty builds or duplicate requests.\n  40  * 4. UX Safety: Provides clear warnings for destructive overwrite operations.\n  41  */\n  42 \n  43 interface BuildManifestHUDProps {\n  44   isOpen: boolean;\n  45   onOpenChange: (open: boolean) => void;\n  46   chaptersToBuild: Chapter[];\n  47   onGenerateProject: () => void;\n  48   isLoading: boolean;\n  49 }\n  50 \n  51 export function BuildManifestHUD({\n  52   isOpen,\n  53   onOpenChange,\n  54   chaptersToBuild = [], // Default to empty array\n  55   onGenerateProject,\n  56   isLoading,\n  57 }: BuildManifestHUDProps) {\n  58   const project = useBuilderStore(state => state.project);\n  59 \n  60   // 1. INPUT VALIDATION & DERIVED STATS\n  61   const totalSections = useMemo(() => {\n  62     try {\n  63         if (!Array.isArray(chaptersToBuild)) return 0;\n  64         return chaptersToBuild.reduce((acc, chapter) => {\n  65             const sectionsCount = Array.isArray(chapter?.sections) ? chapter.sections.length : 0;\n  66             return acc + sectionsCount;\n  67         }, 0);\n  68     } catch (e) {\n  69         console.error(\'[BuildManifestHUD] Section count calculation failed:\', e);\n  70         return 0;\n  71     }\n  72   }, [chaptersToBuild]);\n  73 \n  74   const isValidManifest = useMemo(() => {\n  75     return !!project && chaptersToBuild.length > 0 && totalSections > 0;\n  76   }, [project, chaptersToBuild, totalSections]);\n  77 \n  78   // 2. STABLE HANDLERS\n  79   const handleOpenChange = useCallback((open: boolean) => {\n  80     if (!isLoading) {\n  81         onOpenChange(open);\n  82     }\n  83   }, [onOpenChange, isLoading]);\n  84 \n  85   const handleGenerateProject = useCallback(() => {\n  86     if (!isVal
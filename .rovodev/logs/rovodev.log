     }\n 112         }\n 113       }\n 114       return p;\n 115     });\n 116     toast({ title: 'Pasted', description: `Successfully pasted ${clipboard.type}.` });\n 117   };\n 118 \n 119   return {\n 120     handleMoveItem,\n 121     handleUpdateTitle,\n 122     handleDeleteItem,\n 123     handleAddChapter,\n 124     handleAddSection,\n 125     handleDuplicateItem,\n 126     handleCopyItem,\n 127     handlePasteItem,\n 128     undo,\n 129     clipboard\n 130   };\n 131 };\n 132 \n````"], "tool_call_id": "pyd_ai_73498a9b9990475aad2d295d00ea2e9c", "metadata": null, "timestamp": "2026-04-05T05:07:06.351889+00:00", "part_kind": "tool-return"}

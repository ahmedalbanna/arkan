hema, type FactCheckInput, type FactCheckOutput } from '@/modules/ai/domain/schemas';\n   9 \n  10 const factCheckPrompt = ai.definePrompt({\n  11   name: 'factCheckPrompt',\n  12   input: { schema: FactCheckInputSchema },\n  13   // No output schema - model returns plain JSON text\n  14   model: 'ollama/phi4-mini:latest',\n  15   config: {\n  16     // responseSchema removed\n  17     temperature: 0.3,\n  18   },\n  19 \n  20   prompt: `You are an expert fact-checker and research analyst. Your task is to analyze the following text, identify all verifiable claims, and determine their factual accuracy.\n  21 \n  22 **Your Process:**\n  23 1.  **Identify Claims:** Carefully read the text and extract all specific, factual statements that can be verified (e.g., statistics, historical events, scientific statements).\n  24 2.  **Verify Claims:** For each claim, determine its status ('Verified', 'False', or 'Inconclusive').\n  25 3.  **Find a Source:** Provide one high-quality, reliable source (e.g., a reputable news organization, scientific journal, or official website) that supports your verification. Provide the domain name (e.g., 'wikipedia.org', 'nasa.gov').\n  26 4.  **Explain Your Reasoning:** Briefly explain your conclusion for each claim.\n  27 5.  **Calculate Originality Score:** Based on the accuracy of the claims, provide an overall originality/accuracy score from 0 to 100.\n  28 \n  29 **Text to Analyze:**\n  30 ---\n  31 {{{text}}}\n  32 ---\n  33 \n  34 **JSON Output:**`,\n  35 });\n  36 \n  37 const factCheckFlow = ai.defineFlow({\n  38   name: 'factCheckFlow',\n  39   inputSchema: FactCheckInputSchema,\n  40   outputSchema: FactCheckOutputSchema,\n  41 }, async (input: FactCheckInput) => {\n  42   try {\n  43     const result = await factCheckPrompt(input);\n  44     \n  45     if (!result) {\n  46       throw new Error('No output received from the model.');\n  47     }\n  48 \n  49     let output: FactCheckOutput;\n  50     try {\n  51       const jsonText = result.text || result.output || '';\n  52       output = JSON.parse(jsonText);\n  53     } catch (parseError) {\n  54       console.error('Failed to parse Fact Check JSON:', parseError);\n  55       throw new Error('Fact Check returned invalid JSON');\n  56     }\n  57 \n  58     const validation = FactCheckOutputSchema.safeParse(output);\n  59     if (!validation.success) {\n  60       console.error('Fact Check output validation failed:', validation.error);\n  61       throw new Error('Fact Check output does not match expected structure');\n  62     }\n  63 \n  64     return validation.data;\n  65   } catch (error) {\n  66     console.error('Error in factCheckFlow:', error);\n  67     throw new Error(`factCheck failed: ${error instanceof Error ? error.message : 'Unknown error'}`);\n  68   }\n  69 });\n  70 \n  71 export async function factCheckText(input: FactCheckInput): Promise<FactCheckOutput> {\n  72   const validation = FactCheckInputSchema.safeParse(input);\n  73   if (!validation.success) {\n  74     throw new Error(`Invalid input for factCheckText: ${validation.error.message}`);\n  75   }\n  76   return factCheckFlow(validation.data);\n  77 }\n  78 \n````"], "tool_call_id": "pyd_ai_c781e75dedbe4eef95a8cd907da2a62b", "metadata": null, "timestamp": "2026-04-03T04:15:05.159614+00:00", "part_kind": "tool-return"}

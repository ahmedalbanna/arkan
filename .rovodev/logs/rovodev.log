iResponse(templates, 200);\\n    } catch (error) {\\n        return handleApiError(error);\\n    }\\n}\\n\\n\\nexport const POST = withAuth(async ({ request }) => {\\n    try {\\n        const adminApp = getAdminApp();\\n        const adminDb = getFirestore(adminApp);\\n        const collectionRef = adminDb.collection(\'templates\').doc(\'report\').collection(\'items\');\\n\\n        let body = await request.json();\\n        const validation = CreateReportTemplateSchema.safeParse(body);\\n        if (!validation.success) {\\n            return handleApiError(validation.error);\\n        }\\n\\n        const { id, ...data } = validation.data;\\n\\n        const docRef = collectionRef.doc(id);\\n        const doc = await docRef.get();\\n        if (doc.exists) {\\n            return handleApiError({ message: \'A report template with this ID already exists.\' }, 409);\\n        }\\n\\n        await docRef.set(data);\\n        return createApiResponse({ id, ...data }, 201);\\n    } catch (error) {\\n        return handleApiError(error);\\n    }\\n}, { requireAdmin: true });", "replace": "// @ts-nocheck\\n\\n// src/app/api/templates/report/route.ts\\nimport { CreateReportTemplateSchema, type ReportTemplateProperties } from \'@/lib/models\';\\nimport { createApiResponse, handleApiError, withAuth } from \'@/lib/utils/api-utils\';\\nimport { defaultReportTemplates } from \'@/lib/db/seed-data/report-templates\';\\nimport { db } from \'@/db\';\\nimport { templates } from \'@/db/schema\';\\nimport { eq } from \'drizzle-orm\';\\n\\n// This is a public endpoint that does not require authentication\\n// as all users need to be able to fetch the templates for building reports.\\nexport async function GET() {\\n    try {\\n        // Fetch report templates from PostgreSQL\\n        let templateRecords = await db\\n            .select()\\n            .from(templates)\\n            .where(eq(templates.type, \'report\'));\\n\\n        // Lazy seeding if no templates exist\\n        if (templateRecords.length === 0) {\\n            // Insert default templates\\n            for (const template of defaultReportTemplates) {\\n                await db.insert(templates).values({\\n                    name: template.name || template.id,\\n                    description: template.description,\\n                    category: template.category || \'report\',\\n                    type: \'report\',\\n                    sections: template.content ? JSON.stringify(template.content) : null,\\n                });\\n            }\\n            \\n            // Re-fetch after seeding\\n            templateRecords = await db\\n                .select()\\n                .from(templates)\\n                .where(eq(templates.type, \'report\'));\\n        }\\n\\n        // Map database records to response format\\n        const result = templateRecords.map(record => ({\\n            id: record.id,\\n            name: record.name,\\n            description: record.description,\\n            category: record.category,\\n            type: record.type,\\n            content: record.sections ? JSON.parse(record.sections as string) : undefined,\\n        }));\\n\\n        return createApiResponse(result, 200);\\n    } catch (error) {\\n        return handleApiError(error);\\n    }\\n}\\n\\n\\nexport const POST = withAuth(async ({ request }) => {\\n    try {\\n        let body = await request.json();\\n        const validation = CreateReportTemplateSchema.safeParse(body);\\n        if (!validation.success) {\\n            return handleApiError(validation.error);\\n        }\\n\\n        const { id, name, description, category, content } = validation.data;\\n\\n        // Check if template with this name already exists\\n        const existing = await db\\n            .select()\\n            .from(templates)\\n            .where(eq(templates.name, name));\\n\\n        if (existing.length > 0) {\\n            return handleApiError({ message: \'A report template with thi
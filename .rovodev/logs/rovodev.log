atsUseCase.execute();\\n  58     }\\n  59 \\n  60     async clearCache() {\\n  61         return this.clearRagCacheUseCase.execute();\\n  62     }\\n  63 \\n  64     async isSearchCacheHit(query: string, options?: { projectId?: string; topK?: number; minScore?: number }) {\\n  65         return this.checkRagSearchCacheHitUseCase.execute(query, options);\\n  66     }\\n  67 \\n  68     async compareReranking(query: string, strategy?: \'cross-encoder\' | \'bm25\' | \'hybrid\' | \'reciprocal-rank-fusion\' | \'all\') {\\n  69         return this.compareRerankingUseCase.execute(query, strategy);\\n  70     }\\n  71 \\n  72     async getIndexedDocuments(limit?: number) {\\n  73         return this.getIndexedDocumentsUseCase.execute(limit);\\n  74     }\\n  75 \\n  76     async deleteIndexedDocument(options: { projectId?: string, sourceFile?: string }) {\\n  77         return this.deleteIndexedDocumentUseCase.execute(options);\\n  78     }\\n  79 \\n  80     async recordFailedIndexing(data: Pick<IndexedDocumentRecord, \'projectId\' | \'userId\' | \'sourceFile\' | \'fileSize\' | \'type\' | \'errorMessage\'>) {\\n  81         return this.indexDocumentUseCase.recordFailed(data);\\n  82     }\\n  83 }\\n  84 \\n````","Successfully opened src/app/api/rag/index-document/route.ts:\\n\\n````typescript\\n   0 \\n   1 import { NextRequest } from \'next/server\';\\n   2 import { z } from \'zod\';\\n   3 import { container } from \'@/infrastructure/di/container\';\\n   4 import { RagController } from \'@/modules/rag/adapters/controllers/RagController\';\\n   5 import { handleRagResult, handleApiError } from \'@/infrastructure/api/api-utils\';\\n   6 \\n   7 const IndexDocumentSchema = z.object({\\n   8   content: z.string().min(1, \'Content is required\'),\\n   9   fileName: z.string().min(1, \'File name is required\'),\\n  10   userId: z.string().min(1, \'User ID is required\'),\\n  11   projectId: z.string().optional(),\\n  12   type: z.enum([\'user_upload\', \'reference\']).default
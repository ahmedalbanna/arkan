ndex(null);\n 189         } catch (error) {\n 190             console.error(\'[SourceManager] Vector update failure:\', error);\n 191         }\n 192     }, [editingIndex, project, updateProject]);\n 193 \n 194     const removeContext = useCallback((index: number) => {\n 195         if (!project || !updateProject) return;\n 196         try {\n 197             updateProject(p => p.removeExternalContext(index));\n 198         } catch (error) {\n 199             console.error(\'[SourceManager] Vector removal failure:\', error);\n 200         }\n 201     }, [project, updateProject]);\n 202 \n 203     const updateContextType = useCallback((index: number, type: ExternalContextType) => {\n 204         if (!project || !updateProject) return;\n 205         try {\n 206             updateProject(p => p.updateExternalContextType(index, type));\n 207         } catch (error) {\n 208             console.error(\'[SourceManager] Context type classification failure:\', error);\n 209         }\n 210     }, [project, updateProject]);\n 211 \n 212     if (!project) {\n 213         return (\n 214             <div className="flex flex-col items-center justify-center h-64 text-center space-y-4 opacity-40">\n 215                 <div className="p-5 rounded-[24px] bg-primary/5 border border-primary/10">\n 216                     <Database className="h-8 w-8 text-primary/40" />\n 217                 </div>\n 218                 <div className="space-y-1.5 px-6">\n 219                     <p className="text-[10px] font-black uppercase tracking-[0.3em] text-muted-foreground">Source Matrix Offline</p>\n 220                     <p className="text-[11px] font-medium leading-relaxed italic text-muted-foreground/60 max-w-[200px]">\n 221                         Initialize or load a project to map cognitive source vectors.\n 222                     </p>\n 223                 </div>\n 224             </div>\n 225         );\n 226     }\n 227 \n 228     return (\n 229         <div className="flex flex-c
2026-04-05 08:38:15.900 | 24908 (24908) | DEBUG    | Model response tool call: {"tool_name": "create_file", "args": {"initial_content": "import { POINTS_PER_INCH } from './constants';\n\n/**\n * A minimal interface for a 2D rendering context, sufficient for text measurement.\n */\ninterface MeasurableContext {\n    measureText(text: string): { width: number };\n}\n\n/**\n * A cache for measurable contexts to avoid re-allocation.\n */\nconst measurableContextCache: { [key: string]: MeasurableContext } = {};\n\n/**\n * Gets a MeasurableContext based on the current environment.\n * prioritizes Heuristic measurement for server-side stability.\n * \n * DEFENSIVE MEASURES:\n * 1. Server-First: Heuristic logic is instantiated without DOM references.\n * 2. Strict Isolation: Browser check is performed inside an isolated try-catch.\n * 3. Fallback Integrity: Guaranteed return of a valid object.\n */\nfunction getMeasurableContext(fontFace: string, fontSize: number): MeasurableContext {\n    const key = `${fontFace}-${fontSize}`;\n    if (measurableContextCache[key]) {\n        return measurableContextCache[key];\n    }\n\n    // 1. PURE HEURISTIC CONTEXT \u2014 Safe for Node.js / Server Actions\n    const heuristic: MeasurableContext = {\n        measureText: (text: string) => {\n            const length = text ? String(text).length : 0;\n            const hasArabic = /[\\u0600-\\u06FF]/.test(text || '');\n            // Multipliers: Arabic (0.7), Standard (0.55)\n            const multiplier = hasArabic ? 0.7 : 0.55;\n            return { width: length * fontSize * multiplier };\n        }\n    };\n\n    // 2. OPTIONAL BROWSER CONTEXT \u2014 Attempt only if window/document exist\n    try {\n        if (typeof window !== 'undefined' && \n            typeof document !== 'undefined' && \n            typeof document.createElement === 'function') {\n            \n            const canvas = document.createElement('canvas');\n            const context = canvas.getContext('2d');\n            if (context) {\n                context.font = `${fontSize}pt \"${fontFace}\"`;\n                measurableContextCache[key] = context;\n                return context;\n            }\n        }\n    } catch (e) {\n        // Silently fail and use heuristic\n    }\n\n    measurableContextCache[key] = heuristic;\n    return heuristic;\n}\n\n/**\n * Calculates the number of lines a given text will occupy with word wrapping.\n */\nexport function calculateLineCount(text: string, fontFace: string, fontSize: number, maxWidthInches: number): number {\n    if (!text || !String(text).trim()) return 1;\n\n    try {\n        const context = getMeasurableContext(fontFace, fontSize);\n        const maxWidthPx = maxWidthInches * POINTS_PER_INCH;\n\n        const paragraphs = String(text).split('\\n');\n        let totalLines = 0;\n\n        for (const paragraph of paragraphs) {\n            const trimmed = paragraph.trim();\n            if (!trimmed) {\n                totalLines++;\n                continue;\n            }\n            const words = trimmed.split(/\\s+/);\n            let lineCount = 1;\n            let currentLine = '';\n\n            for (const word of words) {\n                const testLine = currentLine ? `${currentLine} ${word}` : word;\n                const metrics = context.measureText(testLine);\n                if (metrics.width > maxWidthPx && currentLine) {\n                    lineCount++;\n                    currentLine = word;\n                } else {\n                    currentLine = testLine;\n                }\n            }\n            totalLines += lineCount;\n        }\n\n        return Math.max(1, totalLines);\n    } catch (e) {\n        console.warn('[Export:PPTX] Line count fallback engaged:', e);\n        return 1;\n    }\n}\n\n/**\n * Calculates the number of lines a code block will occupy.\n */\nexport function calculateCodeLineCount(text: string, fontFace: string, fontSize: number, maxWidthInches: number): number {\n    if (!text) return 1;\n\n    try {\n        const context = getMeasurableContext(fontFace, fontSize);\n        const maxWidthPx = maxWidthInches * POINTS_PER_INCH;\n\n        const lines = String(text).split('\\n');\n        let totalLines = 0;\n\n        for (const line of lines) {\n            if (line === '') {\n                totalLines++;\n                continue;\n            }\n            const metrics = context.measureText(line);\n            const lineWraps = Math.ceil(metrics.width / maxWidthPx);\n            totalLines += Math.max(1, lineWraps);\n        }\n\n        return Math.max(1, totalLines);\n    } catch (e) {\n        console.warn('[Export:PPTX] Code line count fallback engaged:', e);\n        return 1;\n    }\n}\n", "file_path": "src/modules/templates/infrastructure/exporters/pptx/text-measurement.ts", "overwrite": true}, "tool_call_id": "pyd_ai_7a7b7bd0a829430ea26f1186e8e22d95", "id": null, "provider_name": "google-vertex", "provider_details": {"thought_signature": "ZTI0ODMwYTctNWNkNi00MmZlLTk5OGItZWU1MzllNzJiOWMz"}, "part_kind": "tool-call"}

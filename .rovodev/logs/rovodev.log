2026-04-08 01:54:15.338 | 5617  (5617) | DEBUG    | Processing tool event with attributes: {'gen_ai.tool.name': 'find_and_replace_code', 'gen_ai.tool.call.id': 'pyd_ai_9b894d0e13b742628ca5cd3bea13489c', 'tool_arguments': '{"replace":"            {/* Panel Footer */}\\n            <div className=\\"absolute bottom-0 left-0 right-0 px-6 py-3 border-t border-primary/10 bg-background/40 backdrop-blur-xl flex items-center justify-between\\">\\n                <div className=\\"flex items-center gap-2\\">\\n                    <div className=\\"h-1 w-1 rounded-full bg-primary/30 shadow-[0_0_8_rgba(var(--primary),0.4)]\\" />\\n                    <span className=\\"text-[8px] font-black uppercase tracking-[0.3em] text-muted-foreground/40\\">Chapter Controls</span>\\n                </div>\\n                <span className=\\"text-[8px] font-bold text-muted-foreground/20 tabular-nums tracking-widest uppercase\\">v1.0</span>\\n            </div>","file_path":"src/modules/ai-content/adapters/components/builder/generation/ChapterGenerationHUD.tsx","find":"            {/* Stable Version Footer */}\\n            <div className=\\"absolute bottom-0 left-0 right-0 px-6 py-3 border-t border-primary/10 bg-background/40 backdrop-blur-xl flex items-center justify-between\\">\\n                <div className=\\"flex items-center gap-2\\">\\n                    <div className=\\"h-1 w-1 rounded-full bg-primary/30 shadow-[0_0_8_rgba(var(--primary),0.4)]\\" />\\n                    <span className=\\"text-[8px] font-black uppercase tracking-[0.3em] text-muted-foreground/40\\">Chapter Manifest</span>\\n                </div>\\n                <span className=\\"text-[8px] font-bold text-muted-foreground/20 tabular-nums tracking-widest uppercase\\">v2.4.0-STABLE</span>\\n            </div>"}', 'logfire.msg': 'running tool: find_and_replace_code', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span', 'original_content': '\'use client\';\n\nimport React, { useCallback, useMemo, useState } from \'react\';\nimport { Edit, Link as LinkIcon, Loader2, Layout, PlusCircle, Wand2, AlertCircle, Database } from \'lucide-react\';\nimport { Button } from \'@/components/ui/button\';\nimport { Switch } from \'@/components/ui/switch\';\nimport { Form } from \'@/components/ui/form\';\nimport { Input } from \'@/components/ui/input\';\nimport { Label } from \'@/components/ui/label\';\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \'@/components/ui/select\';\nimport { Slider } from \'@/components/ui/slider\';\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \'@/components/ui/tabs\';\nimport { Badge } from \'@/components/ui/badge\';\nimport { Separator } from \'@/components/ui/separator\';\nimport { Chapter } from \'@/modules/ai-content/domain/entities/Chapter\';\nimport { useChapterActions } from \'@/modules/ai-content/adapters/hooks/report-mode/use-chapter-actions\';\nimport { useAiActions } from \'@/modules/ai-content/adapters/hooks/report-mode/use-ai-actions\';\nimport { ContextSelector } from \'./controls/ContextSelector\';\nimport { SidebarContainer } from \'../layout/SidebarContainer\';\n\n/**\n * ChapterGenerationHUD — AI generation controls for chapters.\n * Supports chapter-level configuration and bulk generation.\n */\n\ninterface ChapterGenerationHUDProps {\n    chapter: Chapter | null;\n    className?: string;\n    onClose?: () => void;\n}\n\nexport function ChapterGenerationHUD({ chapter, className, onClose }: ChapterGenerationHUDProps) {\n    // 1. HOOK RESOLUTION (Always at top)\n    // Passing chapter as-is (might be null), hook handles internal defaults\n    const chapterActions = useChapterActions(chapter);\n    const { generateChapterWithRAGMutation } = useAiActions();\n    const [useRAG, setUseRAG] = useState(false);\n\n    const {\n        manipulationType,\n        setManipulationType,\n        manipulationTypes,\n        isProcessing,\n        processedText,\n        handleApplyToNewSection,\n        form,\n        onSubmit,\n        compressionRatio,\n        setCompressionRatio,\n        styles,\n    } = chapterActions;\n\n    // 2. STABLE HANDLERS\n    const handleSubmit = useCallback((data: any) => {\n        if (!chapter) return;\n        if (useRAG) {\n            generateChapterWithRAGMutation.mutate({ \n                chapterId: chapter.id, \n                sectionIds: chapter.sections.map(s => s.id) \n            });\n        } else {\n            onSubmit(data);\n        }\n    }, [onSubmit, chapter, useRAG, generateChapterWithRAGMutation]);\n\n    const handleApply = useCallback(() => {\n        if (!chapter) return;\n        handleApplyToNewSection();\n    }, [handleApplyToNewSection, chapter]);\n\n    const chapterSectionIds = useMemo(() => {\n        if (!chapter) return [];\n        return chapter.sections.map(s => s.id);\n    }, [chapter]);\n\n    // 3. RENDER LOGIC\n    if (!chapter) {\n        return (\n            <SidebarContainer title="Chapter Neural Core" icon={<Layout className="h-3.5 w-3.5" />}>\n                <div className="flex flex-col items-center justify-center h-64 text-center space-y-4 opacity-40">\n                    <div className="p-5 rounded-[24px] bg-primary/5 border border-primary/10 shadow-inner">\n                        <Layout className="h-8 w-8 text-primary/40" />\n                    </div>\n                    <div className="space-y-1.5 px-6">\n                        <p className="text-[10px] font-black uppercase tracking-[0.3em] text-muted-foreground">No selection</p>\n                        <p className="text-[11px] font-medium leading-relaxed italic text-muted-foreground/60">\n                            Select a chapter in the navigator to perform bulk AI operations.\n                        </p>\n                    </div>\n                </div>\n            </SidebarContainer>\n        );\n    }\n\n    return (\n        <SidebarContainer\n            title="Chapter Neural Core"\n            icon={<Layout className="h-3.5 w-3.5" />}\n        >\n            <div className="space-y-8 relative">\n                {/* Chapter Identity & Trigger */}\n                <div className="flex flex-col gap-5">\n                    <div className="space-y-1.5 px-1">\n                        <span className="text-[9px] font-black uppercase tracking-[0.3em] text-primary/60">Active Chapter</span>\n                        <h3 className="text-[13px] font-black uppercase truncate tracking-[0.15em] text-foreground/90 tabular-nums leading-tight">\n                            {chapter.title}\n                        </h3>\n                    </div>\n\n                    <Form {...form}>\n                        <form onSubmit={form.handleSubmit(handleSubmit)} className="space-y-4">\n                            <div className="flex items-center justify-between px-3 py-2 rounded-xl bg-muted/30 border border-border/50">\n                                <div className="flex items-center gap-2">\n                                    <Database className={`h-3.5 w-3.5 ${useRAG ? \'text-primary\' : \'text-muted-foreground\'}`} />\n                                    <Label htmlFor="chapter-rag-toggle" className="text-[9px] font-black uppercase tracking-wider cursor-pointer">\n                                        RAG Synthesis\n                                    </Label>\n                                </div>\n                                <Switch \n                                    id="chapter-rag-toggle" \n                                    checked={useRAG} \n                                    onCheckedChange={setUseRAG}\n                                    disabled={isProcessing || generateChapterWithRAGMutation.isPending}\n                                />\n                            </div>\n\n                            <Button\n                                type="submit"\n                                disabled={isProcessing || generateChapterWithRAGMutation.isPending}\n                                className={`w-full font-black h-12 gap-2.5 shadow-xl shadow-primary/10 rounded-2xl uppercase tracking-[0.2em] text-[10px] relative overflow-hidden group/gen transition-all duration-500 ease-[0.22,1,0.36,1] ${useRAG ? \'ring-2 ring-primary ring-offset-2 ring-offset-background\' : \'\'}`}\n                            >\n                                {isProcessing || generateChapterWithRAGMutation.isPending ? (\n                                    <Loader2 className="h-4 w-4 animate-spin shrink-0" />\n                                ) : (\n                                    useRAG ? <Database className="h-4 w-4 shrink-0" /> : <Wand2 className="h-4 w-4 shrink-0 transition-transform group-hover/gen:rotate-12" />\n                                )}\n                                <span>\n                                    {isProcessing || generateChapterWithRAGMutation.isPending \n                                        ? \'Synthesizing...\' \n                                        : (useRAG ? \'Synthesize with RAG\' : \'Generate Chapter\')}\n                                </span>\n                                <div className="absolute inset-0 bg-gradient-to-r from-white/0 via-white/10 to-white/0 -translate-x-full group-hover/gen:translate-x-full transition-transform duration-1000 ease-in-out" />\n                            </Button>\n\n                            {processedText && !isProcessing && (\n                                <Button\n                                    type="button"\n                                    variant="outline"\n                                    onClick={handleApply}\n                                    className="w-full font-black h-10 gap-2 border border-primary/20 bg-primary/5 text-primary hover:bg-primary/10 rounded-xl uppercase tracking-wide
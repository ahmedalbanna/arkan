ing, options: ConversionOptions = {}) {\n  39   const processedMarkdown = processPlantUml(markdown);\n  40   const ast = unified().use(remarkParse).use(remarkGfm).parse(await processedMarkdown) as Root;\n  41 \n  42   const { footnoteIdMap, docxFootnotes } = await processFootnotes(ast, options);\n  43   const docxObjects = await convertAstToDocxObjects(ast, footnoteIdMap, options);\n  44 \n  45   return { docxObjects, docxFootnotes };\n  46 }\n  47 \n  48 const numbering: INumberingOptions = {\n  49   config: [\n  50     {\n  51       reference: \"default-numbering\",\n  52       levels: [\n  53         { level: 0, format: \"decimal\", text: \"%1.\", alignment: AlignmentType.START },\n  54         { level: 1, format: \"lowerLetter\", text: \"%2)\", alignment: AlignmentType.START },\n  55         { level: 2, format: \"lowerRoman\", text: \"%3.\", alignment: AlignmentType.START },\n  56         { level: 3, format: \"upperLetter\", text: \"%4)\", alignment: AlignmentType.START },\n  57       ],\n  58     },\n  59   ],\n  60 };\n  61 \n  62 function generateMarkdownFromContent(content: ProjectContent | any[]): string {\n  63     if (!content || !Array.isArray(content)) return '';\n  64     return content.map(item => {\n  65         // Check if item has sections (Chapter-like)\n  66         if (item.sections && Array.isArray(item.sections)) {\n  67             const chapterContent = `# ${item.title || ''}`;\n  68             const sectionsContent = item.sections.map((section: any) => \n  69                 `## ${section.title || ''}\\n\\n${section.content || ''}`\n  70             ).join('\\n\\n');\n  71             return `${chapterContent}\\n\\n${sectionsContent}`;\n  72         } else { // Section-like\n  73             return `# ${item.title || ''}\\n\\n${item.content || ''}`;\n  74         }\n  75     }).join('\\n\\n<!-- slide-break -->\\n\\n');\n  76 }\n  77 \n  78 /**\n  79  * Creates a professional cover page directly using docx API\n  80  * This provides better 
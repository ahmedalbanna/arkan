  23 \\n  24     async getAll(type: TemplateType): Promise<Result<Template[], TemplateError>> {\\n  25         try {\\n  26             const results = await db.query.templates.findMany({\\n  27                 where: eq(templates.type, type as any),\\n  28                 orderBy: [desc(templates.createdAt)],\\n  29             });\\n  30             return Result.ok(results.map(this.toDomain) as Template[]);\\n  31         } catch (error: any) {\\n  32             return Result.fail(TemplateError.internal(error.message));\\n  33         }\\n  34     }\\n  35 \\n  36     async save(type: TemplateType, template: Template): Promise<Result<Template, TemplateError>> {\\n  37         try {\\n  38             const now = new Date().toISOString();\\n  39             const persistenceData = this.toPersistence({ ...template, type });\\n  40             \\n  41             const existing = await db.query.templates.findFirst({\\n  42                 where: and(eq(templates.id, template.id), eq(templates.type, type as any)),\\n  43             });\\n  44 \\n  45             if (!existing) {\\n  46                 persistenceData.createdAt = now;\\n  47             }\\n  48             persistenceData.updatedAt = now;\\n  49 \\n  50             await db.insert(templates).values(persistenceData).onConflictDoUpdate({\\n  51                 target: templates.id,\\n  52                 set: persistenceData,\\n  53             });\\n  54             return Result.ok(template);\\n  55         } catch (error: any) {\\n  56             return Result.fail(TemplateError.saveError(error.message));\\n  57         }\\n  58     }\\n  59 \\n  60     async delete(type: TemplateType, id: string): Promise<Result<void, TemplateError>> {\\n  61         try {\\n  62             await db.delete(templates).where(and(eq(templates.id, id), eq(templates.type, type as any)));\\n  63             return Result.ok();\\n  64         } catch (error: any) {\\n  65             return Result.fail(TemplateError.deleteError(error.message));\\n  66         }\\n  67     }\\n  68 \\n  69     private toDomain(result: any): any {\\n  70         return {\\n  71             ...result,\\n  72             isDefault: !!result.isDefault,\\n  73             content: result.content ? JSON.parse(result.content) : undefined,\\n  74         };\\n  75     }\\n  76 \\n  77     private toPersistence(template: any): any {\\n  78         return {\\n  79             ...template,\\n  80             isDefault: template.isDefault ? 1 : 0,\\n  81             content: template.content ? JSON.stringify(template.content) : null,\\n  82         };\\n  83     }\\n  84 }\\n  85 \\n````"]'}

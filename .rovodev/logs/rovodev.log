.meta?.author ? parseInt(projectData.meta.author, 10) : null,\\n  34     metadata: {\\n  35       ...projectData.meta,\\n  36       updated: now,\\n  37     },\\n  38   };\\n  39 \\n  40   if (projectData.id) {\\n  41     // Update existing project\\n  42     const projectId = parseInt(projectData.id as any, 10);\\n  43     await db\\n  44       .update(projects)\\n  45       .set({\\n  46         ...projectData_normalized,\\n  47         updatedAt: new Date(now),\\n  48       })\\n  49       .where(eq(projects.id, projectId));\\n  50 \\n  51     return {\\n  52       ...projectData,\\n  53       meta: {\\n  54         ...projectData.meta,\\n  55         updated: now,\\n  56       },\\n  57     };\\n  58   } else {\\n  59     // Create new project\\n  60     const result = await db\\n  61       .insert(projects)\\n  62       .values({\\n  63         ...projectData_normalized,\\n  64         createdAt: new Date(now),\\n  65         updatedAt: new Date(now),\\n  66       })\\n  67       .returning();\\n  68 \\n  69     return {\\n  70       ...projectData,\\n  71       id: result[0]?.id?.toString(),\\n  72       meta: {\\n  73         ...projectData.meta,\\n  74         updated: now,\\n  75       },\\n  76     };\\n  77   }\\n  78 }\\n  79 \\n  80 /**\\n  81  * Fetches all projects for a given user.\\n  82  * @param userId The ID of the user whose projects to fetch.\\n  83  * @returns An array of project properties.\\n  84  */\\n  85 export async function getProjects(userId: string): Promise<ProjectProperties[]> {\\n  86   const numUserId = parseInt(userId, 10);\\n  87   \\n  88   const result = await db\\n  89     .select()\\n  90     .from(projects)\\n  91     .where(eq(projects.userId, numUserId))\\n  92     .orderBy(desc(projects.updatedAt));\\n  93 \\n  94   return result.map(proj => ({\\n  95     id: proj.id?.toString(),\\n  96     name: proj.title,\\n  97     description: proj.description || undefined,\\n  98     content: proj.content || undefined,\\n  99     m
o export.', variant: 'destructive' });\\n      return;\\n    }\\n\\n    setIsExporting(true);\\n    try {\\n      const templateStyles = pptxTemplates[options.template] || pptxTemplates.modern;\\n\\n      // Dynamic import to ensure pptxgenjs only loads in the browser environment\\n      const { convertMarkdownToPptx } = await import(\\n        '@/modules/templates/infrastructure/exporters/pptx/markdown-to-pptx-converter'\\n      );\\n\\n      // Generate markdown from selected content client-side\\n      const markdown = project.fullMarkdownContent || '';\\n      if (!markdown.trim()) throw new Error('Project manifest contains no renderable content.');\\n\\n      const pptxOptions = {\\n        styles: templateStyles.styles,\\n        isRtl: options.isRtl,\\n        includeToc: options.includeToc,\\n        title: project.name,\\n      };\\n\\n      const result = await convertMarkdownToPptx(markdown, project.name, pptxOptions as any);\\n      const blob = result instanceof Blob ? result : new Blob([result as any], {\\n        type: 'application/vnd.openxmlformats-officedocument.presentationml.presentation'\\n      });\\n\\n      saveAs(blob, `${project.name.replace(/\\\\s+/g, '_')}_presentation.pptx`);\\n      toast({ title: 'Export Successful', description: 'Your slide-deck has been synthesized.' });\\n    } catch (error: unknown) {\\n      console.error('[Hook:Export] PPTX Failure:', error);\\n      toast({\\n        title: 'Export Failed',\\n        description: error instanceof Error ? error.message : 'The PPTX production pipeline encountered an error.',\\n        variant: 'destructive',\\n      });\\n    } finally {\\n      setIsExporting(false);\\n    }\\n  }, []);\"}", "tool_call_id": "toolu_vrtx_01Tswn75YcJLN6ZovcXPyqRm", "id": null, "provider_name": null, "provider_details": null, "part_kind": "tool-call"}

ntId: \'agent_expensive\',\n 165         userId: \'user_456\',\n 166         input: {},\n 167         output: {},\n 168         creditCost: 100,\n 169       });\n 170 \n 171       expect(mockCollection.add).toHaveBeenCalledWith(\n 172         expect.objectContaining({\n 173           creditCost: 100,\n 174         })\n 175       );\n 176     });\n 177 \n 178     it(\'should handle decimal credit costs\', async () => {\n 179       await logGeneration({\n 180         agentId: \'agent_123\',\n 181         userId: \'user_456\',\n 182         input: {},\n 183         output: {},\n 184         creditCost: 2.5,\n 185       });\n 186 \n 187       expect(mockCollection.add).toHaveBeenCalledWith(\n 188         expect.objectContaining({\n 189           creditCost: 2.5,\n 190         })\n 191       );\n 192     });\n 193   });\n 194 \n 195   // ============================================================================\n 196   // Different Agent Types\n 197   // ============================================================================\n 198 \n 199   describe(\'Different agent types\', () => {\n 200     it(\'should log text generation\', async () => {\n 201       await logGeneration({\n 202         agentId: \'text-generator\',\n 203         userId: \'user_123\',\n 204         input: { prompt: \'Write a story\' },\n 205         output: { text: \'Once upon a time...\' },\n 206         creditCost: 3,\n 207       });\n 208 \n 209       expect(mockCollection.add).toHaveBeenCalled();\n 210     });\n 211 \n 212     it(\'should log image generation\', async () => {\n 213       await logGeneration({\n 214         agentId: \'image-generator\',\n 215         userId: \'user_123\',\n 216         input: { prompt: \'A sunset\' },\n 217         output: { imageUrl: \'https://example.com/image.png\' },\n 218         creditCost: 10,\n 219       });\n 220 \n 221       expect(mockCollection.add).toHaveBeenCalled();\n 222     });\n 223 \n 224     it(\'should log analysis operations\', async () =>
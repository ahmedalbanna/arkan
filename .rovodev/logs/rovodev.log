              e.stopPropagation();\n 477                 handleAddChapter();\n 478               }}\n 479             >\n 480               <Plus className=\"h-3 w-3\" />\n 481             </Button>\n 482           </div>\n 483         </div>\n 484 \n 485         {/* Search */}\n 486         <div className=\"relative group/search\">\n 487           <Input\n 488             value={searchQuery}\n 489             onChange={(e) => setSearchQuery(e.target.value)}\n 490             placeholder=\"Search outline...\"\n 491             className=\"h-8 pl-8 pr-8 text-[10px] bg-muted/5 border-primary/10 focus-visible:ring-primary/20 rounded-xl transition-all\"\n 492           />\n 493           <Search className=\"absolute left-2.5 top-1/2 -translate-y-1/2 h-3 w-3 text-muted-foreground/40 group-focus-within/search:text-primary transition-colors\" />\n 494           {searchQuery && (\n 495             <button\n 496               onClick={() => setSearchQuery('')}\n 497               className=\"absolute right-2.5 top-1/2 -translate-y-1/2 hover:text-primary transition-colors\"\n 498             >\n 499               <X className=\"h-3 w-3\" />\n 500             </button>\n 501           )}\n 502         </div>\n 503       </div>\n 504 \n 505       {/* Outline list */}\n 506       <ScrollArea className=\"flex-1 min-h-0 -mx-1 px-1\">\n 507         <DndContext\n 508           sensors={sensors}\n 509           collisionDetection={closestCenter}\n 510           onDragEnd={handleDragEnd}\n 511         >\n 512           <SortableContext items={allSortableIds} strategy={verticalListSortingStrategy}>\n 513             {filteredChapters.map((chapter, cIdx) => (\n 514               <SortableItem\n 515                 key={chapter.id}\n 516                 id={chapter.id}\n 517                 index={cIdx}\n 518                 title={chapter.title}\n 519                 isActive={activeChapterId === chapter.id}\n 520                 isChapter={true}\n 521                 isExpanded={expand
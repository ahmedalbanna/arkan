serId: doc.userId?.toString(),\n        planId: 'plan_' + doc.id?.toString(),\n        planName: doc.description || 'Credit Purchase',\n        credits: doc.credits || 0,\n        price: doc.amount ? parseFloat(doc.amount.toString()) : 0,\n        userName: '',\n        userEmail: '',\n        status: (doc.status as any) || 'verified',\n        proofUrl: '',\n        createdAt: doc.createdAt?.toISOString() || new Date().toISOString(),\n    } as TransactionProperties));\n\n    const hasNextPage = result.length > limit;\n    const newLastVisibleId = hasNextPage ? txns[txns.length - 1].id : null;\n\n    return { transactions: txns, hasNextPage, lastVisibleId: newLastVisibleId };\n}\n\nexport async function getTransactionsByUserId(userId: string): Promise<TransactionProperties[]> {\n    const numUserId = parseInt(userId, 10);\n    \n    const result = await db\n        .select()\n        .from(transactions)\n        .where(eq(transactions.userId, numUserId))\n        .orderBy(desc(transactions.createdAt));\n\n    return result.map(doc => ({\n        id: doc.id?.toString(),\n        userId: doc.userId?.toString(),\n        planId: 'plan_' + doc.id?.toString(),\n        planName: doc.description || 'Credit Purchase',\n        credits: doc.credits || 0,\n        price: doc.amount ? parseFloat(doc.amount.toString()) : 0,\n        userName: '',\n        userEmail: '',\n        status: (doc.status as any) || 'verified',\n        proofUrl: '',\n        createdAt: doc.createdAt?.toISOString() || new Date().toISOString(),\n    } as TransactionProperties));\n}\n\nexport async function getTransactionsByDateRange(startDate: string, endDate: string): Promise<TransactionProperties[]> {\n    const startDateTime = new Date(startDate);\n    const endDateTime = new Date(endDate);\n\n    const result = await db\n        .select()\n        .from(transactions)\n        .where(\n            and(\n                gte(transactions.createdAt, startDateTime),\n                lte(transactions.createdAt, endDateTime)\n            )\n        )\n        .orderBy(desc(transactions.createdAt));\n\n    return result.map(doc => ({\n        id: doc.id?.toString(),\n        userId: doc.userId?.toString(),\n        planId: 'plan_' + doc.id?.toString(),\n        planName: doc.description || 'Credit Purchase',\n        credits: doc.credits || 0,\n        price: doc.amount ? parseFloat(doc.amount.toString()) : 0,\n        userName: '',\n        userEmail: '',\n        status: (doc.status as any) || 'verified',\n        proofUrl: '',\n        createdAt: doc.createdAt?.toISOString() || new Date().toISOString(),\n    } as TransactionProperties));\n}\n", 'tool_response': 'Successfully replaced code in src/services/transactionService.ts:\n\n--- src/services/transactionService.ts\n+++ src/services/transactionService.ts\n@@ -36,20 +36,23 @@\n     hasNextPage: boolean, \n     lastVisibleId?: string | null \n }> {\n-    let query = db\n-        .select()\n-        .from(transactions)\n-        .where(eq(transactions.status, status))\n-        .orderBy(desc(transactions.createdAt))\n-        .limit(limit + 1);\n-\n+    let whereCondition = eq(transactions.status, status);\n+    \n     // Handle pagination with lastVisibleId\n     if (lastVisibleId) {\n         const lastId = parseInt(lastVisibleId, 10);\n-        query = query.where(gt(transactions.id, lastId));\n+        whereCondition = and(\n+            eq(transactions.status, status),\n+            gt(transactions.id, lastId)\n+        ) as any;\n     }\n \n-    const result = await query;\n+    const result = await db\n+        .select()\n+        .from(transactions)\n+        .where(whereCondition)\n+        .orderBy(desc(transactions.createdAt))\n+        .limit(limit + 1);\n \n     const txns = result.slice(0, limit).map(doc => ({\n         id: doc.id?.toString(),\n'}

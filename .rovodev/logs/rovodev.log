ansition-all resize-none p-4 leading-relaxed font-serif italic\" \n 124                           placeholder=\"Describe the scope of this project...\"\n 125                         />\n 126                       </FormControl>\n 127                       <FormMessage className=\"text-[10px]\" />\n 128                     </FormItem>\n 129                   )} \n 130                 />\n 131               </div>\n 132 \n 133               <div className=\"space-y-5\">\n 134                 <div className=\"flex items-center gap-3 group/header\">\n 135                     <div className=\"h-4 w-1 bg-primary/40 rounded-full group-hover:h-6 transition-all duration-300\" />\n 136                     <span className=\"text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/80\">Academic Context</span>\n 137                 </div>\n 138 \n 139                 <div className=\"grid gap-5\">\n 140                   <FormField\n 141                     control={form.control}\n 142                     name=\"projectType\"\n 143                     render={({ field }) => (\n 144                       <FormItem className=\"space-y-1.5\">\n 145                         <FormLabel className=\"text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60\">Document Type</FormLabel>\n 146                         <FormControl>\n 147                           <CustomSelect\n 148                             value={field.value || ''}\n 149                             onChange={(value: string) => {\n 150                               field.onChange(value);\n 151                               handleBlur();\n 152                             }}\n 153                             options={documentTypeOptions}\n 154                             placeholder=\"Select type...\"\n 155                             className=\"h-10 text-[11px] bg-muted/5 border-border/40 focus:ring-primary/20 rounded-xl\"\n 156                           />\n 157                         </F
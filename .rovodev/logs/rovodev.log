e-toc.ts:\\n\\n````typescript\\n   0 \\n   1 \'use server\';\\n   2 \\n   3 /**\\n   4  * @fileOverview An AI agent for generating a table of contents from a project Description.\\n   5  */\\n   6 \\n   7 import { ai } from \'@/modules/ai/infrastructure/services/Genkit\';\\n   8 import { GenerateTocInputSchema, GenerateTocOutputSchema, type GenerateTocInput, type GenerateTocOutput } from \'@/modules/ai/domain/schemas\';\\n   9 \\n  10 const generateTocPrompt = ai.definePrompt({\\n  11   name: \'generateTocPrompt\',\\n  12   input: { schema: GenerateTocInputSchema },\\n  13   output: { schema: GenerateTocOutputSchema },\\n  14   model: \'ollama/gemma:2b\',\\n  15   prompt: `You are an expert project planner and technical writer. Based on the provided project Description, generate a logical and comprehensive table of contents for a formal report.\\n  16 \\n  17 **Project Description:**\\n  18 ---\\n  19 {{{projectDescription}}}\\n  20 ---\\n  21 \\n  22 {{#if additionalInstructions}}\\n  23 **Additional Constraints & Instructions:**\\n  24 ---\\n  25 {{{additionalInstructions}}}\\n  26 ---\\n  27 {{/if}}\\n  28 \\n  29 **Instructions:**\\n  30 1.  Analyze the project Description to understand its core components, objectives, and scope.\\n  31 2.  Generate a list of relevant **chapters**.\\n  32 3.  For each chapter, generate a list of 3-5 relevant **section** titles.\\n  33 4.  The output must be an array of objects, where each object has a \'title\' (for the chapter) and a \'sections\' (an array of strings for the section titles).\\n  34 5.  Include standard report chapters like \'Introduction\', \'System Analysis\', \'Conclusion\', etc., but tailor the sections within them to the project description.\\n  35 `,\\n  36   config: {\\n  37     temperature: 0.4,\\n  38   }\\n  39 });\\n  40 \\n  41 const generateTocFlow = ai.defineFlow({\\n  42   name: \'generateTocFlow\',\\n  43   inputSchema: GenerateTocInputSchema,\\n  44   outputSchema: GenerateTocOutputSchema,\\n  4
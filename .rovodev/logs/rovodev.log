Select?: boolean) => void;\n  25   onActivate?: () => void;\n  26   isActive?: boolean;\n  27 }\n  28 \n  29 export function SortableChapterItem({\n  30   chapter,\n  31   index,\n  32   isProjectBuildMode,\n  33   selectedSectionsForBuild,\n  34   toggleChapterSelection,\n  35   toggleSectionSelection,\n  36   activeSectionId,\n  37   selectedSectionIds = [],\n  38   onActivateSection,\n  39   onActivate,\n  40   isActive,\n  41 }: SortableChapterItemProps) {\n  42   const { updateProject } = useBuilderStore(state => ({\n  43     updateProject: state.updateProject,\n  44   }));\n  45 \n  46   const [isCollapsed, setIsCollapsed] = useState(false);\n  47 \n  48   const { attributes, listeners, setNodeRef, transform, transition, isDragging } = useSortable({\n  49     id: chapter.id,\n  50   });\n  51 \n  52   const style: React.CSSProperties = {\n  53     transform: CSS.Transform.toString(transform),\n  54     transition,\n  55     zIndex: isDragging ? 2 : 0,\n  56     position: \'relative\',\n  57   };\n  58 \n  59   const sectionsInChapter = chapter.sections;\n  60 \n  61   const isAllSectionsSelected = useMemo(() => {\n  62     if (sectionsInChapter.length === 0) return false;\n  63     return sectionsInChapter.every(s => selectedSectionsForBuild.has(s.id));\n  64   }, [sectionsInChapter, selectedSectionsForBuild]);\n  65 \n  66   const isSomeSectionsSelected = useMemo(() => {\n  67     if (sectionsInChapter.length === 0) return false;\n  68     const hasSelected = sectionsInChapter.some(s => selectedSectionsForBuild.has(s.id));\n  69     return hasSelected && !isAllSectionsSelected;\n  70   }, [sectionsInChapter, selectedSectionsForBuild, isAllSectionsSelected]);\n  71 \n  72   const handleAddSection = (chapterId: string) => {\n  73     updateProject(p => p.addSectionToChapter(chapterId, uuidv4(), \'Untitled Section\'));\n  74   };\n  75 \n  76   return (\n  77     <div ref={setNodeRef} style={style} {...attributes} className="group/chapter-container">\n  78       <div\n  79         className={cn(\n  80           \'relative overflow-hidden rounded-xl border shadow-sm transition-all duration-300 hover:translate-x-0.5\',\n  81           isActive\n  82             ? \'border-primary/30 bg-primary/[0.02] ring-1 ring-primary/10 shadow-[0_4px_20px_rgba(0,0,0,0.04)]\'\n  83             : \'border-border/60 bg-card/40 hover:border-primary/20 hover:shadow-md\'\n  84         )}\n  85       >\n  86         {/* Chapter Header */}\n  87         <div\n  88           className={cn(\n  89             \'flex items-center gap-3 border-b px-3 py-2 cursor-pointer transition-colors duration-200\',\n  90             isActive\n  91               ? \'border-primary/10 bg-primary/[0.04]\'\n  92               : \'border-border/40 bg-muted/10 hover:bg-muted/20\'\n  93           )}\n  94           onClick={() => onActivate?.()}\n  95         >\n  96           {/* Build mode checkbox */}\n  97           {isProjectBuildMode && (\n  98             <div\n  99               className="shrink-0"\n 100               onClick={e => e.stopPropagation()}\n 101             >\n 102               <Checkbox\n 103                 id={`select-chapter-${chapter.id}`}\n 104                 checked={isAllSectionsSelected}\n 105                 aria-checked={isSomeSectionsSelected ? \'mixed\' : isAllSectionsSelected}\n 106                 onCheckedChange={(checked: boolean) =>\n 107                   toggleChapterSelection(chapter.id, !!checked)\n 108                 }\n 109                 className="h-4 w-4 rounded-md border-primary/40 data-[state=checked]:bg-primary"\n 110               />\n 111             </div>\n 112           )}\n 113 \n 114           {/* Drag handle + index */}\n 115           {listeners && (\n 116             <div\n 117               {...listeners}\n 118               className="flex items-center gap-1.5 shrink-0 text-muted-foreground/40 cursor-grab active:cursor-grabbing transition-colors hover:text-primary"\n 119               onClick={e => e.st
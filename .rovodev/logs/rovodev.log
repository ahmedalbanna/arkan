age(inputValue, projectContext);\n            setInputValue(\'\');\n        }\n    };\n\n    useEffect(() => {\n        if (scrollAreaRef.current) {\n            scrollAreaRef.current.scrollTop = scrollAreaRef.current.scrollHeight;\n        }\n    }, [messages, isLoading]);\n\n    if (!isOpen) return null;\n\n    return (\n        <SidebarContainer\n            title="Project Consultant"\n            icon={<MessageSquare className="h-3.5 w-3.5" />}\n            actions={\n                <div className="flex items-center gap-1.5 px-2 py-1 rounded-full bg-green-500/5 border border-green-500/20">\n                    <div className="h-1 w-1 rounded-full bg-green-500 animate-pulse" />\n                    <span className="text-[7px] font-black text-green-600 dark:text-green-400 uppercase tracking-widest">Online</span>\n                </div>\n            }\n        >\n            <div className="flex flex-col h-full relative -mx-6 -my-6">\n                {/* Messages area */}\n                <div className="flex-1 overflow-hidden relative min-h-[400px] px-6 py-6">\n                    <div className="space-y-6">\n\n                        {/* Empty state */}\n                        {messages.length === 0 && (\n                            <div className="text-center py-12 px-6">\n                                <Avatar className="h-14 w-14 mx-auto mb-5 rounded-2xl border border-primary/20 shadow-lg shadow-primary/5 bg-primary/5 p-3">\n                                    <AvatarFallback className="bg-transparent text-primary text-xl">🤖</AvatarFallback>\n                                </Avatar>\n                                <h4 className="text-[10px] font-black uppercase tracking-[0.2em] text-primary mb-2">\n                                    Ready to help\n                                </h4>\n                                <p className="text-[11px] text-muted-foreground/60 italic leading-relaxed font-medium">\n                                    Ask for writing suggestions, section improvements, or help structuring your document.\n                                </p>\n                            </div>\n                        )}\n\n                        {/* Message list */}\n                        {messages.map((message, index) => (\n                            <div\n                                key={index}\n                                className={cn(\n                                    "flex items-start gap-3",\n                                    message.role === \'user\' ? \'flex-row-reverse\' : \'\'\n                                )}\n                            >\n                                {message.role === \'assistant\' && (\n                                    <div className="h-7 w-7 shrink-0 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center text-[10px] shadow-sm">\n                                        🤖\n                                    </div>\n                                )}\n                                <div className={cn(\n                                    "max-w-[90%] p-3 rounded-xl shadow-[0_4px_20px_rgba(0,0,0,0.03)] border transition-all duration-300",\n                                    message.role === \'assistant\'\n                                        ? \'bg-background/60 backdrop-blur-xl border-primary/10 rounded-tl-none font-serif italic leading-relaxed text-muted-foreground hover:text-foreground\'\n                                        : \'bg-primary text-primary-foreground border-primary/20 rounded-tr-none font-sans font-medium shadow-primary/10\'\n                                )}>\n                                    <div className="prose prose-sm dark:prose-invert">\n                                        <ReactMarkdown components={markdownComponents}>{message.content}</ReactMarkdown>\n                                    </div>\n                                </div>\n                                {message.role === \'user
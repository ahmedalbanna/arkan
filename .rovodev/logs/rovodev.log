        </div>\n 216             <div\n 217               className="p-1 hover:bg-red-500/10 rounded-md cursor-pointer transition-colors text-muted-foreground hover:text-red-600"\n 218               onClick={(e) => {\n 219                 e.stopPropagation();\n 220                 onDelete?.();\n 221               }}\n 222             >\n 223               <Trash2 className="h-2.5 w-2.5" />\n 224             </div>\n 225           </div>\n 226         )}\n 227       </div>\n 228 \n 229       {isChapter && isExpanded && (\n 230         <div className="mt-1 border-l border-primary/10 ml-3.5 pl-1">{children}</div>\n 231       )}\n 232     </div>\n 233   );\n 234 };\n 235 \n 236 // ---------------------------------------------------------------------------\n...\n 240 interface SidebarOutlineManagerProps {\n 241   activeChapterId: string | null;\n 242   selectedSectionIds: string[];\n 243   onActiveChapterChange: (id: string | null) => void;\n 244   onActiveSectionChange: (id: string | null, multiSelect?: boolean) => void;\n 245 }\n 246 \n 247 export function SidebarOutlineManager({\n 248   activeChapterId,\n 249   selectedSectionIds,\n 250   onActiveChapterChange,\n 251   onActiveSectionChange,\n 252 }: SidebarOutlineManagerProps) {\n 253   const { project, updateProject, undo, syncProjectStructure } = useBuilderStore(state => ({\n 254     project: state.project,\n 255     updateProject: state.updateProject,\n 256     undo: state.undo,\n 257     syncProjectStructure: state.syncProjectStructure,\n 258   }));\n 259 \n 260   // Sync structure on mount to ensure outline matches editor content\n 261   useEffect(() => {\n 262     syncProjectStructure();\n 263   }, [syncProjectStructure]);\n 264 \n 265   const [expandedChapters, setExpandedChapters] = useState<Set<string>>(new Set());\n 266   const [searchQuery, setSearchQuery] = useState(\'\');\n 267   const [clipboard, setClipboard] = useState<{ type: \'chapter\' | \'section\'; data: any } | null>(null);\n 268 \n 269   const sensors = useSensors(\n 270     useSensor(PointerSensor, { activationConstraint: { distance: 8 } }),\n 271     useSensor(KeyboardSensor, { coordinateGetter: sortableKeyboardCoordinates })\n 272   );\n 273 \n 274   // Keyboard shortcuts (Cmd+Z undo, Cmd+D duplicate, Cmd+C copy, Cmd+V paste)\n 275   useEffect(() => {\n 276     const handleKeyDown = (e: KeyboardEvent) => {\n 277       const isMod = e.metaKey || e.ctrlKey;\n 278       const activeId = activeChapterId || (selectedSectionIds.length > 0 ? selectedSectionIds[0] : null);\n 279       const isChapter = !!activeChapterId;\n 280 \n 281       if (isMod && e.key === \'z\') {\n 282         e.preventDefault();\n 283         undo();\n 284       }\n 285 \n 286       if (!activeId) return;\n 287 \n 288       if (isMod && e.key === \'d\') {\n 289         e.preventDefault();\n 290         handleDuplicate(activeId, isChapter);\n 291       }\n 292       if (isMod && e.key === \'c\') {\n 293         e.preventDefault();\n 294         handleCopy(activeId, isChapter);\n 295       }\n 296       if (isMod && e.key === \'v\') {\n 297         e.preventDefault();\n 298         handlePaste(activeId, isChapter);\n 299       }\n 300     };\n 301 \n 302     window.addEventListener(\'keydown\', handleKeyDown);\n 303     return () => window.removeEventListener(\'keydown\', handleKeyDown);\n 304   // eslint-disable-next-line react-hooks/exhaustive-deps\n 305   }, [activeChapterId, selectedSectionIds, clipboard]);\n 306 \n 307   const toggleChapter = (id: string) => {\n 308     setExpandedChapters(prev => {\n 309       const next = new Set(prev);\n 310       if (next.has(id)) next.delete(id);\n 311       else next.add(id);\n 312       return next;\n 313     });\n 314   };\n 315 \n 316   const handleItemClick = (id: string, isChapter: boolean) => {\n 317     if (isChapter) {\n 318       onActiveChapterChange(id);\n 319     } else {\n 320       onActiveSectionChange(id);\n 321     }\n 322     setTimeout(() => {\n 323       const element = document.getElementById(`item-${id}`);\n 324       if (element) element.scrollIntoView({ behavior: \'smooth\', block: \'start\' });\n 325     }, 100);\n 326   };\n 327 \n 328   const handleDragEnd = (event: DragEndEvent) => {\n 329     const { active, over } = event;\n 330     if (over && active.id !== over.id) {\n 331       updateProject(p => p.moveContentItem(active.id.toString(), over.id.toString()));\n 332     }\n 333   };\n 334 \n 335   const handleUpdateTitle = (id: string, newTitle: string, isChapter: boolean) => {\n 336     if (isChapter) {\n 337       updateProject(p => p.updateChapter(id, c => c.withProps({ title: newTitle })));\n 338     } else {\n 339       updateProject(p => p.updateSection(id, s => s.withProps({ title: newTitle })));\n 340     }\n 341   };\n 342 \n 343   const handleDeleteItem = (id: string, isChapter: boolean) => {\n 344     if (isChapter) {\n 345       updateProject(p => p.removeChapter(id));\n 346     } else {\n 347       const info = project?.findSection(id);\n 348       if (info) {\n 349         updateProject(p => p.updateChapter(info.chapter.id, c => c.removeSection(id)));\n 350       }\n 351     }\n 352   };\n 353 \n 354   const handleAddChapter = () => {\n 355     updateProject(p => p.addChapter(uuidv4(), \'New Chapter\'));\n 356   };\n 357 \n 358   const handleAddSection = (chapterId: string) => {\n 359     updateProject(p => p.addSectionToChapter(chapterId, uuidv4(), \'New Section\'));\n 360   };\n 361 \n 362   const handleDuplicate = (id: string, isChapter: boolean) => {\n 363     updateProject(p => (isChapter ? p.duplicateChapter(id, uuidv4) : p.duplicateSection(id, uuidv4)));\n 364   };\n 365 \n 366   const handleCopy = (id: string, isChapter: boolean) => {\n 367     if (isChapter) {\n 368       const chapter = project?.getChapter(id);\n 369       if (chapter) setClipboard({ type: \'chapter\', data: chapter.toProperties() });\n 370     } else {\n 371       const info = project?.findSection(id);\n 372       if (info) setClipboard({ type: \'section\', data: info.section.toProperties() });\n 373     }\n 374     toast({ title: \'Copied\', description: \'Item copied to outline clipboard.\' });\n 375   };\n 376 \n 377   const handlePaste = (targetId: string, targetIsChapter: boolean) => {\n 378     if (!clipboard) return;\n 379     updateProject(p => {\n 380       const newId = uuidv4();\n 381       if (clipboard.type === \'chapter\') {\n 382         const newChapterProps = {\n 383           ...clipboard.data,\n 384           id: newId,\n 385           title: `${clipboard.data.title} (Copy)`,\n 386         };\n 387         if (newChapterProps.sections) {\n 388           newChapterProps.sections = newChapterProps.sections.map((s: any) => ({ ...s, id: uuidv4() }));\n 389         }\n 390         const newChapter = new Chapter(newChapterProps);\n 391         let insertionIndex = -1;\n 392         if (targetIsChapter) {\n 393           insertionIndex = p.content.findIndex(c => c.id === targetId);\n 394         } else {\n 395           const info = p.findSection(targetId);\n 396           if (info) insertionIndex = p.content.findIndex(c => c.id === info.chapter.id);\n 397         }\n 398         if (insertionIndex !== -1) {\n 399           const newContent = [...p.content];\n 400           newContent.splice(insertionIndex + 1, 0, newChapter);\n 401           return p.withProps({ content: newContent });\n 402         }\n 403       } else if (clipboard.type === \'section\') {\n 404         const newSectionProps = {\n 405           ...clipboard.data,\n 406           id: newId,\n 407           title: `${clipboard.data.title} (Copy)`,\n 408         };\n 409         const newSection = new Section(newSectionProps);\n 410         if (targetIsChapter) {\n 411           return p.updateChapter(targetId, c => c.addSection(newSection, 0));\n 412         } else {\n 413           const info = p.findSection(targetId);\n 414           if (info) {\n 415             return p.updateChapter(info.chapter.id, c => c.ad
                                                <Layout className="h-3.5 w-3.5  
                    text-primary/40 group-hover/label:text-primary              
                    transition-colors" />                                       
                                                <Label className="text-[10px]   
                    font-black uppercase tracking-[0.2em]                       
                    text-muted-foreground/60">Output Shape</Label>              
                                            </div>                              
                                            <Button                             
                                                variant="outline"               
                                                size="sm"                       
                                                className="h-7 px-2.5 text-[9px]

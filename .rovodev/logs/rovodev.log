ssName="h-5 w-5 text-primary" />\n  84             </div>\n  85             <div>\n  86                 <DialogTitle className="text-[14px] font-black uppercase tracking-tight">\n  87                     {mode === \'add\' ? \'Integrate Source Matrix\' : \'Update Cognitive Vector\'}\n  88                 </DialogTitle>\n  89                 <DialogDescription className="text-[10px] uppercase tracking-widest text-muted-foreground/60 font-bold">\n  90                     Raw data ingestion protocol\n  91                 </DialogDescription>\n  92             </div>\n  93           </div>\n  94         </DialogHeader>\n  95         \n  96         <div className="p-8 space-y-6">\n  97           <div className="space-y-2.5">\n  98             <Label className="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60 px-1">Source Identifier</Label>\n  99             <Input\n 100               value={name}\n 101               onChange={(e) => setName(e.target.value)}\n 102               placeholder="e.g., Reference_Data_Matrix_01"\n 103               className="h-11 bg-muted/5 border-primary/10 focus-visible:ring-primary/20 rounded-xl font-bold uppercase tracking-widest placeholder:text-muted-foreground/20"\n 104             />\n 105           </div>\n 106           <div className="space-y-2.5">\n 107             <Label className="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60 px-1">Content Payloads</Label>\n 108             <Textarea\n 109               value={content}\n 110               onChange={(e) => setContent(e.target.value)}\n 111               placeholder="Paste raw research data, guidelines, or reference text here..."\n 112               className="min-h-[240px] bg-muted/5 border-primary/10 focus-visible:ring-primary/20 rounded-2xl resize-none p-4 font-serif italic text-[13px] leading-relaxed shadow-inner"\n 113             />\n 114           </div>\n 115         </div>\n 116 \n 117         <DialogFooter className="px-8 py-4 bg-primary/[0.02] border-t border-primary/10">\n 118           <Button variant="ghost" onClick={onClose} className="text-[10px] font-black uppercase tracking-widest rounded-xl h-10 px-6">Abort</Button>\n 119           <Button \n 120             onClick={handleSave} \n 121             disabled={!name.trim() || !content.trim()}\n 122             className="text-[10px] font-black uppercase tracking-[0.2em] rounded-xl h-10 px-8 shadow-xl shadow-primary/10 ring-1 ring-inset ring-white/20"\n 123           >\n 124             {mode === \'add\' ? \'Initialize Vector\' : \'Commit Changes\'}\n 125           </Button>\n 126         </DialogFooter>\n 127       </DialogContent>\n 128     </Dialog>\n 129   );\n 130 }\n 131 \n 132 // ── Main Component ─────────────────────────────────────────────────────────────\n 133 \n 134 export function SourceManager() {\n 135     const { project, updateProject } = useBuilderStore();\n 136     const { getRootProps, getInputProps } = useFileUpload((_field, val) => {\n 137         if (val && typeof val === \'string\') {\n 138             updateProject(p => p.addExternalContext({\n 139                 fileName: \'Extracted Content\',\n 140                 content: val,\n 141                 type: \'context\'\n 142             }, String(Date.now())));\n 143         }\n 144     }, { fieldName: \'text\' });\n 145     \n 146     const [isAddingText, setIsAddingText] = useState(false);\n 147     const [editingIndex, setEditingIndex] = useState<number | null>(null);\n 148 \n 149     const onAddText = (name: string, content: string) => {\n 150         updateProject(p => p.addExternalContext({\n 151             fileName: name,\n 152             content,\n 153             type: \'context\'\n 154         }, String(Date.now())));\n 155     };\n 156 \n 157     const onUpdateText = (name: string, content: string) => {\n 158         if (editingIndex === null) return;\n 159         updateProject(p => {\n 160             const current = p.externalContext[editingIndex];\n 161             const updated = (p.externalContext as any).map((c: any, i: number) => \n 162                 i === editingIndex ? c.withProps({ fileName: name, content }) : c\n 163             );\n 164             return p.withProps({ externalContext: updated });\n 165         });\n 166         setEditingIndex(null);\n 167     };\n 168 \n 169     const removeContext = (index: number) => {\n 170         updateProject(p => p.removeExternalContext(index));\n 171     };\n 172 \n 173     const updateContextType = (index: number, type: ExternalContextType) => {\n 174         updateProject(p => p.updateExternalContextType(index, type));\n 175     };\n 176 \n 177     const handleManualUpload = () => {\n 178         // Dropzone handle via getRootProps/getInputProps in the UI\n 179     };\n 180 \n 181     if (!project) return null;\n 182 \n 183     return (\n 184         <div className="flex flex-col h-full gap-6 pt-2">\n 185             <div className="space-y-1.5 px-1">\n 186                 <h4 className="text-[10px] font-black uppercase tracking-[0.3em] text-primary/70 flex items-center gap-2.5">\n 187                     <Database className="h-3.5 w-3.5" />\n 188                     Context Matrix\n 189                 </h4>\n 190                 <p className="text-[9px] text-muted-foreground italic font-medium opacity-60 uppercase tracking-widest">\n 191                     Manage the intellectual input vectors for the AI core.\n 192                 </p>\n 193             </div>\n 194 \n 195             {/* Quick Ingestion Hub */}\n 196             <div className="grid grid-cols-2 gap-2.5">\n 197                 <div {...getRootProps()}>\n 198                     <input {...getInputProps()} />\n 199                     <Button \n 200                         variant="outline" \n 201                         className="h-14 w-full flex flex-col items-center justify-center gap-1.5 rounded-2xl border-dashed border-primary/20 bg-primary/[0.02] hover:bg-primary/5 hover:border-primary/40 transition-all group/up"\n 202                     >\n 203                         <UploadCloud className="h-4 w-4 text-primary/40 group-hover/up:text-primary group-hover/up:scale-110 transition-all" />\n 204                         <span className="text-[8px] font-black uppercase tracking-[0.2em] text-muted-foreground/60 group-hover/up:text-primary transition-colors">Import File</span>\n 205                     </Button>\n 206                 </div>\n 207                 <Button \n 208                     variant="outline" \n 209                     className="h-14 flex flex-col items-center justify-center gap-1.5 rounded-2xl border-dashed border-primary/20 bg-primary/[0.02] hover:bg-primary/5 hover:border-primary/40 transition-all group/txt"\n 210                     onClick={() => setIsAddingText(true)}\n 211                 >\n 212                     <Plus className="h-4 w-4 text-primary/40 group-hover/txt:text-primary group-hover/txt:scale-110 transition-all" />\n 213                     <span className="text-[8px] font-black uppercase tracking-[0.2em] text-muted-foreground/60 group-hover/txt:text-primary transition-colors">Raw Logic</span>\n 214                 </Button>\n 215             </div>\n 216 \n 217             {/* Matrix Stack — High-Density Node List */}\n 218             <div className="flex-1 space-y-3 relative">\n 219                 {/* Depth architectural line */}\n 220                 <div className="absolute left-[-1.25rem] top-0 bottom-0 w-px bg-gradient-to-b from-primary/30 via-primary/5 to-transparent" />\n 221                 \n 222                 {project.externalContext.length > 0 ? (\n 223                     project.externalContext.map((item, index) => (\n 224                         <div key={item.id} className="space-y-2">\n 225                             <FileNodeItem \n 226                                 item={item} \n 227                                 onEdit={() => setEditingIndex(index)}\n 228                                 onDelete={() => removeContext(index)}\n 229                             />\n 230                             \n 231                             <div className="flex items-center gap-2 pl-3">\n 232                                 <ArrowRight className="h-2.5 w-2.5 text-primary/20" />\n 233                                 <Select \n 234                                     value={item.type} \n 235                                     onValueChange={(v) => updateContextType(index, v as any)}\n 236                                 >\n 237                                     <SelectTrigger className="h-6 w-auto min-w-[90px] border-none bg-primary/5 hover:bg-primary/10 text-[8px] font-black uppercase tracking-widest text-primary/60 transition-all px-2 rounded-lg focus:ring-0">\n 238                                         <SelectValue />\n 239                                     </SelectTrigger>\n 240                                     <SelectContent className="rounded-xl border-primary/10 shadow-2xl backdrop-blur-3xl">\n 241                                         {FILE_TYPES.map(t => (\n 242                                             <SelectItem key={t} value={t} className="text-[9px] font-black uppercase tracking-widest py-2">\n 243                                                 {t}\n 244                                             </SelectItem>\n 245                                         ))}\n 246                                     </SelectContent>\n 247                                 </Select>\n 248                             </div>\n 249                         </div>\n 250                     ))\n 251                 ) : (\n 252                     <div className="flex flex-col items-center justify-center py-20 text-center space-y-4 opacity-30">\n 253                         <div className="p-5 rounded-full bg-muted/20 border border-dashed border-muted-foreground/40">\n 254                             <Database className="h-10 w
2026-04-03 04:16:06.523 | 9969  (9969) | DEBUG    | Processing tool event with attributes: {'gen_ai.tool.name': 'find_and_replace_code', 'gen_ai.tool.call.id': 'pyd_ai_a7d6ed6c7e414e7e951edb243c4091d3', 'tool_arguments': '{"replace":"import { ai, OLLAMA_MODELS } from \'@/modules/ai/infrastructure/services/Genkit\';","file_path":"src/modules/ai/infrastructure/flows/generation/presentation-content-creator.ts","find":"import { ai } from \'@/modules/ai/infrastructure/services/Genkit\';"}', 'logfire.msg': 'running tool: find_and_replace_code', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span', 'original_content': '/**\n * @fileOverview Presentation Content Creator Flow\n *\n * Generates structured content for project presentations including\n * demos, pitches, technical reviews, and status updates.\n */\n\nimport { ai } from \'@/modules/ai/infrastructure/services/Genkit\';\nimport { presentationContentPrompt } from \'@/modules/ai/infrastructure/prompts/project-documentation\';\nimport {\n    PresentationContentSchema,\n    PresentationTypeSchema,\n} from \'@/modules/ai/domain/schemas/project-documentation\';\nimport {\n    analyzeProjectStructureTool,\n    extractDependenciesTool,\n} from \'@/modules/ai/infrastructure/tools/project-analysis\';\nimport {\n    calculateProjectMetricsTool,\n    generateArchitectureDiagramTool,\n} from \'@/modules/ai/infrastructure/tools/reporting-and-metrics\';\nimport {z} from \'zod\';\n// ==================== INPUT/OUTPUT SCHEMAS ====================\n\nconst PresentationInputSchema = z.object({\n    projectPath: z.string().describe(\'Path to the project\'),\n    projectName: z.string().describe(\'Project name\'),\n    projectDescription: z.string().describe(\'Brief project description\'),\n    presentationType: PresentationTypeSchema.describe(\'Type of presentation\'),\n    duration: z.number().describe(\'Presentation duration in minutes\'),\n    audience: z.string().describe(\'Target audience description\'),\n    keyPoints: z.array(z.string()).optional().describe(\'Key points to emphasize\'),\n    includeMetrics: z.boolean().default(true).describe(\'Include project metrics\'),\n    includeDiagram: z.boolean().default(true).describe(\'Include architecture diagram\'),\n    includeDemo: z.boolean().default(false).describe(\'Include demo section\'),\n});\n\nconst presentationContentCreatorFlow = ai.defineFlow(\n    {\n        name: \'presentationContentCreator\',\n        inputSchema: PresentationInputSchema,\n        outputSchema: PresentationContentSchema,\n    },\n    async (input: z.infer<typeof PresentationInputSchema>) => {\n        const {\n            projectPath,\n            projectName,\n            projectDescription,\n            presentationType,\n            duration,\n            audience,\n            keyPoints,\n            includeMetrics,\n            includeDiagram,\n        } = input;\n\n        console.log(`🎤 Creating ${presentationType} presentation for: ${projectName}`);\n        console.log(`⏱️ Duration: ${duration} minutes | Audience: ${audience}`);\n\n        // Step 1: Analyze project structure\n        console.log(\'📊 Step 1/5: Analyzing project...\');\n        const projectStructure = await analyzeProjectStructureTool({\n            projectPath,\n            includeHidden: false,\n            maxDepth: 3,\n        });\n\n        // Step 2: Extract dependencies for tech stack slide\n        console.log(\'📦 Step 2/5: Extracting technology stack...\');\n        const dependencies = await extractDependenciesTool({\n            projectPath,\n            analyzeOutdated: false,\n            categorize: true,\n        });\n\n        // Step 3: Calculate metrics (if requested)\n        let metrics;\n        if (includeMetrics) {\n            console.log(\'📈 Step 3/5: Calculating project metrics...\');\n            metrics = await calculateProjectMetricsTool({\n                projectPath,\n                includeTestCoverage: true,\n                includeQualityMetrics: false,\n            });\n        }\n\n        // Step 4: Generate architecture diagram (if requested)\n        let diagram;\n        if (includeDiagram) {\n            console.log(\'🏗️ Step 4/5: Creating architecture diagram...\');\n            diagram = await generateArchitectureDiagramTool({\n                projectPath,\n                diagramType: presentationType === \'technical_review\' ? \'component\' : \'flowchart\',\n                includeDetails: presentationType === \'technical_review\',\n                style: presentationType === \'pitch\' ? \'simple\' : \'detailed\',\n            });\n        }\n\n        // Step 5: Generate presentation content\n        console.log(\'🎨 Step 5/5: Generating presentation content...\');\n\n        const presentationPromptResult = await presentationContentPrompt({\n            projectName,\n            presentationType: presentationType as "demo" | "pitch" | "technical_review" | "status_update" | "training",\n            duration,\n            audience,\n            keyPoints,\n        });\n\n        // Enhance with project-specific data\n        const enhancedPresentation = await ai.generate({\n            model: \'ollama/phi4-mini:latest\',\n            prompt: `Create detailed presentation slides for a ${presentationType} presentation.\n\nProject: ${projectName}\nDescription: ${projectDescription}\nDuration: ${duration} minutes\nAudience: ${audience}\n\nBase Structure:\n${presentationPromptResult.text}\n\nProject Details:\n- Project Type: ${projectStructure.projectType}\n- Total Files: ${projectStructure.totalFiles}\n- Main Components: ${projectStructure.mainDirectories.length}\n- Tech Stack: ${Object.keys(dependencies.categories).flatMap((cat: any) => (dependencies.categories as any)[cat]).slice(0, 8).join(\', \')}\n\n${metrics ? `\nMetrics to Highlight:\n- Lines of Code: ${metrics.code.linesOfCode.toLocaleString()}\n- Active Contributors: ${metrics.general.activeContributors}\n- Project Age: ${metrics.general.projectAge}\n- Recent Commits: ${metrics.activity.commitsLastMonth}\n` : \'\'}\n\n${diagram ? `\nArchitecture Diagram Available:\n${diagram.description}\n\nInclude this in the architecture slide:\n\\`\\`\\`mermaid\n${diagram.diagram}\n\\`\\`\\`\n` : \'\'}\n\n${keyPoints ? `\nKey Points to Emphasize:\n${keyPoints.map((p: any) => `- ${p}`).join(\'\\n\')}\n` : \'\'}\n\nFor each slide, provide:\n1. Slide number and title\n2. Content (concise bullet points)\n3. Speaker notes (what to say - detailed)\n4. Visual suggestion (what to show)\n\nGuidelines:\n- Keep slides visual and minimal text\n- Allocate time appropriately (${(duration / 10).toFixed(1)} min per slide approx)\n- Build narrative flow between slides\n- End with strong call-to-action or takeaways\n- ${presentationType === \'demo\' ? \'Allocate 60% of time to live demo\' : \'\'}\n- ${presentationType === \'pitch\' ? \'Focus on problem-solution-traction\' : \'\'}\n- ${presentationType === \'technical_review\' ? \'Deep dive into architecture and design decisions\' : \'\'}`,\n            output: { schema: PresentationContentSchema },\n        });\n\n        const result = enhancedPresentation.output!;\n\n        console.log(`✅ Generated ${result.slides.length} slides for ${duration}-minute presentation`);\n\n        return result;\n    }\n);\n\nexport async function presentationContentCreator(input: z.infer<typeof PresentationInputSchema>): Promise<z.infer<typeof PresentationContentSchema>> {\n    return presentationContentCreatorFlow(input);\n}\n', 'tool_response': "Successfully replaced code in src/modules/ai/infrastructure/flows/generation/presentation-content-creator.ts:\n\n--- src/modules/ai/infrastructure/flows/generation/presentation-content-creator.ts\n+++ src/modules/ai/infrastructure/flows/generation/presentation-content-creator.ts\n@@ -5,7 +5,7 @@\n  * demos, pitches, technical reviews, and status updates.\n  */\n \n-import { ai } from '@/modules/ai/infrastructure/services/Genkit';\n+import { ai, OLLAMA_MODELS } from '@/modules/ai/infrastructure/services/Genkit';\n import { presentationContentPrompt } from '@/modules/ai/infrastructure/prompts/project-documentation';\n import {\n     PresentationContentSchema,\n"}

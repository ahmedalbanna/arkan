                 <FormItem className=\\"space-y-1.5\\">\\n                              <FormLabel className=\\"text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60\\">University / Organization</FormLabel>\\n                              <FormControl>\\n                                  <CustomSelect\\n                                      value={field.value || \'\'}\\n                                      onChange={(value: string) => {\\n                                          field.onChange(value);\\n                                          handleBlur();\\n                                      }}\\n                                      options={universityOptions}\\n                                      placeholder=\\"Institution name...\\"\\n                                      className=\\"h-10 text-[11px] bg-muted/5 border-border/40 focus:ring-primary/20 rounded-xl\\"\\n                                  />\\n                              </FormControl>\\n                              <FormMessage />\\n                          </FormItem>\\n                      )}\\n                  />"}', 'logfire.msg': 'running tool: find_and_replace_code', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span', 'original_content': '\'use client\';\n\nimport React, { useEffect } from \'react\';\nimport { useForm } from \'react-hook-form\';\nimport { zodResolver } from \'@hookform/resolvers/zod\';\nimport * as z from \'zod\';\nimport { useBuilderStore } from \'@/hooks\';\nimport { Form, FormControl, FormField, FormItem, FormLabel, FormMessage } from \'@/components/ui/form\';\nimport { Input } from \'@/components/ui/input\';\nimport { Textarea } from \'@/components/ui/textarea\';\nimport { ScrollArea } from \'@/components/ui/scroll-area\';\nimport { CustomSelect } from \'@/components/ui/CustomSelect\';\nimport { \n    documentTypeOptions, \n    specializationOptions, \n    educationalLevelOptions, \n    universityOptions, \n    citationStyleOptions \n} from \'./OptionConstants\';\n\n/**\n * ProjectSettingsHUD — High-fidelity metadata configuration for the document manifest.\n * Manages core identity and academic context parameters.\n */\n\nconst settingsSchema = z.object({\n  name: z.string().min(1, \'Title is required\'),\n  projectDescription: z.string().optional(),\n  projectType: z.string().optional(),\n  educationalLevel: z.string().optional(),\n  specialization: z.string().optional(),\n  university: z.string().optional(),\n  citationStyle: z.string().optional(),\n});\n\ntype SettingsFormValues = z.infer<typeof settingsSchema>;\n\nexport function ProjectSettingsHUD() {\n  const { project, updateProject } = useBuilderStore();\n\n  const form = useForm<SettingsFormValues>({\n    resolver: zodResolver(settingsSchema),\n    defaultValues: {\n      name: project?.name || \'\',\n      projectDescription: project?.projectDescription || \'\',\n      projectType: project?.projectType || \'\',\n      educationalLevel: project?.educationalLevel || \'\',\n      specialization: project?.specialization || \'\',\n      university: project?.university || \'\',\n      citationStyle: project?.citationStyle || \'\',\n    },\n  });\n\n  useEffect(() => {\n    if (project) {\n      form.reset({\n        name: project.name || \'\',\n        projectDescription: project.projectDescription || \'\',\n        projectType: project.projectType || \'\',\n        educationalLevel: project.educationalLevel || \'\',\n        specialization: project.specialization || \'\',\n        university: project.university || \'\',\n        citationStyle: project.citationStyle || \'\',\n      });\n    }\n  }, [project, form]);\n\n  const handleBlur = () => {\n    const values = form.getValues();\n    updateProject((p) => {\n      return p.withProps({\n        ...values,\n      });\n    });\n  };\n\n  return (\n    <div className="h-full flex flex-col space-y-6 pt-2 animate-in fade-in slide-in-from-right-2 duration-300">\n      <div className="space-y-1 px-1">\n        <h4 className="text-[10px] font-black uppercase tracking-[0.2em] text-primary/70">Project Settings</h4>\n        <p className="text-[9px] text-muted-foreground italic font-medium uppercase tracking-[0.1em] opacity-60">\n          Configure project identity and academic context.\n        </p>\n      </div>\n\n      <Form {...form}>\n        <form className="flex-grow flex flex-col min-h-0">\n          <ScrollArea className="flex-grow pr-4 -mr-4">\n            <div className="space-y-8 pb-24 relative px-1">\n              {/* Depth architectural line */}\n              <div className="absolute left-[-1.25rem] top-0 bottom-0 w-px bg-gradient-to-b from-primary/30 via-primary/5 to-transparent" />\n              \n              <div className="space-y-5">\n                <FormField \n                  control={form.control} \n                  name="name" \n                  render={({ field }) => (\n                    <FormItem className="space-y-1.5">\n                      <FormLabel className="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60">Project Title</FormLabel>\n                      <FormControl>\n                        <Input \n                          {...field} \n                          onBlur={handleBlur} \n                          placeholder="Untitled Project..."\n                          className="h-10 text-[11px] bg-muted/5 border-primary/10 focus-visible:ring-primary/20 rounded-xl shadow-inner transition-all font-bold uppercase tracking-widest"\n                        />\n                      </FormControl>\n                      <FormMessage className="text-[10px]" />\n                    </FormItem>\n                  )} \n                />\n\n                <FormField \n                  control={form.control} \n                  name=
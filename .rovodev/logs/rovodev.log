)\n  32 // ============================================================================\n  33 \n  34 export const ParaphraseInputSchema = BaseTextInputSchema.extend({\n  35     mode: ParaphraseModeSchema.describe(\'The desired style of the paraphrased text.\'),\n  36     instruction: z.string().optional(), // Added for runtime prompt construction\n  37 }).merge(BaseControlsSchema);\n  38 export const ParaphraseOutputSchema = z.string().describe(\'The rewritten text, with original markdown formatting preserved.\');\n  39 export type ParaphraseInput = z.infer<typeof ParaphraseInputSchema>;\n  40 export type ParaphraseOutput = z.infer<typeof ParaphraseOutputSchema>;\n  41 \n  42 export const SummarizeInputSchema = BaseTextInputSchema.extend({\n  43     length: SummarizeLengthSchema.describe(\'The desired length of the summary.\'),\n  44 }).merge(BaseControlsSchema);\n  45 export const SummarizeOutputSchema = z.string().describe(\'The generated summary of the original text.\');\n  46 export type SummarizeInput = z.infer<typeof SummarizeInputSchema>;\n  47 export type SummarizeOutput = z.infer<typeof SummarizeOutputSchema>;\n  48 \n  49 // ai-proofread-document.ts\n  50 export const AiProofreadDocumentInputSchema = z.object({\n  51     documentText: z\n  52         .string()\n  53         .describe(\'The text content of the document to be proofread.\'),\n  54     constraints: z\n  55         .string()\n  56         .optional()\n  57         .describe(\n  58             \'Optional constraints to tailor the proofreading suggestions, such as specific style guidelines or target audience.\'\n  59         ),\n  60 });\n  61 export type AiProofreadDocumentInput = z.infer<typeof AiProofreadDocumentInputSchema>;\n  62 \n  63 export const AiProofreadDocumentOutputSchema = z.object({\n  64     proofreadDocument: z\n  65         .string()\n  66         .describe(\'The proofread document with suggested corrections.\'),\n  67 });\n  68 export type AiProofreadDocumentOutput = z.infer<typeof AiProofreadDocumentOutputSchema>;\n  69 \n  70 // ai-researcher.ts\n  71 export const AIResearcherInputSchema = BaseTopicInputSchema.extend({\n  72     depth: ResearchDepthSchema.optional().describe(\'The depth of research to conduct.\'),\n  73 });\n  74 export type AIResearcherInput = z.infer<typeof AIResearcherInputSchema>;\n  75 \n  76 export const AIResearcherOutputSchema = z.object({\n  77     summary: z.string().describe(\'A comprehensive summary of the research topic.\'),\n  78     keyPoints: z.array(z.string()).describe(\'A list of key points or facts about the topic.\'),\n  79     sources: z.array(z.string()).describe(\'A list of URLs for the sources used.\'),\n  80     methodology: z.string().optional().describe(\'A brief description of the research methodology used.\'),\n  81     findings: z.array(z.string()).optional().describe(\'Detailed findings from the research.\'),\n  82 });\n  83 export type AIResearcherOutput = z.infer<typeof AIResearcherOutputSchema>;\n  84 \n  85 // solve-assignments.ts\n  86 export const SolveAssignmentsInputSchema = BaseTextInputSchema.extend({\n  87 });\n  88 export type SolveAssignmentsInput = z.infer<typeof SolveAssignmentsInputSchema>;\n  89 \n  90 export const SolveAssignmentsOutputSchema = z.object({\n  91     text: z.string().describe(\'The comprehensive solutions to all identified questions and problems in markdown format.\'),\n  92 });\n  93 export type SolveAssignmentsOutput = z.infer<typeof SolveAssignmentsOutputSchema>;\n  94 \n  95 // generate-project-blueprint.ts\n  96 export const GenerateProjectBlueprintInputSchema = z.object({\n  97     projectName: z.string().describe(\'The name of the project/application to be developed.\'),\n  98     projectType: z.string().describe(\'Type of project (e.g., Web Application, Mobile App, E-commerce, Blog, Portfolio).\'),\n  99     description: z.string().describe(\'Detailed description of the project requirements and vision.\'),\n 100     targetAudience: z.string().describe(\'Description of the target users and audience for the project.\'),\n 101     complexity: ProjectComplexitySchema.describe(\'Project complexity level.\'),\n 102     features: z.string().describe(\'List of desired features and functionalities.\'),\n 103     techStack: z.string().optional().describe(\'Preferred technology stack or specific requirements.\'),\n 104     budget: z.string().optional().describe(\'Budget range or constraints.\'),\n 105     timeline: z.string().optional().describe(\'Project timeline or deadline requirements.\'),\n 106 });\n 107 export type GenerateProjectBlueprintInput = z.infer<typeof GenerateProjectBlueprintInputSchema>;\n 108 \n 109 export const GenerateProjectBlueprintOutputSchema = z.object({\n 110     text: z.string().describe(\'Comprehensive project blueprint in markdown format with architecture, features, timeline, and implementation details.\'),\n 111 });\n 112 export type GenerateProjectBlueprintOutput = z.infer<typeof GenerateProjectBlueprintOutputSchema>;\n 113 \n 114 // literature-review-generator.ts\n 115 export const LiteratureReviewInputSchema = BaseTopicInputSchema.extend({\n 116     focusAreas: z.array(z.string()).optional().describe(\'Specific areas or themes to focus on in the review.\'),\n 117     numberOfSources: z.number().int().min(5).max(50).optional().describe(\'Desired number of sources to include (default: 10).\'),\n 118     timeRange: z.string().optional().describe(\'Time range for sources (e.g., "last 5 years", "2020-2024").\'),\n 119 });\n 120 export type LiteratureReviewInput = z.infer<typeof LiteratureReviewInputSchema>;\n 121 \n 122 export const LiteratureReviewOutputSchema = z.object({\n 123     introduction: z.string().describe(\'An introduction to the literature review.\'),\n 124     mainBody: z.string().describe(\'The main body of the literature review, organized by themes or topics.\'),\n 125     conclusion: z.string().describe(\'A conclusion summarizing key findings and gaps in the literature.\'),\n 126     sources: z.array(z.object({\n 127         title: z.string().describe(\'Title of the source.\'),\n 128         url: z.string().url().describe(\'URL of the source.\'),\n 129         summary: z.string().describe(\'Brief summary of the source.\'),\n 130         relevance: z.string().describe(\'Why this source is relevant to the topic.\'),\n 131     })).describe(\'An array of sources used in the literature review.\'),\n 132     gaps: z.array(z.string()).optional().describe(\'Identified gaps in the current literature.\'),\n 133 });\n 134 export type LiteratureReviewOutput = z.infer<typeof LiteratureReviewOutputSchema>;\n 135 \n 136 // question-answering.ts\n 137 export const QuestionAnsweringInputSchema = z\n 138     .object({\n 139         question: z.string().describe(\'The question to answer.\'),\n 140         context: z\n 141             .string()\n 142             .optional()\n 143             .describe(\'Optional context text to base the answer on. If provided, answer based on this text.\'),\n 144     })\n 145     .merge(BaseWebSearchSchema);\n 146 export type QuestionAnsweringInput = z.infer<typeof QuestionAnsweringInputSchema>;\n 147 \n 148 export const QuestionAnsweringOutputSchema = z.object({\n 149     answer: z.string().describe(\'A comprehensive answer to the question.\'),\n 150     confidence: ConfidenceLevelSchema.describe(\'Confidence level in the answer.\'),\n 151     sources: z.array(z.object({\n 152         url: z.string().url().describe(\'URL of the source.\'),\n 153         title: z.string().optional().describe(\'Title of the source.\'),\n 154         relevance: z.string().optional().describe(\'Why this source is relevant.\'),\n 155     })).optional().describe(\'Sources used to answer the question.\'),\n 156     contextUsed: z.boolean().describe(\'Whether the provided context was used in the answer.\'),\n 157     additionalNotes: z.string().optional().describe(\'Any additional notes or caveats about the answer.\'),\n 158 });\n 159 export type QuestionAnsweringOutput = z.infer<typeof QuestionAnsweringOutputSchema>;\n 160 \n 161 // fact-retrieval.ts\n 162 export const FactRetrievalInputSchema = z.object({\n 163     factQuery: z.string().describe(\'The specific fact or information to retrieve (e.g., "population of Japan", "date of first moon landing").\'),\n 164     useWebSearch: z.boolean().optional().default(true).describe(\'Whether to search the web for the fact.\'),\n 165     requireSource: z.boolean().optional().default(true).describe(\'Whether to require a source for the fact.\'),\n 166 });\n 167 export type FactRetrievalInput = z.infer<typeof FactRetrievalInputSchema>;\n 168 \n 169 export const FactRetrievalOutputSchema = z.object({\n 170     fact: z.string().describe(\'The retrieved fact or information.\'),\n 171     source: z.string().url().optional().describe(\'URL of the source for this fact.\'),\n 172     sourceTitle: z.string().optional().describe(\'Title of the source.\'),\n 173     lastVerified: z.string().optional().describe(\'When this fact was last verified or the date of the source.\'),\n 174     confidence: z.enum([\'high\', \'medium\', \'low\']).describe(\'Confidence level in the accuracy of the fact.\'),\n 175     relatedFacts: z.array(z.string()).optional().describe(\'Related facts that might be of interest.\'),\n 176 });\n 177 export type FactRetrievalOutput = z.infer<typeof FactRetrievalOutputSchema>;\n 178 \n 179 // analyze-context.ts\n 180 export const AnalyzeContextInputSchema = BasePromptSchema.extend({\n 181     contextFiles: z.array(BaseContextFileSchema).describe(\n 182         \'An array of context files (text, images, PDFs as data URIs) to be analyzed.\'\n 183     ),\n 184 });\n 185 export type AnalyzeContextInput = z.infer<typeof AnalyzeContextInputSchema>;\n 186 \n 187 export const AnalyzeContextOutputSchema = z.object({\n 188     schema: z.string().describe("A Zod schema string that defines the structure of the output data. This schema should be dynamically generated based on the user\'s prompt."),\n 189     data: z.any().describe("The structured data, conforming to the generated schema, extracted and synthesized from the context files based on the user\'s prompt."),\n 190 });\n 191 export type AnalyzeContextOutput = z.infer<typeof AnalyzeContextOutputSchema>;\n 192 \n 193 // bias-checker.ts\n 194 export const BiasCheckInputSchema = BaseTextInputSchema.extend({\n 195 }).merge(BaseControlsSchema);\n 196 export type BiasCheckInput = z.infer<typeof BiasCheckInputSchema>;\n 197 \n 198 export const BiasIssueSchema = z.object({\n 199     phrase: z.string().describe(\'The potentially biased phrase or sentence.\'),\n 200     explanation: z.string().describe(\'An explanation of why the phrase might be considered biased.\'),\n 201     suggestion: z.string().describe(\'A more inclusive alternative.\'),\n 202     biasType: BiasTypeSchema.describe(\'The type of bias identified.\'),\n 203 });\n 204 export type BiasIssue = z.infer<typeof BiasIssueSchema>;\n 205 \n 206 export const BiasCheckOutputSchema = z.object({\n 207     issues: z.array(BiasIssueSchema).describe(\'An array of identified bias issues.\'),\n 208     overallAssessment: z.string().describe(\'A brief, overall assessment of the text\\\'s inclusivity.\'),\n 209     inclusivityScore: z.number().min(0).max(100).describe(\'A score from 0 to 100 representing the inclusivity of the text, where 100 is completely inclusive.\'),\n 210 });\n 211 export type BiasCheckOutput = z.infer<typeof BiasCheckOutputSchema>;\n 212 \n 213 // sentence-structure-checker.ts\n 214 export const SentenceStructureCheckInputSchema = BaseTextInputSchema.extend({\n 215 }).merge(BaseControlsSchema);\n 216 export type SentenceStructureCheckInput = z.infer<typeof SentenceStructureCheckInputSchema>;\n 217 \n 218 export const SentenceStructureIssueSchema = z.object({\n 219     sentence: z.string().describe(\'The problematic sentence.\'),\n 220     issue: z.string().describe(\'A brief description of the issue (e.g., "Too long", "Too short/choppy", "Complex").\'),\n 221     suggestion: z.string().describe(\'A suggestion for how to improve or rewrite the sentence.\'),\n 222 });\n 223 export type SentenceStructureIssue = z.infer<typeof SentenceStructureIssueSchema>;\n 224 \n 225 export const SentenceStructureCheckOutputSchema = z.string().describe(\'A brief, overall assessment of the sentence structure and suggestions for improvement.\');\n 226 export type SentenceStructureCheckOutput = z.infer<typeof SentenceStructureCheckOutputSchema>;\n 227 \n 228 // detect-ai-content.ts\n 229 export const DetectAIInputSchema = BaseTextInputSchema.extend({\n 230 }).merge(BaseControlsSchema);\n 231 export type DetectAIInput = z.infer<typeof DetectAIInputSchema>;\n 232 \n 233 export const DetectAIOutputSchema = z.object({\n 234     score: z.number().min(0).max(100).describe(\'The probability score (0-100) that the text was written by an AI.\'),\n 235     analysis: z.string().describe(\'A brief analysis explaining the reasoning behind the score.\'),\n 236 });\n 237 export type DetectAIOutput = z.infer<typeof DetectAIOutputSchema>;\n 238 \n 239 \n 240 // fact-checker.ts\n 241 export const ClaimSchema = z.object({\n 242     statement: z.string().describe("The specific claim extracted from the text."),\n 243     status: ClaimStatusSchema.describe("The verification status of the claim."),\n 244     source: z.string().describe("The URL of the most reliable source found to verify the claim."),\n 245     explanation: z.string().describe("A brief explanation of why the claim was given its status, based on the source.")\n 246 });\n 247 \n 248 export const FactCheckInputSchema = BaseTextInputSchema.extend({\n 249 });\n 250 export type FactCheckInput = z.infer<typeof FactCheckInputSchema>;\n 251 \n 252 export const FactCheckOutputSchema = z.object({\n 253     claims: z.array(ClaimSchema).describe("An array of identified claims and their verification details."),\n 254     originalityScore: z.number().min(0).max(100).describe("An overall score from 0 to 100 representing the factual accuracy and originality of the text, where 100 is completely accurate.")\n 255 });\n 256 export type FactCheckOutput = z.infer<typeof FactCheckOutputSchema>;\n 257 \n 258 // generate-agent-config.ts\n 259 export const GenerateAgentConfigInputSchema = BasePromptSchema.extend({\n 260     includeJsonOutput: z.boolean().optional().describe(\n 261         "Whether to include a sample JSON output structure in the agent\'s prompt."\n 262     ),\n 263     contextFiles: z\n 264         .array(BaseContextFileSchema)\n 265         .optional()\n 266         .describe("An array of contextual documents (text, images) to inform the agent\'s creation."),\n 267 });\n 268 \n 269 export const GenerateAgentConfigOutputSchema = z.object({\n 270     name: z.string().describe("A short, descriptive name for the new agent."),\n 271     description: z.string().describe("A concise, one-sentence description of the agent\'s purpose."),\n 272     instructions: z.string().describe("The base prompt or primary instruction for the agent. This should be a clear, concise paragraph explaining the agent\'s purpose and core function."),\n 273     guidelines: z.string().describe("A newline-separated list of 3-5 specific, actionable guidelines for the agent to follow. Each guideline should start with \'- \'."),\n 274     jsonStructure: z.any().optional().describe("If the user requested JSON output, provide a sample JSON object structure that the agent should return. It should be a simple but relevant example based on the user\'s prompt and any provided context. Otherwise, this field should be omitted."),\n 275 });\n 276 export type GenerateAgentConfigOutput = z.infer<typeof GenerateAgentConfigOutputSchema>;\n 277 export type GenerateAgentConfigInput = z.infer<typeof GenerateAgentConfigInputSchema>;\n 278 \n 279 \n 280 // generate-citation.ts\n 281 export const GenerateCitationInputSchema = z.object({\n 282     sourceText: z.string().describe(\'The source material to generate a citation for. This can be a URL, a block of text from an article, or a book title and author.\'),\n 283     style: CitationStyleSchema.describe(\'The citation style to use (e.g., APA, MLA).\'),\n 284 });\n 285 export type GenerateCitationInput = z.infer<typeof GenerateCitationInputSchema>;\n 286 \n 287 export const GenerateCitationOutputSchema = z.object({\n 288     citations: z.array(z.string().describe(\'A single formatted citation string.\'))\n 289         .describe(\'An array of formatted citation strings, one for each source found in the input.\'),\n 290 });\n 291 export type GenerateCitationOutput = z.infer<typeof GenerateCitationOutputSchema>;\n 292 \n 293 // generate-diagrams.ts\n 294 export const GenerateDiagramInputSchema = z\n 295     .object({\n 296         diagramToGenerate: DiagramTypeSchema.describe(\'The type of diagram to generate.\'),\n 297         otherSections: z\n 298             .record(SectionNameSchema, z.string())\n 299             .optional()\n 300             .describe(\'A map of previously generated text sections to provide context.\'),\n 301         otherDiagrams: z\n 302             .record(DiagramTypeSchema, z.string())\n 303             .optional()\n 304             .describe(\'A map of previously generated PlantUML diagrams to provide context.\'),\n 305     })\n 306     .merge(BaseGenerationSchema);\n 307 export type GenerateDiagramInput = z.infer<typeof GenerateDiagramInputSchema>;\n 308 \n 309 export const GenerateDiagramOutputSchema = z.object({\n 310     plantUmlCode: z.string().describe("The complete PlantUML code for the diagram, starting with @startuml and ending with @enduml."),\n 311     explanation: z.string().describe("A detailed explanation of the generated diagram, formatted in markdown."),\n 312 });\n 313 export type GenerateDiagramOutput = z.infer<typeof GenerateDiagramOutputSchema>;\n 314 \n 315 // generate-plantuml.ts\n 316 export const GeneratePlantUMLInputSchema = z.object({\n 317     description: z.string().describe("A detailed text description of the diagram to be generated."),\n 318     diagramType: DiagramTypeSchema.describe("The type of PlantUML diagram to generate."),\n 319 });\n 320 export type GeneratePlantUMLInput = z.infer<typeof GeneratePlantUMLInputSchema>;\n 321 \n 322 // We can reuse the output schema from generate-diagrams\n 323 export const GeneratePlantUMLOutputSchema = GenerateDiagramOutputSchema;\n 324 export type GeneratePlantUMLOutput = z.infer<typeof GeneratePlantUMLOutputSchema>;\n 325 \n 326 \n 327 // generate-image.ts\n 328 export const GenerateImageInputSchema = BasePromptSchema.extend({\n 329 });\n 330 export type GenerateImageInput = z.infer<typeof GenerateImageInputSchema>;\n 331 \n 332 export const GenerateImageOutputSchema = z.object({\n 333     imageUrl: z.string().describe("The generated image as a Base64 data URI."),\n 334 });\n 335 export type GenerateImageOutput = z.infer<typeof GenerateImageOutputSchema>;\n 336 \n 337 // generate-ideas.ts\n 338 export const IdeaGenerationInputSchema = z\n 339     .object({\n 340         specialization: z\n 341             .string()\n 342             .describe(\n 343                 \'The user\\\'s field of expertise or specialization (e.g., "Web Development", "Marketing", "Biotechnology").\',\n 344             ),\n 345         domain: z\n 346             .string()\n 347             .optional()\n 348             .describe(\'The specific industry or domain of interest (e.g., "E-commerce", "Healthcare", "Education").\'),\n 349         region: z\n 350             .string()\n 351             .optional()\n 352             .describe(\'The geographical region or country to target (e.g., "Southeast Asia", "Germany").\'),\n 353         circumstances: z\n 354             .string()\n 355             .optional()\n 356             .describe(\n 357                 \'Any specific circumstances, trends, or constraints (e.g., "post-pandemic recovery", "rising inflation", "remote work transition").\',\n 358             ),\n 359         additionalContext: z\n 360             .string()\n 361             .optional()\n 362             .describe(\'Any other relevant information or detailed context provided by the user.\'),\n 363     })\n 364     .merge(BaseControlsSchema);\n 365 export type IdeaGenerationInput = z.infer<typeof IdeaGenerationInputSchema>;\n 366 \n 367 export const IdeaGenerationOutputSchema = z.string().describe(\'A markdown formatted string of generated ideas, each with a title and description.\');\n 368 export type IdeaGenerationOutput = z.infer<typeof IdeaGenerationOutputSchema>;\n 369 \n 370 \n 371 // generate-quiz.ts\n 372 const MultipleChoiceQuestionSchema = z.object({\n 373     type: MultipleChoiceTypeSchema,\n 374     question: z.string().describe("The question text."),\n 375     options: z.array(z.string()).length(4).describe("An array of 4 possible answers."),\n 376     answer: z.string().describe("The correct answer from the options."),\n 377 });\n 378 \n 379 const TrueFalseQuestionSchema = z.object({\n 380     type: TrueFalseTypeSchema,\n 381     question: z.string().describe("The statement to be evaluated."),\n 382     options: z.array(z.string()).length(2).describe("The options: an array containing \'True\' and \'False\'."),\n 383     answer: TrueFalseAnswerSchema.describe("The correct answer, either \'True\' or \'False\'."),\n 384 });\n 385 \n 386 const DirectQuestionSchema = z.object({\n 387     type: DirectQuestionTypeSchema,\n 388     question: z.string().describe("The open-ended question."),\n 389     answer: z.string().describe("A concise, ideal answer to the question."),\n 390 });\n 391 \n 392 export const QuizQuestionSchema = z.discriminatedUnion(\'type\', [\n 393     MultipleChoiceQuestionSchema,\n 394     TrueFalseQuestionSchema,\n 395     DirectQuestionSchema,\n 396 ]);\n 397 \n 398 export const GenerateQuizInputSchema = BaseTextInputSchema.extend({\n 399     numQuestions: z.number().int().min(1).max(20).describe(\'The number of questions to generate.\'),\n 400     questionType: QuestionTypeSchema.describe(\'The type of questions to generate.\'),\n 401 });\n 402 export type GenerateQuizInput = z.infer<typeof GenerateQuizInputSchema>;\n 403 \n 404 export const GenerateQuizOutputSchema = z.object({\n 405     questions: z.array(QuizQuestionSchema).describe("An array of quiz questions of the specified type."),\n 406 });\n 407 export type GenerateQuizOutput = z.infer<typeof GenerateQuizOutputSchema>;\n 408 \n 409 // generate-report-section.ts\n 410 export const GenerateSectionInputSchema = z\n 411     .object({\n 412         sectionToGenerate: SectionNameSchema,\n 413         prompt: z.string().min(10, \'Prompt must be at least 10 characters.\'),\n 414         otherSections: z\n 415             .record(z.string(), z.string())\n 416             .optional()\n 417             .describe(\n 418                 "A map of previously generated text sections and other textual context (like the proposal or plan). The key is the item\'s name and the value is the markdown/JSON content.",\n 419             ),\n 420         instructionText: z.string().optional().describe(\'A dynamically generated instruction string based on UI controls.\'),\n 421     })\n 422     .merge(BaseExternalContextSchema)\n 423     .merge(BaseControlsSchema);\n 424 \n 425 \n 426 export type GenerateSectionInput = z.infer<typeof GenerateSectionInputSchema>;\n 427 \n 428 export const GenerateSectionOutputSchema = z.object({\n 429     sectionName: SectionNameSchema.describe("The name of the section that was generated. This must match the \'sectionToGenerate\' from the input."),\n 430     content: z.string().describe("The generated markdown content for the specified section."),\n 431 });\n 432 export type GenerateSectionOutput = z.infer<typeof GenerateSectionOutputSchema>;\n 433 \n 434 // generate-chapter-content.ts\n 435 const SectionInstructionSchema = z.object({\n 436     title: z.string().describe("The title of the section."),\n 437     prompt: z.string().optional().describe("The base prompt for generating this section."),\n 438     guidelines: z.array(z.string()).optional().describe("Specific guidelines for this section."),\n 439     instructionText: z.string().optional().describe("Dynamically generated instructions from UI controls."),\n 440     context: z.string().optional().describe("All contextual information (from other sections, files, etc.) to be used for generating this section.")\n 441 });\n 442 \n 443 export const GenerateChapterInputSchema = z.object({\n 444     chapterTitle: z.string().describe("The main title of the chapter to be generated."),\n 445     sectionInstructions: z.array(SectionInstructionSchema).describe("An ordered array of instructions for each section within the chapter."),\n 446 });\n 447 export type GenerateChapterInput = z.infer<typeof GenerateChapterInputSchema>;\n 448 \n 449 export const GenerateChapterOutputSchema = z.object({\n 450     markdownContent: z.string().describe("The complete markdown content for the entire chapter, with each section formatted with a level 2 heading (##)."),\n 451 });\n 452 export type GenerateChapterOutput = z.infer<typeof GenerateChapterOutputSchema>;\n 453 \n 454 \n 455 // generate-text.ts\n 456 export const GenerateTextInputSchema = BaseTextInputSchema.extend({\n 457 }).merge(BaseControlsSchema);\n 458 export type GenerateTextInput = z.infer<typeof GenerateTextInputSchema>;\n 459 \n 460 export const GenerateTextOutputSchema = z.string().describe(\'The generated text.\');\n 461 export type GenerateTextOutput = z.infer<typeof GenerateTextOutputSchema>;\n 462 \n 463 \n 464 // grammar-checker.ts\n 465 export const CorrectionSchema = z.object({\n 466     original: z.string().describe("The original incorrect phrase or word."),\n 467     corrected: z.string().describe("The corrected version of the phrase or word."),\n 468     explanation: z.string().describe("A brief, clear explanation of why the correction was made."),\n 469     type: z.enum([\'grammar\', \'spelling\', \'punctuation\']).describe("The type of correction: \'grammar\' for grammatical errors, \'spelling\' for misspellings, \'punctuation\' for punctuation issues."),\n 470 });\n 471 \n 472 export const GrammarCheckInputSchema = BaseTextInputSchema.extend({\n 473 }).merge(BaseControlsSchema);\n 474 export type GrammarCheckInput = z.infer<typeof GrammarCheckInputSchema>;\n 475 \n 476 export const GrammarCheckOutputSchema = z.string().describe("The full text with all corrections applied, preserving original markdown.");\n 477 export type GrammarCheckOutput = z.infer<typeof GrammarCheckOutputSchema>;\n 478 \n 479 \n 480 // humanize-text.ts\n 481 export const HumanizeTextInputSchema = BaseTextInputSchema.extend({\n 482 }).merge(BaseControlsSchema);\n 483 export type HumanizeTextInput = z.infer<typeof HumanizeTextInputSchema>;\n 484 \n 485 export const HumanizeTextOutputSchema = z.string().describe(\'The rewritten text, which sounds more natural and less robotic.\');\n 486 export type HumanizeTextOutput = z.infer<typeof HumanizeTextOutputSchema>;\n 487 \n 488 \n 489 // image-to-text.ts\n 490 export const ImageToTextInputSchema = z.object({\n 491     imageDataUri: z.string().describe("An image file encoded as a data URI that must include a MIME type and use Base64 encoding. Expected format: \'data:image/...;base64,<encoded_data>\'."),\n 492 });\n 493 export type ImageToTextInput = z.infer<typeof ImageToTextInputSchema>;\n 494 \n 495 export const ImageToTextOutputSchema = z.object({\n 496     text: z.string().describe(\'The extracted text content from the image, formatted as markdown.\'),\n 497 });\n 498 export type ImageToTextOutput = z.infer<typeof ImageToTextOutputSchema>;\n 499 \n 500 \n 501 // improve-report-markdown.ts\n 502 export const ImproveMarkdownInputSchema = z\n 503     .object({\n 504         markdownContent: z.string().min(20, \'Markdown content is too short.\'),\n 505         userPrompt: z.string().min(10, \'Instructions for the AI must be at least 10 characters.\'),\n 506     })\n 507     .merge(BaseControlsSchema);\n 508 export type ImproveMarkdownInput = z.infer<typeof ImproveMarkdownInputSchema>;\n 509 \n 510 export const ImproveMarkdownOutputSchema = z.object({\n 511     text: z.string().describe(\'The improved and reformatted Markdown content.\'),\n 512 });\n 513 export type ImproveMarkdownOutput = z.infer<typeof ImproveMarkdownOutputSchema>;\n 514 \n 515 \n 516 // manipulate-text.ts\n 517 export const ManipulateTextInputSchema = z\n 518     .object({\n 519         textToManipulate: z.string().describe(\'The original text to be modified.\'),\n 520         command: z.string().describe(\n 521             \'The instruction for how to modify the text (e.g., "summarize", "expand on this topic", "rewrite this to be more formal").\',\n 522         ),\n 523     })\n 524     .merge(BaseControlsSchema);\n 525 export type ManipulateTextInput = z.infer<typeof ManipulateTextInputSchema>;\n 526 \n 527 export const ManipulateTextOutputSchema = z.object({\n 528     text: z.string().describe(\'The resulting text after applying the command.\'),\n 529 });\n 530 export type ManipulateTextOutput = z.infer<typeof ManipulateTextOutputSchema>;\n 531 \n 532 \n 533 \n 534 \n 535 // plagiarism-checker.ts\n 536 export const MatchedSourceSchema = z.object({\n 537     source: z.string().describe("The full, real URL of the source where the similar text was found. This must be a complete and valid URL (e.g., https://www.example.com/article)."),\n 538     title: z.string().describe("The title of the webpage or article found at the source URL."),\n 539     summary: z.string().describe("A brief summary of the content from the source that is similar to the user\'s text."),\n 540     similarity: z.number().min(0).max(100).describe("A percentage score (0-100) indicating how similar the provided text is to the found source."),\n 541 });\n 542 \n 543 export const PlagiarismCheckInputSchema = BaseTextInputSchema.extend({\n 544 }).merge(BaseControlsSchema);\n 545 export type PlagiarismCheckInput = z.infer<typeof PlagiarismCheckInputSchema>;\n 546 \n 547 export const PlagiarismCheckOutputSchema = z.object({\n 548     originalityScore: z.number().min(0).max(100).describe("An overall score from 0 to 100 representing how original the text is, where 100 is completely unique."),\n 549     matches: z.array(MatchedSourceSchema).describe("An array of potential sources that contain similar text."),\n 550 });\n 551 export type PlagiarismCheckOutput = z.infer<typeof PlagiarismCheckOutputSchema>;\n 552 \n 553 \n 554 // rewrite-document-to-markdown.ts\n 555 export const RewriteDocumentInputSchema = z.object({\n 556     pdfDataUri: z.string().describe("A PDF file encoded as a data URI that must include a MIME type and use Base64 encoding. Expected format: \'data:application/pdf;base64,<encoded_data>\'."),\n 557 });\n 558 export type RewriteDocumentInput = z.infer<typeof RewriteDocumentInputSchema>;\n 559 \n 560 export const RewriteDocumentOutputSchema = z.string().describe(\'The rewritten content, formatted as clean, well-structured markdown.\');\n 561 export type RewriteDocumentOutput = z.infer<typeof RewriteDocumentOutputSchema>;\n 562 \n 563 \n 564 // rewrite-to-markdown.ts\n 565 export const RewriteToMarkdownInputSchema = z.object({\n 566     rawText: z.string().describe(\'The raw, unstructured text extracted from a document.\'),\n 567 });\n 568 export type RewriteToMarkdownInput = z.infer<typeof RewriteToMarkdownInputSchema>;\n 569 \n 570 export const RewriteToMarkdownOutputSchema = z.string().describe(\'The rewritten content, formatted as clean, well-structured markdown.\');\n 571 export type RewriteToMarkdownOutput = z.infer<typeof RewriteToMarkdownOutputSchema>;\n 572 \n 573 \n 574 // summarize-document.ts\n 575 export const SummarizeDocumentInputSchema = z.object({\n 576     documentDataUri: z\n 577         .string()\n 578         .describe(\n 579             \'A document, as a data URI that must include a MIME type and use Base64 encoding. Expected format: \\\'data:<mimetype>;base64,<encoded_data>\\\'.\'\n 580         ),\n 581 });\n 582 export type SummarizeDocumentInput = z.infer<typeof SummarizeDocumentInputSchema>;\n 583 \n 584 export const SummarizeDocumentOutputSchema = z.string().describe(\'A concise summary of the document.\');\n 585 export type SummarizeDocumentOutput = z.infer<typeof SummarizeDocumentOutputSchema>;\n 586 \n 587 \n 588 // summarize-project.ts\n 589 export const SummarizeProjectInputSchema = z.object({\n 590     projectDescription: z\n 591         .string()\n 592         .describe(\'The detailed description of the project that needs to be summarized.\'),\n 593 });\n 594 export type SummarizeProjectInput = z.infer<typeof SummarizeProjectInputSchema>;\n 595 \n 596 export const SummarizeProjectOutputSchema = z.object({\n 597     text: z.string().describe(\'A concise summary of the project.\'),\n 598     technologies: z.array(z.string()).describe(\'A list of technologies, frameworks, and libraries identified in the project description.\'),\n 599     progress: z.string().describe(\'Details on the summarization progress\'),\n 600 });\n 601 export type SummarizeProjectOutput = z.infer<typeof SummarizeProjectOutputSchema>;\n 602 \n 603 \n 604 // text-stylist.ts\n 605 export const RewriteTextInputSchema = BaseTextInputSchema.extend({\n 606     style: z.string().describe(\'The target style for the rewritten text (e.g., Formal, Creative, Simple).\'),\n 607 })\n 608     .merge(BaseControlsSchema);\n 609 export type RewriteTextInput = z.infer<typeof RewriteTextInputSchema>;\n 610 \n 611 \n 612 export const RewriteTextOutputSchema = z.string().describe(\'The text rewritten in the specified style.\');\n 613 export type RewriteTextOutput = z.infer<typeof RewriteTextOutputSchema>;\n 614 \n 615 export const SummarizeTextWithRatioInputSchema = BaseTextInputSchema.extend({\n 616     ratio: z.number().min(10).max(90).describe(\'The desired compression ratio (10% - 90%). 10% is a very short summary, 90% is almost the original length.\'),\n 617 });\n 618 export type SummarizeTextWithRatioInput = z.infer<typeof SummarizeTextWithRatioInputSchema>;\n 619 \n 620 export const SummarizeTextWithRatioOutputSchema = z.string().describe(\'The generated summary of the original text.\');\n 621 export type SummarizeTextWithRatioOutput = z.infer<typeof SummarizeTextWithRatioOutputSchema>;\n 622 \n 623 // Style Editor\n 624 export const StyleEditorInputSchema = BaseTextInputSchema.extend({\n 625 })\n 626     .merge(BaseControlsSchema);\n 627 export type StyleEditorInput = z.infer<typeof StyleEditorInputSchema>;\n 628 \n 629 export const StyleEditorOutputSchema = z.object({\n 630     text: z.string().describe(\'The text with improved style, maintaining the original meaning.\'),\n 631     improvements: z.array(z.string()).optional().describe(\'A list of style improvements made to the text.\'),\n 632 });\n 633 export type StyleEditorOutput = z.infer<typeof StyleEditorOutputSchema>;\n 634 \n 635 // Readability Enhancer\n 636 export const ReadabilityEnhancerInputSchema = BaseTextInputSchema.extend({\n 637     targetLevel: TargetReadingLevelSchema.optional().describe(\'The target reading level.\'),\n 638 })\n 639     .merge(BaseControlsSchema);\n 640 export type ReadabilityEnhancerInput = z.infer<typeof ReadabilityEnhancerInputSchema>;\n 641 \n 642 export const ReadabilityEnhancerOutputSchema = z.object({\n 643     text: z.string().describe(\'The text enhanced for better readability.\'),\n 644     readabilityScore: z.number().min(0).max(100).optional().describe(\'A readability score (0-100) for the enhanced text.\'),\n 645     improvements: z.array(z.string()).optional().describe(\'A list of readability improvements made.\'),\n 646 });\n 647 export type ReadabilityEnhancerOutput = z.infer<typeof ReadabilityEnhancerOutputSchema>;\n 648 \n 649 // Conciseness Checker\n 650 export const ConcisenessCheckerInputSchema = BaseTextInputSchema.extend({\n 651     targetReduction: z\n 652         .number()\n 653         .min(0)\n 654         .max(50)\n 655         .optional()\n 656         .describe(\'Target percentage reduction in word count (0-50%).\'),\n 657 })\n 658     .merge(BaseControlsSchema);\n 659 export type ConcisenessCheckerInput = z.infer<typeof ConcisenessCheckerInputSchema>;\n 660 \n 661 export const ConcisenessCheckerOutputSchema = z.object({\n 662     text: z.string().describe(\'The text made more concise while preserving meaning.\'),\n 663     originalWordCount: z.number().optional().describe(\'The original word count.\'),\n 664     newWordCount: z.number().optional().describe(\'The new word count after making it concise.\'),\n 665     reductionPercentage: z.number().optional().describe(\'The percentage reduction in word count.\'),\n 666     improvements: z.array(z.string()).optional().describe(\'A list of conciseness improvements made.\'),\n 667 });\n 668 export type ConcisenessCheckerOutput = z.infer<typeof ConcisenessCheckerOutputSchema>;\n 669 \n 670 // Clarity Advisor\n 671 export const ClarityAdvisorInputSchema = BaseTextInputSchema.extend({\n 672     focusAreas: z\n 673         .array(z.string())\n 674         .optional()\n 675         .describe(\'Specific areas to focus on (e.g., "sentence structure", "word choice", "logical flow").\'),\n 676 })\n 677     .merge(BaseControlsSchema);\n 678 export type ClarityAdvisorInput = z.infer<typeof ClarityAdvisorInputSchema>;\n 679 \n 680 export const ClarityAdvisorOutputSchema = z.object({\n 681     text: z.string().describe(\'The text improved for clarity.\'),\n 682     clarityScore: z.number().min(0).max(100).optional().describe(\'A clarity score (0-100) for the improved text.\'),\n 683     suggestions: z.array(z.object({\n 684         issue: z.string().describe(\'The clarity issue identified.\'),\n 685         suggestion: z.string().describe(\'A suggestion for improvement.\'),\n 686         location: z.string().optional().describe(\'The location or context of the issue in the text.\'),\n 687     })).optional().describe(\'A list of clarity suggestions and improvements.\'),\n 688 });\n 689 export type ClarityAdvisorOutput = z.infer<typeof ClarityAdvisorOutputSchema>;\n 690 \n 691 \n 692 // topic-explainer.ts\n 693 export const TopicExplainerInputSchema = BaseTopicInputSchema.extend({\n 694 });\n 695 export type TopicExplainerInput = z.infer<typeof TopicExplainerInputSchema>;\n 696 \n 697 export const TopicExplainerOutputSchema = z.string().describe(\'A simple, easy-to-understand explanation of the topic, formatted as markdown.\');\n 698 export type TopicExplainerOutput = z.infer<typeof TopicExplainerOutputSchema>;\n 699 \n 700 // translate-text.ts\n 701 export const TranslateTextInputSchema = BaseTextInputSchema.extend({\n 702     targetLang: TargetLanaguage.describe(\'The target language (e.g., "English", "Arabic").\'),\n 703 })\n 704     .merge(BaseControlsSchema);\n 705 export type TranslateTextInput = z.infer<typeof TranslateTextInputSchema>;\n 706 \n 707 export const TranslateTextOutputSchema = z.string().describe(\'The resulting translated text, with original markdown formatting preserved.\');\n 708 export type TranslateTextOutput = z.infer<typeof TranslateTextOutputSchema>;\n 709 \n 710 \n 711 // write-document.ts\n 712 export const WriteDocumentInputSchema = z\n 713     .object({\n 714         topic: z.string().describe(\'The topic or title of the document to be written.\'),\n 715         documentType: z\n 716             .string()\n 717             .describe(\'The type of document to generate (e.g., "Blog Post", "Formal Report", "Essay", "Technical Article").\'),\n 718         knowledge: z\n 719             .string()\n 720             .optional()\n 721             .describe(\'Any specific knowledge, context, or instructions for the document.\'),\n 722         tableOfContents: z\n 723             .array(z.string())\n 724             .optional()\n 725             .describe("An optional list of headings to be used as the document\'s structure."),\n 726     })\n 727     .merge(BaseControlsSchema);\n 728 export type WriteDocumentInput = z.infer<typeof WriteDocumentInputSchema>;\n 729 \n 730 export const WriteDocumentOutputSchema = z.string().describe(\'The fully generated document content, formatted as markdown.\');\n 731 export type WriteDocumentOutput = z.infer<typeof WriteDocumentOutputSchema>;\n 732 \n 733 // evaluate-report.ts\n 734 export const EvaluateReportInputSchema = z.object({\n 735     reportSections: z.record(SectionNameSchema, z.string()).describe("A map of all generated report sections."),\n 736     diagrams: z.record(DiagramTypeSchema, z.string()).optional().describe("A map of all generated PlantUML diagrams.").nullable(),\n 737     acceptanceCriteria: z.array(z.string()).describe("A list of acceptance criteria to evaluate the report against.").nullable().optional(),\n 738 });\n 739 export type EvaluateReportInput = z.infer<typeof EvaluateReportInputSchema>;\n 740 \n 741 export const FeedbackItemSchema = z.object({\n 742     point: z.string().describe("A specific feedback point related to one of the acceptance criteria."),\n 743     status: FeedbackStatusSchema.describe("The status of the report regarding this feedback point."),\n 744     sectionKey: SectionNameSchema.optional().describe("The specific section key (e.g., \'introduction\', \'systemDesign\') this feedback point applies to. This is crucial for applying automated fixes."),\n 745     solution: z.string().optional().describe("A suggested prompt for an AI agent to fix the issue if status is \'Weak\' or \'Not Present\'. This prompt should be a clear, actionable command."),\n 746 });\n 747 \n 748 export const AIContentAnalysisSchema = z.object({\n 749     sectionName: z.string(),\n 750     aiContentScore: z.number().min(0).max(100),\n 751     analysis: z.string(),\n 752 });\n 753 \n 754 export const EvaluateReportOutputSchema = z.object({\n 755     evaluationScore: z.number().min(0).max(100).describe("A numerical score from 0 to 100 representing the report\'s quality against the criteria."),\n 756     feedback: z.array(FeedbackItemSchema).describe("A list of specific feedback points, including praise for met criteria and suggestions for areas of improvement, each with a status."),\n 757     summary: z.string().describe("A concise summary of the overall evaluation."),\n 758     aiContentAnalysis: z.array(AIContentAnalysisSchema).optional().describe("An analysis of each section for AI-generated content probability."),\n 759 });\n 760 export type EvaluateReportOutput = z.infer<typeof EvaluateReportOutputSchema>;\n 761 \n 762 // generate-toc.ts\n 763 export const GenerateTocInputSchema = z.object({\n 764     projectDescription: z.string().min(10, \'Project idea must be at least 10 characters.\'),\n 765     additionalInstructions: z.string().optional(),\n 766 });\n 767 export type GenerateTocInput = z.infer<typeof GenerateTocInputSchema>;\n 768 \n 769 const TocSectionSchema = z.object({\n 770     title: z.string(),\n 771     sections: z.array(z.string()),\n 772 });\n 773 \n 774 export const GenerateTocOutputSchema = z.object({\n 775     tableOfContents: z.array(TocSectionSchema).describe(\'A list of suggested chapters, each with a title and a list of section titles.\'),\n 776 });\n 777 export type GenerateTocOutput = z.infer<typeof GenerateTocOutputSchema>;\n 778 \n 779 \n 780 // generate-ui-description.ts\n 781 export const GenerateUIDescriptionInputSchema = z.object({\n 782     projectFeatures: z.string().min(20, \'Please provide more details about the project features.\'),\n 783     designType: DesignTypeSchema,\n 784 });\n 785 export type GenerateUIDescriptionInput = z.infer<typeof GenerateUIDescriptionInputSchema>;\n 786 \n 787 \n 788 export const GenerateUIDescriptionOutputSchema = z.object({\n 789     text: z.string().describe(\'The generated UI/UX workflow description in markdown format.\'),\n 790 });\n 791 export 
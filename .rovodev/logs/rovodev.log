ated\', description: \'Your project state has been saved.\' });\\n  31         },\\n  32         onError: (error: any) => {\\n  33             toast({ title: \'Snapshot Failed\', description: error.message, variant: \'destructive\' });\\n  34         }\\n  35     });\\n  36 \\n  37     const deleteSnapshotMutation = useMutation({\\n  38         mutationFn: async (snapshotId: string) => {\\n  39             const result = await apiClient.deleteSnapshot(snapshotId);\\n  40             if (result.isSuccess) return result.getValue();\\n  41             throw result.error;\\n  42         },\\n  43         onSuccess: () => {\\n  44             queryClient.invalidateQueries({ queryKey: [\'projects\', projectId, \'snapshots\'] });\\n  45             toast({ title: \'Snapshot Deleted\', description: \'The snapshot has been removed.\' });\\n  46         },\\n  47         onError: (error: any) => {\\n  48             toast({ title: \'Delete Failed\', description: error.message, variant: \'destructive\' });\\n  49         }\\n  50     });\\n  51 \\n  52     return {\\n  53         snapshots: snapshotsQuery.data || [],\\n  54         isLoading: snapshotsQuery.isLoading,\\n  55         createSnapshot: createSnapshotMutation.mutate,\\n  56         isCreating: createSnapshotMutation.isPending,\\n  57         deleteSnapshot: deleteSnapshotMutation.mutate,\\n  58         isDeleting: deleteSnapshotMutation.isPending,\\n  59     };\\n  60 }\\n  61 \\n````"]'}

     }\n  37     }\n  38 \n  39     // \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  40     // Core HTTP bridge to n8n\n  41     // \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  42 \n  43     private async callN8n<T>(payload: Record<string, unknown>): Promise<Result<T, AiError>> {\n  44         const startTime = performance.now();\n  45         const action = String(payload.action || 'unknown');\n  46         \n  47         try {\n  48             const controller = new AbortController();\n  49             const timeout = setTimeout(() => controller.abort(), this.timeoutMs);\n  50 \n  51             const response = await fetch(this.webhookUrl, {\n  52                 method: 'POST',\n  53                 headers: { 'Content-Type': 'application/json' },\n  54                 body: JSON.stringify(payload),\n  55                 signal: controller.signal,\n  56             });\n  57 \n  58             clearTimeout(timeout);\n  59 \n  60             const duration = (performance.now() - startTime).toFixed(2);\n  61 \n  62             if (!response.ok) {\n  63                 const text = await response.text();\n  64                 console.error(`[N8nAiService] ${action} failed (${duration}ms): ${response.status}`);\n  65                 return Result.fail(AiError.generationFailed(`n8n responded with ${response.status}: ${text}`));\n  66             }\n  67 \n  68             const data = await response.json() as Record<string, unknown>;\n  69 \n  70             if (data.success === false) {\n  71                 console.error(`[N8nAiService] ${action} business error (${duration}ms): ${data.error}`);\n  72                 return Result.fail(AiError.generationFailed(String(data.error || 'n8n returned an unsuccessful response')));\n  73             }\n  74 \n  75             console.log(`[N8nAiService] ${action} success (${duration}ms)`);\n  76             return Result.ok(data as T);\n  77         } catch (error: unknown) {\n  78             const duration = (performance.now() - startTime).toFixed(2);\n  79             const message = error instanceof Error ? error.message : String(error);\n  80             \n  81             console.error(`[N8nAiService] ${action} system error (${duration}ms): ${message}`);\n  82 \n  83             if (message.includes('abort') || message.includes('timeout')) {\n  84                 return Result.fail(AiError.generationFailed('n8n request timed out after 2 minutes'));\n  85             }\n  86             return Result.fail(AiError.generationFailed(message));\n  87         }\n  88     }\n  89 \n  90     // \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  91     // IAiService implementation\n  92     // \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  93 \n  94     /**\n  95      * Sends a text generation request to the n8n Arkan AI Agent.\n  96      */\n  97     async generateText(prompt: string, options?: unknown): Promise<Result<string, AiError>> {\n  98         const result = await this.callN8n<{ text: string }>({\n  99             action: 'generateText',\n 100             prompt,\n 101             options,\n 102         });\n 103 \n 104         if (!result.isSuccess) return Result.fail(result.error!);\n 105         const text = result.getValue()?.text;\n 106         if (typeof text !== 'string') {\n 107             return Result.fail(AiError.generationFailed('n8n response missing \"text\" field'));\n 108         }\n 109         return Result.ok(this.cleanAiOutput(text));\n 110     }\n 111 \n 112     /**\n 113      * Maps specific flowNames to n8n specialized agents.\n 114      * When a flow is listed here, it will be executed via n8n instead of locally.\n 115      * This allows gradual migration of specific flows to n8n agents.\n 116      */\n 117     private readonly N8N_FLOW_MAP: Record<string, string> = {\n 118         // Writing Tools\n 119         'summarize': 'summarize',\n 120         'summarizer': 'summarize',\n 121         'grammar-checker': 'grammarCheck',\n 122         'paraphrase': 'paraphrase',\n 123         'paraphraser': 'paraphrase',\n 124         'humanize': 'humanize',\n 125         'translator': 'translate',\n 126         'translate-text': 'translate',\n 127         'write-document': 'writeDocument',\n 128         'manipulate-text': 'manipulateText',\n 129         'text-stylist': 'textStyleTune',\n 130         \n 131         // Analysis Tools\n 132         'ai-detector': 'detectAi',\n 133         'bias-checker': 'biasCheck',\n 134         'fact-checker': 'factCheck',\n 135         'plagiarism-checker': 'plagiarismCheck',\n 136         'sentence-structure-checker': 'sentenceStructureCheck',\n 137         \n 138         // Academic Tools\n 139         'ai-researcher': 'aiResearch',\n 140         'lecture-generator': 'generateLecture',\n 141         'generate-citation': 'generateCitation',\n 142         'literature-review-generator': 'generateLitReview',\n 143         'generate-quiz': 'quiz',\n 144         'solve-assignments': 'solveAssignments',\n 145         'theoretical-lecture': 'generateTheoreticalLecture',\n 146         \n 147         // Generation Tools\n 148         'generate-ideas': 'generateIdeas',\n 149         'generate-toc': 'generateTOC',\n 150         'generate-ui-description': 'generateUIDescription',\n 151         'generate-session-plan': 'generateSessionPlan',\n 152         'generate-project-blueprint': 'generateProjectBlueprint',\n 153         'topic-explainer': 'explainTopic',\n 154         'image-to-text': 'imageToText',\n 155         'generate-plant-uml': 'generatePlantUML',\n 156         'question-answering': 'questionAnswering',\n 157         'fact-retrieval': 'factRetrieval',\n 158 \n 159         // Document Level Specialized Agents (Used directly via flowName)\n 160         'proofreadDocument': 'proofreadDocument',\n 161         'analyzeContext': 'analyzeContext',\n 162         'checkPaperQuality': 'checkPaperQuality',\n 163         'improveMarkdown': 'improveMarkdown',\n 164         'generateProjectDoc': 'generateProjectDoc',\n 165         'rewriteToMarkdown': 'rewriteToMarkdown',\n 166         'writeTechSpec': 'writeTechSpec',\n 167         'createPresentation': 'createPresentation'\n 168     };\n 169 \n 170     /**\n 171      * HYBRID: \n 172      * - If the flowName is in N8N_FLOW_MAP \u2192 delegates to the n8n specialized agent.\n 173      * - Otherwise \u2192 executes the Genkit flow function DIRECTLY on the server.\n 174      * This preserves all 40+ existing flow functions without rewriting them.\n 175      */\n 176     async runFlow<TInput, TOutput>(\n 177         flow: (input: TInput) => Promise<TOutput>,\n 178         input: TInput,\n 179         flowName?: string\n 180     ): Promise<Result<TOutput, AiError>> {\n 181         // Check if this flow has an n8n specialized agent\n 182         if (flowName && this.N8N_FLOW_MAP[flowName]) {\n 183             console.log(`[N8nAiService] Routing flow \"${flowName}\" to n8n specialized agent`);\n 184             const result = await this.callN8n<{ text: unknown }>({\n 185                 action: 'generateText',\n 186                 flowName: this.N8N_FLOW_MAP[flowName],\n 187                 prompt: typeof input === 'object' ? JSON.stringify(input) : String(input),\n 188                 input,\n 189             });\n 190 \n 191             if (!result.isSuccess) return Result.fail(result.error!);\n 192             const text = result.getValue()?.text;\n 193             if (typeof text === 'string') {\n 194                 return Result.ok(this.cleanAiOutput(text) as unknown as TOutput);\n 195             }\n 196             return Result.ok(text as TOutput);\n 197         }\n 198 \n 199         // Default: execute locally\n 200         try {\n 201             console.log(`[N8nAiService] Running flow locally: ${flowName || 'unnamed'}`);\n 202             const result = await flow(input);\n 203 \n 204             // Post-process string outputs to remove conversational filler\n 205             if (result && typeof result === 'object') {\n 206                 const processed = result as Record<string, unknown>;\n 207                 for (const key in processed) {\n 208                     if (typeof processed[key] === 'string') {\n 209                         processed[key] = this.cleanAiOutput(processed[key] as string);\n 210                     }\n 211                 }\n 212                 return Result.ok(processed as TOutput);\n 213             } else if (typeof result === 'string') {\n 214                 return Result.ok(this.cleanAiOutput(result) as unknown as TOutput);\n 215             }\n 216 \n 217             return Result.ok(result as TOutput);\n 218         } catch (error: unknown) {\n 219             const message = error instanceof Error ? error.message : String(error);\n 220             console.warn(`[N8nAiService] Local flow execution failed for \"${flowName || 'unnamed'}\": ${message}`);\n 221             return Result.fail(AiError.generationFailed(message));\n 222         }\n 223     }\n 224 \n 225     /**\n 226      * Retrieves relevant context from the knowledge base via n8n \u2192 Qdrant.\n 227      */\n 228     async retrieveContext(query: string, options?: RetrievalOptions): Promise<Result<RetrievalResult, AiError>> {\n 229         const result = await this.callN8n<RetrievalResult>({\n 230             action: 'retrieveContext',\n 231             prompt: query,\n 232             options,\n 233         });\n 234 \n 235         if (!result.isSuccess) return Result.fail(result.error!);\n 236         return Result.ok(result.getValue()!);\n 237     }\n 238 \n 239     /**\n 240      * Generates chapter content using the n8n Chapter RAG Agent.\n 241      * The full structured input is forwarded to n8n.\n 242      */\n 243     async generateChapterWithRAG(input: unknown): Promise<Result<unknown, AiError>> {\n 244         const result = await this.callN8n<{ text: unknown }>({\n 245             action: 'generateChapterWithRAG',\n 246             flowName: 'generateChapterWithRAG',\n 247             input,\n 248         });\n 249 \n 250         if (!result.isSuccess) return Result.fail(result.error!);\n 251         return Result.ok(result.getValue()?.text ?? result.getValue());\n 252     }\n 253 \n 254     /**\n 255      * Generates a report section using the n8n Section RAG Agent.\n 256      * The full structured input is forwarded to n8n.\n 257      */\n 258     async generateSectionWithRAG(input: unknown): Promise<Result<unknown, AiError>> {\n 259         const result = await this.callN8n<{ text: unknown }>({\n 260             action: 'generateSectionWithRAG',\n 261             flowName: 'generateSectionWithRAG',\n 262             input,\n 263         });\n 264 \n 265         if (!result.isSuccess) return Result.fail(result.error!);\n 266         return Result.ok(result.getValue()?.text ?? result.getValue());\n 267     }\n 268 \n 269     // \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n 270     // Output sanitization (mirrors GenkitAiService)\n 271     // \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n 272 \n 273     private cleanAiOutput(text: string): string {\n 274         if (!text) return text;\n 275 \n 276         const patterns = [\n 277             /^Sure,? (here is|here's) the [^:]+:?\\s*/i,\n 278             /^Sure,? here (is|'s) [^:]+:?\\s*/i,\n 279             /^Certainly!? [^:]+:?\\s*/i,\n 280             /^As requested,? [^:]+:?\\s*/i,\n 281             /^I have [^:]+ below:?\\s*/i,\n 282             /^The following is [^:]+:?\\s*/i,\n 283             /^Ok,? (here is|here's) [^:]+:?\\s*/i,\n 284             /^Below is the [^:]+:?\\s*/i,\n 285             /^Sure,? I can [^:]+:?\\s*/i,\n 286         ];\n 287 \n 288         let cleaned = text.trim();\n 289         for (let i = 0; i < 2; i++) {\n 290             for (const pattern of patterns) {\n 291                 cleaned = cleaned.replace(pattern, '');\n 292             }\n 293             cleaned = cleaned.trim();\n 294         }\n 295         return cleaned;\n 296     }\n 297 }\n 298 \n````", "tool_call_id": "pyd_ai_2898057e80fe464a82a6707bd058a5b3", "metadata": null, "timestamp": "2026-04-07T04:56:31.088431+00:00", "part_kind": "tool-return"}

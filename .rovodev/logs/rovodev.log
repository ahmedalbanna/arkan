iagramTool({\\n  91                 projectPath,\\n  92                 diagramType: presentationType === \'technical_review\' ? \'component\' : \'flowchart\',\\n  93                 includeDetails: presentationType === \'technical_review\',\\n  94                 style: presentationType === \'pitch\' ? \'simple\' : \'detailed\',\\n  95             });\\n  96         }\\n  97 \\n  98         // Step 5: Generate presentation content\\n  99         console.log(\'🎨 Step 5/5: Generating presentation content...\');\\n 100 \\n 101         const presentationPromptResult = await presentationContentPrompt({\\n 102             projectName,\\n 103             presentationType: presentationType as \\"demo\\" | \\"pitch\\" | \\"technical_review\\" | \\"status_update\\" | \\"training\\",\\n 104             duration,\\n 105             audience,\\n 106             keyPoints,\\n 107         });\\n 108 \\n 109         // Enhance with project-specific data\\n 110         const enhancedPresentation = await ai.generate({\\n 111             model: \'ollama/phi4-mini:latest\',\\n 112             prompt: `Create detailed presentation slides for a ${presentationType} presentation.\\n 113 \\n 114 Project: ${projectName}\\n 115 Description: ${projectDescription}\\n 116 Duration: ${duration} minutes\\n 117 Audience: ${audience}\\n 118 \\n 119 Base Structure:\\n 120 ${presentationPromptResult.text}\\n 121 \\n 122 Project Details:\\n 123 - Project Type: ${projectStructure.projectType}\\n 124 - Total Files: ${projectStructure.totalFiles}\\n 125 - Main Components: ${projectStructure.mainDirectories.length}\\n 126 - Tech Stack: ${Object.keys(dependencies.categories).flatMap((cat: any) => (dependencies.categories as any)[cat]).slice(0, 8).join(\', \')}\\n 127 \\n 128 ${metrics ? `\\n 129 Metrics to Highlight:\\n 130 - Lines of Code: ${metrics.code.linesOfCode.toLocaleString()}\\n 131 - Active Contributors: ${metrics.general.activeContributors}\\n 132 - Project Age: ${metrics.general.projectAge}\\n 
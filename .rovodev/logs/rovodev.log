             options={citationStyleOptions}\n 224                                 placeholder=\"Citation...\"\n 225                                 className=\"h-10 text-[11px] bg-muted/5 border-primary/10 focus:ring-primary/20 rounded-xl\"\n 226                             />\n 227                             </FormControl>\n 228                             <FormMessage />\n 229                         </FormItem>\n 230                         )}\n 231                     />\n 232                   </div>\n 233                   \n 234                   <FormField\n 235                       control={form.control}\n 236                       name=\"university\"\n 237                       render={({ field }) => (\n 238                           <FormItem className=\"space-y-1.5\">\n 239                               <FormLabel className=\"text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60\">Institution</FormLabel>\n 240                               <FormControl>\n 241                                   <CustomSelect\n 242                                       value={field.value || ''}\n 243                                       onChange={(value: string) => {\n 244                                           field.onChange(value);\n 245                                           handleBlur();\n 246                                       }}\n 247                                       options={universityOptions}\n 248                                       placeholder=\"Map institution...\"\n 249                                       className=\"h-10 text-[11px] bg-muted/5 border-primary/10 focus:ring-primary/20 rounded-xl\"\n 250                                   />\n 251                               </FormControl>\n 252                               <FormMessage />\n 253                           </FormItem>\n 254                       )}\n 255                   />\n 256                 </div>\n 257               </div>\n 258             </div>\n
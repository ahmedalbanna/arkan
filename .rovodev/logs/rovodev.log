. Type Safety: Validates rewrite styles and handles missing action hooks gracefully.\\n  19  * 4. UX Integrity: Disables all inputs during processing and provides visual feedback.\\n  20  */\\n  21 \\n  22 interface SelectionGenerationHUDProps {\\n  23     viewMode: \'edit\' | \'preview\';\\n  24     className?: string;\\n  25 }\\n  26 \\n  27 const SelectionGenerationHUDComponent = ({ viewMode, className }: SelectionGenerationHUDProps) => {\\n  28     // 1. STATE RESOLUTION\\n  29     const selection = useEditorStore((state) => state.selection);\\n  30     const { isProcessing, handleAiAction, rewriteStyles = [] } = useAiActions();\\n  31 \\n  32     // 2. STABLE HANDLERS (with defensive checks)\\n  33     const handleSummarize = useCallback(() => {\\n  34         if (!selection.hasSelection || !handleAiAction) return;\\n  35         handleAiAction(\'summarize\');\\n  36     }, [handleAiAction, selection.hasSelection]);\\n  37 \\n  38     const handleExpand = useCallback(() => {\\n  39         if (!selection.hasSelection || !handleAiAction) return;\\n  40         handleAiAction(\'expand\');\\n  41     }, [handleAiAction, selection.hasSelection]);\\n  42 \\n  43     const handleGrammar = useCallback(() => {\\n  44         if (!selection.hasSelection || !handleAiAction) return;\\n  45         handleAiAction(\'grammar\');\\n  46     }, [handleAiAction, selection.hasSelection]);\\n  47 \\n  48     const handleRewrite = useCallback((style: string) => {\\n  49         if (!selection.hasSelection || !handleAiAction) return;\\n  50         handleAiAction(\'rewrite\', { style });\\n  51     }, [handleAiAction, selection.hasSelection]);\\n  52 \\n  53     // 3. RENDER GUARDS\\n  54     if (viewMode !== \'edit\' || !selection.hasSelection) return null;\\n  55 \\n  56     return (\\n  57         <div\\n  58             className={cn(\\n  59                 \'absolute right-6 top-6 z-40 w-[280px] rounded-2xl border border-border/40 bg-background/80 backdrop-blur-2xl shadow-[0_1
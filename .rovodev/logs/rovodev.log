n  // Extract userId from meta.author (needs to be numeric for FK)\n  const userId = projectData.meta?.author \n    ? parseInt(projectData.meta.author, 10)\n    : null;\n\n  if (!userId) {\n    throw new Error('Project must have a valid userId (meta.author)');\n  }\n\n  // Convert content to string if it's an array\n  const contentStr = typeof projectData.content === 'string' \n    ? projectData.content \n    : Array.isArray(projectData.content)\n    ? JSON.stringify(projectData.content)\n    : null;\n\n  const projectData_normalized = {\n    userId,\n    title: projectData.name || 'Untitled Project',\n    description: projectData.description || null,\n    content: contentStr,\n    status: 'draft',\n    language: 'en',\n    templateId: null,\n    lastModifiedBy: userId,\n    metadata: {\n      ...projectData.meta,\n      updated: now,\n    },\n  };\n\n  if (projectData.id) {\n    // Update existing project\n    const projectId = parseInt(projectData.id as any, 10);\n    await db\n      .update(projects)\n      .set({\n        userId: projectData_normalized.userId,\n        title: projectData_normalized.title,\n        description: projectData_normalized.description,\n        content: projectData_normalized.content,\n        status: projectData_normalized.status,\n        language: projectData_normalized.language,\n        templateId: projectData_normalized.templateId,\n        lastModifiedBy: projectData_normalized.lastModifiedBy,\n        metadata: projectData_normalized.metadata,\n        updatedAt: new Date(now),\n      })\n      .where(eq(projects.id, projectId));\n\n    return {\n      ...projectData,\n      meta: {\n        ...projectData.meta,\n        updated: now,\n      },\n    };\n  } else {\n    // Create new project\n    const result = await db\n      .insert(projects)\n      .values({\n        userId: projectData_normalized.userId,\n        title: projectData_normalized.title,\n        description: projectData_normalized.description,\n        content: projectData_normalized.content,\n        status: projectData_normalized.status,\n        language: projectData_normalized.language,\n        templateId: projectData_normalized.templateId,\n        lastModifiedBy: projectData_normalized.lastModifiedBy,\n        metadata: projectData_normalized.metadata,\n        createdAt: new Date(now),\n        updatedAt: new Date(now),\n      })\n      .returning();\n\n    return {\n      ...projectData,\n      id: result[0]?.id?.toString(),\n      meta: {\n        ...projectData.meta,\n        updated: now,\n      },\n    };\n  }\n}\n\n/**\n * Fetches all projects for a given user.\n * @param userId The ID of the user whose projects to fetch.\n * @returns An array of project properties.\n */\nexport async function getProjects(userId: string): Promise<ProjectProperties[]> {\n  const numUserId = parseInt(userId, 10);\n  \n  const result = await db\n    .select()\n    .from(projects)\n    .where(eq(projects.userId, numUserId))\n    .orderBy(desc(projects.updatedAt));\n\n  return result.map(proj => ({\n    id: proj.id?.toString(),\n    name: proj.title,\n    description: proj.description || undefined,\n    content: proj.content || undefined,\n    meta: {\n      author: proj.userId?.toString(),\n      updated: proj.updatedAt?.toISOString(),\n      ...(proj.metadata || {}),\n    },\n  } as ProjectProperties));\n}\n\n/**\n * Fetches a single project by its ID.\n * @param projectId The ID of the project to fetch.\n * @returns The project properties or null if not found.\n */\nexport async function getProject(projectId: string): Promise<ProjectProperties | null> {\n  const numProjectId = parseInt(projectId, 10);\n  \n  const result = await db\n    .select()\n    .from(projects)\n    .where(eq(projects.id, numProjectId))\n    .limit(1);\n\n  if (result.length === 0) {\n    return null;\n  }\n\n  const proj = result[0];\n  return {\n    id: proj.id?.toString(),\n    name: proj.title,\n    description: proj.description || undefined,\n    content: proj.content || undefined,\n    meta: {\n      author: proj.userId?.toString(),\n      updated: proj.updatedAt?.toISOString(),\n      ...(proj.metadata || {}),\n    },\n  } as ProjectProperties;\n}\n\n/**\n * Deletes a project from PostgreSQL.\n * @param projectId The ID of the project to delete.\n */\nexport async function deleteProject(projectId: string): Promise<void> {\n  const numProjectId = parseInt(projectId, 10);\n  await db\n    .delete(projects)\n    .where(eq(projects.id, numProjectId));\n}\n", 'tool_response': "Successfully replaced code in src/services/projectService.ts:\n\n--- src/services/projectService.ts\n+++ src/services/projectService.ts\n@@ -115,17 +115,20 @@\n     .where(eq(projects.userId, numUserId))\n     .orderBy(desc(projects.updatedAt));\n \n-  return result.map(proj => ({\n-    id: proj.id?.toString(),\n-    name: proj.title,\n-    description: proj.description || undefined,\n-    content: proj.content || undefined,\n-    meta: {\n-      author: proj.userId?.toString(),\n-      updated: proj.updatedAt?.toISOString(),\n-      ...(proj.metadata || {}),\n-    },\n-  } as ProjectProperties));\n+  return result.map(proj => {\n+    const metadata = proj.metadata || {};\n+    return {\n+      id: proj.id?.toString(),\n+      name: proj.title,\n+      description: proj.description || undefined,\n+      content: proj.content || undefined,\n+      meta: {\n+        author: proj.userId?.toString(),\n+        updated: proj.updatedAt?.toISOString(),\n+        ...((typeof metadata === 'object' && metadata !== null) ? metadata : {}),\n+      },\n+    } as any as ProjectProperties;\n+  });\n }\n \n /**\n"}

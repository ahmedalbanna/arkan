us-visible:ring-primary/20 rounded-2xl shadow-inner transition-all resize-none p-4 leading-relaxed font-serif italic\" \n 124                           placeholder=\"Describe the intellectual scope of this manifest...\"\n 125                         />\n 126                       </FormControl>\n 127                       <FormMessage className=\"text-[10px]\" />\n 128                     </FormItem>\n 129                   )} \n 130                 />\n 131               </div>\n 132 \n 133               <div className=\"space-y-5\">\n 134                 <div className=\"flex items-center gap-3 group/header\">\n 135                     <div className=\"h-4 w-1 bg-primary/40 rounded-full group-hover:h-6 transition-all duration-300\" />\n 136                     <span className=\"text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/80\">Academic Matrix</span>\n 137                 </div>\n 138 \n 139                 <div className=\"grid gap-5\">\n 140                   <FormField\n 141                     control={form.control}\n 142                     name=\"projectType\"\n 143                     render={({ field }) => (\n 144                       <FormItem className=\"space-y-1.5\">\n 145                         <FormLabel className=\"text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60\">Document Vector</FormLabel>\n 146                         <FormControl>\n 147                           <CustomSelect\n 148                             value={field.value || ''}\n 149                             onChange={(value: string) => {\n 150                               field.onChange(value);\n 151                               handleBlur();\n 152                             }}\n 153                             options={documentTypeOptions}\n 154                             placeholder=\"Select classification...\"\n 155                             className=\"h-10 text-[11px] bg-muted/5 border-primary/10 focus:ring-primary/20 rounded-xl\"\n 156                           />\n 157                         </FormControl>\n 158                         <FormMessage />\n 159                       </FormItem>\n 160                     )}\n 161                   />\n 162 \n 163                   <FormField\n 164                       control={form.control}\n 165                       name=\"specialization\"\n 166                       render={({ field }) => (\n 167                           <FormItem className=\"space-y-1.5\">\n 168                               <FormLabel className=\"text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60\">Intellectual Field</FormLabel>\n 169                               <FormControl>\n 170                                   <CustomSelect\n 171                                       value={field.value || ''}\n 172                                       onChange={(value: string) => {\n 173                                           field.onChange(value);\n 174                                           handleBlur();\n 175                                       }}\n 176                                       options={specializationOptions}\n 177                                       placeholder=\"Select specialization...\"\n 178                                       className=\"h-10 text-[11px] bg-muted/5 border-primary/10 focus:ring-primary/20 rounded-xl\"\n 179                                   />\n 180                               </FormControl>\n 181                               <FormMessage />\n 182                           </FormItem>\n 183                       )}\n 184                   />\n 185 \n 186                   <div className=\"grid grid-cols-2 gap-4\">\n 187                     <FormField\n 188                         control={form.control}\n 189                         name=\"educationalLevel\"\n 190                         render={({ field }) => (\n 191                             <FormItem className=\"space-y-1.5\">\n 192      
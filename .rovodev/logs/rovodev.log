rstError = error.errors[0];\\n  81       throw new ProjectValidationError(\\n  82         `Project validation failed: ${firstError?.message || \'Invalid data\'}`,\\n  83         firstError?.path.join(\'.\'),\\n  84         error\\n  85       );\\n  86     }\\n  87     throw error;\\n  88   }\\n  89 }\\n  90 \\n  91 /**\\n  92  * Checks for duplicate IDs in content\\n  93  *\\n  94  * @param content - Array of chapters/sections with IDs\\n  95  * @returns Array of duplicate IDs found\\n  96  */\\n  97 export function findDuplicateIds(content: Array<{ id: string; sections?: Array<{ id: string }> }>): string[] {\\n  98   const ids = new Set<string>();\\n  99   const duplicates = new Set<string>();\\n 100 \\n 101   content.forEach(item => {\\n 102     if (ids.has(item.id)) {\\n 103       duplicates.add(item.id);\\n 104     }\\n 105     ids.add(item.id);\\n 106 \\n 107     // Check nested sections\\n 108     if (item.sections) {\\n 109       item.sections.forEach(section => {\\n 110         if (ids.has(section.id)) {\\n 111           duplicates.add(section.id);\\n 112         }\\n 113         ids.add(section.id);\\n 114       });\\n 115     }\\n 116   });\\n 117 \\n 118   return Array.from(duplicates);\\n 119 }\\n 120 \\n 121 /**\\n 122  * Validates that all IDs in project content are unique\\n 123  *\\n 124  * @param content - Project content to check\\n 125  * @throws {ProjectValidationError} If duplicate IDs found\\n 126  */\\n 127 export function validateUniqueIds(content: Array<{ id: string; sections?: Array<{ id: string }> }>): void {\\n 128   const duplicates = findDuplicateIds(content);\\n 129 \\n 130   if (duplicates.length > 0) {\\n 131     throw new ProjectValidationError(\\n 132       `Duplicate IDs found in project content: ${duplicates.join(\', \')}`,\\n 133       \'content\'\\n 134     );\\n 135   }\\n 136 }\\n 137 \\n 138 /**\\n 139  * Validates external context references\\n 140  *\\n 141  * @param sectionContext - Section context referencing external files\\n 142  * @param availableContextIds - IDs of available external context\\n 143  * @returns Array of invalid/missing context IDs\\n 144  */\\n 145 export function validateExternalContextReferences(\\n 146   sectionContext: Record<string, any>,\\n 147   availableContextIds: string[]\\n 148 ): string[] {\\n 149   const contextIds = Object.keys(sectionContext);\\n 150   const availableSet = new Set(availableContextIds);\\n 151 \\n 152   return contextIds.filter(id => !availableSet.has(id));\\n 153 }\\n 154 \\n 155 /**\\n 156  * Validates section references in context\\n 157  *\\n 158  * @param sectionContext - Section context referencing other sections\\n 159  * @param availableSectionIds - IDs of available sections\\n 160  * @returns Array of invalid/missing section IDs\\n 161  */\\n 162 export function validateSectionReferences(\\n 163   sectionContext: Record<string, any>,\\n 164   availableSectionIds: string[]\\n 165 ): string[] {\\n 166   const contextIds = Object.keys(sectionContext);\\n 167   const availableSet = new Set(availableSectionIds);\\n 168 \\n 169   return contextIds.filter(id => !availableSet.has(id));\\n 170 }\\n 171 \\n 172 /**\\n 173  * Partial validation for updates (allows partial data)\\n 174  */\\n 175 export const PartialProjectPropertiesSchema = ProjectPropertiesSchema.partial();\\n 176 \\n 177 /**\\n 178  * Validates partial project updates\\n 179  */\\n 180 export function validatePartialProjectProperties(\\n 181   props: unknown\\n 182 ): Partial<z.infer<typeof ProjectPropertiesSchema>> {\\n 183   try {\\n 184     return PartialProjectPropertiesSchema.parse(props);\\n 185   } catch (error) {\\n 186     if (error instanceof z.ZodError) {\\n 187       const firstError = error.errors[0];\\n 188       throw new ProjectValidationError(\\n 189         `Project update validation failed: ${firstError?.message || \'Invalid data\'}`,\\n 190         firstError?.path.join(\'.\'),\\n 191         error\\n 192       );\\n 193     }\\n 194     throw e
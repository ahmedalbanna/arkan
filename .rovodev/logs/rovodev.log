vate generationLogRepository: IGenerationLogRepository,\\n  26         @inject(DeductCreditsUseCase) private deductCreditsUseCase: DeductCreditsUseCase,\\n  27         @inject(WritingToolRegistry)\\n  28         private writingToolRegistry: WritingToolRegistry\\n  29     ) {}\\n  30 \\n  31     async execute<TInput, TOutput>(params: RunAiToolInput<TInput>): Promise<Result<TOutput, AiError>> {\\n  32         const { userId, toolName, input, ip } = params;\\n  33 \\n  34         const config = this.writingToolRegistry.getTool(toolName);\\n  35         if (!config) {\\n  36             return Result.fail(AiError.notFound(`Tool ${toolName} not found in registry.`));\\n  37         }\\n  38 \\n  39         const { flow, creditCost, isFreeForGuests } = config;\\n  40 \\n  41         // 1. Handle guest access\\n  42         const isGuest = userId === \'guest\';\\n  43         if (isGuest) {\\n  44             if (!isFreeForGuests) {\\n  45                 return Result.fail(AiError.unauthorized(`The ${toolName} tool requires a registered account.`));\\n  46             }\\n  47 \\n  48             // Apply daily limit for guests (5 requests per 24h)\\n  49             const limiterResult = await rateLimiter.check(\'guest-writing-tools\', ip || \'unknown\', 5, 24 * 60 * 60 * 1000);\\n  50             if (!limiterResult.allowed) {\\n  51                 return Result.fail(AiError.unauthorized(\\"Guest daily limit exceeded (5 requests/day). Please sign up for unlimited access.\\"));\\n  52             }\\n  53         }\\n  54 \\n  55         // 2. Pre-deduct credits or check free tier for registered users\\n  56         let creditsDeducted = false;\\n  57         let isFreeTierRegistered = false;\\n  58 \\n  59         if (!isGuest && creditCost > 0) {\\n  60             const deductResult = await this.deductCreditsUseCase.execute(userId, creditCost);\\n  61             \\n  62             if (deductResult.isFailure) {\\n  63                 // Check if they can use the free registered tier (10 generations/day)\\n  64                 if (isFreeForGuests) {\\n  65                     const limiterResult = await rateLimiter.check(\'registered-free-tier\', userId, 10, 24 * 60 * 60 * 1000);\\n  66                     if (!limiterResult.allowed) {\\n  67                         return Result.fail(AiError.unauthorized(\\"Daily free tier limit exceeded (10 generations/day). Please top up your credits.\\"));\\n  68                     }\\n  69                     isFreeTierRegistered = true;\\n  70                 } else {\\n  71                     return Result.fail(AiError.internal(`Insufficient credits and tool is not free tier compatible.`));\\n  72                 }\\n  73             } else {\\n  74                 creditsDeducted = true;\\n  75             }\\n  76         }\\n  77 \\n  78         // 3. Run the AI Flow\\n  79         try {\\n  80             const aiResult = await this.aiService.runFlow<TInput, TOutput>(flow, input, toolName);\\n  81             \\n  82             if (aiResult.isFailure) {\\n  83                 // Refund credits if AI flow fails\\n  84                 if (creditsDeducted) {\\n  85                     await this.deductCreditsUseCase.execute(userId, -creditCost);\\n  86                 }\\n  87                 return aiResult;\\n  88             }\\n  89 \\n  90             const result = aiResult.getValue();\\n  91 \\n  92             // 4. Log the generation\\n  93             await this.generationLogRepository.log({\\n  94                 agentId: toolName,\\n  95                 userId: userId,\\n  96                 input: input,\\n  97                 output: result,\\n  98                 creditCost: (isGuest || isFreeTierRegistered) ? 0 : creditCost\\n  99             });\\n 100 \\n 101             // 5. Wrap response with usage metadata (only if result is an object)\\n 102             if (typeof result === \'string\') {\\n 103                 return Result.ok(result as any);\\n 104             }\\n 105 \\n 106             const usage = isGuest \\n 107                 ? await rateLimiter.getStats(\'guest-writing-tools\', ip || \'unknown\', 5, 24 * 60 * 60 * 1000)\\n 108                 : isFreeTierRegistered \\n 109                     ? await rateLimiter.getStats(\'registered-free-tier\', userId, 10, 24 * 60 * 60 * 1000)\\n 110                     : null;\\n 111 \\n 112             return Result.ok({\\n 113                 ...(result as any),\\n 114                 usageMetadata: usage\\n 115             } as any);\\n 116         } catch (error: any) {\\n 117             // Refund credits on unexpected error\\n 118             if (creditsDeducted) {\\n 119                 await this.deductCreditsUseCase.execute(userId, -creditCost);\\n 120             }\\n 121             return Result.fail(AiError.internal(error.message));\\n 122         }\\n 123     }\\n 124 }\\n 125 \\n````","Successfully opened src/modules/ai/application/services/WritingToolRegistry.ts:\\n\\n````typescript\\n   0 if (typeof window !== \'undefined\') {\\n   1     throw new Error(\'WritingToolRegistry cannot be imported in the browser. It depends on server-only Genkit infrastructure.\');\\n   2 }\\n   3 \\n   4 import { injectable } from \\"tsyringe\\";\\n   5 import { AcademicTools } from \\"./tool-providers/AcademicToolProvider\\";\\n   6 import { WritingTools } from \\"./tool-providers/WritingToolProvider\\";\\n   7 import { GenerationTools } from \\"./tool-providers/GenerationToolProvider\\";\\n   8 \\n   9 export interface ToolConfig {\\n  10     flow: any;\\n  11     schema: any;\\n  12     creditCost: number;\\n  13     isFreeForGuests?: boolean;\\n  14 }\\n  15 \\n  16 @injectable()\\n  17 export class WritingToolRegistry {\\n  18     private toolConfig: Record<string, ToolConfig> = {\\n  19         ...AcademicTools,\\n  20         ...WritingTools,\\n  21         ...GenerationTools,\\n  22     };\\n  23 \\n  24     getTool(name: string): ToolConfig | undefined {\\n  25         return this.toolConfig[name];\\n  26     }\\n  27 \\n  28     getAllTools(): string[] {\\n  29         return Object.keys(this.toolConfig);\\n  30     }\\n  31 }\\n  32 \\n````"]'}

n  29   educationalLevel: z.string().optional(),\n  30   specialization: z.string().optional(),\n  31   university: z.string().optional(),\n  32   citationStyle: z.string().optional(),\n  33 });\n  34 \n  35 type SettingsFormValues = z.infer<typeof settingsSchema>;\n  36 \n  37 export function ProjectSettingsHUD() {\n  38   const { project, updateProject } = useBuilderStore();\n  39 \n  40   const form = useForm<SettingsFormValues>({\n  41     resolver: zodResolver(settingsSchema),\n  42     defaultValues: {\n  43       name: project?.name || \'\',\n  44       projectDescription: project?.projectDescription || \'\',\n  45       projectType: project?.projectType || \'\',\n  46       educationalLevel: project?.educationalLevel || \'\',\n  47       specialization: project?.specialization || \'\',\n  48       university: project?.university || \'\',\n  49       citationStyle: project?.citationStyle || \'\',\n  50     },\n  51   });\n  52 \n  53   useEffect(() => {\n  54     if (project) {\n  55       form.reset({\n  56         name: project.name || \'\',\n  57         projectDescription: project.projectDescription || \'\',\n  58         projectType: project.projectType || \'\',\n  59         educationalLevel: project.educationalLevel || \'\',\n  60         specialization: project.specialization || \'\',\n  61         university: project.university || \'\',\n  62         citationStyle: project.citationStyle || \'\',\n  63       });\n  64     }\n  65   }, [project, form]);\n  66 \n  67   const handleBlur = () => {\n  68     const values = form.getValues();\n  69     updateProject((p) => {\n  70       return p.withProps({\n  71         ...values,\n  72       });\n  73     });\n  74   };\n  75 \n  76   return (\n  77     <div className="h-full flex flex-col space-y-6 pt-2 animate-in fade-in slide-in-from-right-2 duration-300">\n  78       <div className="space-y-1 px-1">\n  79         <h4 className="text-[10px] font-black uppercase tracking-[0.2em] text-primary/70">Project 
Prompt({\\n  19     name: \'generateReportSectionPrompt\', // Static name\\n  20     input: { schema: GenerateSectionInputSchema },\\n  21     // No output schema - model returns plain text\\n  22     model: OLLAMA_MODELS.GEMMA_2B,\\n  23     system: systemPrompt,\\n  24     prompt: `\\n  25 Write the requested section: \'{{sectionToGenerate}}\'. Your writing style should be natural and engaging, not robotic.\\n  26 \\n  27 Output ONLY the markdown content for this section. Do NOT wrap it in JSON or any other format. Just write the section content directly.\\n  28 \\n  29 {{#if guidelines}}\\n  30 --- Guidelines ---\\\\n\\n  31 {{#each guidelines}}\\n  32 - {{{this}}}\\n  33 {{/each}}\\n  34 {{/if}}\\n  35 \\n  36 {{#if instructionText}}\\n  37 --- Additional Instructions ---\\\\n\\n  38 {{{instructionText}}}\\n  39 {{/if}}\\n  40 \\n  41 --- AVAILABLE CONTEXT FROM PROJECT ---\\\\n\\n  42 You have access to the following documents. Review them and use the most relevant information to generate the requested section.\\n  43 \\n  44 {{#if otherSections}}\\n  45 --- Other Report Sections & Context ---\\\\n\\n  46 {{#each otherSections}}\\n  47 --- Context Item: {{@key}} ---\\\\n\\n  48 {{{this}}}\\n  49 ---\\n  50 {{/each}}\\n  51 {{/if}}\\n  52 \\n  53 {{#if otherDiagrams}}\\n  54 --- Other Generated Diagrams (PlantUML) ---\\\\n\\n  55 {{#each otherDiagrams}}\\n  56 --- Diagram: {{@key}} ---\\\\n\\n  57 {{{this}}}\\n  58 ---\\n  59 {{/each}}\\n  60 {{/if}}\\n  61 \\n  62 {{#if externalContext}}\\n  63 --- Additional Context Files ---\\\\n\\n  64 {{#each externalContext}}\\n  65 --- File: {{this.fileName}} (Type: {{this.type}}) ---\\\\n\\n  66 {{{this.content}}}\\n  67 ---\\n  68 {{/each}}\\n  69 {{/if}}\\n  70 \\n  71 {{#if ragContext}}\\n  72 --- RAG RETRIEVED CONTEXT (Most Relevant Information) ---\\\\n\\n  73 {{{ragContext}}}\\n  74 ---\\n  75 {{/if}}\\n  76 `,\\n  77     config: {\\n  78       temperature: 0.3,\\n  79     },\\n  80   });\\n  81 \\n  82   // Call th
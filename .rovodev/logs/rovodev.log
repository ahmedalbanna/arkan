iew(input: LiteratureReviewInput): Promise<LiteratureReviewOutput> {\n  const validation = LiteratureReviewInputSchema.safeParse(input);\n  if (!validation.success) {\n    throw new Error(`Invalid input for generateLiteratureReview: ${validation.error.message}`);\n  }\n  return literatureReviewFlow(validation.data);\n}\n\n", 'tool_response': "Successfully replaced code in src/modules/ai/infrastructure/flows/academic/literature-review-generator.ts:\n\n--- src/modules/ai/infrastructure/flows/academic/literature-review-generator.ts\n+++ src/modules/ai/infrastructure/flows/academic/literature-review-generator.ts\n@@ -5,7 +5,7 @@\n  * @fileOverview An AI agent for generating comprehensive literature reviews.\n  */\n \n-import { ai } from '@/modules/ai/infrastructure/services/Genkit';\n+import { ai, OLLAMA_MODELS } from '@/modules/ai/infrastructure/services/Genkit';\n import { LiteratureReviewInputSchema, LiteratureReviewOutputSchema, type LiteratureReviewInput, type LiteratureReviewOutput } from '@/modules/ai/domain/schemas';\n \n const literatureReviewPrompt = ai.definePrompt({\n"}

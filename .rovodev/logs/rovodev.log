fections.\\n  38 - **21-50 (Likely Human):** Generally natural, but may have some uniform sentence structures or overly formal phrasing.\\n  39 - **51-80 (Likely AI):** Shows several signs of uniformity, lacks a distinct voice, and may have repetitive or unnatural phrasing.\\n  40 - **81-100 (Very Likely AI):** Highly uniform, generic, and lacks the nuance and \\"messiness\\" of authentic human writing.\\n  41 \\n  42 **Text to Analyze:**\\n  43 ---\\n  44 {{{text}}}\\n  45 ---`,\\n  46     config: {\\n  47         temperature: 0.3, // Slightly higher temp for more nuanced analysis\\n  48     }\\n  49 });\\n  50 \\n  51 const detectAiContentFlow = ai.defineFlow({\\n  52     name: \'detectAiContentFlow\',\\n  53     inputSchema: DetectAIInputSchema,\\n  54     outputSchema: DetectAIOutputSchema,\\n  55 }, async (input: DetectAIInput) => {\\n  56   try {\\n  57     const result = await detectAiPrompt(input);\\n  58     \\n  59     if (!result) {\\n  60       throw new Error(\'No output received from the model.\');\\n  61     }\\n  62 \\n  63     // Parse the JSON response\\n  64     let output: DetectAIOutput;\\n  65     try {\\n  66       const jsonText = result.text || result.output || \'\';\\n  67       output = JSON.parse(jsonText);\\n  68     } catch (parseError) {\\n  69       console.error(\'Failed to parse AI Detection JSON:\', parseError);\\n  70       throw new Error(\'AI Detection returned invalid JSON\');\\n  71     }\\n  72 \\n  73     // Validate the parsed output\\n  74     const validation = DetectAIOutputSchema.safeParse(output);\\n  75     if (!validation.success) {\\n  76       console.error(\'AI Detection output validation failed:\', validation.error);\\n  77       throw new Error(\'AI Detection output does not match expected structure\');\\n  78     }\\n  79 \\n  80     return validation.data;\\n  81   } catch (error) {\\n  82     console.error(\'Error in detectAiContentFlow:\', error);\\n  83     throw new Error(`detectAiContent failed: ${error instanceof Error ? error.message : \'Unknown error\'}`);\\n  84   }\\n  85 });\\n  86 \\n  87 \\n  88 export async function detectAiContent(input: DetectAIInput): Promise<DetectAIOutput> {\\n  89     const validation = DetectAIInputSchema.safeParse(input);\\n  90     if (!validation.success) {\\n  91         throw new Error(`Invalid input for detectAiContent: ${validation.error.message}`);\\n  92     }\\n  93     return detectAiContentFlow(validation.data);\\n  94 }\\n  95 \\n````","Successfully opened src/modules/ai/infrastructure/flows/analysis/plagiarism-checker.ts:\\n\\n````typescript\\n   0 \\n   1 \'use server\';\\n   2 \\n   3 /**\\n   4  * @fileOverview An AI agent for checking text for potential plagiarism.\\n   5  */\\n   6 \\n   7 import { ai } from \'@/modules/ai/infrastructure/services/Genkit\';\\n   8 import { PlagiarismCheckInputSchema, PlagiarismCheckOutputSchema, type PlagiarismCheckInput, type PlagiarismCheckOutput } from \'@/modules/ai/domain/schemas\';\\n   9 \\n  10 const plagiarismCheckPrompt = ai.definePrompt({\\n  11   name: \'plagiarismCheckPrompt\',\\n  12   input: { schema: PlagiarismCheckInputSchema },\\n  13   // No output schema - model returns plain JSON text\\n  14   model: \'ollama/phi4-mini:latest\',\\n  15   config: {\\n  16     temperature: 0.3,\\n  17   },\\n  18 \\n  19   prompt: `You are an advanced plagiarism detection engine. Your task is to analyze the following text for originality and find real web sources for any matching content.\\n  20 \\n  21 Output ONLY valid JSON in this format:\\n  22 {\\n  23   \\"matches\\": [{\\"source\\": \\"https://...\\", \\"title\\": \\"...\\", \\"summary\\": \\"...\\", \\"similarity\\": 0-100}],\\n  24   \\"originalityScore\\": 0-100\\n  25 }\\n  26 \\n  27 Do NOT include any explanations or additional text outside the JSON.\\n  28 \\n  29 **Your Process:**\\n  30 1.  **Analyze Content:** Carefully read the text and identify phrases, sentences, and ideas that may not be original.\\n  31 2.  *
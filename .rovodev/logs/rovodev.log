alizer\n  33 const ReactJson = dynamic(() => import(\'@microlink/react-json-view\'), {\n  34     ssr: false,\n  35     loading: () => <div className="h-40 flex items-center justify-center bg-muted/5 rounded-2xl animate-pulse text-[9px] font-black uppercase tracking-widest text-muted-foreground/40">Initializing Neural Visualizer...</div>\n  36 });\n  37 \n  38 /**\n  39  * IntelligenceAnalyst — Deep spectral analysis hub for context vectors.\n  40  * Allows structural decomposition of source data into manageable neural nodes.\n  41  * \n  42  * DEFENSIVE MEASURES:\n  43  * 1. Schema Validation: Strict Zod validation for analysis parameters.\n  44  * 2. Error Containment: Wraps JSON transformation and dynamic visualization in try-catch.\n  45  * 3. Execution Guard: Prevents duplicate analysis and handles malformed payloads.\n  46  * 4. UX Safety: Implements pulse triggers and loading states for long-running AI tasks.\n  47  */\n  48 \n  49 const analysisSchema = z.object({\n  50     query: z.string().min(3, \'Analysis vector requires at least 3 characters\'),\n  51     depth: z.enum([\'shallow\', \'standard\', \'deep\']).default(\'standard\'),\n  52 });\n  53 \n  54 type AnalysisFormValues = z.infer<typeof analysisSchema>;\n  55 \n  56 function jsonToMarkdown(json: any, level = 1): string {\n  57     if (typeof json !== \'object\' || json === null) return String(json);\n  58 \n  59     try {\n  60         let md = \'\';\n  61         const indent = \'  \'.repeat(level - 1);\n  62         for (const [key, value] of Object.entries(json)) {\n  63             if (typeof value === \'object\' && value !== null) {\n  64                 md += `${indent}- **${key}**\\n${jsonToMarkdown(value, level + 1)}`;\n  65             } else {\n  66                 md += `${indent}- **${key}**: ${value}\\n`;\n  67             }\n  68         }\n  69         return md;\n  70     } catch (e) {\n  71         console.error(\'[IntelligenceAnalyst] JSON to MD conversion failed:\', e);\n  72         return \'Data serialization error encountered.\';\n  73     }\n  74 }\n  75 \n  76 export function IntelligenceAnalyst() {\n  77     const { project, updateProject } = useBuilderStore();\n  78     const { toast } = useToast();\n  79     const [isAnalyzing, setIsAnalyzing] = useState(false);\n  80     const [result, setResult] = useState<any>(null);\n  81 \n  82     const form = useForm<AnalysisFormValues>({\n  83         resolver: zodResolver(analysisSchema),\n  84         defaultValues: {\n  85             query: \'\',\n  86             depth: \'standard\',\n  87         }\n  88     });\n  89 \n  90     const handleRunAnalysis = useCallback(async (values: AnalysisFormValues) => {\n  91         if (!project) return;\n  92 \n  93         setIsAnalyzing(true);\n  94         setResult(null);\n  95 \n  96         try {\n  97             // Simulated deep spectral analysis pipeline\n  98             // In production, this would call a specialized analysis tool via useWritingTool\n  99             await new Promise(resolve => setTimeout(resolve, 2000));\n 100 \n 101             const mockAnalysis = {\n 102                 metadata: {\n 103                     vector_density: \'0.84\',\n 104                     semantic_cohesion: \'high\',\n 105                     source_nodes: project.externalContext.length,\n 106                 },\n 107                 structural_insights: [\n 108                     { category: \'Technical Constraints\', identified: 12, critical: 2 },\n 109                     { category: \'Thematic Patterns\', identified: 5, confidence: \'92%\' }\n 110                 ],\n 111                 recommended_blueprints: [\'technical-deep-dive\', \'executive-summary-v2\']\n 112             };\n 113 \n 114             setResult(mockAnalysis);\n 115             toast({ title: "Analysis Synchronized", description: "Intelligence vector successfully mapped from source matrix." });\n 116         } catch (error) {\n 117             console.error(\'[IntelligenceAnalyst] Analysis failed:\', error);\n 118             toast({ title: "System Overload", description: "The analysis core failed to process the current context window.", variant: \'destructive\' });\n 119         } finally {\n 120             setIsAnalyzing(false);\n 121         }\n 122     }, [project, toast]);\n 123 \n 124     const handleIntegrateInsight = useCallback(() => {\n 125         if (!result || !updateProject) return;\n 126 \n 127         try {\n 128             const content = jsonToMarkdown(result);\n 129             updateProject(p => p.addExternalContext({\n 130                 fileName: `Analysis_Insight_${Date.now()}.md`,\n 131                 content,\n 132                 type: \'guidelines\'\n 133             }, generateRandomId()));\n 134 \n 135             toast({ title: "Insight Materialized", description: "Spectral data node successfully integrated into context matrix." });\n 136         } catch (error) {\n 137             console.error(\'[IntelligenceAnalyst] Integration failure:\', error);\n 138             toast({ title: "Materialization Error", description: "Failed to synthesize insight node.", variant: \'destructive\' });\n 139         }\n 140     }, [result, updateProject, toast]);\n 141 \n 142     if (!project) return null;\n 143 \n 144     return (\n 145         <div className="flex flex-col h-full gap-8 pt-2 animate-in fade-in slide-in-from-right-4 duration-500">\n 146             <div className="space-y-1.5 px-1">\n 147                 <div className="flex items-center gap-2.5">\n 148                     <BrainCircuit className="h-4 w-4 text-primary/70" />\n 149                     <h4 className="text-[10px] font-black uppercase tracking-[0.3em] text-primary/70">Neural Analyst</h4>\n 150                 </div>\n 151                 <p className="text-[9px] text-muted-foreground italic font-medium opacity-60 uppercase tracking-widest">\n 152                     Decompose source matrices into structural intelligence.\n 153       
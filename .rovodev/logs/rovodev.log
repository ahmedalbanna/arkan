03                     </div>\n 204                 </div>\n 205             </SidebarContainer>\n 206         );\n 207     }\n 208 \n 209     return (\n 210         <SidebarContainer\n 211             title="Context Dashboard"\n 212             icon={<LayoutGrid className="h-3.5 w-3.5" />}\n 213         >\n 214             <Tabs defaultValue="files" className="w-full flex flex-col gap-8 pt-2 animate-in fade-in slide-in-from-right-4 duration-500">\n 215                 <TabsList className="flex flex-wrap sm:grid sm:grid-cols-2 w-full h-auto sm:h-11 rounded-2xl bg-muted/20 p-1 gap-1 border border-border/40">\n 216                     <TabsTrigger value="files" className="flex-1 text-[10px] font-black uppercase tracking-[0.15em] data-[state=active]:bg-background data-[state=active]:text-primary px-2 py-2 sm:py-0 transition-all rounded-xl">\n 217                         Source Core\n 218                     </TabsTrigger>\n 219                     <TabsTrigger value="analyst" className="flex-1 gap-2 text-[10px] font-black uppercase tracking-[0.15em] data-[state=active]:bg-background data-[state=active]:text-primary px-2 py-2 sm:py-0 transition-all rounded-xl">\n 220                         <AtomIcon className="h-3.5 w-3.5 shrink-0" />\n 221                         Analyst\n 222                     </TabsTrigger>\n 223                 </TabsList>\n 224 \n 225                 <TabsContent value="files" className="m-0 focus-visible:ring-0 flex flex-col gap-8">\n 226                     {/* Ingestion Matrix */}\n 227                     <div className="space-y-6 relative px-1">\n 228                         {/* Depth architectural line */}\n 229                         <div className="absolute left-[-1.25rem] top-0 bottom-0 w-px bg-gradient-to-b from-primary/30 via-primary/5 to-transparent" />\n 230 \n 231                         <Tabs defaultValue="upload" className="w-full">\n 232                             <TabsList className="grid w-full grid-cols-2 h-9 rounded-xl bg-
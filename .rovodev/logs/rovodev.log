s: PptxStyleOptions\n 352 ): { current: PptxGenJS.TextProps[], remaining: PptxGenJS.TextProps[] } {\n 353     const fontFace = styles.body.fontFace || DEFAULT_FONT;\n 354     const fontSize = typeof styles.body.fontSize === 'number' ? styles.body.fontSize : 18;\n 355     const lineHeight = (styles.body.lineSpacing || fontSize * 1.2) / POINTS_PER_INCH;\n 356 \n 357     // Reserve some space for safety margin\n 358     const safetyMargin = 0.1;\n 359     const effectiveHeight = Math.max(0, availableHeight - safetyMargin);\n 360     const maxLines = Math.floor(effectiveHeight / lineHeight);\n 361 \n 362     if (maxLines <= 0) {\n 363         return { current: [], remaining: allRuns };\n 364     }\n 365 \n 366     // Quick check: if all content fits, return it\n 367     const totalText = allRuns.map(r => r.text || '').join('');\n 368     const totalLineCount = calculateLineCount(totalText, fontFace, fontSize, layout.CONTENT_WIDTH);\n 369 \n 370     if (totalLineCount <= maxLines) {\n 371         return { current: allRuns, remaining: [] };\n 372     }\n 373 \n 374     // Find the split point by testing progressively longer text segments\n 375     let splitRunIndex = -1;\n 376     let runsBeforeSplit: PptxGenJS.TextProps[] = [];\n 377 \n 378     for (let i = 0; i < allRuns.length; i++) {\n 379         const testRuns = allRuns.slice(0, i + 1);\n 380         const testText = testRuns.map(r => r.text || '').join('');\n 381         const testLineCount = calculateLineCount(testText, fontFace, fontSize, layout.CONTENT_WIDTH);\n 382 \n 383         if (testLineCount > maxLines) {\n 384             splitRunIndex = i;\n 385             runsBeforeSplit = allRuns.slice(0, i);\n 386             break;\n 387         }\n 388     }\n 389 \n 390     // If no split point found, all content should fit (shouldn't happen due to earlier check)\n 391     if (splitRunIndex === -1) {\n 392         return { current: allRuns, remaining: [] };\n 393     }\n 394 \n 395     // Handle the run that need
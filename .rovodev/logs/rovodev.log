2 \\n  23 const MarkdownEditorComponent = ({\\n  24   content,\\n  25   onChange,\\n  26   onDebouncedChange,\\n  27   onActiveItemDetect,\\n  28   editorClassName,\\n  29   debounceMs = 1000\\n  30 }: MarkdownEditorProps) => {\\n  31   const { setActiveEditor, updateSelectionState } = useEditorStore();\\n  32   const markdownService = useService<IMarkdownService>(IMarkdownServiceToken);\\n  33   const bubbleMenuId = React.useId();\\n  34 \\n  35   const editor = useEditor({\\n  36     extensions: editorExtensions(bubbleMenuId, markdownService),\\n  37     content: markdownService.toHtml(content),\\n  38     onSelectionUpdate: ({ editor }) => {\\n  39       updateSelectionState(editor);\\n  40       if (!onActiveItemDetect) return;\\n  41       // Find nearest heading node above cursor position\\n  42       const { $anchor } = editor.state.selection;\\n  43       let headingText: string | null = null;\\n  44       for (let depth = $anchor.depth; depth >= 0; depth--) {\\n  45         const node = $anchor.node(depth);\\n  46         if (node.type.name === \'heading\') {\\n  47           headingText = node.textContent;\\n  48           break;\\n  49         }\\n  50       }\\n  51       // Walk backwards through doc to find nearest heading before cursor\\n  52       if (!headingText) {\\n  53         const pos = $anchor.pos;\\n  54         editor.state.doc.nodesBetween(0, pos, (node) => {\\n  55           if (node.type.name === \'heading\') {\\n  56             headingText = node.textContent;\\n  57           }\\n  58         });\\n  59       }\\n  60       onActiveItemDetect(headingText);\\n  61     },\\n  62     onUpdate: ({ editor }) => {\\n  63       // Notify the store about selection/state changes\\n  64       updateSelectionState(editor);\\n  65 \\n  66       if (onDebouncedChange) {\\n  67         const markdown = markdownService.toMarkdown(editor.getHTML());\\n  68         // Simple manual debounce\\n  69         const timer = (editor as any)._updateTimer;\\n 
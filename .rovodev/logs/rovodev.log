  const sectionTitles = input.sectionInstructions?.map(s => s.title).join(', ') || '';\n  36       const query = `${input.chapterTitle}\\nSections: ${sectionTitles}`;\n  37       \n  38       const aiService = container.resolve<any>(IAiServiceToken);\n  39       const retrieval = await aiService.retrieveContext(query, {\n  40         projectId: input.projectId,\n  41         userId: input.userId,\n  42         topK: input.ragTopK || 8, // More context for chapters\n  43         minScore: 0.5,\n  44         includeTypes: ['reference', 'context', 'user_upload'],\n  45       });\n  46       \n  47       // 1a. Truncate context based on model context limits to avoid crashes\n  48       const modelLimit = MODEL_CONTEXT_LIMITS.PHI3_MINI; // Default model limit\n  49       const maxContextTokens = Math.floor(modelLimit * 0.6); // Reserve 40% for prompt + completion\n  50       \n  51       ragContext = TokenManager.truncateRagContext(retrieval.context, maxContextTokens);\n  52       const truncated = ragContext.length < retrieval.context.length;\n  53 \n  54       console.log(`[RAG] Retrieved ${retrieval.sources.length} chunks. ${truncated ? 'Truncated context for safety.' : 'Context within limits.'}`);\n  55     } catch (error) {\n  56       console.error('[RAG] Error retrieving context for chapter:', error);\n  57       // Continue without RAG context on error\n  58     }\n  59   }\n  60 \n  61   // 2. Define the chapter prompt with RAG context\n  62   const chapterPrompt = ai.definePrompt({\n  63     name: 'generateChapterContentPromptRAG',\n  64     input: { schema: GenerateChapterInputSchema },\n  65     output: { schema: GenerateChapterOutputSchema },\n  66     model: 'ollama/phi4-mini:latest',\n  67 \n  68     prompt: `You are an expert author and technical writer. Your task is to write the complete content for a chapter titled \"{{chapterTitle}}\".\n  69 \n  70 You will be given a list of sections to write for this chapter. For each section, you must follow its specific instructions, which include a base prompt, guidelines, and contextual information.\n  71 \n  72 ${ragContext ? `\n  73 --- RAG RETRIEVED CONTEXT (Most Relevant Information from Knowledge Base) ---\n  74 IMPORTANT: Use this retrieved context to enhance your writing. This information has been specifically retrieved as relevant to this chapter and its sections.\n  75 \n  76 ${ragContext}\n  77 ---\n  78 ` : ''}\n  79 \n  80 Your final output must be a single markdown string. Each section must start with a level 2 markdown heading (e.g., '## Section Title'). Follow the order of the sections as provided in the instructions.\n  81 \n  82 **Chapter Title:**\n  83 # {{chapterTitle}}\n  84 \n  85 **Sections to Generate:**\n  86 {{#each sectionInstructions}}\n  87 ---\n  88 ### Instructions for Section: \"{{this.title}}\"\n  89 \n  90 **Base Prompt:**\n  91 {{this.prompt}}\n  92 \n  93 **Guidelines:**\n  94 {{#if this.guidelines}}\n  95 {{#each this.guidelines}}\n  96 - {{{this}}}\n  97 {{/each}}\n  98 {{else}}\n  99 - No specific guidelines provided.\n 100 {{/if}}\n 101 \n 102 **Additional Instructions:**\n 103 {{this.instructionText}}\n 104 \n 105 **Context:**\n 106 {{{this.context}}}\n 107 ---\n 108 {{/each}}\n 109 \n 110 Now, write the complete chapter content. Synthesize information from:\n 111 1. The RAG-retrieved context (if available)\n 112 2. The specific instructions for each section\n 113 3. The context provided for each section\n 114 \n 115 Create a cohesive, well-structured chapter that flows naturally from section to section.\n 116 `,\n 117     config: {\n 118       temperature: 0.5,\n 119       maxOutputTokens: 8192,\n 120     }\n 121   });\n 122 \n 123   // 3. Generate chapter content\n 124   const generateChapterFlow = ai.defineFlow({\n 125     name: 'generateChapterContentFlowRAG',\n 126     inputSchema: GenerateChapterInputSchema,\n 127     outputSchema: GenerateChapterOutputSchema,\n 128   }, async (input: GenerateChapterInput) => {\n 129     const { output } = await chapterPrompt(input);\n 130 \n 131     if (!output) {\n 132       throw new Error(`The AI failed to generate a response for the chapter \"${input.chapterTitle}\". Please try again.`);\n 133     }\n 134 \n 135     return output;\n 136   });\n 137 \n 138   // 4. Validate and execute\n 139   const validation = GenerateChapterInputSchema.safeParse(input);\n 140   if (!validation.success) {\n 141     throw new Error(`Invalid input for generateChapterContentWithRAG: ${validation.error.message}`);\n 142   }\n 143   \n 144   return generateChapterFlow(validation.data);\n 145 }\n 146 \n````", "Successfully opened src/modules/ai/infrastructure/flows/generation/generate-report-section.ts:\n\n````typescript\n   0 \n   1 \n   2 'use server';\n   3 \n   4 /**\n   5  * @fileOverview A generic AI agent for generating any section of a project report.\n   6  * - generateReportSection\n   7  */\n   8 \n   9 import { ai } from '@/modules/ai/infrastructure/services/Genkit';\n  10 import { GenerateSectionInputSchema, type GenerateSectionInput, type GenerateSectionOutput } from '@/modules/ai/domain/schemas';\n  11 \n  12 export async function generateReportSection(input: GenerateSectionInput): Promise<GenerateSectionOutput> {\n  13 \n  14   const systemPrompt = `${input.prompt}\n  15 \n  16 You are also an expert analyst. Before you begin writing, you must first review all the provided context sections (proposal, project plan, other report sections, diagrams, etc.). From this context, intelligently identify and synthesize only the most relevant information needed to create the requested report section. Do not simply list information; integrate it into a well-written, coherent narrative.`;\n  17 \n  18   const reportSectionPrompt = ai.definePrompt({\n  19     name: 'generateReportSectionPrompt', // Static name\n  20     input: { schema: GenerateSectionInputSchema },\n  21     // No output schema - model returns plain text\n  22     model: 'ollama/gemma:2b',\n  23     system: systemPrompt,\n  24     prompt: `\n  25 Write the requested section: '{{sectionToGenerate}}'. Your writing style should be natural and engaging, not robotic.\n  26 \n  27 Output ONLY the markdown content for this section. Do NOT wrap it in JSON or any other format. Just write the section content directly.\n  28 \n  29 {{#if guidelines}}\n  30 --- Guidelines ---\\n\n  31 {{#each guidelines}}\n  32 - {{{this}}}\n  33 {{/each}}\n  34 {{/if}}\n  35 \n  36 {{#if instructionText}}\n  37 --- Additional Instructions ---\\n\n  38 {{{instructionText}}}\n  39 {{/if}}\n  40 \n  41 --- AVAILABLE CONTEXT FROM PROJECT ---\\n\n  42 You have access to the following documents. Review them and use the most relevant information to generate the requested section.\n  43 \n  44 {{#if otherSections}}\n  45 --- Other Report Sections & Context ---\\n\n  46 {{#each otherSections}}\n  47 --- Context Item: {{@key}} ---\\n\n  48 {{{this}}}\n  49 ---\n  50 {{/each}}\n  51 {{/if}}\n  52 \n  53 {{#if otherDiagrams}}\n  54 --- Other Generated Diagrams (PlantUML) ---\\n\n  55 {{#each otherDiagrams}}\n  56 --- Diagram: {{@key}} ---\\n\n  57 {{{this}}}\n  58 ---\n  59 {{/each}}\n  60 {{/if}}\n  61 \n  62 {{#if externalContext}}\n  63 --- Additional Context Files ---\\n\n  64 {{#each externalContext}}\n  65 --- File: {{this.fileName}} (Type: {{this.type}}) ---\\n\n  66 {{{this.content}}}\n  67 ---\n  68 {{/each}}\n  69 {{/if}}\n  70 \n  71 {{#if ragContext}}\n  72 --- RAG RETRIEVED CONTEXT (Most Relevant Information) ---\\n\n  73 {{{ragContext}}}\n  74 ---\n  75 {{/if}}\n  76 `,\n  77     config: {\n  78       temperature: 0.3,\n  79     },\n  80   });\n  81 \n  82   // Call the AI and get plain text response\n  83   const result = await reportSectionPrompt(input);\n  84 \n  85   // Wrap the plain text in the expected output structure\n  86   const output: GenerateSectionOutput = {\n  87     sectionName: input.sectionToGenerate,\n  88     content: result.text || result.output || '' // Handle different response formats\n  89   };\n  90 \n  91   if (!output.content || output.content.trim().length === 0) {\n  92     console.error(`AI failed to generate content for section: ${input.sectionToGenerate}`);\n  93     throw new Error(`The AI failed to generate a response for the '${input.sectionToGenerate}' section. Please try again.`);\n  94   }\n  95 \n  96   return output;\n  97 }\n  98 \n````"], "tool_call_id": "pyd_ai_f115c1f9e02d41d7bca0e029ae34fb87", "metadata": null, "timestamp": "2026-04-03T04:15:19.011498+00:00", "part_kind": "tool-return"}

eration successfully\', async () => {\n  42       const logData = {\n  43         agentId: \'agent_123\',\n  44         userId: \'user_456\',\n  45         input: { text: \'Test input\' },\n  46         output: { result: \'Test output\' },\n  47         creditCost: 5,\n  48       };\n  49 \n  50       await logGeneration(logData);\n  51 \n  52       expect(adminDb.collection).toHaveBeenCalledWith(\'agent_generations\');\n  53       expect(mockCollection.add).toHaveBeenCalledWith(\n  54         expect.objectContaining({\n  55           agentId: \'agent_123\',\n  56           userId: \'user_456\',\n  57           input: { text: \'Test input\' },\n  58           output: { result: \'Test output\' },\n  59           creditCost: 5,\n  60           createdAt: expect.any(String),\n  61         })\n  62       );\n  63     });\n  64 \n  65     it(\'should add timestamp to log entry\', async () => {\n  66       const beforeLog = new Date().toISOString();\n  67 \n  68       await logGeneration({\n  69         agentId: \'agent_123\',\n  70         userId: \'user_456\',\n  71         input: {},\n  72         output: {},\n  73         creditCost: 1,\n  74       });\n  75 \n  76       const callArgs = mockCollection.add.mock.calls[0][0];\n  77       const afterLog = new Date().toISOString();\n  78 \n  79       expect(callArgs.createdAt).toBeDefined();\n  80       expect(new Date(callArgs.createdAt).getTime()).toBeGreaterThanOrEqual(\n  81         new Date(beforeLog).getTime()\n  82       );\n  83       expect(new Date(callArgs.createdAt).getTime()).toBeLessThanOrEqual(\n  84         new Date(afterLog).getTime()\n  85       );\n  86     });\n  87 \n  88     it(\'should handle complex input data\', async () => {\n  89       const complexInput = {\n  90         text: \'Generate a report\',\n  91         options: {\n  92           language: \'en\',\n  93           style: \'formal\',\n  94           sections: [\'intro\', \'body\', \'conclusion\'],\n  95         },\n  96         metadata
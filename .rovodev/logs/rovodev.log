board, setOutlineClipboard] = useState<{ type: \'chapter\' | \'section\', data: any } | null>(null);\n  30 \n  31     if (!project) return null;\n  32 \n  33     return (\n  34         <FloatingOutline\n  35             isVisible={isVisible}\n  36             project={project}\n  37             activeChapterId={activeChapterId}\n  38             selectedSectionIds={selectedSectionIds}\n  39             onActiveChapterChange={onActiveChapterChange}\n  40             onActiveSectionChange={onActiveSectionChange}\n  41             onMoveItem={(activeId, overId) => updateProject(p => p.moveContentItem(activeId, overId))}\n  42             onUpdateTitle={(id, newTitle, isChapter) => {\n  43                 if (isChapter) {\n  44                     updateProject(p => p.updateChapter(id, c => c.withProps({ title: newTitle })));\n  45                 } else {\n  46                     updateProject(p => p.updateSection(id, s => s.withProps({ title: newTitle })));\n  47                 }\n  48             }}\n  49             onDeleteItem={(id, isChapter) => {\n  50                 if (isChapter) {\n  51                     updateProject(p => p.removeChapter(id));\n  52                 } else {\n  53                     const sectionInfo = project.findSection(id);\n  54                     if (sectionInfo) {\n  55                         updateProject(p => p.updateChapter(sectionInfo.chapter.id, c => c.removeSection(id)));\n  56                     }\n  57                 }\n  58             }}\n  59             onAddChapter={() => {\n  60                 updateProject(p => p.addChapter(uuidv4(), "New Chapter"));\n  61             }}\n  62             onAddSection={(chapterId) => {\n  63                 updateProject(p => p.addSectionToChapter(chapterId, uuidv4(), "New Section"));\n  64             }}\n  65             onDuplicateItem={(id, isChapter) => {\n  66                 updateProject(p => isChapter ? p.duplicateChapter(id, uuidv4) : p.duplicateSection(id, uuidv4));\n  67             }}\n  68             onUndo={() => undo()}\n  69             onCopyItem={(id, isChapter) => {\n  70                 if (isChapter) {\n  71                     const chapter = project.getChapter(id);\n  72                     if (chapter) setOutlineClipboard({ type: \'chapter\', data: chapter.toProperties() });\n  73                 } else {\n  74                     const info = project.findSection(id);\n  75                     if (info) setOutlineClipboard({ type: \'section\', data: info.section.toProperties() });\n  76                 }\n  77                 toast({ title: \'Copied\', description: \'Item copied to outline clipboard.\' });\n  78             }}\n  79             onPasteItem={(targetId, targetIsChapter) => {\n  80                 if (!outlineClipboard) return;\n  81 \n  82                 updateProject(p => {\n  83                     const newId = uuidv4();\n  84 \n  85                     // CASE 1: Pasting a CHAPTER\n  86                     if (outlineClipboard.type === \'chapter\') {\n  87                         const newChapterProps = {\n  88                             ...outlineClipboard.data,\n  89                             id: newId,\n  90                             title: `${outlineClipboard.data.title} (Copy)`\n  91                         };\n  92                         if (newChapterProps.sections) {\n  93                             newChapterProps.sections = newChapterProps.sections.map((s: any) => ({ ...s, id: uuidv4() }));\n  94                         }\n  95                         const newChapter = new Chapter(newChapterProps);\n  96 \n  97                         // Find insertion index\n  98                         let insertionIndex = -1;\n  99                         if (targetIsChapter) {\n 100                             insertionIndex = p.content.findIndex(c => c.id === targetId);\n 101                         } else {\n 102                             const info = p.findSection(targetId);\n 103                             if (info) insertionIndex = p.content.findIndex(c => c.id === info.chapter.id);\n 104                         }\n 105 \n 106                         if (insertionIndex !== -1) {\n 107                             const newContent = [...p.content];\n 108                             newContent.splice(insertionIndex + 1, 0, newChapter);\n 109                             return p.withProps({ content: newContent });\n 110                         }\n 111                     }\n 112 \n 113                     // CASE 2: Pasting a SECTION\n 114                     else if (outlineClipboard.type === \'section\') {\n 115                         const newSectionProps = {\n 116                             ...outlineClipboard.data,\n 117                             id: newId,\n 118                             title: `${outlineClipboard.data.title} (Copy)`\n 119                         };\n 120                         const newSection = new Section(newSectionProps);\n 121 \n 122                         if (targetIsChapter) {\n 123                             // Paste as first section of the chapter\n 124                             return p.updateChapter(targetId, c => c.addSection(newSection, 0));\n 125                         } else {\n 126                             // Paste below the target section\n 127                             const info = p.findSection(targetId);\n 128                             if (info) {\n 129                                 return p.updateChapter(info.chapter.id, c => c.addSection(newSection, info.sectionIndex + 1));\n 130                             }\n 131                         }\n 132                     }\n 133                     return p;\n 134                 });\n 135                 toast({ title: \'Pasted\', description: `Successfully pasted ${outlineClipboard.type}.` });\n 136             }}\n 137         />\n 138     );\n 139 };\n 140 \n````'}

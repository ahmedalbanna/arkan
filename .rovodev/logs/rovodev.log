>\n  69                         </div>\n  70                         <div>\n  71                             <DialogTitle className="text-[14px] font-black uppercase tracking-tight">{item.fileName}</DialogTitle>\n  72                             <p className="text-[10px] uppercase tracking-widest text-muted-foreground/60 font-bold">Spectral content analysis</p>\n  73                         </div>\n  74                     </div>\n  75                 </DialogHeader>\n  76                 <div className="flex-1 overflow-hidden relative group">\n  77                     {/* Atmospheric decoration */}\n  78                     <div className="absolute inset-0 pointer-events-none opacity-[0.02] bg-[radial-gradient(circle_at_center,_var(--primary)_1px,_transparent_1px)] bg-[size:28px_28px]" />\n  79 \n  80                     <ScrollArea className="h-full w-full custom-scrollbar">\n  81                         <div className="p-10">\n  82                             <div className="space-y-6">\n  83                                 <h3 className="text-[16px] font-black uppercase tracking-tight text-foreground/80">{item.fileName}</h3>\n  84                                 <pre className="p-8 bg-muted/30 border border-primary/10 rounded-3xl overflow-auto max-h-[60vh] text-[12px] font-serif leading-relaxed italic shadow-inner">\n  85                                     {item.content || \'Zero payload detected in source vector.\'}\n  86                                 </pre>\n  87                             </div>\n  88                         </div>\n  89                     </ScrollArea>\n  90                 </div>\n  91                 <div className="px-8 py-4 bg-primary/[0.02] border-t border-primary/10 flex justify-between items-center shrink-0">\n  92                     <span className="text-[8px] font-black uppercase tracking-widest text-muted-foreground/40">Context Vector Analysis Pipeline</span>\n  93                     <Button variant="ghost" onClick={onClose}
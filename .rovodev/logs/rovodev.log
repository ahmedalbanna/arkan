efault to empty array\\n  onGenerateProject,\\n  isLoading,\\n}: BuildManifestHUDProps) {\\n  const project = useBuilderStore(state => state.project);\\n\\n  // 1. INPUT VALIDATION & DERIVED STATS\\n  const totalSections = useMemo(() => {\\n    try {\\n        if (!Array.isArray(chaptersToBuild)) return 0;\\n        return chaptersToBuild.reduce((acc, chapter) => {\\n            const sectionsCount = Array.isArray(chapter?.sections) ? chapter.sections.length : 0;\\n            return acc + sectionsCount;\\n        }, 0);\\n    } catch (e) {\\n        console.error(\'[BuildManifestHUD] Section count calculation failed:\', e);\\n        return 0;\\n    }\\n  }, [chaptersToBuild]);\\n\\n  const isValidManifest = useMemo(() => {\\n    return !!project && chaptersToBuild.length > 0 && totalSections > 0;\\n  }, [project, chaptersToBuild, totalSections]);\\n\\n  // 2. STABLE HANDLERS\\n  const handleOpenChange = useCallback((open: boolean) => {\\n    if (!isLoading) {\\n        onOpenChange(open);\\n    }\\n  }, [onOpenChange, isLoading]);\\n\\n  const handleGenerateProject = useCallback(() => {\\n    if (!isValidManifest || isLoading) return;\\n    onGenerateProject();\\n  }, [onGenerateProject, isValidManifest, isLoading]);\\n\\n  // 3. RENDER LOGIC\\n  return (\\n    <Dialog open={isOpen} onOpenChange={handleOpenChange}>\\n      <DialogContent className=\\"max-w-5xl h-[85vh] p-0 overflow-hidden flex flex-col gap-0 border-primary/10 shadow-2xl rounded-[32px] bg-background/80 backdrop-blur-3xl\\">\\n        \\n        {/* Production Manifest Header */}\\n        <header className=\\"px-10 py-8 border-b border-primary/10 bg-primary/[0.02] relative overflow-hidden shrink-0\\">\\n            {/* Dot-grid atmosphere — Standardized Workspace Alignment (28px) */}\\n            <div \\n                className=\\"absolute inset-0 opacity-[0.02] dark:opacity-[0.04] bg-[radial-gradient(circle_at_center,_var(--primary)_1px,_transparent_1px)] bg-[size:28px_28px] pointer-events-none
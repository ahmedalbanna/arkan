2026-04-04 19:27:39.273 | 1653284 (1653284) | DEBUG    | Model response tool call: {"tool_name": "create_file", "args": {"initial_content": "'use client';\n\nimport React, { useMemo, useCallback } from 'react';\nimport { Database, FileText, Link as LinkIcon, Sparkles } from 'lucide-react';\nimport { Badge } from '@/components/ui/badge';\nimport { Label } from '@/components/ui/label';\nimport { Separator } from '@/components/ui/separator';\nimport { useBuilderStore } from '@/hooks';\nimport { cn } from '@/infrastructure/utils/cn';\n\n/**\n * ContextSelector \u2014 High-fidelity HUD for mapping AI context.\n * Allows linking sections and external files as neural input for generation.\n * \n * DEFENSIVE MEASURES:\n * 1. Existence Checks: Verifies project and section exist before calculation.\n * 2. Atomic Updates: Performs batch updates in a single reduce pass outside the setter.\n * 3. Error Handling: Wraps complex context logic in try-catch to prevent crash.\n * 4. Empty State Fallbacks: Handles cases with no available sections or files.\n */\n\ninterface ContextSelectorProps {\n  sectionId: string;\n  selectedSectionIds?: string[];\n}\n\nconst ContextSelectorComponent = ({ sectionId, selectedSectionIds = [] }: ContextSelectorProps) => {\n  const { project, updateProject } = useBuilderStore();\n\n  const section = useMemo(() => {\n    if (!project || !sectionId) return null;\n    return project.getSection(sectionId);\n  }, [project, sectionId]);\n\n  const reportSections = useMemo(() => project?.sections || [], [project]);\n\n  const otherSections = useMemo(() => {\n    if (!sectionId) return reportSections;\n    return reportSections.filter(s => s.id !== sectionId);\n  }, [reportSections, sectionId]);\n\n  const handleUpdateContext = useCallback((type: 'sections' | 'externalContext', id: string, enabled: boolean) => {\n    if (!project || !updateProject) return;\n\n    // Determine target nodes for the update\n    const targets = selectedSectionIds.length > 1 ? selectedSectionIds : [sectionId];\n    if (targets.length === 0) return;\n\n    try {\n        updateProject((currentProject) => {\n            // Defensive check: ensure the project object is valid\n            if (!currentProject) return currentProject;\n\n            // Atomic Batch Update: Update each target section in a single pass\n            return targets.reduce((p, targetId) => {\n                // Verify section exists in current project state before updating\n                const targetSection = p.getSection(targetId);\n                if (!targetSection) return p;\n\n                return p.updateSection(targetId, (s) => {\n                    const currentContext = { ...(s.context || {}) };\n                    const subContext = { ...(currentContext[type] || {}) };\n\n                    if (enabled) {\n                        subContext[id] = 'context'; // Using 'context' as standard value\n                    } else {\n                        delete subContext[id];\n                    }\n\n                    return s.withProps({\n                        context: { ...currentContext, [type]: subContext },\n                    });\n                });\n            }, currentProject);\n        });\n    } catch (error) {\n        console.error('[ContextSelector] Failed to update context:', error);\n    }\n  }, [selectedSectionIds, sectionId, updateProject, project]);\n\n  const sectionOptions = useMemo(() => otherSections.map(s => ({\n    label: s.title || 'Untitled Section',\n    value: s.id,\n  })), [otherSections]);\n\n  const fileOptions = useMemo(() => (project?.externalContext || []).map(f => ({\n    label: f.fileName,\n    value: f.id,\n  })), [project?.externalContext]);\n\n  if (!section) {\n    return (\n        <div className=\"p-4 rounded-2xl bg-muted/5 border border-dashed border-primary/10 text-center\">\n            <p className=\"text-[10px] text-muted-foreground italic uppercase tracking-widest\">\n                Source mapping unavailable.\n            </p>\n        </div>\n    );\n  }\n\n  const activeSections = Object.keys(section.context?.sections || {});\n  const activeFiles = Object.keys(section.context?.externalContext || {});\n\n  return (\n    <div className=\"space-y-8 pt-2 relative\">\n      {/* Dot-grid atmosphere \u2014 Standardized Workspace Alignment (28px) */}\n      <div\n        className=\"absolute inset-0 opacity-[0.02] dark:opacity-[0.04] bg-[radial-gradient(circle_at_center,_var(--primary)_1px,_transparent_1px)] bg-[size:28px:28px] pointer-events-none\"\n        style={{ backgroundSize: '28px 28px' }}\n      />\n\n      {/* HUD Header */}\n      <div className=\"space-y-1.5 px-1 relative z-10\">\n        <h4 className=\"text-[10px] font-black uppercase tracking-[0.3em] text-primary/70 flex items-center gap-2.5\">\n          <Database className=\"h-3.5 w-3.5\" />\n          Neural Source Matrix\n        </h4>\n        <p className=\"text-[9px] text-muted-foreground italic font-medium uppercase tracking-[0.2em] opacity-60\">\n          Map intellectual dependencies and source data.\n        </p>\n      </div>\n\n      <div className=\"space-y-8 relative px-1 z-10\">\n        {/* Depth accent line */}\n        <div className=\"absolute left-[-1.25rem] top-0 bottom-0 w-px bg-gradient-to-b from-primary/30 via-primary/5 to-transparent\" />\n\n        {/* Section Context Zone */}\n        <div className=\"space-y-4\">\n          <div className=\"flex items-center justify-between group/label\">\n            <div className=\"flex items-center gap-2\">\n              <FileText className=\"h-3.5 w-3.5 text-primary/40 group-hover/label:text-primary transition-colors\" />\n              <Label className=\"text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60\">Cross-Node Intelligence</Label>\n            </div>\n            <Badge variant=\"outline\" className=\"h-5 text-[9px] font-black border-primary/20 bg-primary/5 text-primary tabular-nums shadow-inner ring-1 ring-inset ring-primary/10\">\n              {activeSections.length} LINKS\n            </Badge>\n          </div>\n\n          <div className=\"flex flex-wrap gap-2 min-h-[44px] p-3 rounded-2xl bg-muted/5 border border-primary/10 shadow-inner\">\n            {sectionOptions.map(opt => {\n              const isActive = activeSections.includes(opt.value);\n              return (\n                <button\n                  key={opt.value}\n                  onClick={() => handleUpdateContext('sections', opt.value, !isActive)}\n                  className={cn(\n                    \"px-3 py-1.5 rounded-xl border text-[10px] font-bold uppercase tracking-[0.15em] transition-all duration-500 ease-[0.22,1,0.36,1]\",\n                    isActive\n                      ? \"bg-primary/10 border-primary/20 text-primary shadow-sm ring-1 ring-primary/10 scale-[1.02]\"\n                      : \"bg-background/40 border-transparent text-muted-foreground hover:border-primary/10 hover:bg-muted/10 active:scale-95\"\n                  )}\n                >\n                  {opt.label}\n                </button>\n              );\n            })}\n            {sectionOptions.length === 0 && (\n              <span className=\"text-[9px] text-muted-foreground/40 italic px-1 py-1.5\">No other nodes available.</span>\n            )}\n          </div>\n        </div>\n\n        <Separator className=\"bg-gradient-to-r from-primary/20 via-primary/5 to-transparent h-px\" />\n\n        {/* External Context Zone */}\n        <div className=\"space-y-4\">\n          <div className=\"flex items-center justify-between group/label\">\n            <div className=\"flex items-center gap-2\">\n              <LinkIcon className=\"h-3.5 w-3.5 text-primary/40 group-hover/label:text-primary transition-colors\" />\n              <Label className=\"text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60\">External Knowledge Base</Label>\n            </div>\n            <Badge variant=\"outline\" className=\"h-5 text-[9px] font-black border-primary/20 bg-primary/5 text-primary tabular-nums shadow-inner ring-1 ring-inset ring-primary/10\">\n              {activeFiles.length} VECTORS\n            </Badge>\n          </div>\n\n          <div className=\"flex flex-wrap gap-2 min-h-[44px] p-3 rounded-2xl bg-muted/5 border border-primary/10 shadow-inner\">\n            {fileOptions.map(opt => {\n              const isActive = activeFiles.includes(opt.value);\n              return (\n                <button\n                  key={opt.value}\n                  onClick={() => handleUpdateContext('externalContext', opt.value, !isActive)}\n                  className={cn(\n                    \"px-3 py-1.5 rounded-xl border text-[10px] font-bold uppercase tracking-[0.15em] transition-all duration-500 ease-[0.22,1,0.36,1]\",\n                    isActive\n                      ? \"bg-primary/10 border-primary/20 text-primary shadow-sm ring-1 ring-primary/10 scale-[1.02]\"\n                      : \"bg-background/40 border-transparent text-muted-foreground hover:border-primary/10 hover:bg-muted/10 active:scale-95\"\n                  )}\n                >\n                  {opt.label}\n                </button>\n              );\n            })}\n            {fileOptions.length === 0 && (\n              <span className=\"text-[9px] text-muted-foreground/40 italic px-1 py-1.5\">No external data mapped.</span>\n            )}\n          </div>\n        </div>\n\n        {/* Tactical Info Layer */}\n        <div className=\"p-5 rounded-[24px] border border-dashed border-primary/10 bg-primary/[0.02] text-center space-y-2 group/info hover:bg-primary/[0.04] transition-all\">\n          <div className=\"flex justify-center mb-1\">\n            <Sparkles className=\"h-4 w-4 text-primary/30 group-hover/info:scale-110 transition-transform\" />\n          </div>\n          <p className=\"text-[10px] text-primary/40 italic leading-relaxed font-medium uppercase tracking-[0.2em] group-hover:text-primary/60 transition-colors px-4\">\n            Selected nodes will be injected into the AI context window to ensure thematic continuity.\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport const ContextSelector = React.memo(ContextSelectorComponent);\n\nContextSelector.displayName = 'ContextSelector';\n", "file_path": "src/modules/ai-content/adapters/components/builder/generation/controls/ContextSelector.tsx", "overwrite": true}, "tool_call_id": "pyd_ai_d007afd20bf34c81aa70a6732af13b5a", "id": null, "provider_name": "google-vertex", "provider_details": {"thought_signature": "ZTI0ODMwYTctNWNkNi00MmZlLTk5OGItZWU1MzllNzJiOWMz"}, "part_kind": "tool-call"}

@inject(IGenerationLogRepositoryToken)\\n  25         private generationLogRepository: IGenerationLogRepository,\\n  26         @inject(DeductCreditsUseCase) private deductCreditsUseCase: DeductCreditsUseCase,\\n  27         @inject(WritingToolRegistry)\\n  28         private writingToolRegistry: WritingToolRegistry\\n  29     ) {}\\n  30 \\n  31     async execute<TInput, TOutput>(params: RunAiToolInput<TInput>): Promise<Result<TOutput, AiError>> {\\n  32         const { userId, toolName, input, ip } = params;\\n  33 \\n  34         const config = this.writingToolRegistry.getTool(toolName);\\n  35         if (!config) {\\n  36             return Result.fail(AiError.notFound(`Tool ${toolName} not found in registry.`));\\n  37         }\\n  38 \\n  39         const { flow, creditCost, isFreeForGuests } = config;\\n  40 \\n  41         // 1. Handle guest access\\n  42         const isGuest = userId === \'guest\';\\n  43         if (isGuest) {\\n  44             if (!isFreeForGuests) {\\n  45                 return Result.fail(AiError.unauthorized(`The ${toolName} tool requires a registered account.`));\\n  46             }\\n  47 \\n  48             // Apply daily limit for guests (5 requests per 24h)\\n  49             const limiterResult = await rateLimiter.check(\'guest-writing-tools\', ip || \'unknown\', 5, 24 * 60 * 60 * 1000);\\n  50             if (!limiterResult.allowed) {\\n  51                 return Result.fail(AiError.unauthorized(\\"Guest daily limit exceeded (5 requests/day). Please sign up for unlimited access.\\"));\\n  52             }\\n  53         }\\n  54 \\n  55         // 2. Pre-deduct credits or check free tier for registered users\\n  56         let creditsDeducted = false;\\n  57         let isFreeTierRegistered = false;\\n  58 \\n  59         if (!isGuest && creditCost > 0) {\\n  60             const deductResult = await this.deductCreditsUseCase.execute(userId, creditCost);\\n  61             \\n  62             if (deductResult.isFailure) {
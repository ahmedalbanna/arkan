nction\') {\\n            \\n            const canvas = document.createElement(\'canvas\');\\n            const context = canvas.getContext(\'2d\');\\n            if (context) {\\n                context.font = `${fontSize}pt \\"${fontFace}\\"`;\\n                measurableContextCache[key] = context;\\n                return context;\\n            }\\n        }\\n    } catch (e) {\\n        // Silently fail and use heuristic\\n    }\\n\\n    measurableContextCache[key] = heuristic;\\n    return heuristic;\\n}\\n\\n/**\\n * Calculates the number of lines a given text will occupy with word wrapping.\\n */\\nexport function calculateLineCount(text: string, fontFace: string, fontSize: number, maxWidthInches: number): number {\\n    if (!text || !String(text).trim()) return 1;\\n\\n    try {\\n        const context = getMeasurableContext(fontFace, fontSize);\\n        const maxWidthPx = maxWidthInches * POINTS_PER_INCH;\\n\\n        const paragraphs = String(text).split(\'\\\\n\');\\n        let totalLines = 0;\\n\\n        for (const paragraph of paragraphs) {\\n            const trimmed = paragraph.trim();\\n            if (!trimmed) {\\n                totalLines++;\\n                continue;\\n            }\\n            const words = trimmed.split(/\\\\s+/);\\n            let lineCount = 1;\\n            let currentLine = \'\';\\n\\n            for (const word of words) {\\n                const testLine = currentLine ? `${currentLine} ${word}` : word;\\n                const metrics = context.measureText(testLine);\\n                if (metrics.width > maxWidthPx && currentLine) {\\n                    lineCount++;\\n                    currentLine = word;\\n                } else {\\n                    currentLine = testLine;\\n                }\\n            }\\n            totalLines += lineCount;\\n        }\\n\\n        return Math.max(1, totalLines);\\n    } catch (e) {\\n        console.warn(\'[Export:PPTX] Line count fallback engaged:\', e);\\n        return 1;\\n    }\\n}\\n\\n/**\\n * Calculates the number of lines a code block will occupy.\\n */\\nexport function calculateCodeLineCount(text: string, fontFace: string, fontSize: number, maxWidthInches: number): number {\\n    if (!text) return 1;\\n\\n    try {\\n        const context = getMeasurableContext(fontFace, fontSize);\\n        const maxWidthPx = maxWidthInches * POINTS_PER_INCH;\\n\\n        const lines = String(text).split(\'\\\\n\');\\n        let totalLines = 0;\\n\\n        for (const line of lines) {\\n            if (line === \'\') {\\n                totalLines++;\\n                continue;\\n            }\\n            const metrics = context.measureText(line);\\n            const lineWraps = Math.ceil(metrics.width / maxWidthPx);\\n            totalLines += Math.max(1, lineWraps);\\n        }\\n\\n        return Math.max(1, totalLines);\\n    } catch (e) {\\n        console.warn(\'[Export:PPTX] Code line count fallback engaged:\', e);\\n        return 1;\\n    }\\n}\\n","file_path":"src/modules/templates/infrastructure/exporters/pptx/text-measurement.ts","overwrite":true}', 'logfire.msg': 'running tool: create_file', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span', 'original_content': '', 'tool_response': 'Successfully updated src/modules/templates/infrastructure/exporters/pptx/text-measurement.ts.'}

ng/infrastructure/:\n\nsrc/modules/billing/infrastructure/repositories/: (COLLAPSED)\n\nsrc/modules/billing/infrastructure/services/: (COLLAPSED)\n\nsrc/modules/projects/:\n\nsrc/modules/projects/adapters/:\n\nsrc/modules/projects/adapters/api-client/: (COLLAPSED)\n\nsrc/modules/projects/adapters/components/: (COLLAPSED)\n\nsrc/modules/projects/adapters/controllers/: (COLLAPSED)\n\nsrc/modules/projects/adapters/hooks/: (COLLAPSED)\n\nsrc/modules/projects/adapters/local-storage/: (COLLAPSED)\n\nsrc/modules/projects/adapters/state/: (COLLAPSED)\n\nsrc/modules/projects/application/:\n\nsrc/modules/projects/application/use-cases/: (COLLAPSED)\n\nsrc/modules/projects/domain/:\n\nsrc/modules/projects/domain/entities/: (COLLAPSED)\n\nsrc/modules/projects/domain/errors/: (COLLAPSED)\n\nsrc/modules/projects/domain/repositories/: (COLLAPSED)\n\nsrc/modules/projects/domain/schemas/: (COLLAPSED)\n\nsrc/modules/projects/domain/utils/: (COLLAPSED)\n\nsrc/modules/projects/infrastructure/:\n\nsrc/modules/projects/infrastructure/io/: (COLLAPSED)\n\nsrc/modules/projects/infrastructure/repositories/: (COLLAPSED)\n\nsrc/modules/rag/:\n\nsrc/modules/rag/adapters/:\n\nsrc/modules/rag/adapters/api-client/: (COLLAPSED)\n\nsrc/modules/rag/adapters/components/: (COLLAPSED)\n\nsrc/modules/rag/adapters/controllers/: (COLLAPSED)\n\nsrc/modules/rag/adapters/hooks/: (COLLAPSED)\n\nsrc/modules/rag/application/:\n\nsrc/modules/rag/application/use-cases/: (COLLAPSED)\n\nsrc/modules/rag/domain/:\n\nsrc/modules/rag/domain/errors/: (COLLAPSED)\n\nsrc/modules/rag/domain/repositories/: (COLLAPSED)\n\nsrc/modules/rag/infrastructure/:\ncache.ts\nconfig.ts\nembeddings.ts\nindex.ts\nindexer.ts\nqdrant-adapter.ts\nreranker.ts\nretrieval.ts\nvector-store-interface.ts\nvector-store.ts\n\nsrc/modules/rag/infrastructure/__tests__/: (COLLAPSED)\n\nsrc/modules/rag/infrastructure/repositories/: (COLLAPSED)\n\nsrc/modules/templates/:\n\nsrc/modules/templates/adapters/:\n\nsrc/modules/templates/adapters/api-client/: (
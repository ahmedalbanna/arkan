2026-01-26 04:15:13.626 | DEBUG    | Model response tool call: {"tool_name": "find_and_replace_code", "args": "{\"file_path\": \"src/app/api/notifications/clear/route.ts\", \"find\": \"// @ts-nocheck\\n// src/app/api/notifications/clear/route.ts\\nimport { NextResponse } from 'next/server';\\nimport { z } from 'zod';\\n\\nconst clearSchema = z.object({\\n  notificationIds: z.array(z.string()).min(1, \\\"At least one notification ID is required.\\\"),\\n});\\n\\n\\nexport async function POST(request: Request) {\\n\\n    let authorization = request.headers.get('Authorization');\\n    if (!authorization?.startsWith('Bearer ')) {\\n        return NextResponse.json({ message: 'Unauthorized' }, { status: 401 });\\n    }\\n\\n    let token = authorization.substring(7);\\n    try {\\n        let decodedToken = await adminAuth.verifyIdToken(token, true);\\n        let userId = decodedToken.uid;\\n\\n        let body = await request.json();\\n        let validation = clearSchema.safeParse(body);\\n        if (!validation.success) {\\n            return NextResponse.json({ errors: validation.error.flatten().fieldErrors }, { status: 400 });\\n        }\\n\\n        let { notificationIds } = validation.data;\\n\\n        let db = getDatabase();\\n        let updates: { [key: string]: null } = {};\\n        notificationIds.forEach(id => {\\n            updates[`/notifications/${userId}/${id}`] = null; // Setting to null deletes the key in RTDB\\n        });\\n\\n        await db.ref().update(updates);\\n\\n        return NextResponse.json({ message: 'Notifications cleared.' }, { status: 200 });\\n\\n    } catch (error) {\\n        console.error('Error clearing notifications:', error);\\n        return NextResponse.json({ message: 'An unexpected error occurred.' }, { status: 500 });\\n    }\\n}\", \"replace\": \"// @ts-nocheck\\n// src/app/api/notifications/clear/route.ts\\nimport { NextResponse } from 'next/server';\\nimport { z } from 'zod';\\nimport { auth } from '@/auth';\\nimport { db } from '@/db';\\nimport { notifications } from '@/db/schema';\\nimport { eq, inArray } from 'drizzle-orm';\\n\\nconst clearSchema = z.object({\\n  notificationIds: z.array(z.number()).min(1, \\\"At least one notification ID is required.\\\"),\\n});\\n\\nexport async function POST(request: Request) {\\n    try {\\n        const session = await auth();\\n        if (!session?.user?.id) {\\n            return NextResponse.json({ message: 'Unauthorized' }, { status: 401 });\\n        }\\n\\n        let body = await request.json();\\n        let validation = clearSchema.safeParse(body);\\n        if (!validation.success) {\\n            return NextResponse.json({ errors: validation.error.flatten().fieldErrors }, { status: 400 });\\n        }\\n\\n        let { notificationIds } = validation.data;\\n        const userId = parseInt(session.user.id);\\n\\n        // Delete notifications from PostgreSQL\\n        await db\\n            .delete(notifications)\\n            .where(\\n                eq(notifications.userId, userId) && \\n                inArray(notifications.id, notificationIds)\\n            );\\n\\n        return NextResponse.json({ message: 'Notifications cleared.' }, { status: 200 });\\n\\n    } catch (error) {\\n        console.error('Error clearing notifications:', error);\\n        return NextResponse.json({ message: 'An unexpected error occurred.' }, { status: 500 });\\n    }\\n}\"}", "tool_call_id": "toolu_bdrk_011Cfe2XVgzJjxjw7StmV1Au", "id": null, "provider_details": null, "part_kind": "tool-call"}

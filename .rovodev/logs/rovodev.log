);\n\ndescribe(\'Generation Service\', () => {\n  let mockDb: any;\n\n  beforeEach(() => {\n    jest.clearAllMocks();\n    \n    // Get the mocked db\n    const dbModule = require(\'@/db\');\n    mockDb = dbModule.db;\n\n    // Mock console.error to avoid cluttering test output\n    jest.spyOn(console, \'error\').mockImplementation(() => {});\n  });\n\n  afterEach(() => {\n    jest.restoreAllMocks();\n  });\n\n  // ============================================================================\n  // Basic Logging Operations\n  // ============================================================================\n\n  describe(\'logGeneration\', () => {\n    it(\'should log generation successfully\', async () => {\n      const logData = {\n        agentId: \'agent_123\',\n        userId: \'456\',\n        input: { text: \'Test input\' },\n        output: { result: \'Test output\' },\n        creditCost: 5,\n      };\n\n      await logGeneration(logData);\n\n      expect(mockDb.insert).toHaveBeenCalled();\n      expect(mockDb.values).toHaveBeenCalledWith(\n        expect.objectContaining({\n          agentId: \'agent_123\',\n          userId: 456,\n          creditsUsed: 5,\n          status: \'completed\',\n        })\n      );\n    });\n\n    it(\'should add timestamp to log entry\', async () => {\n      const beforeLog = new Date();\n\n      await logGeneration({\n        agentId: \'agent_123\',\n        userId: \'456\',\n        input: {},\n        output: {},\n        creditCost: 1,\n      });\n\n      const callArgs = mockDb.values.mock.calls[0][0];\n      const afterLog = new Date();\n\n      expect(callArgs.createdAt).toBeDefined();\n      expect(callArgs.createdAt.getTime()).toBeGreaterThanOrEqual(beforeLog.getTime());\n      expect(callArgs.createdAt.getTime()).toBeLessThanOrEqual(afterLog.getTime());\n    });\n\n    it(\'should handle complex input data\', async () => {\n      const complexInput = {\n        text: \'Generate a report\',\n        options: {\n          language: \'en\',\n          style: \'formal\',\n          sections: [\'intro\', \'body\', \'conclusion\'],\n        },\n        metadata: {\n          projectId: \'proj_123\',\n          version: \'1.0\',\n        },\n      };\n\n      await logGeneration({\n        agentId: \'agent_123\',\n        userId: \'456\',\n        input: complexInput,\n        output: {},\n        creditCost: 10,\n      });\n\n      expect(mockDb.values).toHaveBeenCalledWith(\n        expect.objectContaining({\n          metadata: expect.objectContaining({\n            input: complexInput,\n          }),\n        })\n      );\n    });\n\n    it(\'should handle complex output data\', async () => {\n      const complexOutput = {\n        text: \'Generated report...\',\n        metadata: {\n          wordCount: 1500,\n          duration: 5000,\n          model: \'gemini-pro\',\n        },\n        sections: [\n          { title: \'Introduction\', content: \'...\' },\n          { title: \'Body\', content: \'...\' },\n        ],\n      };\n\n      await logGeneration({\n        agentId: \'agent_123\',\n        userId: \'456\',\n        input: {},\n        output: complexOutput,\n        creditCost: 15,\n      });\n\n      expect(mockDb.values).toHaveBeenCalledWith(\n        expect.objectContaining({\n          output: JSON.stringify(complexOutput),\n        })\n      );\n    });\n\n    it(\'should handle zero credit cost\', async () => {\n      await logGeneration({\n        agentId: \'agent_free\',\n        userId: \'456\',\n        input: {},\n        output: {},\n        creditCost: 0,\n      });\n\n      expect(mockDb.values).toHaveBeenCalledWith(\n        expect.objectContaining({\n          creditsUsed: 0,\n        })\n      );\n    });\n\n    it(\'should handle large credit costs\', async () => {\n      await logGeneration({\n        agentId: \'agent_expensive\',\n        userId: \'456\',\n        input: {},\n        output: {},\n        creditCost: 100,\n      });\n\n      expect(mockDb.values).toHaveBeenCalledWith(\n        expect.objectContaining({\n          creditsUsed: 100,\n        })\n      );\n    });\n\n    it(\'should handle decimal credit costs\', async () => {\n      await logGeneration({\n        agentId: \'agent_123\',\n        userId: \'456\',\n        input: {},\n        output: {},\n        creditCost: 2.5,\n      });\n\n      expect(mockDb.values).toHaveBeenCalledWith(\n        expect.objectContaining({\n          creditsUsed: 2.5,\n        })\n      );\n    });\n  });\n\n  // ============================================================================\n  // Different Agent Types\n  // ============================================================================\n\n  describe(\'Different agent types\', () => {\n    it(\'should log text generation\', async () => {\n      await logGeneration({\n        agentId: \'text-generator\',\n        userId: \'user_123\',\n        input: { prompt: \'Write a story\' },\n        output: { text: \'Once upon a time...\' },\n        creditCost: 3,\n      });\n\n      expect(mockCollection.add).toHaveBeenCalled();\n    });\n\n    it(\'should log image generation\', async () => {\n      await logGeneration({\n        agentId: \'image-generator\',\n        userId: \'user_123\',\n        input: { prompt: \'A sunset\' },\n        output: { imageUrl: \'https://example.com/image.png\' },\n        creditCost: 10,\n      });\n\n      expect(mockCollection.add).toHaveBeenCalled();\n    });\n\n    it(\'should log analysis operations\', async () => {\n      await logGeneration({\n        agentId: \'plagiarism-checker\',\n        userId: \'user_123\',\n        input: { text: \'Document content...\' },\n        output: { plagiarismScore: 5.2, matches: [] },\n        creditCost: 5,\n      });\n\n      expect(mockCollection.add).toHaveBeenCalled();\n    });\n\n    it(\'should log transformation operations\', async () => {\n      await logGeneration({\n        agentId: \'markdown-to-pdf\',\n        userId: \'user_123\',\n        input: { markdown: \'# Title\\n\\nContent\' },\n        output: { pdfUrl: \'https://example.com/doc.pdf\' },\n        creditCost: 2,\n      });\n\n      expect(mockCollection.add).toHaveBeenCalled();\n    });\n  });\n\n  // ============================================================================\n  // Error Handling\n  // ============================================================================\n\n  describe(\'Error handling\', () => {\n    it(\'should not throw when logging fails\', async () => {\n      mockCollection.add.mockRejectedValue(new Error(\'Database error\'));\n\n      // Should not throw - logging is non-critical\n      await expect(\n        logGeneration({\n          agentId: \'agent_123\',\n          userId: \'user_456\',\n          input: {},\n          output: {},\n          creditCost: 5,\n        })\n      ).resolves.not.toThrow();\n    });\n\n    it(\'should log error when logging fails\', async () => {\n      const error = new Error(\'Network timeout\');\n      mockCollection.add.mockRejectedValue(error);\n\n      await logGeneration({\n        agentId: \'agent_123\',\n        userId: \'user_456\',\n        input: {},\n        output: {},\n        creditCost: 5,\n      });\n\n      expect(console.error).toHaveBeenCalledWith(\n        \'Failed to log generation for agent agent_123:\',\n        error\n      );\n    });\n\n    it(\'should handle Firestore permission errors\', async () => {\n      mockCollection.add.mockRejectedValue(\n        new Error(\'PERMISSION_DENIED: Missing or insufficient permissions\')\n      );\n\n      await logGeneration({\n        agentId: \'agent_123\',\n        userId: \'user_456\',\n        input: {},\n        output: {},\n        creditCost: 5,\n      });\n\n      expect(console.error).toHaveBeenCalled();\n    });\n\n    it(\'should handle Firestore quota errors\', async () => {\n      mockCollection.add.mockRejectedValue(\n        new Error(\'RESOURCE_EXHAUSTED: Quota exceeded\')\n      );\n\n      await logGeneration({\n        agentId: \'agent_123\',\n        userId: \'user_456\',\n        input: {},\n        output: {},\n        creditCost: 5,\n      });\n\n      expect(console.error).toHaveBeenCalled();\n    });\n\n    it(\'should handle null/undefined values gracefully\', async () => {\n      await logGeneration({\n        agentId: \'agent_123\',\n        userId: \'user_456\',\n        input: null as any,\n        output: undefined as any,\n        creditCost: 0,\n      });\n\n      expect(mockCollection.add).toHaveBeenCalledWith(\n        expect.objectContaining({\n          input: null,\n          output: undefined,\n        })\n      );\n    });\n  });\n\n  // ============================================================================\n  // Multiple Operations\n  // ============================================================================\n\n  describe(\'Multiple operations\', () => {\n    it(\'should handle concurrent logging\', async () => {\n      const logs = [\n        {\n          agentId: \'agent_1\',\n          userId: \'user_1\',\n          input: {},\n          output: {},\n          creditCost: 1,\n        },\n        {\n          agentId: \'agent_2\',\n          userId: \'user_2\',\n          input: {},\n          output: {},\n          creditCost: 2,\n        },\n        {\n          agentId: \'agent_3\',\n          userId: \'user_3\',\n          input: {},\n          output: {},\n          creditCost: 3,\n        },\n      ];\n\n      await Promise.all(logs.map(log => logGeneration(log)));\n\n      expect(mockCollection.add).toHaveBeenCalledTimes(3);\n    });\n\n    it(\'should handle sequential logging\', async () => {\n      await logGeneration({\n        agentId: \'agent_1\',\n        userId: \'user_123\',\n        input: { step: 1 },\n        output: { result: 1 },\n        creditCost: 1,\n      });\n\n      await logGeneration({\n        agentId: \'agent_2\',\n        userId: \'user_123\',\n        input: { step: 2 },\n        output: { result: 2 },\n        creditCost: 2,\n      });\n\n      await logGeneration({\n        agentId: \'agent_3\',\n        userId: \'user_123\',\n        input: { step: 3 },\n        output: { result: 3 },\n        creditCost: 3,\n      });\n\n      expect(mockCollection.add).toHaveBeenCalledTimes(3);\n    });\n\n    it(\'should continue logging after failure\', async () => {\n      // First call fails\n      mockCollection.add.mockRejectedValueOnce(new Error(\'Temporary error\'));\n\n      await logGeneration({\n        agentId: \'agent_1\',\n        userId: \'user_123\',\n        input: {},\n        output: {},\n        creditCost: 1,\n      });\n\n      // Second call succeeds\n      mockCollection.add.mockResolvedValueOnce({ id: \'gen_456\' });\n\n      await logGeneration({\n        agentId: \'agent_2\',\n        userId: \'user_123\',\n        input: {},\n        output: {},\n        creditCost: 2,\n      });\n\n      expect(mockCollection.add).toHaveBeenCalledTimes(2);\n    });\n  });\n\n  // ============================================================================\n  // Data Integrity\n  // ============================================================================\n\n  describe(\'Data integrity\', () => {\n    it(\'should preserve data types in input\', async () => {\n      const input = {\n        string: \'text\',\n        number: 42,\n        boolean: true,\n        array: [1, 2, 3],\n        object: { key: \'value\' },\n        null: null,\n      };\n\n      await logGeneration({\n        agentId: \'agent_123\',\n        userId: \'user_456\',\n        input,\n        output: {},\n        creditCost: 5,\n      });\n\n      expect(mockCollection.add).toHaveBeenCalledWith(\n        expect.objectContaining({\n          input,\n        })\n      );\n    });\n\n    it(\'should preserve data types in output\', async () => {\n      const output = {\n        string: \'result\',\n        number: 99.9,\n        boolean: false,\n        array: [\'a\', \'b\', \'c\'],\n        object: { nested: { deep: \'value\' } },\n      };\n\n      await logGeneration({\n        agentId: \'agent_123\',\n        userId: \'user_456\',\n        input: {},\n        output,\n        creditCost: 5,\n      });\n\n      expect(mockCollection.add).toHaveBeenCalledWith(\n        expect.objectContaining({\n          output,\n        })\n      );\n    });\n\n    it(\'should handle large data payloads\', async () => {\n      const largeInput = {\n        text: \'A\'.repeat(10000), // 10KB of text\n      };\n\n      const largeOutput = {\n        result: \'B\'.repeat(50000), // 50KB of text\n      };\n\n      await logGeneration({\n        agentId: \'agent_123\',\n        userId: \'user_456\',\n        input: largeInput,\n        output: largeOutput,\n        creditCost: 20,\n      });\n\n      expect(mockCollection.add).toHaveBeenCalled();\n    });\n\n    it(\'should handle special characters in data\', async () => {\n      const specialChars = {\n        unicode: \'你好世界 🚀 émojis\',\n        escaped: \'Line 1\\nLine 2\\tTabbed\',\n        quotes: \'He said "Hello"\',\n      };\n\n      await logGeneration({\n        agentId: \'agent_123\',\n        userId: \'user_456\',\n        input: specialChars,\n        output: specialChars,\n        creditCost: 5,\n      });\n\n      expect(mockCollection.add).toHaveBeenCalledWith(\n        expect.objectContaining({\n          input: specialChars,\n          output: specialChars,\n        })\n      );\n    });\n  });\n\n  // ============================================================================\n  // Use Cases\n  // ============================================================================\n\n  describe(\'Real-world use cases\', () => {\n    it(\'should log document generation\', async () => {\n      await logGeneration({\n        agentId: \'document-writer\',\n        userId: \'user_academic\',\n        input: {\n          title: \'Research Paper\',\n          topic: \'Machine Learning\',\n          sections: [\'Introduction\', \'Methodology\', \'Results\'],\n          style: \'academic\',\n        },\n        output: {\n          document: \'# Research Paper\\n\\n...\',\n          wordCount: 2500,\n          readingTime: 10,\n        },\n        creditCost: 15,\n      });\n\n      expect(mockCollection.add).toHaveBeenCalled();\n    });\n\n    it(\'should log grammar checking\', async () => {\n      await logGeneration({\n        agentId: \'grammar-checker\',\n        userId: \'user_student\',\n        input: {\n          text: \'This is a sentance with errors.\',\n        },\n        output: {\n          corrections: [\n            { original: \'sentance\', corrected: \'sentence\', position: 10 },\n          ],\n          score: 95,\n        },\n        creditCost: 3,\n      });\n\n      expect(mockCollection.add).toHaveBeenCalled();\n    });\n\n    it(\'should log translation\', async () => {\n      await logGeneration({\n        agentId: \'translator\',\n        userId: \'user_translator\',\n        input: {\n          text: \'Hello, world!\',\n          sourceLanguage: \'en\',\n          targetLanguage: \'ar\',\n        },\n        output: {\n          translatedText: \'مرحبا بالعالم!\',\n          confidence: 0.98,\n        },\n        creditCost: 2,\n      });\n\n      expect(mockCollection.add).toHaveBeenCalled();\n    });\n\n    it(\'should log summarization\', async () => {\n      await logGeneration({\n        agentId: \'summarizer\',\n        userId: \'user_researcher\',\n        input: {\n          text: \'Very long article...\',\n          maxLength: 100,\n        },\n        output: {\n          summary: \'Article summary...\',\n          compressionRatio: 0.1,\n        },\n        creditCost: 5,\n      });\n\n      expect(mockCollection.add).toHaveBeenCalled();\n    });\n\n    it(\'should log AI detection\', async () => {\n      await logGeneration({\n        agentId: \'ai-detector\',\n        userId: \'user_teacher\',\n        input:
getContext('2d');\n            if (context) {\n                context.font = `${fontSize}pt \"${fontFace}\"`;\n                canvasContextCache[key] = context;\n                return context;\n            }\n        }\n    } catch (probingError) {\n        // Fall through to heuristic if DOM access throws\n    }\n\n    const fallback = getHeuristicContext();\n    canvasContextCache[key] = fallback;\n    return fallback;\n}\n\n/**\n * Calculates the number of lines a given text will occupy with word wrapping.\n */\nexport function calculateLineCount(text: string, fontFace: string, fontSize: number, maxWidthInches: number): number {\n    if (!text || !String(text).trim()) {\n        return 1;\n    }\n\n    try {\n        const context = getCanvasContext(fontFace, fontSize);\n        const maxWidthPx = maxWidthInches * POINTS_PER_INCH;\n\n        const paragraphs = String(text).split('\\n');\n        let totalLines = 0;\n\n        for (const paragraph of paragraphs) {\n            const trimmed = paragraph.trim();\n            if (!trimmed) {\n                totalLines++;\n                continue;\n            }\n            const words = trimmed.split(' ');\n            let lineCount = 1;\n            let currentLine = '';\n\n            for (const word of words) {\n                const testLine = currentLine ? `${currentLine} ${word}` : word;\n                const metrics = context.measureText(testLine);\n                if (metrics.width > maxWidthPx && currentLine) {\n                    lineCount++;\n                    currentLine = word;\n                } else {\n                    currentLine = testLine;\n                }\n            }\n            totalLines += lineCount;\n        }\n\n        return Math.max(1, totalLines);\n    } catch (e) {\n        console.error('[Export:PPTX] Line count calculation failed:', e);\n        return 1; \n    }\n}\n\n/**\n * Calculates the number of lines a code block will occupy.\n */\nexport function calculateCodeLineCount(text: string, fontFace: string, fontSize: number, maxWidthInches: number): number {\n    if (!text) {\n        return 1;\n    }\n\n    try {\n        const context = getCanvasContext(fontFace, fontSize);\n        const maxWidthPx = maxWidthInches * POINTS_PER_INCH;\n\n        const lines = String(text).split('\\n');\n        let totalLines = 0;\n\n        for (const line of lines) {\n            if (line === '') {\n                totalLines++;\n                continue;\n            }\n            const metrics = context.measureText(line);\n            const lineWraps = Math.ceil(metrics.width / maxWidthPx);\n            totalLines += Math.max(1, lineWraps);\n        }\n\n        return Math.max(1, totalLines);\n    } catch (e) {\n        console.error('[Export:PPTX] Code line count calculation failed:', e);\n        return 1;\n    }\n}\n", "overwrite": true, "file_path": "src/modules/templates/infrastructure/exporters/pptx/text-measurement.ts"}, "tool_call_id": "pyd_ai_1b198b0d552840c3934852ccc8a5797e", "id": null, "provider_name": "google-vertex", "provider_details": {"thought_signature": "ZTI0ODMwYTctNWNkNi00MmZlLTk5OGItZWU1MzllNzJiOWMz"}, "part_kind": "tool-call"}

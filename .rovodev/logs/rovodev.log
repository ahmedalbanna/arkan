`);\n  41         console.log(`📋 Project: ${input.title}`);\n  42         console.log(`👤 Student: ${input.studentName}`);\n  43         console.log(`🏛️  University: ${input.university}`);\n  44         console.log(`🎯 Type: ${input.projectType}`);\n  45         console.log(`📊 Detail Level: ${input.detailLevel}`);\n  46         console.log(`${'='.repeat(60)}\\n`);\n  47 \n  48         const startTime = Date.now();\n  49 \n  50         // Determine which chapters to generate\n  51         const chaptersToGenerate = input.chaptersToGenerate || [\n  52             'abstract',\n  53             'introduction',\n  54             'literature_review',\n  55             'methodology',\n  56             'system_analysis',\n  57             'system_design',\n  58             'implementation',\n  59             'testing',\n  60             'results',\n  61             'discussion',\n  62             'conclusion',\n  63             'recommendations',\n  64         ];\n  65 \n  66         console.log(`📝 Generating ${chaptersToGenerate.length} chapters...\\n`);\n  67 \n  68         // ==================== CHAPTER 1: ABSTRACT ====================\n  69         let abstractContent;\n  70         if (chaptersToGenerate.includes('abstract')) {\n  71             console.log('📄 [1/12] Generating Abstract...');\n  72             const abstractResult = await abstractPrompt({\n  73                 title: input.title,\n  74                 projectType: input.projectType,\n  75                 problemStatement: input.problemStatement,\n  76                 objectives: input.objectives,\n  77                 methodology: input.methodology,\n  78                 keywords: input.keywords,\n  79             });\n  80 \n  81             const abstractGenerated = await ai.generate({\n  82                 model: 'ollama/llama2:7b',\n  83                 prompt: abstractResult.text,\n  84             });\n  85 \n  86             abstractContent = {\n  87                 background: abstractGenerated.
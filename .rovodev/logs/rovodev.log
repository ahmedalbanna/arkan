127                 fill: 'F8F9FA'\n 128             },\n 129             bidirectional: isArabic\n 130         })\n 131     );\n 132     \n 133     // Project Description/Subtitle\n 134     if (project.projectDescription) {\n 135         coverPageElements.push(\n 136             new Paragraph({\n 137                 text: project.projectDescription,\n 138                 heading: HeadingLevel.HEADING_2,\n 139                 alignment: AlignmentType.CENTER,\n 140                 spacing: { before: 240, after: 480 },\n 141                 bidirectional: isArabic\n 142             })\n 143         );\n 144     }\n 145     \n 146     // Decorative line separator\n 147     coverPageElements.push(\n 148         new Paragraph({\n 149             alignment: AlignmentType.CENTER,\n 150             spacing: { before: 240, after: 240 },\n 151             border: {\n 152                 top: { color: 'CCCCCC', space: 1, style: BorderStyle.SINGLE, size: 6 }\n 153             }\n 154         })\n 155     );\n 156     \n 157     // Project Metadata Section\n 158     const metadataItems: { label: string; value: string }[] = [];\n 159     \n 160     if (project.projectType) {\n 161         metadataItems.push({ \n 162             label: isArabic ? '\u0646\u0648\u0639 \u0627\u0644\u0645\u0634\u0631\u0648\u0639' : 'Project Type', \n 163             value: project.projectType \n 164         });\n 165     }\n 166     \n 167     if (project.specialization) {\n 168         metadataItems.push({ \n 169             label: isArabic ? '\u0627\u0644\u062a\u062e\u0635\u0635' : 'Specialization', \n 170             value: project.specialization \n 171         });\n 172     }\n 173     \n 174     // Add metadata as a styled box\n 175     if (metadataItems.length > 0) {\n 176         metadataItems.forEach(item => {\n 177             coverPageElements.push(\n 178                 new Paragraph({\n 179                     alignment: AlignmentType.CENTER,\n 180                     spacing: { before: 120, after: 120 },\n 181                     bidirectional: isArabic,\n 182                     children: [\n 183                         new TextRun({\n 184                             text: `${item.label}: `,\n 185                             bold: true,\n 186                             size: 24,\n 187                             color: '2C3E50'\n 188                         }),\n 189                         new TextRun({\n 190                             text: item.value,\n 191                             size: 24,\n 192                             color: '34495E'\n 193                         })\n 194                     ]\n 195                 })\n 196             );\n 197         });\n 198         \n 199         coverPageElements.push(\n 200             new Paragraph({ spacing: { before: 240, after: 240 } })\n 201         );\n 202     }\n 203     \n 204     // Team Members Section with Box Design\n 205     if (project.teamMembers && project.teamMembers.length > 0) {\n 206         coverPageElements.push(\n 207             new Paragraph({\n 208                 text: isArabic ? '\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0637\u0644\u0627\u0628' : 'Prepared by',\n 209                 alignment: AlignmentType.CENTER,\n 210                 spacing: { before: 360, after: 240 },\n 211                 bidirectional: isArabic,\n 212                 children: [\n 213                     new TextRun({\n 214                         text: isArabic ? '\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0637\u0644\u0627\u0628' : 'Prepared by',\n 215                         bold: true,\n 216                         size: 28,\n 217                         color: '1F4788',\n 218                         underline: { type: 'single' }\n 219                     })\n 220                 ]\n 221             })\n 222         );\n 223         \n 224         project.teamMembers.forEach((member: string, index: number) => {\n 225             coverPageElements.push(\n 226                 new Paragraph({\n 227                     alignment: AlignmentType.CENTER,\n 228                     spacing: { before: 160, after: 160 },\n 229                     bidirectional: isArabic,\n 230                     shading: {\n 231                         type: ShadingType.CLEAR,\n 232                         fill: index % 2 === 0 ? 'F8F9FA' : 'FFFFFF'\n 233                     },\n 234                     border: {\n 235                         left: { color: '4A90E2', space: 2, style: BorderStyle.SINGLE, size: 12 }\n 236                     },\n 237                     children: [\n 238                         new TextRun({\n 239                             text: member,\n 240                             size: 26,\n 241                             bold: true,\n 242                             color: '2C3E50'\n 243                         })\n 244                     ]\n 245                 })\n 246             );\n 247         });\n 248         \n 249         coverPageElements.push(\n 250             new Paragraph({ spacing: { before: 360, after: 240 } })\n 251         );\n 252     }\n 253     \n 254     // Supervisor Section - Highlighted\n 255     if (project.supervisor) {\n 256         coverPageElements.push(\n 257             new Paragraph({\n 258                 alignment: AlignmentType.CENTER,\n 259                 spacing: { before: 480, after: 240 },\n 260                 bidirectional: isArabic,\n 261                 children: [\n 262                     new TextRun({\n 263                         text: isArabic ? '\u0625\u0634\u0631\u0627\u0641' : 'Supervised by',\n 264                         size: 24,\n 265                         bold: true,\n 266                         color: '7F8C8D'\n 267                     })\n 268                 ]\n 269             }),\n 270             new Paragraph({\n 271                 text: project.supervisor,\n 272                 heading: HeadingLevel.HEADING_3,\n 273                 alignment: AlignmentType.CENTER,\n 274                 spacing: { before: 120, after: 480 },\n 275                 bidirectional: isArabic,\n 276                 border: {\n 277                     top: { color: '4A90E2', space: 2, style: BorderStyle.SINGLE, size: 6 },\n 278                     bottom: { color: '4A90E2', space: 2, style: BorderStyle.SINGLE, size: 6 }\n 279                 },\n 280                 shading: {\n 281                     type: ShadingType.CLEAR,\n 282                     fill: 'E8F4F8'\n 283                 }\n 284             })\n 285         );\n 286     }\n 287     \n 288     // Institution Information - Boxed Section\n 289     coverPageElements.push(\n 290         new Paragraph({\n 291             alignment: AlignmentType.CENTER,\n 292             spacing: { before: 480, after: 0 },\n 293             border: {\n 294                 top: { color: '2C3E50', space: 2, style: BorderStyle.DOUBLE, size: 12 }\n 295             }\n 296         })\n 297     );\n 298     \n 299     if (project.university) {\n 300         coverPageElements.push(\n 301             new Paragraph({\n 302                 text: project.university,\n 303                 heading: HeadingLevel.HEADING_3,\n 304                 alignment: AlignmentType.CENTER,\n 305                 spacing: { before: 360, after: 200 },\n 306                 bidirectional: isArabic,\n 307                 shading: {\n 308                     type: ShadingType.CLEAR,\n 309                     fill: 'F0F3F5'\n 310                 }\n 311             })\n 312         );\n 313     }\n 314     \n 315     if (project.course) {\n 316         coverPageElements.push(\n 317             new Paragraph({\n 318                 alignment: AlignmentType.CENTER,\n 319                 spacing: { before: 160, after: 160 },\n 320                 bidirectional: isArabic,\n 321                 children: [\n 322                     new TextRun({\n 323                         text: project.course,\n 324                         size: 26,\n 325                         bold: true,\n 326                         color: '34495E'\n 327                     })\n 328                 ]\n 329             })\n 330         );\n 331     }\n 332     \n 333     if (project.educationalLevel) {\n 334         coverPageElements.push(\n 335             new Paragraph({\n 336                 alignment: AlignmentType.CENTER,\n 337                 spacing: { before: 120, after: 360 },\n 338                 bidirectional: isArabic,\n 339                 children: [\n 340                     new TextRun({\n 341                         text: project.educationalLevel,\n 342                         size: 22,\n 343                         italics: true,\n 344                         color: '7F8C8D'\n 345                     })\n 346                 ]\n 347             })\n 348         );\n 349     }\n 350     \n 351     // Date and Academic Year - Bottom Section\n 352     coverPageElements.push(\n 353         new Paragraph({\n 354             alignment: AlignmentType.CENTER,\n 355             spacing: { before: 480, after: 0 },\n 356             border: {\n 357                 top: { color: '2C3E50', space: 2, style: BorderStyle.DOUBLE, size: 12 }\n 358             }\n 359         })\n 360     );\n 361     \n 362     const dateLocale = isArabic ? 'ar-SA' : 'en-US';\n 363     const formattedDate = new Date().toLocaleDateString(dateLocale, {\n 364         year: 'numeric',\n 365         month: 'long',\n 366         day: 'numeric'\n 367     });\n 368     \n 369     const currentYear = new Date().getFullYear();\n 370     const academicYear = `${currentYear}-${currentYear + 1}`;\n 371     const yearLabel = isArabic ? '\u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u062f\u0631\u0627\u0633\u064a' : 'Academic Year';\n 372     \n 373     coverPageElements.push(\n 374         new Paragraph({\n 375             alignment: AlignmentType.CENTER,\n 376             spacing: { before: 360, after: 120 },\n 377             bidirectional: isArabic,\n 378             children: [\n 379                 new TextRun({\n 380                     text: formattedDate,\n 381                     size: 24,\n 382                     bold: true,\n 383                     color: '2C3E50'\n 384                 })\n 385             ]\n 386         }),\n 387         new Paragraph({\n 388             alignment: AlignmentType.CENTER,\n 389             spacing: { before: 120, after: 480 },\n 390             bidirectional: isArabic,\n 391             children: [\n 392                 new TextRun({\n 393                     text: `${yearLabel} ${academicYear}`,\n 394                     size: 22,\n 395                     italics: true,\n 396                     color: '7F8C8D'\n 397                 })\n 398             ]\n 399         })\n 400     );\n 401     \n 402     return coverPageElements;\n 403 }\n 404 \n 405 // Overload for Project object or plain project data\n 406 export async function convertMarkdownToWord(\n 407   project: Project | any,\n 408   options?: ConversionOptions & { selectedContent?: ProjectContent }\n 409 ): Promise<Buffer | Blob>;\n 410 \n 411 // Overload for markdown string\n 412 export async function convertMarkdownToWord(\n 413   markdown: string,\n 414   fileName: string,\n 415   options?: ConversionOptions\n 416 ): Promise<Buffer | Blob>;\n 417 \n 418 /**\n 419  * Converts a Project object (or plain project data) or a raw markdown string to a styled .docx file.\n 420  * This is the main server-side function for DOCX generation.\n 421  * \n 422  * Note: Accepts both Project instances and plain project data objects to support\n 423  * server-side rendering where client components cannot be instantiated.\n 424  */\n 425 export async function convertMarkdownToWord(\n 426   projectOrMarkdown: Project | any | string,\n 427   optionsOrFileName?: (ConversionOptions & { selectedContent?: ProjectContent }) | string,\n 428   optionsForMarkdown: ConversionOptions = {}\n 429 ): Promise<Buffer | Blob> {\n 430   try {\n 431     // Input validation\n 432     if (!projectOrMarkdown) {\n 433       throw new Error('Input is required: provide either a Project object or markdown string');\n 434     }\n 435 \n 436     // Check if input is a Project-like object (either instance or plain object)\n 437     if (typeof projectOrMarkdown === 'object' && projectOrMarkdown !== null && 'content' in projectOrMarkdown) {\n 438       // Handle Project object or plain project data\n 439       const project = projectOrMarkdown as any;\n 440       const options = (optionsOrFileName as (ConversionOptions & { selectedContent?: ProjectContent })) || {};\n 441       const { styles, selectedContent, coverPageMarkdown: explicitCoverPage } = options;\n 442 \n 443       const finalStyles: IStylesOptions = {\n 444         ...styles,\n 445         paragraphStyles: [...(styles?.paragraphStyles || [])],\n 446       };\n 447 \n 448       const captionStyleExists = finalStyles.paragraphStyles!.some(style => style.id === 'Caption');\n 449       if (!captionStyleExists) {\n 450         (finalStyles.paragraphStyles as any).push({\n 451           id: 'Caption',\n 452           name: 'Caption',\n 453           basedOn: 'Normal',\n 454           next: 'Normal',\n 455           quickFormat: true,\n 456           run: { size: 18, italics: true, color: '595959' },\n 457           paragraph: {\n 458             alignment: AlignmentType.CENTER,\n 459             spacing: { before: 120, after: 240 },\n 460           },\n 461         });\n 462       }\n 463 \n 464       // Validate project has content\n 465       const contentToExport = selectedContent || project.content;\n 466       if (!contentToExport || contentToExport.length === 0) {\n 467         throw new Error('Project has no content to export');\n 468       }\n 469     \n 470     // Generate markdown safely\n 471     let markdown: string;\n 472     try {\n 473       // If we're exporting the full project, use the raw markdown from the editor (source of truth)\n 474       // Otherwise, generate markdown for the specific selected subset.\n 475       const isFullExport = !selectedContent || (selectedContent.length === project.content.length);\n 476       \n 477       if (isFullExport && project.fullMarkdownContent) {\n 478         markdown = project.fullMarkdownContent;\n 479       } else {\n 480         markdown = generateMarkdownFromContent(contentToExport);\n 481       }\n 482 \n 483       if (!markdown || markdown.trim().length === 0) {\n 484         throw new Error('Generated markdown is empty');\n 485       }\n 486     } catch (error) {\n 487       throw new Error(`Failed to generate markdown from content: ${error instanceof Error ? error.message : 'Unknown error'}`);\n 488     }\n 489 \n 490     // Extract footnotes safely\n 491     const fullProjectMarkdown = project.fullMarkdownContent || '';\n 492     const footnoteRegex = /^\\[\\^.+?\\]:.+$/gm;\n 493     const footnoteDefinitions = fullProjectMarkdown.match(footnoteRegex);\n 494 \n 495     let finalMarkdown = markdown;\n 496     // Only append footnotes if they aren't already in the markdown (to avoid duplicates for full exports)\n 497     if (footnoteDefinitions && footnoteDefinitions.length > 0) {\n 498       const existingFootnotes = (markdown.match(footnoteRegex) || []) as string[];\n 499       const newFootnotes = footnoteDefinitions.filter((fn: string) => !existingFootnotes.includes(fn));\n 500       \n 501       if (newFootnotes.length > 0) {\n 502         finalMarkdown += '\\n\\n' + newFootnotes.join('\\n');\n 503       }\n 504     }\n 505 \n 506     // Create DOCX content with error handling\n 507     let docxObjects: DocxObject[];\n 508     let docxFootnotes: any;\n 509     try {\n 510       const result = await createDocxContent(finalMarkdown, options);\n 511       docxObjects = result.docxObjects;\n 512       docxFootnotes = result.docxFootnotes;\n 513       \n 514       if (!docxObjects || docxObjects.length === 0) {\n 515         console.warn('No DOCX objects generated from markdown');\n 516       }\n 517     } catch (error) {\n 518       throw new Error(`Failed to create DOCX content: ${error instanceof Error ? error.message : 'Unknown error'}`);\n 519     }\n 520 \n 521     // Generate professional cover page using direct docx API\n 522     let coverPageDocxObjects: DocxObject[] = [];\n 523     \n 524     if (!explicitCoverPage) {\n 525       // Use the new professional cover page generator\n 526       try {\n 527         const coverPageParagraphs = await createProfessionalCoverPage(project, options);\n 528         coverPageDocxObjects = coverPageParagraphs as any[];\n 529       } catch (error) {\n 530         console.error('Failed to generate professional cover page:', error);\n 531         // Fallback to empty cover page\n 532         coverPageDocxObjects = [];\n 533       }\n 534     } else {\n 535       // Use explicit cover page markdown if provided\n 536       try {\n 537         const { docxObjects: convertedCoverPageObjects } = await createDocxContent(explicitCoverPage, options);\n 538         coverPageDocxObjects = convertedCoverPageObjects || [];\n 539       } catch (error) {\n 540         console.error('Failed to generate cover page from markdown:', error);\n 541         coverPageDocxObjects = [];\n 542       }\n 543     }\n 544 \n 545     // Prepare headers and footers\n 546     const { headerConfiguration, footerConfiguration } = prepareHeadersAndFooters(options);\n 547     \n 548     // Build document sections\n 549     let sections;\n 550     try {\n 551       sections = await buildDocumentSections(docxObjects, coverPageDocxObjects, options, headerConfiguration, footerConfiguration);\n 552       if (!sections || sections.length === 0) {\n 553         throw new Error('No sections generated for document');\n 554       }\n 555     } catch (error) {\n 556       throw new Error(`Failed to build document sections: ${error instanceof Error ? error.message : 'Unknown error'}`);\n 557     }\n 558 \n 559     // Create final document\n 560     let doc;\n 561     try {\n 562       doc = new Document({\n 563         styles: finalStyles,\n 564         numbering: numbering,\n 565         footnotes: docxFootnotes,\n 566         sections: sections,\n 567       });\n 568     } catch (error) {\n 569       throw new Error(`Failed to create DOCX document: ${error instanceof Error ? error.message : 'Unknown error'}`);\n 570     }\n 571 \n 572     // Pack document\n 573     try {\n 574       if (typeof window === 'undefined') {\n 575         return await Packer.toBuffer(doc);\n 576       } else {\n 577         return await Packer.toBlob(doc);\n 578       }\n 579     } catch (error) {\n 580       throw new Error(`Failed to pack DOCX document: ${error instanceof Error ? error.message : 'Unknown error'}`);\n 581     }\n 582   } else {\n 583       // Handle markdown string\n 584       const markdown = projectOrMarkdown;\n 585       \n 586       // Validate markdown\n 587       if (typeof markdown !== 'string' || markdown.trim().length === 0) {\n 588         throw new Error('Invalid markdown: must be a non-empty string');\n 589       }\n 590       \n 591       const options = optionsForMarkdown || {};\n 592       const { styles } = options;\n 593 \n 594       const finalStyles: IStylesOptions = {\n 595         ...styles,\n 596         paragraphStyles: [...(styles?.paragraphStyles || [])],\n 597       };\n 598 \n 599       const captionStyleExists = finalStyles.paragraphStyles!.some(style => style.id === 'Caption');\n 600       if (!captionStyleExists) {\n 601           (finalStyles.paragraphStyles as any).push({\n 602               id: 'Caption',\n 603               name: 'Caption',\n 604               basedOn: 'Normal',\n 605               next: 'Normal',\n 606               quickFormat: true,\n 607               run: { size: 18, italics: true, color: '595959' },\n 608               paragraph: {\n 609                   alignment: AlignmentType.CENTER,\n 610                   spacing: { before: 120, after: 240 },\n 611               },\n 612           });\n 613       }\n 614 \n 615       // Create DOCX content with error handling\n 616       let docxObjects: DocxObject[];\n 617       let docxFootnotes: any;\n 618       try {\n 619         const result = await createDocxContent(markdown, options);\n 620         docxObjects = result.docxObjects;\n 621         docxFootnotes = result.docxFootnotes;\n 622         \n 623         if (!docxObjects || docxObjects.length === 0) {\n 624           throw new Error('No content generated from markdown');\n 625         }\n 626       } catch (error) {\n 627         throw new Error(`Failed to create DOCX content from markdown: ${error instanceof Error ? error.message : 'Unknown error'}`);\n 628       }\n 629 \n 630       const { headerConfiguration, footerConfiguration } = prepareHeadersAndFooters(options);\n 631       \n 632       // Build document sections\n 633       let sections;\n 634       try {\n 635         sections = await buildDocumentSections(docxObjects, [], options, headerConfiguration, footerConfiguration);\n 636         if (!sections || sections.length === 0) {\n 637           throw new Error('No sections generated for document');\n 638         }\n 639       } catch (error) {\n 640         throw new Error(`Failed to build document sections: ${error instanceof Error ? error.message : 'Unknown error'}`);\n 641       }\n 642 \n 643       // Create final document\n 644       let doc;\n 645       try {\n 646         doc = new Document({\n 647           styles: finalStyles,\n 648           numbering: numbering,\n 649           footnotes: docxFootnotes,\n 650           sections: sections,\n 651         });\n 652       } catch (error) {\n 653         throw new Error(`Failed to create DOCX document: ${error instanceof Error ? error.message : 'Unknown error'}`);\n 654       }\n 655 \n 656       // Pack document\n 657       try {\n 658         if (typeof window === 'undefined') {\n 659           return await Packer.toBuffer(doc);\n 660         } else {\n 661           return await Packer.toBlob(doc);\n 662         }\n 663       } catch (error) {\n 664         throw new Error(`Failed to pack DOCX document: ${error instanceof Error ? error.message : 'Unknown error'}`);\n 665       }\n 666     }\n 667   } catch (error) {\n 668     // Top-level error handler\n 669     console.error('Error in convertMarkdownToWord:', error);\n 670     throw new Error(`Document conversion failed: ${error instanceof Error ? error.message : 'Unknown error occurred'}`);\n 671   }\n 672 }\n 673 \n````", "tool_call_id": "pyd_ai_da305002f3c741328a8029297b992899", "metadata": null, "timestamp": "2026-04-05T07:39:10.913771+00:00", "part_kind": "tool-return"}

ct(projectData);\\n  69       if (result.isFailure) throw result.error;\\n  70       return result.getValue();\\n  71     },\\n  72     onSuccess: (savedProject) => {\\n  73       setHasUnsavedChanges(false);\\n  74       queryClient.invalidateQueries({ queryKey: projectKeys.lists(projectScope) });\\n  75       queryClient.invalidateQueries({ queryKey: projectKeys.detail(projectScope, savedProject.id ?? \'\') });\\n  76       toast({ title: \'Project Saved\', description: `\\"${savedProject.name}\\" has been saved to the cloud.` });\\n  77     },\\n  78     onError: (error: unknown) => {\\n  79       const description = error instanceof Error ? error.message : \'Failed to save project.\';\\n  80       toast({ title: \'Error\', description: `Failed to save project: ${description}`, variant: \'destructive\' });\\n  81     },\\n  82   });\\n  83 \\n  84   return {\\n  85     saveProjectMutation,\\n  86     isSaving: saveProjectMutation.isPending,\\n  87   };\\n  88 }\\n  89 \\n  90 export function useDeleteProject() {\\n  91   const queryClient = useQueryClient();\\n  92   const { user } = useAuth();\\n  93   const projectScope = user?.uid ?? \'anonymous\';\\n  94 \\n  95   return useMutation({\\n  96     mutationFn: async (projectId: string) => {\\n  97       const localService = container.resolve(LocalProjectService);\\n  98       const localDelete = localService.deleteProject(projectId);\\n  99 \\n 100       if (navigator.onLine && user) {\\n 101         try {\\n 102           const client = container.resolve(ProjectApiClient);\\n 103           const result = await client.deleteProject(projectId);\\n 104           if (result.isFailure) throw result.error;\\n 105         } catch (error) {\\n 106           console.error(\'Failed to delete from server:\', error);\\n 107         }\\n 108       }\\n 109 \\n 110       await localDelete;\\n 111       return projectId;\\n 112     },\\n 113     onSuccess: (projectId) => {\\n 114       toast({ title: \'Project Deleted\', description: \'The project has been successfully deleted.\' });\\n 115       queryClient.invalidateQueries({ queryKey: projectKeys.lists(projectScope) });\\n 116       queryClient.removeQueries({ queryKey: projectKeys.detail(projectScope, projectId) });\\n 117     },\\n 118     onError: (error: unknown) => {\\n 119       const description = error instanceof Error ? error.message : \'Delete failed.\';\\n 120       toast({ title: \'Delete Failed\', description, variant: \'destructive\' });\\n 121     },\\n 122   });\\n 123 }\\n 124 \\n````","Successfully opened src/modules/projects/adapters/controllers/ProjectController.ts:\\n\\n````typescript\\n   0 import { delay, inject, injectable } from \\"tsyringe\\";\\n   1 import { GetProjectsUseCase } from \\"../../application/use-cases/GetProjectsUseCase\\";\\n   2 import { SaveProjectUseCase } from \\"../../application/use-cases/SaveProjectUseCase\\";\\n   3 import { GetProjectByIdUseCase } from \\"../../application/use-cases/GetProjectByIdUseCase\\";\\n   4 import { DeleteProjectUseCase } from \\"../../application/use-cases/DeleteProjectUseCase\\";\\n   5 import { CreateSnapshotUseCase } from \\"../../application/use-cases/CreateSnapshotUseCase\\";\\n   6 import { GetSnapshotsUseCase } from \\"../../application/use-cases/GetSnapshotsUseCase\\";\\n   7 import { DeleteSnapshotUseCase } from \\"../../application/use-cases/DeleteSnapshotUseCase\\";\\n   8 import { Result } from \\"@/infrastructure/utils/result\\";\\n   9 import { Project, ProjectProperties } from \\"../../domain/entities/Project\\";\\n  10 import { ProjectError } from \\"../../domain/errors/ProjectErrors\\";\\n  11 import { ProjectSnapshot } from \\"../../domain/entities/ProjectSnapshot\\";\\n  12 \\n  13 @injectable()\\n  14 export class ProjectController {\\n  15     constructor(\\n  16         @inject(delay(() => GetProjectsUseCase))\\n  17         private getProjectsUseCase: GetProjectsUseCase,\\n  18         @inject(delay(() => SaveProjectUseCase))\\n  19    
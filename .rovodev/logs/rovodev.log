s: ApiHandlerOptions = {}) => {\\n  28   return async (request: NextRequest, context: { params: Promise<{ [key: string]: string }> }) => {\\n  29     try {\\n  30       // In Next.js 15, params is now a Promise\\n  31       const params = await context.params;\\n  32       \\n  33       const authorization = request.headers.get(\'Authorization\');\\n  34       if (!authorization?.startsWith(\'Bearer \')) {\\n  35         return handleApiError({ message: \'Unauthorized: Missing token\' }, 401);\\n  36       }\\n  37       const token = authorization.substring(7);\\n  38       const decodedToken = await adminAuth.verifyIdToken(token, true);\\n  39 \\n  40       if (!decodedToken || !decodedToken.uid) {\\n  41         return handleApiError({ message: \'Unauthorized: Invalid token\' }, 401);\\n  42       }\\n  43 \\n  44       const user = await getUserProfile(decodedToken.uid);\\n  45       if (!user) {\\n  46         return handleApiError({ message: \'Forbidden: User profile not found\' }, 403);\\n  47       }\\n  48 \\n  49       if (options.requireAdmin && user.role !== \'admin\') {\\n  50         return handleApiError({ message: \'Forbidden: Admin access required\' }, 403);\\n  51       }\\n  52 \\n  53       return handler({ request, user, token, params });\\n  54     } catch (error: any) {\\n  55       // All errors, including auth errors, are now piped through the central handler\\n  56       return handleApiError(error);\\n  57     }\\n  58   };\\n  59 };\\n  60 \\n  61 /**\\n  62  * Standardized error handler for API routes.\\n  63  * @param error - The error object.\\n  64  * @param defaultStatus - The HTTP status code to use if none is found on the error.\\n  65  * @returns A NextResponse object with a standardized error format.\\n  66  */\\n  67 export const handleApiError = (error: any, defaultStatus = 500) => {\\n  68   console.error(\\"API Route Error:\\", error);\\n  69 \\n  70   // 1. Handle Zod validation errors specifically\\n  71   if (error instanceof ZodError) {\\n  72     return NextResponse.json({ message: \'Validation failed\', errors: error.flatten().fieldErrors }, { status: 400 });\\n  73   }\\n  74 \\n  75   // 2. Attempt to handle as a Firebase error\\n  76   const firebaseError = handleFirebaseError(error);\\n  77   if (firebaseError instanceof CustomFirebaseError) {\\n  78     let status = 400; // Default for many auth errors\\n  79     if (firebaseError.code.includes(\'not-found\')) status = 404;\\n  80     if (firebaseError.code.includes(\'permission-denied\')) status = 403;\\n  81     if (firebaseError.code.includes(\'already-exists\')) status = 409;\\n  82     if (firebaseError.code.includes(\'unauthenticated\') || firebaseError.code.includes(\'token-expired\')) status = 401;\\n  83 \\n  84     return NextResponse.json({ message: firebaseError.message, code: firebaseError.code }, { status });\\n  85   }\\n  86 \\n  87   // 3. Handle custom thrown errors (e.g., from our own logic)\\n  88   if (error.status && error.message) {\\n  89     return NextResponse.json({ message: error.message }, { status: error.status });\\n  90   }\\n  91 \\n  92   // 4. Fallback for generic/unexpected errors\\n  93   const message = error.message || \'An unexpected server error occurred.\';\\n  94   const status = error.status || defaultStatus;\\n  95 \\n  96   return NextResponse.json({ message }, { status });\\n  97 };\\n  98 \\n  99 \\n 100 /**\\n 101  * Standardized success response handler for API routes.\\n 102  * @param data - The data payload to send.\\n 103  * @param status - The HTTP status code.\\n 104  * @returns A NextResponse object.\\n 105  */\\n 106 export const createApiResponse = (data: any, status: number) => {\\n 107   return NextResponse.json(data, { status });\\n 108 };\\n 109 \\n````"]'}

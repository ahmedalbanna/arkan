                                                min={0} max={100} step={5}      
                                                className="py-2"                
                                            />                                  
                                        </div>                                  
                                                                                
                                        <div className="space-y-4">             
                                            <div className="flex justify-between
                    items-center group/label">                                  
                                                <div className="flex            

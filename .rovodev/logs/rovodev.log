 <div className="space-y-1.5 px-1">\n  69                 <h4 className="text-[10px] font-black uppercase tracking-[0.3em] text-primary/70 flex items-center gap-2.5">\n  70                     <SlidersHorizontal className="h-3.5 w-3.5" />\n  71                     Cognitive Vectors\n  72                 </h4>\n  73                 <p className="text-[9px] text-muted-foreground italic font-medium opacity-60 uppercase tracking-widest">\n  74                     Fine-tune the neural weight and linguistic elevation.\n  75                 </p>\n  76             </div>\n  77 \n  78             <div className="space-y-8 relative px-1">\n  79                 {/* Depth accent line */}\n  80                 <div className="absolute left-[-1.25rem] top-0 bottom-0 w-px bg-gradient-to-b from-primary/30 via-primary/5 to-transparent" />\n  81 \n  82                 {/* Linguistic Weight Zone */}\n  83                 <div className="space-y-6">\n  84                     <div className="space-y-4">\n  85                         <div className="flex justify-between items-center group/label">\n  86                             <div className="flex items-center gap-2">\n  87                                 <PenTool className="h-3.5 w-3.5 text-primary/40 group-hover/label:text-primary transition-colors" />\n  88                                 <Label className="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60">Neural Formality</Label>\n  89                             </div>\n  90                             <Badge variant="outline" className="h-5 text-[9px] font-black border-primary/20 bg-primary/5 text-primary tabular-nums shadow-inner ring-1 ring-inset ring-primary/10">\n  91                                 {section.controls.formality}%\n  92                             </Badge>\n  93                         </div>\n  94                         <Slider \n  95                             value={[section.controls.formality]} \n  96                             
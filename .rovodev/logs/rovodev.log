);\\n      router.push(\'/login\');\\n      window.location.reload();\\n    },\\n    onError: (error) => handleErrorUtility(error, \\"Logout Failed\\")\\n  });\\n}\\n\\nexport function useSignup(options?: { onSuccess?: (data: any) => void }) {\\n  const router = useRouter();\\n  const { toast } = useToast();\\n\\n  return useMutation({\\n    mutationFn: async (credentials: SignupCredentials) => {\\n      const response = await serviceSignupUser(credentials);\\n      return response;\\n    },\\n    onSuccess: (data) => {\\n      toast({\\n        title: \\"Account Created\\",\\n        description: \\"Your account has been successfully created. Please log in.\\",\\n      });\\n      router.push(\'/login\');\\n      options?.onSuccess?.(data);\\n    },\\n    onError: (error) => {\\n      handleErrorUtility(error, \'Signup Failed\');\\n    }\\n  });\\n}\\n\\nexport function useForgotPassword() {\\n  const { toast } = useToast();\\n  const router = useRouter();\\n  return useMutation({\\n    mutationFn: async (email: string) => {\\n      // With PostgreSQL, implement password reset via email\\n      const response = await fetch(\'/api/auth/forgot-password\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({ email }),\\n      });\\n      if (!response.ok) {\\n        const error = await response.json();\\n        throw new Error(error.message);\\n      }\\n      return response.json();\\n    },\\n    onSuccess: () => {\\n      toast({\\n        title: \\"Password Reset Email Sent\\",\\n        description: \\"Please check your inbox for instructions to reset your password.\\",\\n      });\\n      router.push(\'/login\');\\n    },\\n    onError: (error) => handleErrorUtility(error, \\"Password Reset Failed\\"),\\n  });\\n}\\n\\nexport function useForgotPasswordLoggedIn() {\\n  const { user } = useAuth();\\n  const { toast } = useToast();\\n  return useMutation({\\n    mutationFn: async () => {\\n      if (!user?.email) {\\n        throw new Error(\\"No authenticated user email found.\\");\\n      }\\n      const response = await fetch(\'/api/auth/forgot-password\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({ email: user.email }),\\n      });\\n      if (!response.ok) {\\n        const error = await response.json();\\n        throw new Error(error.message);\\n      }\\n      return response.json();\\n    },\\n    onSuccess: () => {\\n      toast({\\n        title: \\"Password Reset Email Sent\\",\\n        description: \\"Please check your inbox for instructions to reset your password.\\",\\n      });\\n    },\\n    onError: (error) => handleErrorUtility(error, \\"Failed to send reset email\\"),\\n  });\\n}\\n\\nexport function useSendPasswordReset() {\\n  const { user } = useAuth();\\n  const { toast } = useToast();\\n  return useMutation({\\n    mutationFn: async (userId: string) => {\\n      if (!user) throw new Error(\\"Admin not authenticated.\\");\\n      const response = await fetch(`/api/users/${userId}/reset-password`, {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n      });\\n      if (!response.ok) {\\n        const error = await response.json();\\n        throw new Error(error.message);\\n      }\\n      return response.json();\\n    },\\n    onSuccess: (data) => {\\n      toast({\\n        title: \\"Success\\",\\n        description: data.message || \\"Password reset email sent successfully.\\",\\n      });\\n    },\\n    onError: (error) => {\\n      handleErrorUtility(error, \\"Failed to Send Email\\");\\n    },\\n  });\\n}\\n\\n// Import useAuth for use in hooks\\nimport { useAuth } from \'@/hooks/use-auth\';"}', 'logfire.msg': 'running tool: find_and_replace_code', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name":
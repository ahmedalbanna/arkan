lvedValue({ text: 'Could you please provide your assistance in this matter?' });\\n\\n    await paraphraseText(mockInput);\\n\\n    expect(mockPromptFn).toHaveBeenCalledWith(\\n      expect.objectContaining({\\n        instruction: expect.stringContaining('formal'),\\n      }),\\n    );\\n  });\\n\\n  it('should use \\\"fluent\\\" mode instruction when mode is fluent', async () => {\\n    const mockInput: ParaphraseInput = {\\n      text: 'I am going to the store.',\\n      mode: 'fluent',\\n    };\\n    mockPromptFn.mockResolvedValue({ text: \\\"I'm heading to the store.\\\" });\\n\\n    await paraphraseText(mockInput);\\n\\n    expect(mockPromptFn).toHaveBeenCalledWith(\\n      expect.objectContaining({\\n        instruction: expect.stringContaining('fluent'),\\n      }),\\n    );\\n  });\\n\\n  it('should use \\\"creative\\\" mode instruction when mode is creative', async () => {\\n    const mockInput: ParaphraseInput = {\\n      text: 'The sun is bright today.',\\n      mode: 'creative',\\n    };\\n    mockPromptFn.mockResolvedValue({ text: 'Golden rays blazed gloriously across the afternoon sky.' });\\n\\n    await paraphraseText(mockInput);\\n\\n    expect(mockPromptFn).toHaveBeenCalledWith(\\n      expect.objectContaining({\\n        instruction: expect.stringContaining('creative'),\\n      }),\\n    );\\n  });\\n\\n  it('should use \\\"simplify\\\" mode instruction when mode is simplify', async () => {\\n    const mockInput: ParaphraseInput = {\\n      text: 'The utilization of renewable energy sources mitigates environmental degradation.',\\n      mode: 'simplify',\\n    };\\n    mockPromptFn.mockResolvedValue({ text: 'Using clean energy helps the environment.' });\\n\\n    await paraphraseText(mockInput);\\n\\n    expect(mockPromptFn).toHaveBeenCalledWith(\\n      expect.objectContaining({\\n        instruction: expect.stringContaining('simpler'),\\n      }),\\n    );\\n  });\\n\\n  it('should throw an error for empty input text', async () => {\\n    const mockInput = { text: '', mode: 'standard' };\\n    await expect(paraphraseText(mockInput as ParaphraseInput)).rejects.toThrow();\\n  });\\n\\n  it('should throw an error for invalid mode enum', async () => {\\n    const mockInput = { text: 'Some valid text', mode: 'invalid-mode' };\\n    await expect(paraphraseText(mockInput as any)).rejects.toThrow();\\n  });\\n\\n  it('should throw an error if the model returns empty output', async () => {\\n    const mockInput: ParaphraseInput = { text: 'Some valid text.', mode: 'standard' };\\n    mockPromptFn.mockResolvedValue({ text: '' });\\n\\n    await expect(paraphraseText(mockInput)).rejects.toThrow('Failed to paraphrase text.');\\n  });\\n\\n  it('should strip triple-dash separators from the output', async () => {\\n    const mockInput: ParaphraseInput = { text: 'Some text.', mode: 'standard' };\\n    mockPromptFn.mockResolvedValue({ text: '---Paraphrased text here---' });\\n\\n    const result = await paraphraseText(mockInput);\\n    expect(result).not.toContain('---');\\n    expect(result).toBe('Paraphrased text here');\\n  });\\n});\\n\"}", "tool_call_id": "toolu_vrtx_01QFsAahnXq6Zz4uGmSC2oYd", "id": null, "provider_name": null, "provider_details": null, "part_kind": "tool-call"}

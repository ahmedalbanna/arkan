   {\n              "name": "EMBEDDING_MODEL",\n              "value": "nomic-embed-text:latest"\n            },\n            {\n              "name": "LLM_MODEL",\n              "value": "openrouter/auto"\n            }\n          ]\n        },\n        "options": {}\n      },\n      "id": "workflow-settings-id",\n      "name": "Workflow Settings",\n      "type": "n8n-nodes-base.set",\n      "typeVersion": 1,\n      "position": [-400, 300]\n    },\n    {\n      "parameters": {\n        "jsCode": "// Input Validation Logic\\nconst body = $json.body;\\nif (!body || !body.action) {\\n  throw new Error(\'Missing required field: action\');\\n}\\nif ([\'runFlow\'].includes(body.action) && !body.flowName) {\\n  throw new Error(\'Action runFlow requires flowName\');\\n}\\nreturn $json;"\n      },\n      "id": "validate-input-id",\n      "name": "Validate Input",\n      "type": "n8n-nodes-base.code",\n      "typeVersion": 1,\n      "position": [-250, 300]\n    },\n    {\n      "parameters": {\n        "dataType": "string",\n        "value1": "={{ $json.body.action }}",\n        "rules": {\n          "rules": [\n            { "value2": "generateText" },\n            { "value2": "runFlow", "output": 1 },\n            { "value2": "retrieveContext", "output": 2 },\n            { "value2": "generateChapterWithRAG", "output": 3 },\n            { "value2": "generateSectionWithRAG", "output": 4 }\n          ]\n        }\n      },\n      "id": "route-action-id",\n      "name": "Route Action",\n      "type": "n8n-nodes-base.switch",\n      "typeVersion": 1,\n      "position": [-100, 300]\n    },\n    {\n      "parameters": {\n        "dataType": "string",\n        "value1": "={{ $json.body.flowName }}",\n        "rules": {\n          "rules": [\n            { "value2": "summarize" },\n            { "value2": "grammarCheck", "output": 1 },\n            { "value2": "paraphrase", "output": 2 },\n            { "value2": "biasCheck", "output": 3 },\n            { "value2": "detectAi", "output": 4 },\n            { "value2": "translate", "output": 5 },\n            { "value2": "quiz", "output": 6 },\n            { "value2": "factCheck", "output": 7 },\n            { "value2": "plagiarismCheck", "output": 8 },\n            { "value2": "humanize", "output": 9 },\n            { "value2": "aiResearch", "output": 10 },\n            { "value2": "generatePlantUML", "output": 11 },\n            { "value2": "imageToText", "output": 12 },\n            { "value2": "generateCitation", "output": 13 },\n            { "value2": "generateTOC", "output": 14 },\n            { "value2": "generateLitReview", "output": 15 },\n            { "value2": "generateLecture", "output": 16 },\n            { "value2": "sentenceStructureCheck", "output": 17 },\n            { "value2": "explainTopic", "output": 18 },\n            { "value2": "generateIdeas", "output": 19 },\n            { "value2": "generateUIDescription", "output": 20 },\n            { "value2": "generateSessionPlan", "output": 21 },\n            { "value2": "solveAssignments", "output": 22 },\n            { "value2": "generateProjectBlueprint", "output": 23 },\n            { "value2": "proofreadDocument", "output": 24 },\n            { "value2": "analyzeContext", "output": 25 },\n            { "value2": "checkPaperQuality", "output": 26 },\n            { "value2": "improveMarkdown", "output": 27 },\n            { "value2": "generateProjectDoc", "output": 28 },\n            { "value2": "rewriteToMarkdown", "output": 29 },\n            { "value2": "writeTechSpec", "output": 30 },\n            { "value2": "createPresentation", "output": 31 }\n          ]\n        },\n        "fallbackOutput": 32\n      },\n      "id": "route-flow-id",\n      "name": "Route Flow",\n      "type": "n8n-nodes-base.switch",\n      "typeVersion": 1,\n      "position": [50, 300]\n    },\n    {\n      "parameters": {\n        "options": {\n          "text": "={{ $(\'Route Action\').item.json.body.input }}",\n          "systemMessage": "You are Arkan AI, a professional text summarizer.\\n\\nYour task: Summarize the given text.\\n- Input: `{ text, length }` where `length` is \'short\', \'medium\', or \'long\'.\\n- short: single concise paragraph (~50-100 words)\\n- medium: a few paragraphs (~150-300 words)\\n- long: detailed summary (~400-600 words)\\n\\nOutput ONLY the summary text. No preamble, no JSON, no meta-commentary."\n        }\n      },\n      "id": "summarizer-agent-id",\n      "name": "Summarizer Agent",\n      "type": "@n8n/n8n-nodes-langchain.agent",\n      "typeVersion": 1.1,\n      "position": [350, -100]\n    },\n    {\n      "parameters": {\n        "options": {\n          "text": "={{ $(\'Route Action\').item.json.body.input }}",\n          "systemMessage": "You are Arkan AI, an expert English grammar, spelling, and punctuation checker.\\n\\nYour task: Analyze the provided text and correct ALL grammar, spelling, and punctuation errors.\\n- Input: `{ text }` containing the text to check.\\n- Preserve all markdown formatting.\\n- Preserve the original meaning and structure.\\n- Temperature: very low — prioritize accuracy over creativity.\\n\\nOutput ONLY the fully corrected version of the text. No preamble, no JSON, no meta-commentary."\n        }\n      },\n      "id": "grammar-agent-id",\n      "name": "Grammar Checker Agent",\n      "type": "@n8n/n8n-nodes-langchain.agent",\n      "typeVersion": 1.1,\n      "position": [350, 50]\n    },\n    {\n      "parameters": {\n        "options": {\n          "text": "={{ $(\'Route Action\').item.json.body.input }}",\n          "systemMessage": "You are Arkan AI, an expert paraphrasing assistant.\\n\\nYour task: Rewrite the given text in a fresh way while preserving its original meaning.\\n- Input: `{ text, style }` where `style` may be \'academic\', \'casual\', \'formal\', \'creative\', etc.\\n- Change sentence structure, word choice, and flow.\\n- Do NOT change the core meaning or add new information.\\n- Preserve markdown formatting.\\n\\nOut
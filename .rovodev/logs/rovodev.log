 39   requiresStructuredOutput?: boolean;\n  40   requiresDeepReasoning?: boolean;\n  41   isAcademic?: boolean;\n  42   hasRAGContext?: boolean;\n  43 }\n  44 \n  45 /**\n  46  * Model characteristics for selection logic\n  47  */\n  48 interface ModelCharacteristics {\n  49   speed: number;           // 1-10 (higher is faster)\n  50   quality: number;         // 1-10 (higher is better)\n  51   reasoning: number;       // 1-10 (higher is better)\n  52   structuredOutput: number; // 1-10 (higher is better)\n  53   memoryUsage: number;     // GB\n  54   maxConcurrent: number;   // Recommended concurrent requests\n  55 }\n  56 \n  57 const MODEL_CHARACTERISTICS: Record<string, ModelCharacteristics> = {\n  58   [OLLAMA_MODELS.GEMMA_2B]: {\n  59     speed: 9,\n  60     quality: 6,\n  61     reasoning: 5,\n  62     structuredOutput: 6,\n  63     memoryUsage: 2.5,\n  64     maxConcurrent: 5,\n  65   },\n  66   [OLLAMA_MODELS.PHI3_MINI]: {\n  67     speed: 7,\n  68     quality: 8,\n  69     reasoning: 8,\n  70     structuredOutput: 9,\n  71     memoryUsage: 3.3,\n  72     maxConcurrent: 3,\n  73   },\n  74   [OLLAMA_MODELS.LLAMA3_8B]: {\n  75     speed: 4,\n  76     quality: 10,\n  77     reasoning: 10,\n  78     structuredOutput: 8,\n  79     memoryUsage: 4.7,\n  80     maxConcurrent: 1,\n  81   },\n  82 };\n  83 \n  84 /**\n  85  * Select model based on task complexity\n  86  */\n  87 export function selectModelByComplexity(complexity: TaskComplexity): string {\n  88   switch (complexity) {\n  89     case TaskComplexity.SIMPLE:\n  90       return OLLAMA_MODELS.GEMMA_2B;\n  91     case TaskComplexity.MODERATE:\n  92       return OLLAMA_MODELS.PHI3_MINI;\n  93     case TaskComplexity.COMPLEX:\n  94       return OLLAMA_MODELS.LLAMA3_8B;\n  95     default:\n  96       return OLLAMA_MODELS.GEMMA_2B;\n  97   }\n  98 }\n  99 \n 100 /**\n 101  * Select model based on performance priority\n 102  */\n 103 export function selectModelByPriority(priority: PerformancePriority): string {\n 104   switch (priority) {\n 105     case PerformancePriority.SPEED:\n 106       return OLLAMA_MODELS.GEMMA_2B;\n 107     case PerformancePriority.BALANCED:\n 108       return OLLAMA_MODELS.PHI3_MINI;\n 109     case PerformancePriority.QUALITY:\n 110       return OLLAMA_MODELS.LLAMA3_8B;\n 111     default:\n 112       return OLLAMA_MODELS.PHI3_MINI;\n 113   }\n 114 }\n 115 \n 116 /**\n 117  * Select model based on input token count\n 118  */\n 119 export function selectModelByTokenCount(tokens: number): string {\n 120   // For very large inputs, use models with better context handling\n 121   if (tokens > 4000) {\n 122     return OLLAMA_MODELS.LLAMA3_8B;\n 123   } else if (tokens > 2000) {\n 124     return OLLAMA_MODELS.PHI3_MINI;\n 125   }\n 126   return OLLAMA_MODELS.GEMMA_2B;\n 127 }\n 128 \n 129 /**\n 130  * Intelligent model selection based on multiple criteria\n 131  */\n 132 export function selectModel(criteria: ModelSelectionCriteria): string {\n 133   // Priority 1: If flow name is specified, use predefined mapping\n 134   if (criteria.flowName) {\n 135     const flowModel = getModelForFlow(criteria.flowName);\n 136     if (flowModel) return flowModel;\n 137   }\n 138 \n 139   // Priority 2: Academic tasks always use Llama 3 8B\n 140   if (criteria.isAcademic) {\n 141     return OLLAMA_MODELS.LLAMA3_8B;\n 142   }\n 143 \n 144   // Priority 3: Deep reasoning tasks\n 145   if (criteria.requiresDeepReasoning) {\n 146     return criteria.hasRAGContext ? OLLAMA_MODELS.LLAMA3_8B : OLLAMA_MODELS.PHI3_MINI;\n 147   }\n 148 \n 149   // Priority 4: Structured output needs\n 150   if (criteria.requiresStructuredOutput) {\n 151     return OLLAMA_MODELS.PHI3_MINI;\n 152   }\n 153 \n 154   // Priority 5: Performance priority\n 155   if (criteria.performancePriority) {\n 156     return selectModelByPriority(criteria.performancePriority);\n 157   }\n 158 \n 159   // Priority 6: Task complexity\n 160   if (criteria.taskComplexity) {\n 161     return selectModelByComplexity(criteria.taskComplexity);\n 162   }\n 163 \n 164   // Priority 7: Input token count\n 165   if (criteria.inputTokens) {\n 166     return selectModelByTokenCount(criteria.inputTokens);\n 167   }\n 168 \n 169   // Default: Use Phi-3 Mini for balanced performance\n 170   return OLLAMA_MODELS.PHI3_MINI;\n 171 }\n 172 \n 173 /**\n 174  * Get model characteristics\n 175  */\n 176 export function getModelCharacteristics(model: string): ModelCharacteristics | null {\n 177   return MODEL_CHARACTERISTICS[model] || null;\n 178 }\n 179 \n 180 /**\n 181  * Compare two models and return the better one based on criteria\n 182  */\n 183 export function compareModels(\n 184   model1: string,\n 185   model2: string,\n 186   priority: 'speed' | 'quality' | 'reasoning' | 'structuredOutput'\n 187 ): string {\n 188   const char1 = MODEL_CHARACTERISTICS[model1];\n 189   const char2 = MODEL_CHARACTERISTICS[model2];\n 190 \n 191   if (!char1 || !char2) {\n 192     return model1;\n 193   }\n 194 \n 195   return char1[priority] >= char2[priority] ? model1 : model2;\n 196 }\n 197 \n 198 /**\n 199  * Check if model is available for concurrent requests\n 200  */\n 201 export function canHandleConcurrentRequest(model: string, currentRequests: number): boolean {\n 202   const characteristics = MODEL_CHARACTERISTICS[model];\n 203   if (!characteristics) return false;\n 204   return currentRequests < characteristics.maxConcurrent;\n 205 }\n 206 \n 207 /**\n 208  * Get recommended concurrent request limit for a model\n 209  */\n 210 export function getMaxConcurrentRequests(model: string): number {\n 211   const characteristics = MODEL_CHARACTERISTICS[model];\n 212   return characteristics?.maxConcurrent || 1;\n 213 }\n 214 \n 215 /**\n 216  * Get all available models sorted by a characteristic\n 217  */\n 218 export function getModelsSortedBy(\n 219   characteristic: 'speed' | 'quality' | 'reasoning' | 'structuredOutput'\n 220 ): string[] {\n 221   return Object.entries(MODEL_CHARACTERISTICS)\n 222     .sort((a, b) => b[1][characteristic] - a[1][characteristic])\n 223     .map(([model]) => model);\n 224 }\n 225 \n 226 /**\n 227  * Check if model is suitable for task\n 228  */\n 229 export function isModelSuitableForTask(model: string, criteria: ModelSelectionCriteria): boolean {\n 230   const characteristics = MODEL_CHARACTERISTICS[model];\n 231   if (!characteristics) return false;\n 232 \n 233   // Check academic requirement\n 234   if (criteria.isAcademic && model !== OLLAMA_MODELS.LLAMA3_8B) {\n 235     return false;\n 236   }\n 237 \n 238   // Check structured output requirement\n 239   if (criteria.requiresStructuredOutput && characteristics.structuredOutput < 8) {\n 240     return false;\n 241   }\n 242 \n 243   // Check deep reasoning requirement\n 244   if (criteria.requiresDeepReasoning && characteristics.reasoning < 8) {\n 245     return false;\n 246   }\n 247 \n 248   return true;\n 249 }\n 250 \n 251 /**\n 252  * Get fallback model if primary is unavailable\n 253  */\n 254 export function getFallbackModel(primaryModel: string): string {\n 255   // If Llama 3 8B fails, fall back to Phi-3 Mini\n 256   if (primaryModel === OLLAMA_MODELS.LLAMA3_8B) {\n 257     return OLLAMA_MODELS.PHI3_MINI;\n 258   }\n 259 \n 260   // If Phi-3 Mini fails, fall back to Gemma 2B\n 261   if (primaryModel === OLLAMA_MODELS.PHI3_MINI) {\n 262     return OLLAMA_MODELS.GEMMA_2B;\n 263   }\n 264 \n 265   // Gemma 2B is the ultimate fallback\n 266   return OLLAMA_MODELS.GEMMA_2B;\n 267 }\n 268 \n 269 /**\n 270  * Model selection result with metadata\n 271  */\n 272 export interface ModelSelectionResult {\n 273   model: string;\n 274   reason: string;\n 275   characteristics: ModelCharacteristics | null;\n 276   fallbackModel: string;\n 277   warnings: string[];\n 278 }\n 279 \n 280 /**\n 281  * Select model with detailed result information\n 282  */\n 283 export function selectModelWithMetadata(criteria: ModelSelectionCriteria): ModelSelectionResult {\n 284   const warnings: string[] = [];\n 285   let reason = 'Default balanced selection';\n 286 \n 287   // Determine model\n 288   let model: string;\n 289 \n 290   if (criteria.flowName) {\n 291     model = getModelForFlow(criteria.flowName);\n 292     reason = `Predefined mapping for flow: ${criteria.flowName}`;\n 293   } else if (criteria.isAcademic) {\n 294     model = OLLAMA_MODELS.LLAMA3_8B;\n 295     reason = 'Academic task requires highest quality model';\n 296     if (!criteria.hasRAGContext) {\n 297       warnings.push('Academic tasks should use RAG context for best results');\n 298     }\n 299   } else if (criteria.requiresDeepReasoning) {\n 300     model = criteria.hasRAGContext ? OLLAMA_MODELS.LLAMA3_8B : OLLAMA_MODELS.PHI3_MINI;\n 301     reason = 'Deep reasoning task';\n 302   } else if (criteria.requiresStructuredOutput) {\n 303     model = OLLAMA_MODELS.PHI3_MINI;\n 304     reason = 'Structured output requires Phi-3 Mini';\n 305   } else if (criteria.performancePriority) {\n 306     model = selectModelByPriority(criteria.performancePriority);\n 307     reason = `Performance priority: ${criteria.performancePriority}`;\n 308   } else if (criteria.taskComplexity) {\n 309     model = selectModelByComplexity(criteria.taskComplexity);\n 310     reason = `Task complexity: ${criteria.taskComplexity}`;\n 311   } else if (criteria.inputTokens) {\n 312     model = selectModelByTokenCount(criteria.inputTokens);\n 313     reason = `Based on input token count: ${criteria.inputTokens}`;\n 314   } else {\n 315     model = OLLAMA_MODELS.PHI3_MINI;\n 316   }\n 317 \n 318   // Add warnings for resource-intensive models\n 319   const characteristics = MODEL_CHARACTERISTICS[model];\n 320   if (model === OLLAMA_MODELS.LLAMA3_8B) {\n 321     warnings.push('Llama 3 8B uses significant RAM (~4.7GB). Run one request at a time.');\n 322     warnings.push('Consider using request queuing for multiple Llama 3 8B requests.');\n 323   }\n 324 \n 325   if (criteria.inputTokens && criteria.inputTokens > 2000) {\n 326     warnings.push('Large input detected. Monitor memory usage carefully.');\n 327   }\n 328 \n 329   return {\n 330     model,\n 331     reason,\n 332     characteristics,\n 333     fallbackModel: getFallbackModel(model),\n 334     warnings,\n 335   };\n 336 }\n 337 \n 338 /**\n 339  * Export all model constants for convenience\n 340  */\n 341 export { OLLAMA_MODELS, MODEL_BY_TASK };\n 342 \n````"}

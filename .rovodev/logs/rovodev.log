\n 500 \n 501     it('should handle special characters in data', async () => {\n 502       const specialChars = {\n 503         unicode: '\u4f60\u597d\u4e16\u754c \ud83d\ude80 \u00e9mojis',\n 504         escaped: 'Line 1\\nLine 2\\tTabbed',\n 505         quotes: 'He said \"Hello\"',\n 506       };\n 507 \n 508       await logGeneration({\n 509         agentId: 'agent_123',\n 510         userId: 'user_456',\n 511         input: specialChars,\n 512         output: specialChars,\n 513         creditCost: 5,\n 514       });\n 515 \n 516       expect(mockCollection.add).toHaveBeenCalledWith(\n 517         expect.objectContaining({\n 518           input: specialChars,\n 519           output: specialChars,\n 520         })\n 521       );\n 522     });\n 523   });\n 524 \n 525   // ============================================================================\n 526   // Use Cases\n 527   // ============================================================================\n 528 \n 529   describe('Real-world use cases', () => {\n 530     it('should log document generation', async () => {\n 531       await logGeneration({\n 532         agentId: 'document-writer',\n 533         userId: 'user_academic',\n 534         input: {\n 535           title: 'Research Paper',\n 536           topic: 'Machine Learning',\n 537           sections: ['Introduction', 'Methodology', 'Results'],\n 538           style: 'academic',\n 539         },\n 540         output: {\n 541           document: '# Research Paper\\n\\n...',\n 542           wordCount: 2500,\n 543           readingTime: 10,\n 544         },\n 545         creditCost: 15,\n 546       });\n 547 \n 548       expect(mockCollection.add).toHaveBeenCalled();\n 549     });\n 550 \n 551     it('should log grammar checking', async () => {\n 552       await logGeneration({\n 553         agentId: 'grammar-checker',\n 554         userId: 'user_student',\n 555         input: {\n 556           text: 'This is a sentance with errors.',\n 557         },\n 55
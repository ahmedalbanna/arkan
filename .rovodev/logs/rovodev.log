tch (e) {\\n        console.error(\'[Export:PPTX] Line count calculation failed:\', e);\\n        return 1; \\n    }\\n}\\n\\n/**\\n * Calculates the number of lines a code block will occupy.\\n */\\nexport function calculateCodeLineCount(text: string, fontFace: string, fontSize: number, maxWidthInches: number): number {\\n    if (!text) {\\n        return 1;\\n    }\\n\\n    try {\\n        const context = getCanvasContext(fontFace, fontSize);\\n        const maxWidthPx = maxWidthInches * POINTS_PER_INCH;\\n\\n        const lines = String(text).split(\'\\\\n\');\\n        let totalLines = 0;\\n\\n        for (const line of lines) {\\n            if (line === \'\') {\\n                totalLines++;\\n                continue;\\n            }\\n            const metrics = context.measureText(line);\\n            const lineWraps = Math.ceil(metrics.width / maxWidthPx);\\n            totalLines += Math.max(1, lineWraps);\\n        }\\n\\n        return Math.max(1, totalLines);\\n    } catch (e) {\\n        console.error(\'[Export:PPTX] Code line count calculation failed:\', e);\\n        return 1;\\n    }\\n}\\n","overwrite":true,"file_path":"src/modules/templates/infrastructure/exporters/pptx/text-measurement.ts"}', 'logfire.msg': 'running tool: create_file', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span'}

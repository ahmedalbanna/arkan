tOptions,\n 490     footnoteIdMap: Map<string, number>,\n 491     createNewSlide: () => PptxGenJS.Slide,\n 492     options: { bullet?: PptxGenJS.TextPropsOptions['bullet']; x?: number; w?: number; } = {}\n 493 ): Promise<{ slide: PptxGenJS.Slide; y: number }> {\n 494     let textRuns = await transformInlinesToPptxText(node.children, styles.body, styles, isRtl, fonts, footnoteIdMap);\n 495     let y = currentY;\n 496     let currentSlide = slide;\n 497     let isFirstChunk = true;\n 498 \n 499     while (textRuns.length > 0) {\n 500         const availableHeight = bodyEndY - y;\n 501         const lineHeight = (styles.body.lineSpacing || (styles.body.fontSize || 18) * 1.2) / POINTS_PER_INCH;\n 502         const minRequiredHeight = lineHeight + 0.1; // Minimum space needed for one line plus margin\n 503 \n 504         // If not enough space for even one line, create new slide\n 505         if (availableHeight < minRequiredHeight) {\n 506             currentSlide = createNewSlide();\n 507             y = layout.BODY_START_Y;\n 508             continue;\n 509         }\n 510 \n 511         const { current, remaining } = splitRunsByHeight(textRuns, availableHeight, styles);\n 512 \n 513         // If we can't fit anything meaningful, force a new slide\n 514         if (current.length === 0 && remaining.length > 0) {\n 515             currentSlide = createNewSlide();\n 516             y = layout.BODY_START_Y;\n 517             continue;\n 518         }\n 519 \n 520         if (current.length > 0) {\n 521             const heightForTheseRuns = calculateRunsHeight(current, styles);\n 522 \n 523             // Ensure we don't exceed available space\n 524             const maxAllowedHeight = availableHeight - 0.1; // Safety margin\n 525             const renderHeight = Math.min(\n 526                 Math.max(heightForTheseRuns - layout.ELEMENT_PADDING, minRequiredHeight - layout.ELEMENT_PADDING),\n 527                 maxAllowedHeight\n 528             );\n 529 \n 530             const textOptions: PptxGenJS.TextPropsOptions = {\n 531                 x: options.x ?? layout.CONTENT_X,\n 532                 y,\n 533                 w: options.w ?? layout.CONTENT_WIDTH,\n 534                 h: renderHeight,\n 535                 ...styles.body,\n 536                 rtlMode: isRtl,\n 537                 align: isRtl ? 'right' : styles.body.align,\n 538                 valign: 'top' // Ensure text starts at the top of the textbox\n 539             };\n 540 \n 541             // Apply bullet formatting only to the first chunk of a list item\n 542             if (isFirstChunk && options.bullet) {\n 543                 textOptions.bullet = options.bullet;\n 544             }\n 545 \n 546             currentSlide.addText(current, textOptions);\n 547             y += Math.min(heightForTheseRuns, availableHeight - 0.05); // Small buffer for next element\n 548         }\n 549 \n 550         textRuns = remaining;\n 551         isFirstChunk = false;\n 552 \n 553         // Prevent infinite loops\n 554         if (remaining.length > 0 && current.length === 0) {\n 555             console.warn('Text processing stuck in loop, forcing new slide');\n 556             currentSlide = createNewSlide();\n 557             y = layout.BODY_START_Y;\n 558         }\n 559     }\n 560     return { slide: currentSlide, y };\n 561 }\n...\n 566 async function processListNode(\n...\n 646 async function processUnsplittableNode(\n...\n 674 function manageUnsplittableElementOverflow(\n...\n 716 function groupContentNodes(nodes: RootContent[]): RootContent[][] {\n...\n 726 async function renderContentGroup(\n...\n 754 export async function createSlidesWithContent(\n...\n 817 \n````"}

2026-04-05 13:19:17.153 | 507086 (507086) | DEBUG    | Model response tool call: {"tool_name": "create_file", "args": {"file_path": "src/modules/ai-content/adapters/components/builder/layout/BuilderCanvas.tsx", "initial_content": "'use client';\n\nimport React, { useMemo } from 'react';\nimport { Tooltip, TooltipContent, TooltipProvider, TooltipTrigger } from '@/components/ui/tooltip';\nimport { Button } from '@/components/ui/button';\nimport { ZoomIn, ZoomOut, RotateCcw, Scan, Sparkles } from 'lucide-react';\nimport { cn } from '@/infrastructure/utils/cn';\nimport { ScrollArea } from '@/components/ui/scroll-area';\n\n/**\n * BuilderCanvas \u2014 High-fidelity neural workspace viewport.\n * Orchestrates the relationship between document content and technical navigation HUDs.\n * \n * DEFENSIVE MEASURES:\n * 1. RequestAnimationFrame Guards: Ensures smooth zoom transitions at 60fps.\n * 2. Viewport Isolation: Standardized vignette and ambient gradients.\n * 3. Atmospheric Grid: 28px dot-grid synchronized with the project core.\n * 4. Spectral Feedback: Active overlays for RAG and synthesis operations.\n */\n\ninterface BuilderCanvasProps {\n    children: React.ReactNode;\n    zoomLevel: number;\n    onZoomIn: () => void;\n    onZoomOut: () => void;\n    onZoomReset: () => void;\n    toolbar?: React.ReactNode;\n    className?: string;\n    containerRef?: React.RefObject<HTMLDivElement>;\n    isProcessing?: boolean;\n}\n\nexport const BuilderCanvas = React.forwardRef<HTMLDivElement, BuilderCanvasProps>((\n    {\n        children,\n        zoomLevel,\n        onZoomIn,\n        onZoomOut,\n        onZoomReset,\n        toolbar,\n        className,\n        containerRef,\n        isProcessing = false\n    },\n    ref\n) => {\n    // 1. DATA DERIVATION \u2014 Safe transform string\n    const canvasTransform = useMemo(() => `scale(${zoomLevel})`, [zoomLevel]);\n\n    return (\n        <div\n            ref={ref}\n            className={cn(\n                \"flex flex-col h-full w-full bg-[#f8fafc] dark:bg-[#0f172a] relative overflow-hidden transition-all duration-700 ease-[0.22,1,0.36,1] z-10\",\n                className\n            )}\n        >\n            {/* Dot-grid atmosphere \u2014 Standardized Workspace Alignment (28px) */}\n            <div\n                className=\"absolute inset-0 opacity-[0.02] dark:opacity-[0.04] pointer-events-none\"\n                style={{\n                    backgroundImage: 'radial-gradient(circle at 1.5px 1.5px, hsl(var(--primary)) 1px, transparent 0)',\n                    backgroundSize: '28px 28px',\n                }}\n            />\n\n            {/* Ambient gradients for depth */}\n            <div className=\"absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-background/40 to-transparent pointer-events-none z-[15]\" />\n            <div className=\"absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-background/15 to-transparent pointer-events-none z-[15]\" />\n\n            {/* Inner vignette viewport framing */}\n            <div\n                className=\"absolute inset-0 pointer-events-none z-[15] rounded-[inherit]\"\n                style={{ boxShadow: 'inset 0 0 80px 0 hsl(var(--background) / 0.25)' }}\n            />\n\n            {/* 2. SPECTRAL OVERLAY \u2014 Neural Probing Pulse */}\n            {isProcessing && (\n                <div className=\"absolute inset-0 z-[35] pointer-events-none bg-primary/[0.01] animate-in fade-in duration-1000\">\n                    <div className=\"absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--primary)_1px,_transparent_1px)] bg-[size:14px_14px] opacity-[0.05] animate-pulse\" />\n                    <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center gap-3 px-6 py-3 rounded-2xl bg-background/80 backdrop-blur-3xl border border-primary/20 shadow-2xl shadow-primary/10\">\n                        <Sparkles className=\"h-4 w-4 text-primary animate-pulse\" />\n                        <span className=\"text-[10px] font-black uppercase tracking-[0.3em] text-primary/80\">Neural Probing Active</span>\n                    </div>\n                </div>\n            )}\n\n            {toolbar && (\n                <div className=\"flex-shrink-0 border-b border-border/40 bg-background/70 backdrop-blur-xl relative z-30\">\n                    {toolbar}\n                </div>\n            )}\n\n            {/* 3. PRODUCTION CORE \u2014 Scroll & Zoom Orchestration */}\n            <main ref={containerRef} className=\"flex-1 flex flex-col min-h-0 overflow-hidden relative z-20\">\n                <ScrollArea className=\"flex-1 w-full h-full relative scroll-smooth transition-all duration-700 ease-[0.22,1,0.36,1]\">\n                    <div className=\"py-24 px-8 flex justify-center min-h-full relative\">\n                        {/* Physical 'Safe Zone' Crop Marks \u2014 High-Fidelity Detail */}\n                        <div className=\"absolute top-12 left-1/2 -translate-x-1/2 w-full max-w-5xl h-full pointer-events-none opacity-20\">\n                            <div className=\"absolute top-0 left-0 w-8 h-px bg-primary/40\" />\n                            <div className=\"absolute top-0 left-0 w-px h-8 bg-primary/40\" />\n                            <div className=\"absolute top-0 right-0 w-8 h-px bg-primary/40\" />\n                            <div className=\"absolute top-0 right-0 w-px h-8 bg-primary/40\" />\n                        </div>\n\n                        <div\n                            className=\"w-full max-w-5xl transition-all duration-700 ease-[0.22,1,0.36,1] origin-top will-change-transform\"\n                            style={{ transform: canvasTransform }}\n                        >\n                            {children}\n                        </div>\n                    </div>\n                </ScrollArea>\n            </main>\n\n            {/* 4. ZOOM HUD \u2014 Unified control at the bottom */}\n            <div className=\"absolute bottom-8 left-1/2 -translate-x-1/2 z-[40] transition-all duration-500 ease-[0.22,1,0.36,1] opacity-60 hover:opacity-100 focus-within:opacity-100\">\n                <TooltipProvider delayDuration={200}>\n                    <div\n                        className=\"flex items-center gap-1 px-2 py-1.5 bg-background/70 backdrop-blur-3xl border border-primary/10 rounded-full shadow-[0_8px_32px_rgba(0,0,0,0.12)] ring-1 ring-inset ring-white/10\"\n                        role=\"toolbar\"\n                        aria-label=\"Zoom controls\"\n                    >\n                        <Tooltip>\n                            <TooltipTrigger asChild>\n                                <Button\n                                    variant=\"ghost\"\n                                    size=\"icon\"\n                                    aria-label=\"Zoom out\"\n                                    className=\"h-8 w-8 rounded-full hover:bg-primary/10 hover:text-primary transition-all active:scale-90\"\n                                    onClick={onZoomOut}\n                                >\n                                    <ZoomOut className=\"h-4 w-4\" />\n                                </Button>\n                            </TooltipTrigger>\n                            <TooltipContent side=\"top\" className=\"text-[10px] font-black uppercase tracking-[0.2em] bg-background/95 backdrop-blur-md border-primary/20 mb-3\">\n                                Zoom Out\n                            </TooltipContent>\n                        </Tooltip>\n\n                        <Tooltip>\n                            <TooltipTrigger asChild>\n                                <button\n                                    onClick={onZoomReset}\n                                    className=\"px-4 min-w-[4rem] text-center select-none border-x border-primary/10 mx-1 cursor-pointer rounded-lg hover:bg-primary/5 transition-colors focus:outline-none group/reset\"\n                                >\n                                    <span className=\"text-[10px] font-black tracking-[0.25em] text-primary/80 tabular-nums group-hover/reset:text-primary\">\n                                        {Math.round(zoomLevel * 100)}%\n                                    </span>\n                                </button>\n                            </TooltipTrigger>\n                            <TooltipContent side=\"top\" className=\"text-[10px] font-black uppercase tracking-[0.2em] bg-background/95 backdrop-blur-md border-primary/20 mb-3\">\n                                Reset Zoom\n                            </TooltipContent>\n                        </Tooltip>\n\n                        <Tooltip>\n                            <TooltipTrigger asChild>\n                                <Button\n                                    variant=\"ghost\"\n                                    size=\"icon\"\n                                    aria-label=\"Zoom in\"\n                                    className=\"h-8 w-8 rounded-full hover:bg-primary/10 hover:text-primary transition-all active:scale-90\"\n                                    onClick={onZoomIn}\n                                >\n                                    <ZoomIn className=\"h-4 w-4\" />\n                                </Button>\n                            </TooltipTrigger>\n                            <TooltipContent side=\"top\" className=\"text-[10px] font-black uppercase tracking-[0.2em] bg-background/95 backdrop-blur-md border-primary/20 mb-3\">\n                                Zoom In\n                            </TooltipContent>\n                        </Tooltip>\n\n                        <div className=\"w-px h-5 bg-primary/10 mx-1\" aria-hidden />\n\n                        <Tooltip>\n                            <TooltipTrigger asChild>\n                                <Button\n                                    variant=\"ghost\"\n                                    size=\"icon\"\n                                    className=\"h-8 w-8 rounded-full hover:bg-primary/10 hover:text-primary transition-all active:rotate-180 duration-500\"\n                                    onClick={onZoomReset}\n                                >\n                                    <RotateCcw className=\"h-3.5 w-3.5\" />\n                                </Button>\n                            </TooltipTrigger>\n                            <TooltipContent side=\"top\" className=\"text-[10px] font-black uppercase tracking-[0.2em] bg-background/95 backdrop-blur-md border-primary/20 mb-3\">\n                                Reinitialize Viewport\n                            </TooltipContent>\n                        </Tooltip>\n                    </div>\n                </TooltipProvider>\n            </div>\n        </div>\n    );\n});\n\nBuilderCanvas.displayName = 'BuilderCanvas';\n", "overwrite": true}, "tool_call_id": "pyd_ai_b791305cae844e08ab95635b77cb1acc", "id": null, "provider_name": "google-vertex", "provider_details": {"thought_signature": "ZTI0ODMwYTctNWNkNi00MmZlLTk5OGItZWU1MzllNzJiOWMz"}, "part_kind": "tool-call"}

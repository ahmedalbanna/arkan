builder.Section.generating\')}\\n                            </span>\\n                        ) : (\\n                            <>\\n                                {useRAG ? <Database className=\\"h-3.5 w-3.5\\" /> : <Sparkles className=\\"h-3.5 w-3.5\\" />}\\n                                {isBulkGeneration ? t(\'builder.Section.buildProject\') : (useRAG ? \'Generate with RAG\' : t(\'builder.Section.generate\'))}\\n                            </>\\n                        )}\\n                    </Button>","file_path":"src/modules/ai-content/adapters/components/builder/generation/SectionGenerationHUD.tsx","find":"                <div className=\\"flex items-center gap-3\\">\\n                    <Button \\n                        size=\\"sm\\"\\n                        disabled={!canGenerate}\\n                        onClick={handleGenerateClick}\\n                        className=\\"h-8 gap-2 px-4 font-bold uppercase tracking-wider\\"\\n                    >\\n                        {isGenerating ? (\\n                            <span className=\\"flex items-center gap-2\\">\\n                                <span className=\\"h-3 w-3 animate-spin rounded-full border-2 border-white border-t-transparent\\" />\\n                                {isBulkGeneration ? t(\'builder.Section.building\') : t(\'builder.Section.generating\')}\\n                            </span>\\n                        ) : (\\n                            <>\\n                                <Sparkles className=\\"h-3.5 w-3.5\\" />\\n                                {isBulkGeneration ? t(\'builder.Section.buildProject\') : t(\'builder.Section.generate\')}\\n                            </>\\n                        )}\\n                    </Button>"}', 'logfire.msg': 'running tool: find_and_replace_code', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {
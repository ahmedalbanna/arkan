tMap(item =>\n 306             item instanceof Chapter ? item.sections : item instanceof Section ? [item] : []\n 307         ),\n 308     [project.content]);\n 309 \n 310     const handleItemMouseEnter = useCallback((id: string) => {\n 311         if (hoverTimeoutRef.current) clearTimeout(hoverTimeoutRef.current);\n 312         setHoveredItemId(id);\n 313     }, []);\n 314 \n 315     const handleItemMouseLeave = useCallback(() => {\n 316         hoverTimeoutRef.current = setTimeout(() => {\n 317             setHoveredItemId(null);\n 318         }, 300);\n 319     }, []);\n 320 \n 321     useEffect(() => () => {\n 322         if (hoverTimeoutRef.current) {\n 323             clearTimeout(hoverTimeoutRef.current);\n 324             hoverTimeoutRef.current = null;\n 325         }\n 326     }, []);\n 327 \n 328     const handleActiveItemDetect = useCallback((headingText: string | null) => {\n 329         if (!headingText) return;\n 330 \n 331         const matched = allSections.find(section => section.title.trim() === headingText.trim());\n 332         if (matched) {\n 333             handleActiveSectionChange(matched.id);\n 334             return;\n 335         }\n 336 \n 337         const matchedChapter = project.content.find(\n 338             item => item instanceof Chapter && item.title.trim() === headingText.trim()\n 339         );\n 340         if (matchedChapter instanceof Chapter) {\n 341             setActiveChapterId(matchedChapter.id);\n 342         }\n 343     }, [allSections, handleActiveSectionChange, project.content, setActiveChapterId]);\n 344 \n 345     const handleSelectChapterSections = useCallback((chapter: Chapter) => {\n 346         setActiveChapterId(chapter.id);\n 347         chapter.sections.forEach(section => handleActiveSectionChange(section.id, true));\n 348     }, [handleActiveSectionChange, setActiveChapterId]);\n 349 \n 350     const handleSelectChapter = useCallback((chapterId: string) => {\n 351         setActiveChapterId(chapterId);\n 352         setHoveredItemId(null);\n 353     }, [setActiveChapterId]);\n 354 \n 355     const handleSectionClick = useCallback((sectionId: string) => {\n 356         handleActiveSectionChange(sectionId);\n 357     }, [handleActiveSectionChange]);\n 358 \n 359     const handleSectionEdit = useCallback((sectionId: string) => {\n 360         handleActiveSectionChange(sectionId);\n 361         setHoveredItemId(null);\n 362     }, [handleActiveSectionChange]);\n 363 \n 364     const handleSummarize = useCallback((section: Section) => {\n 365         summarizeMutation?.mutate?.({ text: section.content, sectionId: section.id } as any);\n 366     }, [summarizeMutation]);\n 367 \n 368     const handleExpand = useCallback((section: Section) => {\n 369         expandMutation?.mutate?.({ text: section.content, sectionId: section.id } as any);\n 370     }, [expandMutation]);\n 371 \n 372     const handleRewrite = useCallback((section: Section, style: string) => {\n 373         rewriteMutation?.mutate?.({ text: section.content, style, sectionId: section.id } as any);\n 374     }, [rewriteMutation]);\n 375 \n 376     return (\n 377         <div className=\"pb-32\">\n 378             {/* Editor / preview switch retains selection context */}\n 379             {viewMode === 'edit' ? (\n 380                 <MarkdownEditor\n 381                     content={project.fullMarkdownContent}\n 382                     onChange={onMarkdownChange}\n 383                     onDebouncedChange={onMarkdownChange}\n 384                     onActiveItemDetect={handleActiveItemDetect}\n 385                 />\n 386             ) : (\n 387                 <div className=\"space-y-12\">\n 388                     {project.content.map((item, index) => {\n 389                         const isPreview = viewMode === 'preview';\n 390 \n 391                         if (item instanceof Chapter) {\n 392                             return (\n 393                                 <ChapterPreview\n 394             
etTime() : 0;\n  48       return dateB - dateA;\n  49     });\n  50   }\n  51 \n  52   public async getProject(id: string): Promise<ProjectProperties | undefined> {\n  53     const db = await this.getDB();\n  54     return db.get(STORE_NAME, id);\n  55   }\n  56 \n  57   public async saveProject(project: ProjectProperties): Promise<ProjectProperties> {\n  58     const db = await this.getDB();\n  59     const projectToSave = {\n  60       ...project,\n  61       meta: { ...project.meta, updatedAt: new Date().toISOString() },\n  62     };\n  63     await db.put(STORE_NAME, projectToSave);\n  64     return projectToSave;\n  65   }\n  66 \n  67   public async deleteProject(id: string): Promise<void> {\n  68     const db = await this.getDB();\n  69     await db.delete(STORE_NAME, id);\n  70   }\n  71 }\n  72 \n````", "Successfully opened src/modules/projects/domain/repositories/IProjectRepository.ts:\n\n````typescript\n   0 \n   1 import { Project, ProjectProperties } from \"../entities/Project\";\n   2 import { Result } from \"@/infrastructure/utils/result\";\n   3 import { ProjectError } from \"../errors/ProjectErrors\";\n   4 import { ProjectSnapshot } from \"../entities/ProjectSnapshot\";\n   5 \n   6 export interface IProjectRepository {\n   7   getById(id: string): Promise<Result<Project, ProjectError>>;\n   8   getByUserId(userId: string): Promise<Result<Project[], ProjectError>>;\n   9   save(project: ProjectProperties): Promise<Result<Project, ProjectError>>;\n  10   delete(id: string): Promise<Result<void, ProjectError>>;\n  11 \n  12   // Snapshots\n  13   saveSnapshot(snapshot: ProjectSnapshot): Promise<Result<ProjectSnapshot, ProjectError>>;\n  14   getSnapshots(projectId: string): Promise<Result<ProjectSnapshot[], ProjectError>>;\n  15   deleteSnapshot(id: string): Promise<Result<void, ProjectError>>;\n  16 }\n  17 \n  18 export const IProjectRepositoryToken = Symbol(\"IProjectRepository\");\n  19 \n````"], "tool_call_id": "pyd_ai_8d4be8e035aa4b7bb0800d3ac1
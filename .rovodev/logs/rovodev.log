id, ...doc.data() }) as TransactionProperties);\\n}\\n\\nexport async function getTransactionsByDateRange(startDate: string, endDate: string): Promise<TransactionProperties[]> {\\n    const snapshot = await adminDb.collection('transactions')\\n        .where('createdAt', '>=', startDate)\\n        .where('createdAt', '<=', endDate)\\n        .orderBy('createdAt', 'desc')\\n        .get();\\n\\n    return snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }) as TransactionProperties);\\n}\", \"replace\": \"'use server';\\n\\nimport type { TransactionProperties } from '@/lib/models';\\nimport { db } from '@/db';\\nimport { transactions } from '@/db/schema';\\nimport { eq, desc, and, gte, lte, gt } from 'drizzle-orm';\\n\\nexport async function createTransaction(data: Omit<TransactionProperties, 'createdAt' | 'id'>) {\\n    const userId = typeof data.userId === 'string' ? parseInt(data.userId, 10) : data.userId;\\n    \\n    const result = await db\\n        .insert(transactions)\\n        .values({\\n            userId,\\n            type: data.type || 'purchase',\\n            amount: data.amount ? parseFloat(data.amount.toString()) : null,\\n            credits: data.credits || null,\\n            description: data.description || null,\\n            status: data.status || 'completed',\\n            createdAt: new Date(),\\n        })\\n        .returning();\\n\\n    return { id: result[0]?.id?.toString() };\\n}\\n\\nexport async function getTransactionsByStatus({ \\n    status, \\n    limit, \\n    lastVisibleId \\n}: { \\n    status: 'pending' | 'verified' | 'rejected' | 'completed', \\n    limit: number, \\n    lastVisibleId?: string \\n}): Promise<{ \\n    transactions: TransactionProperties[], \\n    hasNextPage: boolean, \\n    lastVisibleId?: string | null \\n}> {\\n    let query = db\\n        .select()\\n        .from(transactions)\\n        .where(eq(transactions.status, status))\\n        .orderBy(desc(transactions.createdAt))\\n        .limit(limit + 1
                                                <Select                         
                                                    value={section.controls.layo
                    ut}                                                         
                                                    onValueChange={(v) =>       
                    handleUpdate({ layout: v as GenerationControlState['layout']
                    })}                                                         
                                                >                               
                                                    <SelectTrigger              
                    className="h-9 bg-background/40 border-primary/10           
                    text-[10px] font-bold uppercase tracking-[0.2em]">          
                                                        <SelectValue />         
                                                    </SelectTrigger>            
                                                    <SelectContent>             
                                                        <SelectItem             
                    value="report">Report</SelectItem>                          

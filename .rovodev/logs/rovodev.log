ration-500 ease-[0.22,1,0.36,1]',\n            isOpen && 'rotate-90 text-primary/60'\n          )}\n        />\n        \n        {/* Technical Label */}\n        <span className=\"text-[9px] font-black uppercase tracking-[0.3em] text-muted-foreground/70 flex-1 group-hover/section:text-primary/80 transition-colors\">\n          {title}\n        </span>\n\n        {/* Action HUD / Status */}\n        {actions ? (\n            <div className=\"flex items-center gap-1 shrink-0 relative z-10\">\n                {actions}\n            </div>\n        ) : (\n            <Binary className=\"h-2.5 w-2.5 text-muted-foreground/10 group-hover/section:text-primary/20 transition-colors\" />\n        )}\n      </button>\n\n      {/* Animated Content Slot */}\n      <AnimatePresence initial={false}>\n        {isOpen && (\n          <motion.div\n            key=\"section-body\"\n            initial={{ height: 0, opacity: 0 }}\n            animate={{ height: 'auto', opacity: 1 }}\n            exit={{ height: 0, opacity: 0 }}\n            transition={{ duration: 0.5, ease: [0.22, 1, 0.36, 1] }}\n            className=\"overflow-hidden\"\n          >\n            <div className=\"p-5 flex flex-col gap-5 relative\">\n              {/* Subtle vertical architectural line */}\n              <div className=\"absolute left-3.5 inset-y-0 w-[1.5px] rounded-full bg-primary/5 shadow-inner\" aria-hidden />\n              \n              <div className=\"relative z-10\">\n                {children}\n              </div>\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}\n"}, "tool_call_id": "pyd_ai_8babccb96ed84b27ba55916f8935db6c", "id": null, "provider_name": null, "provider_details": null, "part_kind": "tool-call"}

.\n  22  */\n  23 \n  24 @injectable()\n  25 export class PptxExportService implements IExportService {\n  26     async export(project: Project, content: ProjectContent, options: ExportOptions): Promise<Result<Blob | Buffer, Error>> {\n  27         try {\n  28             if (!project || !Array.isArray(content) || content.length === 0) {\n  29                 return Result.fail(new Error("Document manifest contains zero valid content nodes."));\n  30             }\n  31 \n  32             const isFullExport = content.length === project.content.length;\n  33             const markdown = isFullExport && project.fullMarkdownContent \n  34                 ? project.fullMarkdownContent \n  35                 : this.generateMarkdownFromContent(content);\n  36             \n  37             // Extract footnotes from full project content — Safe Utility Pattern\n  38             const footnoteDefinitions = this.extractFootnotes(project.fullMarkdownContent || \'\');\n  39 \n  40             let finalMarkdown = markdown;\n  41             // Deduplicate and append footnotes to ensure citation stability across slides\n  42             if (footnoteDefinitions.length > 0) {\n  43                 const existingFootnotes = this.extractFootnotes(markdown);\n  44                 const newFootnotes = footnoteDefinitions.filter(fn => !existingFootnotes.includes(fn));\n  45                 \n  46                 if (newFootnotes.length > 0) {\n  47                     finalMarkdown += \'\\n\\n\' + newFootnotes.join(\'\\n\');\n  48                 }\n  49             }\n  50 \n  51             const pptxOptions: PptxConversionOptions = {\n  52                 styles: options.styles as PptxConversionOptions[\'styles\'],\n  53                 isRtl: options.isRtl,\n  54                 includeToc: options.includeToc,\n  55             };\n  56 \n  57             const result = await convertMarkdownToPptx(finalMarkdown, project.name, pptxOptions);\n  58 \n  59             const output = result instanceof Blob ? result : new Blob([result as any], { \n  60                 type: \'application/vnd.openxmlformats-officedocument.presentationml.presentation\' \n  61             });\n  62 \n  63             return Result.ok(output);\n  64         } catch (error) {\n  65             console.error(\'[Export:PPTX] Slide synthesis pipeline failure:\', error);\n  66             return Result.fail(error instanceof Error ? error : new Error(\'Unknown PPTX synthesis failure\'));\n  67         }\n  68     }\n  69 \n  70     async exportFromMarkdown(markdown: string, fileName: string, options: ExportOptions): Promise<Result<Blob | Buffer, Error>> {\n  71         try {\n  72             if (!markdown || !markdown.trim()) {\n  73                 return Result.fail(new Error("Markdown vector is empty."));\n  74             }\n  75 \n  76             const pptxOptions: PptxConversionOptions = {\n  77                 styles: options.styles as PptxConversionOptions[\'styles\'],\n  78                 isRtl: options.isRtl,\n  79                 includeToc: options.includeToc,\n  80                 title: fileName,\n  81             };\n  82 \n  83             const result = await convertMarkdownToPptx(markdown, fileName, pptxOptions);\n  84 \n  85             const output = result instanceof Blob ? result : new Blob([result as any], { \n  86                 type: \'application/vnd.openxmlformats-officedocument.presentationml.presentation\' \n  87             });\n  88 \n  89             return Result.ok(output);\n  90         } catch (error) {\n  91             console.error(\'[Export:PPTX] Markdown-to-Slide transformation failed:\', error);\n  92             return Result.fail(error instanceof Error ? error : new Error(\'Unrecoverable slide-deck transformation error\'));\n  93         }\n  94     }\n  95 \n  96     /**\n  97      * Standardized Footnote Extraction Vector\n  98      */\n  99     private extractFootnotes(markdown: string): string[] {\n 100         try {\n 101             const footnoteRegex = /^\\[\\^.+?\\]:.+$/gm;\n 102             return (markdown.match(footnoteRegex) || []) as string[];\n 103         } catch (e) {\n 104             console.warn(\'[Export:PPTX] Footnote extraction bypassed:\', e);\n 105             return [];\n 106         }\n 107     }\n 108 \n 109     /**\n 110      * High-Fidelity Markdown Aggregation\n 111      * Includes Spectral Cleanup to ensure pure markdown injection.\n 112      */\n 113     private generateMarkdownFromContent(content: ProjectContent): string {\n 114         return content.map(item => {\n 115             if (item instanceof Chapter) {\n 116                 const chapterTitle = `# ${item.title}`;\n 117                 const sectionsContent = item.sections.map(section => {\n 118                     const cleanContent = cleanAiOutput(section.content || \'\');\n 119                     return `## ${section.title}\\n\\n${cleanContent}`;\n 120                 }).join(\'\\n\\n\');\n 121                 return `${chapterTitle}\\n\\n${sectionsContent}`;\n 122             } else {\n 123                 const cleanContent = cleanAiOutput(item.content || \'\');\n 124                 return `# ${item.title}\\n\\n${cleanContent}`;\n 125             }\n 126         }).join(\'\\n\\n<!-- slide-break -->\\n\\n\');\n 127     }\n 128 }\n 129 \n````'}

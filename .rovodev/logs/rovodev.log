ult.isSuccess) return Result.fail(result.error!);\n 192             const text = result.getValue()?.text;\n 193             if (typeof text === \'string\') {\n 194                 return Result.ok(this.cleanAiOutput(text) as unknown as TOutput);\n 195             }\n 196             return Result.ok(text as TOutput);\n 197         }\n 198 \n 199         // Default: execute locally\n 200         try {\n 201             console.log(`[N8nAiService] Running flow locally: ${flowName || \'unnamed\'}`);\n 202             const result = await flow(input);\n 203 \n 204             // Post-process string outputs to remove conversational filler\n 205             if (result && typeof result === \'object\') {\n 206                 const processed = result as Record<string, unknown>;\n 207                 for (const key in processed) {\n 208                     if (typeof processed[key] === \'string\') {\n 209                         processed[key] = this.cleanAiOutput(processed[key] as string);\n 210                     }\n 211                 }\n 212                 return Result.ok(processed as TOutput);\n 213             } else if (typeof result === \'string\') {\n 214                 return Result.ok(this.cleanAiOutput(result) as unknown as TOutput);\n 215             }\n 216 \n 217             return Result.ok(result as TOutput);\n 218         } catch (error: unknown) {\n 219             const message = error instanceof Error ? error.message : String(error);\n 220             console.warn(`[N8nAiService] Local flow execution failed for "${flowName || \'unnamed\'}": ${message}`);\n 221             return Result.fail(AiError.generationFailed(message));\n 222         }\n 223     }\n 224 \n 225     /**\n 226      * Retrieves relevant context from the knowledge base via n8n → Qdrant.\n 227      */\n 228     async retrieveContext(query: string, options?: RetrievalOptions): Promise<Result<RetrievalResult, AiError>> {\n 229         const result = await this.callN8n<RetrievalResult>({\n 230             action: \'retrieveContext\',\n 231             prompt: query,\n 232             options,\n 233         });\n 234 \n 235         if (!result.isSuccess) return Result.fail(result.error!);\n 236         return Result.ok(result.getValue()!);\n 237     }\n 238 \n 239     /**\n 240      * Generates chapter content using the n8n Chapter RAG Agent.\n 241      * The full structured input is forwarded to n8n.\n 242      */\n 243     async generateChapterWithRAG(input: unknown): Promise<Result<unknown, AiError>> {\n 244         const result = await this.callN8n<{ text: unknown }>({\n 245             action: \'generateChapterWithRAG\',\n 246             flowName: \'generateChapterWithRAG\',\n 247             input,\n 248         });\n 249 \n 250         if (!result.isSuccess) return Result.fail(result.error!);\n 251         return Result.ok(result.getValue()?.text ?? result.getValue());\n 252     }\n 253 \n 254     /**\n 255      * Generates a report section using the n8n Section RAG Agent.\n 256      * The full structured input is forwarded to n8n.\n 257      */\n 258     async generateSectionWithRAG(input: unknown): Promise<Result<unknown, AiError>> {\n 259         const result = await this.callN8n<{ text: unknown }>({\n 260             action: \'generateSectionWithRAG\',\n 261             flowName: \'generateSectionWithRAG\',\n 262             input,\n 263         });\n 264 \n 265         if (!result.isSuccess) return Result.fail(result.error!);\n 266         return Result.ok(result.getValue()?.text ?? result.getValue());\n 267     }\n 268 \n 269     // ──────────────────────────────────────────────\n 270     // Output sanitization (mirrors GenkitAiService)\n 271     // ──────────────────────────────────────────────\n 272 \n 273     private cleanAiOutput(text: string): string {\n 274         if (!text) return text;\n 275 \n 276         const patterns = [\n 277             /^Sure,? (here is|here\'s) the [^:]+:?\\s*/i,\n 278             /^Sure,? here (is|\
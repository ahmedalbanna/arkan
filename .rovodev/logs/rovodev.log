                    transition-colors" />                                       
                                                    <Label                      
                    className="text-[10px] font-black uppercase tracking-[0.2em]
                    text-muted-foreground/60">Creativity Flux</Label>           
                                                </div>                          
                                                <Badge variant="outline"        
                    className="h-5 text-[9px] font-black border-primary/20      

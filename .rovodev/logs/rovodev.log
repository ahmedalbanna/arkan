},\\n  32     onSuccess: () => {\\n  33       queryClient.invalidateQueries({ queryKey: ragKeys.all() });\\n  34       toast({ title: \'Success\', description: \'Document indexed successfully for RAG.\' });\\n  35     },\\n  36     onError: (error: any) => {\\n  37       toast({ title: \'Indexing Failed\', description: error.message, variant: \'destructive\' });\\n  38     },\\n  39   });\\n  40 }\\n  41 \\n````","Successfully opened src/modules/rag/adapters/controllers/RagController.ts:\\n\\n````typescript\\n   0 \\n   1 import { delay, inject, injectable } from \\"tsyringe\\";\\n   2 import type { RagIndexingOptions, RagRetrievalOptions } from \\"../../domain/repositories/IRagRepository\\";\\n   3 import type { IndexedDocumentRecord } from \\"../../domain/repositories/IIndexedDocumentRepository\\";\\n   4 import { RetrieveContextUseCase } from \\"../../application/use-cases/RetrieveContextUseCase\\";\\n   5 import { IndexDocumentUseCase } from \\"../../application/use-cases/IndexDocumentUseCase\\";\\n   6 import { GetRagStatsUseCase } from \\"../../application/use-cases/GetRagStatsUseCase\\";\\n   7 import { GetRagHealthStatusUseCase } from \\"../../application/use-cases/GetRagHealthStatusUseCase\\";\\n   8 import { GetRagCacheStatsUseCase } from \\"../../application/use-cases/GetRagCacheStatsUseCase\\";\\n   9 import { ClearRagCacheUseCase } from \\"../../application/use-cases/ClearRagCacheUseCase\\";\\n  10 import { CheckRagSearchCacheHitUseCase } from \\"../../application/use-cases/CheckRagSearchCacheHitUseCase\\";\\n  11 import { CompareRerankingUseCase } from \\"../../application/use-cases/CompareRerankingUseCase\\";\\n  12 import { GetIndexedDocumentsUseCase } from \\"../../application/use-cases/GetIndexedDocumentsUseCase\\";\\n  13 import { DeleteIndexedDocumentUseCase } from \\"../../application/use-cases/DeleteIndexedDocumentUseCase\\";\\n  14 \\n  15 @injectable()\\n  16 export class RagController {\\n  17     constructor(\\n  18         @inject(delay(()
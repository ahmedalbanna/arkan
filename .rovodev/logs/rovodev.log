2026-04-04 09:03:07.351 | 655960 (655960) | DEBUG    | Processing tool event with attributes: {'gen_ai.tool.name': 'find_and_replace_code', 'gen_ai.tool.call.id': 'call_7WpdZsgc8bDF5e3wqav1sTd4', 'tool_arguments': '{"file_path":"src/modules/ai-content/adapters/components/builder/renderer/BuilderDocument.tsx","find":"                                            <Button variant=\\"ghost\\" size=\\"sm\\" className=\\"h-8 px-3 text-[10px] font-black uppercase tracking-widest gap-1.5 hover:bg-primary/10 hover:text-primary rounded-xl\\" onClick={() => { setActiveChapterId(item.id); setHoveredItemId(null); }}>","replace":"                                            <Button variant=\\"ghost\\" size=\\"sm\\" className=\\"h-8 px-3 text-[10px] font-black uppercase tracking-[0.2em] gap-1.5 hover:bg-primary/10 hover:text-primary rounded-xl\\" onClick={() => { setActiveChapterId(item.id); setHoveredItemId(null); }}>"}', 'logfire.msg': 'running tool: find_and_replace_code', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span', 'original_content': '\'use client\';\n\nimport React, { useState, useRef } from \'react\';\nimport { Project } from \'@/modules/projects/domain/entities/Project\';\nimport { Chapter } from \'@/modules/ai-content/domain/entities/Chapter\';\nimport { Section } from \'@/modules/ai-content/domain/entities/Section\';\nimport MarkdownEditor from \'./MarkdownEditor\';\nimport { MarkdownViewer } from \'@/components/shared/MarkdownViewer\';\nimport { Popover, PopoverContent, PopoverTrigger } from \'@/components/ui/popover\';\nimport { Button } from \'@/components/ui/button\';\nimport { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from \'@/components/ui/dropdown-menu\';\nimport { PenLine, RefreshCw, Sparkles, MousePointer2, AlignLeft, ZoomIn, Wand2 } from \'lucide-react\';\nimport { cn } from \'@/infrastructure/utils/cn\';\nimport { type SectionMutation, type RewriteStyleOption } from \'./types\';\n\ninterface DocumentProps {\n    project: Project;\n    viewMode: \'edit\' | \'preview\';\n    onMarkdownChange: (newMarkdown: string) => void;\n    activeChapterId: string | null;\n    setActiveChapterId: (id: string | null) => void;\n    selectedSectionIds: string[];\n    handleActiveSectionChange: (id: string | null, multiSelect?: boolean) => void;\n    summarizeMutation?: SectionMutation;\n    expandMutation?: SectionMutation;\n    rewriteMutation?: SectionMutation;\n    rewriteStyles?: RewriteStyleOption[];\n}\n\nexport const BuilderDocument = ({\n    project,\n    viewMode,\n    onMarkdownChange,\n    activeChapterId,\n    setActiveChapterId,\n    selectedSectionIds,\n    handleActiveSectionChange,\n    summarizeMutation,\n    expandMutation,\n    rewriteMutation,\n    rewriteStyles,\n}: DocumentProps) => {\n    const [hoveredItemId, setHoveredItemId] = useState<string | null>(null);\n    const hoverTimeoutRef = useRef<NodeJS.Timeout | null>(null);\n\n    const handleItemMouseEnter = (id: string) => {\n        if (hoverTimeoutRef.current) clearTimeout(hoverTimeoutRef.current);\n        setHoveredItemId(id);\n    };\n\n    const handleItemMouseLeave = () => {\n        hoverTimeoutRef.current = setTimeout(() => {\n            setHoveredItemId(null);\n        }, 300);\n    };\n    return (\n        <div className="pb-32">\n            {/* Editor / preview switch retains selection context */}\n            {viewMode === \'edit\' ? (\n                <MarkdownEditor\n                    content={project.fullMarkdownContent}\n                    onChange={onMarkdownChange}\n                    onDebouncedChange={onMarkdownChange}\n                    onActiveItemDetect={(headingText) => {\n                        if (!headingText || !project) return;\n                        const allSections = project.content.flatMap(item =>\n                            item instanceof Chapter ? item.sections : item instanceof Section ? [item] : []\n                        );\n                        const matched = allSections.find(s => s.title.trim() === headingText.trim());\n                        if (matched) {\n                            handleActiveSectionChange(matched.id);\n                        } else {\n                            const matchedChapter = project.content.find(\n                                item => item instanceof Chapter && item.title.trim() === headingText.trim()\n                            );\n                            if (matchedChapter) setActiveChapterId(matchedChapter.id);\n                        }\n                    }}\n                />\n            ) : (\n                <div className="space-y-12">\n                    {project.content.map((item, index) => {\n                        const isPreview = viewMode === \'preview\';\n\n                        if (item instanceof Chapter) {\n                            const chapterContent = (\n                                <div\n                                    id={`item-${item.id}`}\n                                    onMouseEnter={isPreview ? () => handleItemMouseEnter(item.id) : undefined}\n                                    onMouseLeave={isPreview ? handleItemMouseLeave : undefined}\n                                    onDoubleClick={!isPreview ? () => {\n                                        setActiveChapterId(item.id);\n                                        item.sections.forEach(s => handleActiveSectionChange(s.id, true));\n                                    } : undefined}\n                                    className={cn(\n                                        "space-y-8 scroll-mt-24 rounded-xl transition-all duration-200 group/chapter",\n                                        !isPreview && "cursor-default",\n                                        !isPreview && activeChapterId === item.id && "rounded-xl ring-1
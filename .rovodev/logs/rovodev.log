ol({\\n 112             projectPath,\\n 113             reportPeriod,\\n 114             startDate: input.startDate,\\n 115             endDate: input.endDate,\\n 116             includeRecommendations: true,\\n 117         });\\n 118 \\n 119         // Combine all information\\n 120         const fullReport = await ai.generate({\\n 121             model: OLLAMA_MODELS.LLAMA3_8B,\\n 122             prompt: `Create a comprehensive ${reportPeriod} project report for ${projectName}.\\n 123 \\n 124 Target Audience: ${targetAudience}\\n 125 \\n 126 Base Report:\\n 127 ${reportPromptResult.text}\\n 128 \\n 129 Additional Context:\\n 130 ${statusReport.executiveSummary}\\n 131 \\n 132 Metrics:\\n 133 ${metrics ? JSON.stringify(metrics, null, 2) : \'Not available\'}\\n 134 \\n 135 Git Statistics:\\n 136 ${gitHistory ? `\\n 137 - Total Commits: ${gitHistory.totalCommits}\\n 138 - Contributors: ${gitHistory.contributors.length}\\n 139 - Recent Activity: ${gitHistory.recentCommits.length} commits analyzed\\n 140 ` : \'Not available\'}\\n 141 \\n 142 ${timeline ? `\\n 143 Timeline:\\n 144 ${timeline.summary}\\n 145 ` : \'\'}\\n 146 \\n 147 Create a well-structured report with:\\n 148 1. Executive Summary (health status, key highlights)\\n 149 2. Detailed Metrics (with trends)\\n 150 3. Major Achievements\\n 151 4. Current Challenges\\n 152 5. Team Activity\\n 153 6. Roadmap Status\\n 154 7. Recommendations\\n 155 \\n 156 Format: Markdown with tables and visual indicators (✅ ⚠️ ❌ 📈 📉)`,\\n 157             output: { schema: ProjectReportSchema },\\n 158         });\\n 159 \\n 160         console.log(\'✅ Report generation complete!\');\\n 161 \\n 162         return fullReport.output!;\\n 163     }\\n 164 );\\n 165 \\n````","Successfully opened src/modules/ai/infrastructure/flows/document/project-documentation-generator.ts:\\n\\n````typescript\\n   0 /**\\n...\\n  27 const ProjectDocumentationInputSchema = ProjectDataSchema.extend({\\n...\\n  36 const ProjectDocumentationOutputSche
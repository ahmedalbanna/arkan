60 * 1000, // 24 hours\\n  44     searchResultCacheTTL: 60 * 60 * 1000, // 1 hour\\n  45   },\\n  46 } as const;\\n  47 \\n  48 /**\\n  49  * Validate RAG configuration\\n  50  */\\n  51 export function validateRAGConfig(): { valid: boolean; errors: string[] } {\\n  52   const errors: string[] = [];\\n  53 \\n  54   // Validate vector dimension\\n  55   if (RAGConfig.vectorStore.dimension <= 0) {\\n  56     errors.push(\'EMBEDDING_DIMENSION must be a positive number\');\\n  57   }\\n  58 \\n  59   // Validate Qdrant URL if using Qdrant\\n  60   if (RAGConfig.vectorStore.provider === \'qdrant\') {\\n  61     if (!RAGConfig.qdrant.url) {\\n  62       errors.push(\'QDRANT_URL is required when using Qdrant provider\');\\n  63     }\\n  64     \\n  65     try {\\n  66       new URL(RAGConfig.qdrant.url);\\n  67     } catch {\\n  68       errors.push(\'QDRANT_URL must be a valid URL\');\\n  69     }\\n  70   }\\n  71 \\n  72   // Validate Ollama URL\\n  73   try {\\n  74     new URL(RAGConfig.ollama.baseUrl);\\n  75   } catch {\\n  76     errors.push(\'OLLAMA_BASE_URL must be a valid URL\');\\n  77   }\\n  78 \\n  79   return {\\n  80     valid: errors.length === 0,\\n  81     errors,\\n  82   };\\n  83 }\\n  84 \\n````"]'}

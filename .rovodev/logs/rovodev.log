cking-[0.3em] gap-3 shadow-xl shadow-primary/10 rounded-2xl bg-primary hover:opacity-90 relative overflow-hidden group/run transition-all duration-500 ease-[0.22,1,0.36,1]"\n 185                         >\n 186                             {isAnalyzing ? (\n 187                                 <>\n 188                                     <Loader2 className="h-4 w-4 animate-spin" />\n 189                                     <span>Processing Matrix...</span>\n 190                                 </>\n 191                             ) : (\n 192                                 <>\n 193                                     <Zap className="h-4 w-4 transition-transform group-hover/run:rotate-12" />\n 194                                     <span>Initialize Spectral Analysis</span>\n 195                                 </>\n 196                             )}\n 197                             <div className="absolute inset-0 bg-gradient-to-r from-white/0 via-white/10 to-white/0 -translate-x-full group-hover/run:translate-x-full transition-transform duration-1000 ease-in-out" />\n 198                         </Button>\n 199                     </div>\n 200                 </form>\n 201             </Form>\n 202 \n 203             <Separator className="bg-primary/10 h-px" />\n 204 \n 205             <div className="flex-1 min-h-0 flex flex-col gap-4">\n 206                 <div className="flex items-center justify-between px-1">\n 207                     <div className="flex items-center gap-2">\n 208                         <Binary className="h-3 w-3 text-primary/40" />\n 209                         <span className="text-[9px] font-black uppercase tracking-widest text-muted-foreground/60">Spectrum Output</span>\n 210                     </div>\n 211                     {result && (\n 212                         <Button\n 213                             variant="ghost"\n 214                             size="sm"\n 215                             onClick={handleIntegrateInsight
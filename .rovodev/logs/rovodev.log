2026-04-03 04:43:43.338 | 9969  (9969) | DEBUG    | Processing tool event with attributes: {'gen_ai.tool.name': 'find_and_replace_code', 'gen_ai.tool.call.id': 'pyd_ai_e35fb7b8a7164421a0ad7f719365af83', 'tool_arguments': '{"file_path":"src/modules/ai/infrastructure/flows/document/project-documentation-generator.ts","find":"export const projectDocumentationGenerator = ai.defineFlow(\\n    {\\n        name: \'projectDocumentationGenerator\',\\n        inputSchema: ProjectDocumentationInputSchema,\\n        outputSchema: ProjectDocumentationOutputSchema,\\n    },\\n    async (input: z.infer<typeof ProjectDocumentationInputSchema>) => {","replace":"const projectDocumentationGeneratorFlow = ai.defineFlow(\\n    {\\n        name: \'projectDocumentationGenerator\',\\n        inputSchema: ProjectDocumentationInputSchema,\\n        outputSchema: ProjectDocumentationOutputSchema,\\n    },\\n    async (input: z.infer<typeof ProjectDocumentationInputSchema>) => {"}', 'logfire.msg': 'running tool: find_and_replace_code', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span', 'original_content': '/**\n * @fileOverview Project Documentation Generator Flow\n *\n * Comprehensive flow for generating complete project documentation packages\n * including README, API docs, user guide, and architecture diagrams.\n */\n\nimport { ai, OLLAMA_MODELS } from \'@/modules/ai/infrastructure/services/Genkit\';\nimport { readmeGenerationPrompt } from \'@/modules/ai/infrastructure/prompts/project-documentation\';\nimport {\n    ProjectDataSchema,\n    ReadmeOutputSchema\n} from \'@/modules/ai/domain/schemas/project-documentation\';\nimport {\n    createUserGuideTool,\n    generateAPIReferenceTool\n} from \'@/modules/ai/infrastructure/tools/documentation-generation\';\nimport {\n    analyzeProjectStructureTool,\n    extractDependenciesTool,\n} from \'@/modules/ai/infrastructure/tools/project-analysis\';\nimport {\n    generateArchitectureDiagramTool,\n} from \'@/modules/ai/infrastructure/tools/reporting-and-metrics\';\nimport {z} from \'zod\';\n// ==================== INPUT/OUTPUT SCHEMAS ====================\n\nconst ProjectDocumentationInputSchema = ProjectDataSchema.extend({\n    projectPath: z.string().describe(\'Path to the project directory\'),\n    includeREADME: z.boolean().default(true).describe(\'Generate README.md\'),\n    includeAPIReference: z.boolean().default(true).describe(\'Generate API documentation\'),\n    includeUserGuide: z.boolean().default(true).describe(\'Generate user guide\'),\n    includeArchitecture: z.boolean().default(true).describe(\'Generate architecture diagrams\'),\n    template: z.enum([\'minimal\', \'standard\', \'comprehensive\']).default(\'standard\'),\n});\n\nconst ProjectDocumentationOutputSchema = z.object({\n    readme: ReadmeOutputSchema.optional(),\n    apiDocumentation: z.string().optional(),\n    userGuide: z.string().optional(),\n    architectureDiagram: z.string().optional(),\n    projectStructure: z.string(),\n    dependencies: z.string(),\n    summary: z.string(),\n    fullDocumentationPackage: z.string(),\n});\n\n// ==================== MAIN FLOW ====================\n\nexport const projectDocumentationGenerator = ai.defineFlow(\n    {\n        name: \'projectDocumentationGenerator\',\n        inputSchema: ProjectDocumentationInputSchema,\n        outputSchema: ProjectDocumentationOutputSchema,\n    },\n    async (input: z.infer<typeof ProjectDocumentationInputSchema>) => {\n        const {\n            projectPath,\n            includeREADME,\n            includeAPIReference,\n            includeUserGuide,\n            includeArchitecture,\n            template,\n            projectName,\n            projectDescription,\n        } = input;\n\n        console.log(`🚀 Starting documentation generation for: ${projectName}`);\n\n        // Step 1: Analyze project structure\n        console.log(\'📊 Step 1/5: Analyzing project structure...\');\n        const projectStructure = await analyzeProjectStructureTool({\n            projectPath,\n            includeHidden: false,\n            maxDepth: 5,\n        });\n\n        // Step 2: Extract dependencies\n        console.log(\'📦 Step 2/5: Extracting dependencies...\');\n        const dependencies = await extractDependenciesTool({\n            projectPath,\n            analyzeOutdated: false,\n            categorize: true,\n        });\n\n        const results: any = {\n            projectStructure: JSON.stringify(projectStructure, null, 2),\n            dependencies: JSON.stringify(dependencies, null, 2),\n        };\n\n        // Step 3: Generate README (if requested)\n        if (includeREADME) {\n            console.log(\'📝 Step 3/5: Generating README.md...\');\n\n            const techStack = [\n                ...dependencies.categories.ui,\n                ...dependencies.categories.api,\n                ...dependencies.categories.build,\n            ].slice(0, 10);\n\n            const readmeResult = await readmeGenerationPrompt({\n                projectName,\n                description: projectDescription,\n                features: input.behaviors || [],\n                techStack,\n                template,\n            });\n\n            results.readme = {\n                title: projectName,\n                description: projectDescription,\n                fullContent: readmeResult.text,\n            };\n        }\n\n        // Step 4: Generate API Reference (if requested)\n        if (includeAPIReference) {\n            console.log(\'🔌 Step 4/5: Generating API documentation...\');\n\n            const apiDocs = await generateAPIReferenceTool({\n                sourcePath: `${projectPath}/src`,\n                format: \'markdown\',\n                includeExamples: true,\n                language: input.programmingLanguage || \'typescript\',\n            });\n\n            results.apiDocumentation = apiDocs.fullContent;\n        }\n\n        // Step 5: Generate User Guide (if requested)\n        if (includeUserGuide) {\n            console.log(\'📖 Step 5/5: Generating user guide...\');\n\n            const userGuide = await createUserGuideTool({\n                projectPath,\n                targetAudience: input.audienceLevel || \'Professional\',\n                includeScreenshots: true,\n            });\n\n            results.userGuide = userGuide.fullContent;\n        }\n\n        // Step 6: Generate Architecture Diagram (if requested)\n        if (includeArchitecture) {\n            console.log(\'🏗️ Generating architecture diagram...\');\n\n            const archDiagram = await generateArchitectureDiagramTool({\n                projectPath,\n                diagramType: (input.diagramType || \'component\') as "class" | "flowchart" | "sequence" | "component" | "deployment",\n                includeDetails: true,\n                style: \'detailed\',\n            });\n\n            results.architectureDiagram = archDiagram.diagram;\n        }\n\n        // Generate summary\n        console.log(\'✅ Finalizing documentation package...\');\n\n        const summary = await ai.generate({\n            model: OLLAMA_MODELS.PHI3_MINI,\n            prompt: `Create a brief summary of the generated documentation package for ${projectName}.\n\nProject Description: ${projectDescription}\nComponents Generated:\n${includeREADME ? \'- ✅ README.md\' : \'\'}\n${includeAPIReference ? \'- ✅ API Documentation\' : \'\'}\n${includeUserGuide ? \'- ✅ User Guide\' : \'\'}\n${includeArchitecture ? \'- ✅ Architecture Diagram\' : \'\'}\n\nWrite a 2-3 sentence summary highlighting what was generated and its purpose.`,\n        });\n\n        results.summary = summary.text;\n\n        // Create full documentation package markdown\n        const packageParts: string[] = [];\n\n        packageParts.push(`# ${projectName} - Complete Documentatio
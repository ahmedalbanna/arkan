|| {}).map(([key, value]) => (\\n          <div key={key} className=\\"flex flex-col gap-1.5 p-4 rounded-2xl bg-background border border-border/40 shadow-sm group/detail\\">\\n            <span className=\\"text-[9px] font-black uppercase tracking-widest text-muted-foreground/40 group-hover/detail:text-primary transition-colors\\">{key.replace(/_/g, \' \')}</span>\\n            <span className=\\"text-[12px] font-bold text-foreground/80 tabular-nums break-all\\">{String(value)}</span>\\n          </div>\\n        ))}\\n      </div>\\n    </div>\\n  );\\n}","file_path":"src/modules/billing/adapters/components/pricing/PurchaseCreditsDialog.tsx"}', 'logfire.msg': 'running tool: find_and_replace_code', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span'}

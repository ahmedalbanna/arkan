 export function useChapterActions(chapter: Chapter | null, onOpenChange?: (open: boolean) => void) {\\n  28   const { updateProject } = useBuilderStore();\\n  29   const { toast } = useToast();\\n  30   const [activeView, setActiveView] = useState<\'result\' | \'diff\'>(\'result\');\\n  31   const [manipulationType, setManipulationType] = useState<ManipulationType>(\'rewrite\');\\n  32   const [compressionRatio, setCompressionRatio] = useState(50);\\n  33   const [diff, setDiff] = useState<DiffPart[] | null>(null);\\n  34   const [context, setContext] = useState<SectionContext>({ sections: {}, externalContext: {} });\\n  35   \\n  36   const chapterContent = useMemo(() => {\\n  37     if (!chapter) return \'\';\\n  38     return chapter.sections.map(s => `# ${s.title}\\\\n\\\\n${s.content || \'\'}`).join(\'\\\\n\\\\n---\\\\n\\\\n\');\\n  39   }, [chapter]);\\n  40 \\n  41 \\n  42   // When the dialog opens (and chapter is available), default the context\\n  43   useEffect(() => {\\n  44     if (chapter) {\\n  45       const defaultContext: SectionContext = { sections: {}, externalContext: {} };\\n  46       // Default all sections within this chapter to be selected\\n  47       chapter.sections.forEach(section => {\\n  48         defaultContext.sections = defaultContext.sections || {};\\n  49         defaultContext.sections[section.id] = \'context\';\\n  50       });\\n  51       setContext(defaultContext);\\n  52     }\\n  53   }, [chapter]);\\n  54 \\n  55 \\n  56   const form = useForm<FormValues>({\\n  57     resolver: zodResolver(formSchema),\\n  58     defaultValues: {\\n  59       rewriteStyle: \'Formal\',\\n  60       targetAudience: \'\',\\n  61       tone: \'\',\\n  62       targetLevel: \'high-school\',\\n  63       targetReduction: 20,\\n  64       focusAreas: [],\\n  65     },\\n  66   });\\n  67 \\n  68   const mutation = useWritingTool(\'text-stylist\', {\\n  69     onSuccess: (data: any, variables) => {\\n  70       const resultText = data.rewrittenText || data.editedText || data.enhancedText || data.conciseText || data.improvedText || JSON.stringify(data, null, 2);\\n  71       const original = (variables as any).text;\\n  72       setDiff(computeDiff(original, resultText));\\n  73     },\\n  74     onError: (error) => {\\n  75       toast({ title: \'Action Failed\', description: error.message, variant: \'destructive\' });\\n  76     }\\n  77   });\\n  78 \\n  79   const onSubmit = (formData: FormValues) => {\\n  80     const textToProcess = chapterContent;\\n  81     if (!textToProcess.trim()) {\\n  82         toast({ title: \'No content to process\', description: \'The chapter has no content.\', variant: \'destructive\' });\\n  83         return;\\n  84     }\\n  85 \\n  86     let payload: any = { text: textToProcess };\\n  87 \\n  88     switch (manipulationType) {\\n  89         case \'rewrite\':\\n  90             payload.style = formData.rewriteStyle || \'neutral\';\\n  91             break;\\n  92         case \'summarize\':\\n  93              payload.ratio = compressionRatio;\\n  94              break;\\n  95         case \'style-editor\':\\n  96             payload.targetAudience = formData.targetAudience;\\n  97             payload.tone = formData.tone;\\n  98             break;\\n  99         case \'readability-enhancer\':\\n 100             payload.targetLevel = formData.targetLevel;\\n 101              break;\\n 102         case \'conciseness-checker\':\\n 103              payload.targetReduction = formData.targetReduction;\\n 104              break;\\n 105         case \'clarity-advisor\':\\n 106             payload.focusAreas = formData.focusAreas;\\n 107             break;\\n 108     }\\n 109     \\n 110     mutation.mutate(payload);\\n 111   };\\n 112   \\n 113   const isProcessing = mutation.isPending;\\n 114   const resultData = mutation.data as any;\\n 115   let processedText = \'\';\\n 116   if (resultData) {\\n 117       processedText = resultData.rewrittenText || resultData.summarized
zed error handler for API routes.\\n * @param error - The error object.\\n * @param defaultStatus - The HTTP status code to use if none is found on the error.\\n * @returns A NextResponse object with a standardized error format.\\n */\\nexport const handleApiError = (error: any, defaultStatus = 500) => {\\n  console.error(\\"API Route Error:\\", error);\\n\\n  // 1. Handle Zod validation errors specifically\\n  if (error instanceof ZodError) {\\n    return NextResponse.json({ message: \'Validation failed\', errors: error.flatten().fieldErrors }, { status: 400 });\\n  }\\n\\n  // 2. Handle database errors\\n  if (error.code && error.code.startsWith(\'23505\')) {\\n    // PostgreSQL unique constraint violation\\n    return NextResponse.json({ message: \'Resource already exists\' }, { status: 409 });\\n  }\\n\\n  if (error.code && error.code.startsWith(\'23503\')) {\\n    // PostgreSQL foreign key violation\\n    return NextResponse.json({ message: \'Referenced resource not found\' }, { status: 400 });\\n  }\\n\\n  // 3. Handle custom thrown errors (e.g., from our own logic)\\n  if (error.status && error.message) {\\n    return NextResponse.json({ message: error.message }, { status: error.status });\\n  }\\n\\n  // 4. Handle error objects with just a message\\n  if (error.message && !error.status) {\\n    return NextResponse.json({ message: error.message }, { status: defaultStatus });\\n  }\\n\\n  // 5. Fallback for generic/unexpected errors\\n  const message = error?.message || \'An unexpected server error occurred.\';\\n  const status = error?.status || defaultStatus;\\n\\n  return NextResponse.json({ message }, { status });\\n};"}', 'logfire.msg': 'running tool: find_and_replace_code', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span'}

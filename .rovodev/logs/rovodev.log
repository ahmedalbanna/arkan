IState = create<AgentState>((set) => ({\\n  26   selectedAgentId: null,\\n  27   responses: {},\\n  28   selectedCommandId: null,\\n  29   selectAgent: (agentId) => set({ selectedAgentId: agentId, selectedCommandId: null, responses: {} }),\\n  30   setSelectedCommandId: (commandId) => set({ selectedCommandId: commandId }),\\n  31   setResponse: (agentId, commandId, response) =>\\n  32     set((state) => {\\n  33       const newResponses = { ...state.responses };\\n  34       if (!newResponses[agentId]) newResponses[agentId] = {};\\n  35       if (!newResponses[agentId][commandId]) newResponses[agentId][commandId] = [];\\n  36       newResponses[agentId][commandId].push(response);\\n  37       return { responses: newResponses };\\n  38     }),\\n  39   clearResponses: (agentId, commandId) =>\\n  40     set((state) => {\\n  41       const newResponses = { ...state.responses };\\n  42       if (newResponses[agentId]) {\\n  43         if (commandId) delete newResponses[agentId][commandId];\\n  44         else delete newResponses[agentId];\\n  45       }\\n  46       return { responses: newResponses };\\n  47     }),\\n  48 }));\\n  49 \\n  50 export function useAgentManager() {\\n  51   const { user } = useAuth();\\n  52   const queryClient = useQueryClient();\\n  53   const { selectedAgentId, selectAgent, ...uiState } = useAgentUIState();\\n  54 \\n  55   const { data, isLoading, error, refetch } = useQuery({\\n  56     queryKey: agentKeys.all(),\\n  57     queryFn: async () => {\\n  58       if (!user) return [];\\n  59       const client = container.resolve(AgentApiClient);\\n  60       const result = await client.fetchAgentsApi();\\n  61       if (result.isFailure) throw result.error;\\n  62       \\n  63       const fetchedAgents = result.getValue();\\n  64       const cacheService = container.resolve<ICacheService>(ICacheServiceToken);\\n  65       cacheService.set(AGENTS_CACHE_KEY, fetchedAgents);\\n  66       return fetchedAgents;\\n  67     },\\n  68     initialData: () => {\\n  69       const cacheService = container.resolve<ICacheService>(ICacheServiceToken);\\n  70       return cacheService.get<AgentProperties[]>(AGENTS_CACHE_KEY);\\n  71     },\\n  72     enabled: Boolean(user),\\n  73     staleTime: 1000 * 60 * 5,\\n  74   });\\n  75 \\n  76   const agents = data || [];\\n  77 \\n  78   useEffect(() => {\\n  79     if (agents.length > 0 && !agents.find((agent) => agent.id === selectedAgentId)) {\\n  80       selectAgent(agents[0]?.id || null);\\n  81     }\\n  82   }, [agents, selectedAgentId, selectAgent]);\\n  83 \\n  84   const selectedAgent = agents.find((agent) => agent.id === selectedAgentId) || null;\\n  85 \\n  86   const createMutation = useMutation({\\n  87     mutationFn: async (data: Omit<AgentProperties, \'id\'> & { id: string }) => {\\n  88       const client = container.resolve(AgentApiClient);\\n  89       const result = await client.createAgentApi(data);\\n  90       if (result.isFailure) throw result.error;\\n  91       return result.getValue();\\n  92     },\\n  93     onSuccess: (newAgent) => {\\n  94       queryClient.invalidateQueries({ queryKey: agentKeys.all() });\\n  95       selectAgent(newAgent.id);\\n  96     },\\n  97   });\\n  98 \\n  99   const updateMutation = useMutation({\\n 100     mutationFn: async ({ id, data }: { id: string; data: Partial<AgentProperties> }) => {\\n 101       const client = container.resolve(AgentApiClient);\\n 102       const result = await client.updateAgentApi({ id, data });\\n 103       if (result.isFailure) throw result.error;\\n 104       return result.getValue();\\n 105     },\\n 106     onSuccess: () => {\\n 107       queryClient.invalidateQueries({ queryKey: agentKeys.all() });\\n 108     },\\n 109   });\\n 110 \\n 111   const deleteMutation = useMutation({\\n 112     mutationFn: async (id: string) => {\\n 113       const client = container.resolve(AgentApiClient);\\n 114       const result = await client.deleteAgentApi(id);\\n 115       if (result.isFailure) throw result.error;\\n 116       return result.getValue();\\n 117     },\\n 118     onSuccess: (_result, id) => {\\n 119       queryClient.invalidateQueries({ queryKey: agentKeys.all() });\\n 120       if (selectedAgentId === id) {\\n 121         selectAgent(null);\\n 122       }\\n 123     },\\n 124   });\\n 125 \\n 126   const createAgent = async (data: Omit<AgentProperties, \'id\'> & { id: string }) => {\\n 127     try {\\n 128       const newAgent = await createMutation.mutateAsync(data);\\n 129       toast({ title: \'Agent Created\', description: `\\"${newAgent.name}\\" has been created.` });\\n 130       return newAgent;\\n 131     } catch (error: any) {\\n 132       toast({ title: \'Creation Failed\', description: error.message, variant: \'destructive\' });\\n 133       throw error;\\n 134     }\\n 135   };\\n 136 \\n 137   const updateAgent = async (id: string, data: Partial<AgentProperties>) => {\\n 138     try {\\n 139       const updatedAgent = await updateMutation.mutateAsync({ id, data });\\n 140       toast({ title: \'Agent Updated\', description: `\\"${updatedAgent.name}\\" has been updated.` });\\n 141       return updatedAgent;\\n 142     } catch (error: any) {\\n 143       toast({ title: \'Update Failed\', description: error.message, variant: \'destructive\' });\\n 144       throw error;\\n 145     }\\n 146   };\\n 147 \\n 148   const deleteAgent = async (id: string) => {\\n 149     try {\\n 150       await deleteMutation.mutateAsync(id);\\n 151       toast({ title: \'Agent Deleted\', description: \'The agent has been removed.\' });\\n 152     } catch (error: any) {\\n 153       toast({ title: \'Delete Failed\', description: error.message, variant: \'destructive\' });\\n 154       throw error;\\n 155     }\\n 156   };\\n 157 \\n 158   const fetchAgents = () => {\\n 159     refetch();\\n 160   };\\n 161 \\n 162   return {\\n 163     agents,\\n 164     selectedAgent,\\n 165     selectAgent,\\n 166     isLoading,\\n 167     error: error instanceof Error ? error.message : null,\\n 168     createAgent,\\n 169     updateAgent,\\n 170     deleteAgent,\\n 171     fetchAgents,\\n 172     ...uiState,\\n 173   };\\n 174 }\\n 175 \\n````","Successfully opened docs/ARCHITECTURE_STANDARDS.md:\\n\\n````markdown\\n   0 # Architecture Standards: Result Object Pattern\\n   1 \\n   2 This document outlines the standard for error handling and state management across the backend modules using the **Result Object Pattern**.\\n   3 \\n   4 ## Overview\\n   5 \\n   6 The Result Object Pattern is a functional programming pattern used to represent the outcome of an operation that can either succeed or fail. Instead of throwing exceptions for expected business failures, we return a `Result` object that contains either the success value or a domain-specific error.\\n   7 \\n   8 ### Benefits\\n   9 - **Explicit Error Handling**: Failures are part of the function signature, forcing callers to handle them.\\n  10 - **Type Safety**: TypeScript ensures that you cannot access the value of a failed operation without checking its status.\\n  11 - **Clean Architecture**: Domain errors are separated from infrastructure-specific exceptions (like Firestore or Vector Store errors).\\n  12 - **Standardized API Responses**: Standardized handlers translate Result objects into consistent JSON responses.\\n  13 \\n  14 ---\\n  15 \\n  16 ## 1. The Result Class\\n  17 \\n  18 The core implementation lives in `src/lib/utils/result.ts`.\\n  19 \\n  20 ```typescript\\n  21 export class Result<T, E = Error> {\\n  22   public readonly isSuccess: boolean;\\n  23   public readonly isFailure: boolean;\\n  24   public readonly error: E | null;\\n  25   private readonly _value: T | null;\\n  26 \\n  27   // ... (implementation details)\\n  28 \\n  29   public getValue(): T {\\n  30     if (!this.isSuccess) {\\n  31       throw new Error(\\"Can\'t get the value of an error result.\\");\\n  32     }\\n  33     return this._value as T;\\n  34   }\\n  35 \\n  36   public static ok<T, E>(value?: T): Result<T, E> {\\n  37     return new Result<T, E>(true, undefined, value);\\n  38   }\\n  39 \\n  40   public static fail<T, E>(error: E): Result<T, E> {\\n  41     return new Result<T, E>(false, error);\\n  42   }\\n  43 }\\n  44 ```\\n  45 \\n  46 ---\\n  47 \\n  48 ## 2. Defining Domain Errors\\n  49 \\n  50 Each module should define its own domain error class and error types.\\n  51 \\n  52 **Example (`src/modules/projects/domain/errors/ProjectErrors.ts`):**\\n  53 \\n  54 ```typescript\\n  55 export enum ProjectErrorType {\\n  56   NOT_FOUND = \\"NOT_FOUND\\",\\n  57   VALIDATION = \\"VALIDATION\\",\\n  58   SAVE_ERROR = \\"SAVE_ERROR\\",\\n  59   INTERNAL = \\"INTERNAL\\"\\n  60 }\\n  61 \\n  62 export class ProjectError {\\n  63   constructor(\\n  64     public readonly type: ProjectErrorType,\\n  65     public readonly message: string,\\n  66     public readonly details?: any\\n  67   ) {}\\n  68 \\n  69   public static notFound(message: string): ProjectError {\\n  70     return new ProjectError(ProjectErrorType.NOT_FOUND, message);\\n  71   }\\n  72   // ... other static factory methods\\n  73 }\\n  74 ```\\n  75 \\n  76 ---\\n  77 \\n  78 ## 3. Implementation Layers\\n  79 \\n  80 ### Repository Layer\\n  81 Repositories should wrap technical exceptions and return Result objects.\\n  82 \\n  83 ```typescript\\n  84 async getById(id: string): Promise<Result<Project, ProjectError>> {\\n  85     try {\\n  86         const doc = await this.collection.doc(id).get();\\n  87         if (!doc.exists) {\\n  88             return Result.fail(ProjectError.notFound(`Project ${id} not found`));\\n  89         }\\n  90         return Result.ok(new Project(doc.data()));\\n  91     } catch (error: any) {\\n  92         return Result.fail(ProjectError.internal(error.message));\\n  93     }\\n  94 }\\n  95 ```\\n  96 \\n  97 ### Use Case Layer\\n  98 Use cases propagate results or combine multiple results.\\n  99 \\n 100 ```typescript\\n 101 async execute(id: string): Promise<Result<Project, ProjectError>> {\\n 102     return this.projectRepository.getById(id);\\n 103 }\\n 104 ```\\n 105 \\n 106 ### Controller Layer\\n 107 Controllers handle side effects (like cache revalidation) and return the Result.\\n 108 \\n 109 ```typescript\\n 110 async saveProject(data: any, userId: string) {\\n 111     const result = await this.saveProjectUseCase.execute(data, userId);\\n 112     if (result.isSuccess) {\\n 113         revalidatePath(\'/dashboard\');\\n 114     }\\n 115     return result;\\n 116 }\\n 117 ```\\n 118 \\n 119 ---\\n 120 \\n 121 ## 4. API Integration\\n 122 \\n 123 API routes use standardized handlers from `src/lib/utils/api-utils.ts` to convert Results into standard HTTP responses.\\n 124 \\n 125 ```typescript\\n 126 export const GET = withAuth(async ({ params }) => {\\n 127     const controller = container.resolve(ProjectController);\\n 128     const result = await controller.getProjectById(params.id);\\n 129     \\n 130     // Standardized mapping: NOT_FOUND -> 404, UNAUTHORIZED -> 401, etc.\\n 131     return handleProjectResult(result);\\n 132 });\\n 133 ```\\n 134 \\n 135 ---\\n 136 \\n 137 ## 5. Summary of Standard Handlers\\n 138 \\n 139 | Handler | Domain Error Type | Location |\\n 140 |---------|-------------------|----------|\\n 141 | `handleUserResult` | `UserError` | `api-utils.ts` |\\n 142 | `handleProjectResult` | `ProjectError` | `api-utils.ts` |\\n 143 | `handleBillingResult` | `BillingError` | `api-utils.ts` |\\n 144 | `handleRagResult` | `RagError` | `api-utils.ts` |\\n 145 | `handleTemplateResult` | `TemplateError` | `api-utils.ts` |\\n 146 | `handleAIContentResult` | `AIContentError` | `api-utils.ts` |\\n 147 \\n````"]'}

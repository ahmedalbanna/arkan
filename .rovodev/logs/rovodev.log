x-1 flex min-h-0 relative z-10\">\n                {/* Left Sidebar \u2014 Navigator & Ingestion */}\n                <AnimatePresence mode=\"popLayout\">\n                    {leftSidebar && (\n                        <motion.aside\n                            initial={{ x: -24, opacity: 0 }}\n                            animate={{ x: 0, opacity: 1 }}\n                            exit={{ x: -24, opacity: 0 }}\n                            transition={{ duration: 0.5, ease: [0.22, 1, 0.36, 1] }}\n                            className=\"flex-shrink-0 h-full relative z-20\"\n                        >\n                            {leftSidebar}\n                        </motion.aside>\n                    )}\n                </AnimatePresence>\n\n                {/* Central Canvas \u2014 Neural Workspace */}\n                <motion.div \n                    layout\n                    transition={{ duration: 0.6, ease: [0.22, 1, 0.36, 1] }}\n                    className=\"flex-1 min-w-0 h-full overflow-hidden relative z-10\"\n                >\n                    {canvas}\n                </motion.div>\n\n                {/* Right Sidebar \u2014 Synthesis & Parameter Tuning */}\n                <AnimatePresence mode=\"popLayout\">\n                    {rightSidebar && (\n                        <motion.aside\n                            initial={{ x: 24, opacity: 0 }}\n                            animate={{ x: 0, opacity: 1 }}\n                            exit={{ x: 24, opacity: 0 }}\n                            transition={{ duration: 0.5, ease: [0.22, 1, 0.36, 1] }}\n                            className=\"flex-shrink-0 h-full relative z-20\"\n                        >\n                            {rightSidebar}\n                        </motion.aside>\n                    )}\n                </AnimatePresence>\n            </main>\n\n            {/* Atmospheric Decoration \u2014 Global Matrix */}\n            <div className=\"absolute inset-0 pointer-events-none opacity-[0.01] bg-[radial-gradient(circle_at_center,_var(--primary)_1px,_transparent_1px)] bg-[size:40px_40px] z-0\" />\n        </div>\n    );\n};", "file_path": "src/modules/ai-content/adapters/components/builder/layout/BuilderLayout.tsx", "replace": "import React from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { cn } from '@/infrastructure/utils/cn';\nimport { PANEL_TRANSITION, SPRING_EASE } from './motion';\nimport { AtmosphericGrid } from '@/components/shared/AtmosphericGrid';\n\n/**\n * BuilderLayout \u2014 Structural foundation for the builder workspace.\n * Orchestrates the relationship between sidebars, canvas, and project header.\n */\n\ninterface BuilderLayoutProps {\n  header: React.ReactNode;\n  leftSidebar?: React.ReactNode;\n  rightSidebar?: React.ReactNode;\n  canvas: React.ReactNode;\n  className?: string;\n}\n\nexport const BuilderLayout: React.FC<BuilderLayoutProps> = ({\n  header,\n  leftSidebar,\n  rightSidebar,\n  canvas,\n  className,\n}) => {\n  return (\n    <div\n      className={cn(\n        'relative flex-grow flex flex-col bg-background overflow-hidden',\n        'h-[var(--workspace-h,calc(100vh-64px))]',\n        className\n      )}\n    >\n      {/* 1. HEADER ZONE */}\n      {header && (\n        <header className=\"flex-shrink-0 z-30 relative border-b border-primary/10\">\n          {header}\n        </header>\n      )}\n\n      {/* 2. CONTENT CORE \u2014 Edge-to-Edge Integration */}\n      <main className=\"flex-1 flex min-h-0 relative z-10\">\n        {/* Left Sidebar */}\n        <AnimatePresence mode=\"wait\">\n          {leftSidebar && (\n            <motion.aside\n              initial={{ x: -24, opacity: 0 }}\n              animate={{ x: 0, opacity: 1 }}\n              exit={{ x: -24, opacity: 0 }}\n              transition={PANEL_TRANSITION}\n              className=\"flex-shrink-0 h-full relative z-20\"\n            >\n              {leftSidebar}\n            </motion.aside>\n          )}\n        </AnimatePresence>\n\n        {/* Central Canvas */}\n        <motion.div\n          layout\n          transition={{ duration: 0.6, ease: SPRING_EASE }}\n          className=\"flex-1 min-w-0 h-full overflow-hidden relative z-10\"\n        >\n          {canvas}\n        </motion.div>\n\n        {/* Right Sidebar */}\n        <AnimatePresence mode=\"wait\">\n          {rightSidebar && (\n            <motion.aside\n              initial={{ x: 24, opacity: 0 }}\n              animate={{ x: 0, opacity: 1 }}\n              exit={{ x: 24, opacity: 0 }}\n              transition={PANEL_TRANSITION}\n              className=\"flex-shrink-0 h-full relative z-20\"\n            >\n              {rightSidebar}\n            </motion.aside>\n          )}\n        </AnimatePresence>\n      </main>\n\n      {/* Global Background Grid */}\n      <AtmosphericGrid opacity={0.01} size={40} className=\"z-0\" />\n    </div>\n  );\n};"}, "tool_call_id": "pyd_ai_3644abd9bc934f8482604870d977341f", "id": null, "provider_name": null, "provider_details": null, "part_kind": "tool-call"}

ngsHUD\';\nimport { ProjectOutlineHUD } from \'./outline/ProjectOutlineHUD\';\n\ninterface BuilderWorkspaceProps {\n    initialProject?: ProjectProperties | null;\n}\n\nexport const BuilderWorkspace: React.FC<BuilderWorkspaceProps> = ({ initialProject }) => {\n    const {\n        project,\n        updateProject,\n        updateProjectName,\n        isSaving,\n        hasUnsavedChanges,\n        handleSave,\n        activeChapterId,\n        setActiveChapterId,\n        selectedSectionIds,\n        handleActiveSectionChange,\n        activePanelKey,\n        setActivePanelKey,\n        activeRightPanelKey,\n        setActiveRightPanelKey,\n        isOutlineVisible,\n        setIsOutlineVisible,\n        zoomLevel,\n        handleZoomIn,\n        handleZoomOut,\n        handleZoomReset,\n        handleMoveItem,\n        handleUpdateTitle,\n        handleDeleteItem,\n        handleAddChapter,\n        handleAddSection,\n        handleDuplicateItem,\n        handleUndo,\n        handleCopyItem,\n        handlePasteItem,\n        summarizeMutation,\n        expandMutation,\n        rewriteMutation,\n        rewriteStyles,\n        viewMode,\n        setViewMode,\n        syncProjectStructure,\n    } = useReportGenerator(initialProject);\n\n    const { leftPanels, rightPanels } = useSidebarPanels({\n        project,\n        activeChapterId,\n        selectedSectionIds,\n        onActiveChapterChange: setActiveChapterId,\n        onActiveSectionChange: handleActiveSectionChange,\n        setActiveRightPanelKey,\n    });\n\n    const [showOnboarding, setShowOnboarding] = useState(false);\n    const [isFullscreen, setIsFullscreen] = useState(false);\n    const [showCoverPage, setShowCoverPage] = useState(false);\n    const [showCoverSettings, setShowCoverSettings] = useState(false);\n    \n    const containerRef = useRef<HTMLDivElement>(null);\n    const comparisonSnapshotId = useBuilderStore(state => state.comparisonSnapshotId);\n    const setComparisonSnapshotId = useBui
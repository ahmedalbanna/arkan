ctions ---\n  28         console.log("Preparing to seed Sections...");\n  29         const sectionsCollection = adminDb.collection(\'sections\');\n  30         defaultSections.forEach(section => {\n  31             const { ...sectionData } = section;\n  32             const docRef = sectionsCollection.doc(section.id || \'unknown\');\n  33             batch.set(docRef, { ...sectionData });\n  34         });\n  35         console.log(`${defaultSections.length} Sections added to batch.`);\n  36 \n  37         // --- Agents ---\n  38         console.log("Preparing to seed Agents...");\n  39         const agentsCollection = adminDb.collection(\'agents\');\n  40         defaultAgents.forEach(agent => {\n  41             const docRef = agentsCollection.doc(agent.id);\n  42             batch.set(docRef, agent);\n  43         });\n  44         console.log(`${defaultAgents.length} Agents added to batch.`);\n  45 \n  46         // --- Agent Categories ---\n  47         console.log("Preparing to seed Agent Categories...");\n  48         const agentCategoriesCollection = adminDb.collection(\'agent_categories\');\n  49         defaultAgentCategories.forEach(category => {\n  50             const docRef = agentCategoriesCollection.doc(category.id);\n  51             batch.set(docRef, category);\n  52         });\n  53         console.log(`${defaultAgentCategories.length} Agent Categories added to batch.`);\n  54 \n  55         // --- Features ---\n  56         console.log("Preparing to seed Features...");\n  57         const featuresCollection = adminDb.collection(\'features\');\n  58         defaultFeatures.forEach(feature => {\n  59             const docRef = featuresCollection.doc(feature.id);\n  60             batch.set(docRef, feature);\n  61         });\n  62         console.log(`${defaultFeatures.length} Features added to batch.`);\n  63 \n  64         // --- DOCX Templates ---\n  65         console.log("Preparing to seed DOCX templates...");\n  66         const docxCollection = adminDb.collection(\'templates\').doc(\'docx\').collection(\'styles\');\n  67         (Object.keys(defaultDocxTemplates) as DocxTemplateKey[]).forEach(key => {\n  68             const template = defaultDocxTemplates[key];\n  69             const docRef = docxCollection.doc(key);\n  70             batch.set(docRef, { ...template, id: key, createdAt: new Date().toISOString() });\n  71         });\n  72         console.log(`${Object.keys(defaultDocxTemplates).length} DOCX templates added to batch.`);\n  73 \n  74         // --- PPTX Templates ---\n  75         console.log("Preparing to seed PPTX templates...");\n  76         const pptxCollection = adminDb.collection(\'templates\').doc(\'pptx\').collection(\'styles\');\n  77         (Object.keys(defaultPptxTemplates) as PptxTemplateKey[]).forEach(key => {\n  78             const template = defaultPptxTemplates[key];\n  79             const docRef = pptxCollection.doc(key);\n  80             batch.set(docRef, { ...template, id: key, createdAt: new Date().toISOString() });\n  81         });\n  82         console.log(`${Object.keys(defaultPptxTemplates).length} PPTX templates added to batch.`);\n  83 \n  84         // --- Report Generation Templates ---\n  85         console.log("Preparing to seed Report Generation templates...");\n  86         const reportTemplateCollection = adminDb.collection(\'templates\').doc(\'report\').collection(\'items\');\n  87         defaultReportTemplates.forEach(template => {\n  88             const docRef = reportTemplateCollection.doc(template.id);\n  89             // The new structure has `content` which holds chapters and sections\n  90             const { sectionIds, ...restOfTemplate } = template as any; // Cast to any to handle old structure\n  91             const templateData = { ...restOfTemplate };\n  92              if (sectionIds) {\n  93                 // This logic can be removed if the old structure is fully deprecated.\n  94                 // It\'s here for backward c
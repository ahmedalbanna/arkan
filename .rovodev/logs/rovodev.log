 py-6 border-b border-primary/10 bg-primary/5\">\n  89                     <div className=\"flex items-center gap-4\">\n  90                         <div className=\"h-10 w-10 rounded-xl bg-primary/10 flex items-center justify-center border border-primary/20\">\n  91                             <FileCode className=\"h-5 w-5 text-primary\" />\n  92                         </div>\n  93                         <div>\n  94                             <DialogTitle className=\"text-[14px] font-black uppercase tracking-tight\">\n  95                                 {mode === 'add' ? 'Integrate Source Matrix' : 'Update Cognitive Vector'}\n  96                             </DialogTitle>\n  97                             <DialogDescription className=\"text-[10px] uppercase tracking-widest text-muted-foreground/60 font-bold\">\n  98                                 Raw data ingestion protocol\n  99                             </DialogDescription>\n 100                         </div>\n 101                     </div>\n 102                 </DialogHeader>\n 103 \n 104                 <div className=\"p-8 space-y-6\">\n 105                     <div className=\"space-y-2.5\">\n 106                         <Label className=\"text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60 px-1\">Source Identifier</Label>\n 107                         <Input\n 108                             value={name}\n 109                             onChange={(e) => setName(e.target.value)}\n 110                             placeholder=\"e.g., Reference_Data_Matrix_01\"\n 111                             className=\"h-11 bg-muted/5 border-primary/10 focus-visible:ring-primary/20 rounded-xl font-bold uppercase tracking-widest placeholder:text-muted-foreground/20\"\n 112                         />\n 113                     </div>\n 114                     <div className=\"space-y-2.5\">\n 115                         <Label className=\"text-[10px] font-black uppercase tracking-[0.2em] text-
vice\n  22     ) {}\n  23 \n  24     async generateText(prompt: string, options?: any): Promise<Result<string, AiError>> {\n  25         try {\n  26             const result = await ai.generate({\n  27                 prompt,\n  28                 ...options\n  29             });\n  30             return Result.ok(result.text);\n  31         } catch (error: any) {\n  32             return Result.fail(AiError.generationFailed(error.message));\n  33         }\n  34     }\n  35 \n  36     /**\n  37      * Post-processes AI output to remove common conversational prefixes from small models.\n  38      */\n  39     private cleanAiOutput(text: string): string {\n  40         if (!text) return text;\n  41         \n  42         // List of common conversational prefixes used by small models like Gemma/Phi\n  43         const patterns = [\n  44             /^Sure,? (here is|here\'s) the [^:]+:?\\s*/i,\n  45             /^Sure,? here (is|\'s) [^:]+:?\\s*/i,\n  46             /^Certainly!? [^:]+:?\\s*/i,\n  47             /^As requested,? [^:]+:?\\s*/i,\n  48             /^I have [^:]+ below:?\\s*/i,\n  49             /^The following is [^:]+:?\\s*/i,\n  50             /^Ok,? (here is|here\'s) [^:]+:?\\s*/i,\n  51             /^Below is the [^:]+:?\\s*/i,\n  52             /^Sure,? I can [^:]+:?\\s*/i,\n  53         ];\n  54 \n  55         let cleaned = text.trim();\n  56         // Run multiple passes to catch nested filler\n  57         for (let i = 0; i < 2; i++) {\n  58             for (const pattern of patterns) {\n  59                 cleaned = cleaned.replace(pattern, \'\');\n  60             }\n  61             cleaned = cleaned.trim();\n  62         }\n  63         return cleaned;\n  64     }\n  65 \n  66     async runFlow<TInput, TOutput>(flow: any, input: TInput, flowName?: string): Promise<Result<TOutput, AiError>> {\n  67         const primaryModel = flowName ? selectModel({ flowName }) : null;\n  68         const modelsToTry = primaryModel \n  69             ? [primaryModel, "ollama/phi4-mini:latest", "ollama/gemma:2b"] \n  70             : [null]; // null means direct execution without queue manager model selection\n  71         \n  72         // Remove duplicates while preserving order\n  73         const uniqueModels = Array.from(new Set(modelsToTry));\n  74         let lastError: any;\n  75 \n  76         for (const model of uniqueModels) {\n  77             try {\n  78                 let result: any;\n  79                 if (!model) {\n  80                     result = await flow(input);\n  81                 } else {\n  82                     result = await executeWithQueue(\n  83                         generateRequestId(),\n  84                         model,\n  85                         flowName,\n  86                         () => flow(input)\n  87                     );\n  88                 }\n  89 \n  90                 // Post-process string outputs to remove conversational filler\n  91                 if (result && typeof result === \'object\') {\n  92                     for (const key in result) {\n  93                         if (typeof result[key] === \'string\') {\n  94                             result[key] = this.cleanAiOutput(result[key]);\n  95                         }\n  96                     }\n  97                 } else if (typeof result === \'string\') {\n  98                     result = this.cleanAiOutput(result);\n  99                 }\n 100 \n 101                 return Result.ok(result as TOutput);\n 102             } catch (error: any) {\n 103                 lastError = error;\n 104                 console.warn(`Flow execution failed for model ${model || \'default\'} in ${flowName || \'unnamed flow\'}. Error: ${error.message}`);\n 105                 \n 106                 // If it\'s a validation error or user error, don\'t retry with other models\n 107                 if (error.message?.includes(\'validation\') || error.status === 400) {\n 108                     break;\n 109                 }\n 110                 \n 111                 // Continue to next model in the tiered fallback list\n 112                 continue;\n 113             }\n 114         }\n 115 \n 116         return Result.fail(AiError.generationFailed(lastError?.message || \'Flow execution failed after all fallback attempts\'));\n 117     }\n 118 \n 119     async retrieveContext(query: string, options?: RetrievalOptions): Promise<Result<RetrievalResult, AiError>> {\n 120         return this.retrievalService.retrieveContext(query, options);\n 121     }\n 122 \n 123     async generateChapterWithRAG(input: any): Promise<Result<any, AiError>> {\n 124         try {\n 125             const result = await generateChapterContentWithRAG(input);\n 126             return Result.ok(result);\n 127         } catch (error: any) {\n 128             return Result.fail(AiError.generationFailed(error.message));\n 129         }\n 130     }\n 131 \n 132     async generateSectionWithRAG(input: any): Promise<Result<any, AiError>> {\n 133         try {\n 134             const result = await generateReportSectionWithRAG(input);\n 135             return Result.ok(result);\n 136         } catch (error: any) {\n 137             return Result.fail(AiError.generationFailed(error.message));\n 138         }\n 139     }\n 140 }\n 141 \n````'}

ed: !!user,\\n  26   });\\n  27 }\\n  28 \\n  29 export function useTemplate(type: \'docx\' | \'pptx\' | \'report\', id: string) {\\n  30   const { user } = useAuth();\\n  31 \\n  32   return useQuery({\\n  33     queryKey: templateKeys.detail(type, id),\\n  34     queryFn: async () => {\\n  35       if (!user || !id) return null;\\n  36       const client = container.resolve(TemplateApiClient);\\n  37       let result;\\n  38       if (type === \'docx\') result = await client.fetchDocxTemplateByIdApi(id);\\n  39       else if (type === \'pptx\') result = await client.fetchPptxTemplateByIdApi(id);\\n  40       else result = await client.fetchReportTemplateByIdApi(id);\\n  41 \\n  42       if (result.isFailure) throw result.error;\\n  43       return result.getValue();\\n  44     },\\n  45     enabled: !!user && !!id,\\n  46   });\\n  47 }\\n  48 \\n  49 export function useSaveTemplate(type: \'docx\' | \'pptx\' | \'report\') {\\n  50   const queryClient = useQueryClient();\\n  51   const { toast } = useToast();\\n  52 \\n  53   return useMutation({\\n  54     mutationFn: async ({ id, data }: { id: string; data: any }) => {\\n  55       const client = container.resolve(TemplateApiClient);\\n  56       let result;\\n  57       if (type === \'docx\') result = await client.saveDocxTemplateApi({ id, data });\\n  58       else if (type === \'pptx\') result = await client.savePptxTemplateApi({ id, data });\\n  59       else result = await client.saveReportTemplateApi({ id, data });\\n  60 \\n  61       if (result.isFailure) throw result.error;\\n  62       return result.getValue();\\n  63     },\\n  64     onSuccess: (data) => {\\n  65       queryClient.invalidateQueries({ queryKey: templateKeys.lists(type) });\\n  66       if (data.id) {\\n  67         queryClient.invalidateQueries({ queryKey: templateKeys.detail(type, data.id) });\\n  68       }\\n  69       toast({ title: \'Success\', description: \'Template saved successfully.\' });\\n  70     },\\n  71     onError: (er
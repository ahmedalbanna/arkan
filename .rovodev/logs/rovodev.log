        isActive\n 117             ? \'bg-primary/10 border-primary/20 shadow-sm\'\n 118             : \'bg-transparent border-transparent hover:bg-muted/10\'\n 119         )}\n 120         onDoubleClick={handleStartEdit}\n 121       >\n 122         {/* Drag handle */}\n 123         <div\n 124           {...attributes}\n 125           {...listeners}\n 126           className="p-0.5 transition-all duration-300 opacity-0 group-hover/item:opacity-40 cursor-grab active:cursor-grabbing hover:opacity-100"\n 127         >\n 128           <GripVertical className="h-3 w-3" />\n 129         </div>\n 130 \n 131         {/* Index + title area */}\n 132         <div\n 133           className="flex-1 flex items-center gap-2 min-w-0"\n 134           onClick={(e) => {\n 135             e.stopPropagation();\n 136             onActivate();\n 137           }}\n 138         >\n 139           {isChapter && !isEditing && (\n 140             <button\n 141               onClick={(e) => {\n 142                 e.stopPropagation();\n 143                 onToggleExpand?.();\n 144               }}\n 145               className="p-0.5 hover:bg-primary/10 rounded transition-colors"\n 146             >\n 147               {isExpanded ? (\n 148                 <ChevronDown className="h-3 w-3" />\n 149               ) : (\n 150                 <ChevronRight className="h-3 w-3" />\n 151               )}\n 152             </button>\n 153           )}\n 154 \n 155           {!isEditing && (\n 156             <div\n 157               className={cn(\n 158                 \'h-1.5 w-1.5 rounded-full shrink-0\',\n 159                 hasContent ? \'bg-green-500\' : \'bg-amber-500/60\'\n 160               )}\n 161             />\n 162           )}\n 163 \n 164           {!isEditing && (\n 165             <span\n 166               className={cn(\n 167                 \'text-[10px] font-black tabular-nums opacity-40 uppercase tracking-widest shrink-0\',\n 168                 isActive && \'opacity-100 text-pri
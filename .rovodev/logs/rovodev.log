            <main className=\"flex-1 flex min-h-0 relative z-10\">\n                {/* Left Sidebar \u2014 Navigator & Ingestion */}\n                <AnimatePresence mode=\"popLayout\">\n                    {leftSidebar && (\n                        <motion.aside\n                            initial={{ x: -24, opacity: 0 }}\n                            animate={{ x: 0, opacity: 1 }}\n                            exit={{ x: -24, opacity: 0 }}\n                            transition={{ duration: 0.5, ease: [0.22, 1, 0.36, 1] }}\n                            className=\"flex-shrink-0 h-full p-6 pr-0\"\n                        >\n                            {leftSidebar}\n                        </motion.aside>\n                    )}\n                </AnimatePresence>\n\n                {/* Central Canvas \u2014 Neural Workspace */}\n                <motion.div \n                    layout\n                    transition={{ duration: 0.6, ease: [0.22, 1, 0.36, 1] }}\n                    className=\"flex-1 min-w-0 h-full overflow-hidden\"\n                >\n                    {canvas}\n                </motion.div>\n\n                {/* Right Sidebar \u2014 Synthesis & Parameter Tuning */}\n                <AnimatePresence mode=\"popLayout\">\n                    {rightSidebar && (\n                        <motion.aside\n                            initial={{ x: 24, opacity: 0 }}\n                            animate={{ x: 0, opacity: 1 }}\n                            exit={{ x: 24, opacity: 0 }}\n                            transition={{ duration: 0.5, ease: [0.22, 1, 0.36, 1] }}\n                            className=\"flex-shrink-0 h-full p-6 pl-0\"\n                        >\n                            {rightSidebar}\n                        </motion.aside>\n                    )}\n                </AnimatePresence>\n            </main>\n\n            {/* Atmospheric Decoration \u2014 Global Matrix */}\n            <div className=\"absolute inset-0 pointer-event
2026-04-04 07:04:16.571 | 113525 (113525) | DEBUG    | Processing tool event with attributes: {'gen_ai.tool.name': 'delete_file', 'gen_ai.tool.call.id': 'pyd_ai_c3b4b63c5e9d4a129dec9c29395aba0b', 'tool_arguments': '{"file_path":"src/modules/ai-content/adapters/components/report-mode/generation-tools/SectionAccordionItem.tsx"}', 'logfire.msg': 'running tool: delete_file', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span', 'original_content': '\'use client\';\n\nimport { Checkbox } from \'@/components/ui/checkbox\';\nimport { Tooltip, TooltipContent, TooltipProvider, TooltipTrigger } from \'@/components/ui/tooltip\';\nimport { cn } from \'@/infrastructure/utils/cn\';\nimport { useBuilderStore } from \'@/hooks\';\nimport { useAiActions } from \'@/modules/ai-content/adapters/hooks/report-mode/use-ai-actions\';\nimport { Section } from \'@/modules/ai-content/domain/entities/Section\';\nimport { type Project } from \'@/modules/projects/domain/entities/Project\';\nimport { useSortable } from \'@dnd-kit/sortable\';\nimport { CSS } from \'@dnd-kit/utilities\';\nimport { GripVertical, Link as LinkIcon, Loader2 } from \'lucide-react\';\nimport React from \'react\';\n\ninterface SectionAccordionItemProps {\n  section: Section;\n  chapterIndex: number;\n  sectionIndex: number;\n  isProjectBuildMode: boolean;\n  isSelected: boolean;\n  isActive: boolean;\n  onActivate: (sectionId: string, multiSelect?: boolean) => void;\n  toggleSectionSelection: (sectionId: string) => void;\n}\n\nexport function SectionAccordionItem({\n  section,\n  chapterIndex,\n  sectionIndex,\n  isProjectBuildMode,\n  isSelected,\n  isActive,\n  onActivate,\n  toggleSectionSelection,\n}: SectionAccordionItemProps) {\n  const { project } = useBuilderStore();\n  const { generateSectionMutation } = useAiActions();\n\n  const { attributes, listeners, setNodeRef, transform, transition, isDragging } = useSortable({\n    id: section.id,\n  });\n\n  const style: React.CSSProperties = {\n    transform: CSS.Transform.toString(transform),\n    transition,\n    zIndex: isDragging ? 2 : 0,\n    position: \'relative\',\n  };\n\n  if (!section) return null;\n\n  const isGenerating =\n    generateSectionMutation?.isPending && generateSectionMutation.variables === section.id;\n\n  const getContextNames = (proj: Project | null, sec: Section): string[] => {\n    if (!proj || !sec.context) return [];\n    const sectionNames = Object.keys(sec.context.sections || {}).map(\n      id => proj?.getSection(id)?.title || \'Untitled Section\'\n    );\n    const fileNames = Object.keys(sec.context.externalContext || {}).map(\n      id => proj?.externalContext?.find(f => f.id === id)?.fileName || \'Untitled File\'\n    );\n    return [...sectionNames, ...fileNames];\n  };\n\n  const contextNames = getContextNames(project, section);\n  const totalContext = contextNames.length;\n\n  const handleActivate = (e: React.MouseEvent) => {\n    onActivate(section.id, e.shiftKey || e.metaKey || e.ctrlKey);\n  };\n\n  return (\n    <div\n      ref={setNodeRef}\n      style={style}\n      {...attributes}\n      className={cn(\n        \'group/item relative rounded-xl border transition-all duration-300 ease-out hover:translate-x-0.5\',\n        isActive\n          ? \'border-primary/30 bg-primary/[0.03] shadow-[0_0_20px_rgba(var(--primary),0.08)] ring-1 ring-primary/20 -translate-y-[0.5px]\'\n          : \'border-border/40 bg-card/50 shadow-sm hover:border-primary/20 hover:bg-muted/5\'\n      )}\n    >\n      <div\n        className="flex items-center gap-2 px-3 py-2 cursor-pointer select-none"\n        onClick={handleActivate}\n      >\n        {/* Build mode checkbox */}\n        {isProjectBuildMode && (\n          <div\n            className="shrink-0"\n            onClick={e => {\n              e.stopPropagation();\n              toggleSectionSelection(section.id);\n            }}\n          >\n            <Checkbox\n              checked={isSelected}\n              aria-label={`Select section ${section.title}`}\n              className="h-3.5 w-3.5 rounded-sm border-muted-foreground/30 data-[state=checked]:bg-primary data-[state=checked]:border-primary"\n            />\n          </div>\n        )}\n\n        {/* Index label + drag handle */}\n        {listeners && (\n          <div\n            {...listeners}\n            className="flex items-center gap-1 shrink-0 text-muted-foreground/40 transition-colors hover:text-primary cursor-grab active:cursor-grabbing"\n            onClick={e => e.stopPropagation()}\n          >\n            <span className="text-[9px] font-black uppercase tracking-[0.3em] w-7 text-center tabular-nums opacity-60 border-r border-primary/10 pr-1">\n              {chapterIndex >= 0\n                ? `${chapterIndex + 1}.${sectionIndex + 1}`\n                : `${sectionIndex + 1}`}\n            </span>\n            <GripVertical className="h-3.5 w-3.5 opacity-40 group-hover/item:opacity-100 transition-opacity ml-1" />\n          </div>\n        )}\n\n        {/* Status indicator + title */}\n        <div className="flex items-center gap-2 flex-1 min-w-0">\n          {isGenerating ? (\n            <div className="relative shrink-0">\n              <Loader2 className="h-3 w-3 animate-spin text-primary" />\n              <div className="absolute inset-0 blur-sm bg-primary/20 animate-pulse rounded-full" />\n            </div>\n          ) : (\n            <div\n              className={cn(\n                \'h-1.5 w-1.5 rounded-full shrink-0 transition-all duration-300\',\n                isActive\n                  ? \'bg-primary scale-125 shadow-[0_0_12px_rgba(var(--primary),0.8)] animate-pulse\'\n                  : \'bg-muted-foreground/20\'\n              )}\n            />\n          )}\n\n          <span\n            className={cn(\n              \'text-[11px] font-bold tracking-tight truncate flex-1 transition-colors duration-200\',\n              isActive ? \'text-foreground\' : \'text-muted-foreground/80 group-hover/item:text-foreground\'\n            )}\n          >\n            {section.title}\n          </span>\n        </div>\n\n        {/* Context badge */}\n        {totalContext > 0 && (\n          <div className="shrink-0">\n            <TooltipProvider>\n              <Tooltip>\n                <TooltipTrigger asChild>\n                  <div\n                    className="flex items-center gap-1 rounded-full bg-primary/10 px-2 py-0.5 text-primary ring-1 ring-primary/20 transition-colors hover:bg-primary/20 cursor-pointer"\n                  >\n                    <LinkIcon className="h-2.5 w-2.5" />\n                    <span className="text-[9px] font-bold tabular-nums">{totalContext}</span>\n                  </div>\n                </TooltipTrigger>\n                <TooltipContent side="top" className="border-primary/20 bg-background/95 backdrop-blur-md">\n                  <div className="space-y-1.5 p-1 text-[10px] font-medium">\n                    <p className="mb-1.5 border-b border-primary/10 pb-1 text-[8px] font-black uppercase tracking-[0.2em] text-primary">\n                      Linked Context\n                    </p>\n                    {contextNames.map((name, i) => (\n                      <div key={name + i} className="flex items-center gap-2 max-w-[180px]">\n                        <div className="h-1 w-1 rounded-full bg-primary/40 shrink-0" />\n                        <span className="truncate">{name}</span>\n                      </div>\n                    ))}\n                  </div>\n                </TooltipContent>\n              </Tooltip>\n            </TooltipProvider>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n', 'tool_response': 'Successfully deleted src/modules/ai-content/adapters/components/report-mode/generation-tools/SectionAccordionItem.tsx.'}

              <button \n 388                         onClick={() => setSearchQuery('')}\n 389                         className=\"absolute right-2.5 top-1/2 -translate-y-1/2 hover:text-primary transition-colors\"\n 390                     >\n 391                         <X className=\"h-3 w-3\" />\n 392                     </button>\n 393                 )}\n 394             </div>\n 395           </div>\n 396 \n 397           {/* Outline List */}\n 398           <div className=\"flex-1 overflow-auto p-2 custom-scrollbar\">\n 399             <DndContext \n 400               sensors={sensors}\n 401               collisionDetection={closestCenter}\n 402               onDragEnd={handleDragEnd}\n 403             >\n 404               <SortableContext \n 405                 items={allSortableIds}\n 406                 strategy={verticalListSortingStrategy}\n 407               >\n 408                 {filteredChapters.map((chapter, cIdx) => (\n 409                   <SortableItem\n 410                     key={chapter.id}\n 411                     id={chapter.id}\n 412                     index={cIdx}\n 413                     title={chapter.title}\n 414                     isActive={activeChapterId === chapter.id}\n 415                     isChapter={true}\n 416                     isExpanded={expandedChapters.has(chapter.id) || !!searchQuery.trim()}\n 417                     hasContent={chapter.sections.some((s: Section) => !!s.content)}\n 418                     onActivate={() => handleItemClick(chapter.id, true)}\n 419                     onToggleExpand={() => toggleChapter(chapter.id)}\n 420                     onUpdateTitle={(newTitle) => onUpdateTitle(chapter.id, newTitle, true)}\n 421                     onDelete={() => onDeleteItem(chapter.id, true)}\n 422                   >\n 423                     {(chapter.sections as Section[])\n 424                       .filter(s => !searchQuery.trim() || s.title.toLowerCase().includes(searchQuery.toLowerCase()) || chapter.title.toLowerCase().includes(searchQuery.toLowerCase()))\n 425                       .map((section, sIdx) => (\n 426                       <SortableItem\n 427                         key={section.id}\n 428                         id={section.id}\n 429                         index={sIdx}\n 430                         title={section.title}\n 431                         isActive={selectedSectionIds.includes(section.id)}\n 432                         hasContent={!!section.content}\n 433                         onActivate={() => handleItemClick(section.id, false)}\n 434                         onUpdateTitle={(newTitle) => onUpdateTitle(section.id, newTitle, false)}\n 435                         onDelete={() => onDeleteItem(section.id, false)}\n 436                       />\n 437                     ))}\n 438                     {!searchQuery && (\n 439                         <div \n 440                             className=\"ml-4 mt-1 mb-2 px-2 py-1.5 flex items-center gap-2 rounded-lg border border-dashed border-primary/20 bg-primary/[0.02] hover:bg-primary/[0.05] transition-all cursor-pointer group/add\"\n 441                             onClick={(e) => { e.stopPropagation(); onAddSection(chapter.id); }}\n 442                         >\n 443                             <Plus className=\"h-3 w-3 text-primary/40 group-hover/add:text-primary transition-colors\" />\n 444                             <span className=\"text-[9px] font-black uppercase tracking-[0.2em] text-primary/40 group-hover/add:text-primary transition-colors\">Add Section</span>\n 445                         </div>\n 446                     )}\n 447                   </SortableItem>\n 448                 ))}\n 449               </SortableContext>\n 450             </DndContext>\n 451           </div>\n 452 \n 453           {/* Footer Metadata */}\n 454           <div className=\"px-4 py-2 bg-muted/20 border-t border-primary/10 flex items-center justify-between\">\n 455              <p className=\"text-[8px] font-black uppercase tracking-[0.2em] text-muted-foreground/60\">\n 456                 Document Outline\n 457              </p>\n 458              <div className=\"flex items-center gap-1\">\n 459                 <div className=\"h-1 w-1 rounded-full bg-green-500\" />\n 460                 <p className=\"text-[8px] font-black uppercase tracking-[0.2em] text-green-600/60\">Live</p>\n 461              </div>\n 462           </div>\n 463         </motion.div>\n 464       )}\n 465     </AnimatePresence>\n 466   );\n 467 };\n 468 \n````", "tool_call_id": "pyd_ai_436b9033ce634ba7898449c89de5d426", "metadata": null, "timestamp": "2026-04-04T06:10:05.917485+00:00", "part_kind": "tool-return"}

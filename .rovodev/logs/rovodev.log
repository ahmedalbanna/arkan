er.push(\'/builder\');\n  34       toast({ title: "Welcome back!" });\n  35     },\n  36     onError: (error) => handleErrorUtility(error, "Login Failed")\n  37   });\n  38 }\n  39 \n  40 // Helper to create profile on first sign-in\n  41 async function handleFirstSignIn(user: FirebaseUser) {\n  42   // Check if a profile already exists by trying to fetch it.\n  43   // We expect this to fail for a new user.\n  44   const token = await user.getIdToken();\n  45   try {\n  46     const existingProfile = await fetchUserProfileApi(user.uid, token);\n  47 \n  48     if (!existingProfile) {\n  49       // Profile doesn\'t exist, so create it.\n  50       const profileData: Partial<UserProfile> = {\n  51         id: user.uid,\n  52         name: user.displayName || `User ${user.uid.slice(0, 6)}`,\n  53         email: user.email || \'\',\n  54       };\n  55       await createOrUpdateUserProfileApi(user.uid, profileData, token);\n  56     }\n  57   } catch (error) {\n  58     // Handle cases where the initial fetch fails for reasons other than 404\n  59     console.error("Error during first sign-in profile check:", error);\n  60   }\n  61 }\n  62 \n  63 \n  64 export function useGoogleSignIn() {\n  65   const router = useRouter();\n  66   const queryClient = useQueryClient();\n  67   const { toast } = useToast();\n  68 \n  69   return useMutation({\n  70     mutationFn: loginWithGoogle,\n  71     onSuccess: async (userCredential) => {\n  72       const isNewUser = userCredential.isNewUser;\n  73       if (isNewUser) {\n  74         await handleFirstSignIn(userCredential.user);\n  75       }\n  76       queryClient.invalidateQueries({ queryKey: userKeys.all });\n  77       router.push(\'/builder\');\n  78       toast({ title: `Welcome, ${userCredential.user.displayName}!` });\n  79     },\n  80     onError: (error) => handleErrorUtility(error, "Google Sign-In Failed")\n  81   });\n  82 }\n  83 \n  84 export function usePhoneSignIn() {\n  85   const [isLoading, setIsLoading] 
ext Vectors.\\n  67               </DialogDescription>\\n  68             </div>\\n  69           </div>\\n  70         </header>\\n  71 \\n  72         {/* Matrix Body — Monospace Code View */}\\n  73         <div className=\\"flex-1 min-h-0 relative group bg-[#0d1117]/95 dark:bg-black/60 shadow-inner\\">\\n  74           {/* Action HUD — Floating Copy */}\\n  75           <div className=\\"absolute top-6 right-8 z-30 opacity-40 hover:opacity-100 transition-opacity duration-500\\">\\n  76             <Button\\n  77               variant=\\"default\\"\\n  78               size=\\"sm\\"\\n  79               onClick={handleCopy}\\n  80               className=\\"h-9 px-4 gap-2.5 text-[9px] font-black uppercase tracking-[0.2em] shadow-2xl shadow-primary/20 rounded-xl ring-1 ring-inset ring-white/20 transition-all hover:scale-105 active:scale-95\\"\\n  81             >\\n  82               {copied ? (\\n  83                 <>\\n  84                   <Check className=\\"h-4 w-4\\" />\\n  85                   Manifest Copied\\n  86                 </>\\n  87               ) : (\\n  88                 <>\\n  89                   <Copy className=\\"h-4 w-4\\" />\\n  90                   Copy Instruction Set\\n  91                 </>\\n  92               )}\\n  93             </Button>\\n  94           </div>\\n  95 \\n  96           <ScrollArea className=\\"h-[60vh] w-full custom-scrollbar\\">\\n  97             <div className=\\"p-10 pb-24 relative\\">\\n  98               {/* Technical Code Line Indices Decoration */}\\n  99               <div className=\\"absolute left-0 top-0 bottom-0 w-12 border-r border-white/5 bg-white/[0.02] pointer-events-none\\" />\\n 100               \\n 101               <pre className=\\"text-[13px] whitespace-pre-wrap font-mono leading-relaxed text-blue-100/80 selection:bg-primary/30 pl-6\\">\\n 102                 {fullPrompt}\\n 103               </pre>\\n 104             </div>\\n 105 \\n 106             {/* Bottom ambient fade for deep
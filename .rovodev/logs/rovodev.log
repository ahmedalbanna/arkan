iptionPrompt\',\\n  14         input: { schema: GenerateUIDescriptionInputSchema },\\n  15         output: { schema: GenerateUIDescriptionOutputSchema },\\n  16 \\n  17         system: `You are a senior UI/UX designer and product manager. Your task is to take a list of project features and generate a comprehensive, screen-by-screen UI/UX workflow description for either a website or mobile app. The output must be well-structured markdown.`,\\n  18         prompt: `Based on the following project features for a new ${designType}, generate a detailed UI/UX workflow.\\n  19 \\n  20 For each core feature, describe the necessary screens or pages. For each screen, detail its primary purpose and list the key UI elements (e.g., buttons, forms, navigation bars, content areas). Think about the user journey and how they will navigate between screens.\\n  21 \\n  22 **Project Features:**\\n  23 ---\\n  24 {{{projectFeatures}}}\\n  25 ---\\n  26 \\n  27 **Output Format (Markdown):**\\n  28 - Use \'##\' for each User Role (e.g., \'## Unauthenticated User\', \'## Authenticated User\').\\n  29 - Use \'###\' for each major Page/Screen (e.g., \'### Home Page\', \'### Login Screen\').\\n  30 - Under each screen, use bullet points to list the \'Purpose\' and \'Key UI Elements\'.`,\\n  31         config: {\\n  32             temperature: 0.5,\\n  33             maxOutputTokens: 4096,\\n  34         }\\n  35     });\\n  36 \\n  37     const { output } = await uiPrompt({projectFeatures, designType });\\n  38     if (!output) {\\n  39         throw new Error(\\"Failed to generate UI description.\\");\\n  40     }\\n  41 \\n  42     return output;\\n  43 });\\n  44 \\n  45 export async function generateUiDescription(input: GenerateUIDescriptionInput): Promise<GenerateUIDescriptionOutput> {\\n  46     const validation = GenerateUIDescriptionInputSchema.safeParse(input);\\n  47     if (!validation.success) {\\n  48         throw new Error(`Invalid input for generateUiDescription: ${validation.e
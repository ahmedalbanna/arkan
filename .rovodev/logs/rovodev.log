ive z-10 p-5 flex flex-col gap-6\\">\\n                    {children}\\n                </div>\\n            ) : (\\n                <ScrollArea className=\\"flex-1 min-h-0 relative z-10 custom-scrollbar\\">\\n                    <div className=\\"p-5 flex flex-col gap-6 pb-24 w-max min-w-full\\">\\n                        {children}\\n                    </div>\\n                </ScrollArea>\\n            )}\\n\\n            </div>\\n    );\\n};"}', 'logfire.msg': 'running tool: find_and_replace_code', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span'}

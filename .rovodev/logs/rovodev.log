      <div className=\"p-8 border-t bg-muted/5 bg-background/80 backdrop-blur-xl relative z-10\">\n 147         <Form {...form}>\n 148           <form onSubmit={form.handleSubmit(onSubmit)} className=\"relative max-w-4xl mx-auto\">\n 149             <FormField\n 150               control={form.control}\n 151               name=\"userPrompt\"\n 152               render={({ field }) => (\n 153                 <FormItem>\n 154                   <FormControl>\n 155                     <Textarea\n 156                       {...field}\n 157                       placeholder={`Instruct ${agent.name} to execute synthesis...`}\n 158                       className=\"min-h-[100px] w-full bg-background shadow-xl rounded-[24px] border-none ring-1 ring-border/60 focus-visible:ring-primary/40 resize-none px-6 py-5 text-sm leading-relaxed pr-24\"\n 159                       disabled={mutation.isPending || isGuest}\n 160                     />\n 161                   </FormControl>\n 162                 </FormItem>\n 163               )}\n 164             />\n 165             <Button\n 166                 type=\"submit\"\n 167                 size=\"sm\"\n 168                 className=\"absolute bottom-4 right-4 h-12 px-6 rounded-2xl font-bold shadow-xl shadow-primary/20 gap-2 transition-all active:scale-95\"\n 169                 disabled={mutation.isPending || isGuest}\n 170             >\n 171               {mutation.isPending ? (\n 172                 <Loader2 className=\"h-4 w-4 animate-spin\" />\n 173               ) : (\n 174                 <Zap className=\"h-4 w-4 fill-primary-foreground\" />\n 175               )}\n 176               {mutation.isPending ? \"Syncing\" : \"Initiate\"}\n 177             </Button>\n 178           </form>\n 179         </Form>\n 180         <p className=\"text-[9px] text-center text-muted-foreground mt-4 font-medium uppercase tracking-tighter opacity-40\">\n 181             Neural Node V1.0 Stable \u2022 Session Encrypted\n 182         </p>\n
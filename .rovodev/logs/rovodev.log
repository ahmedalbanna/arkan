x));\n 320                                                 } catch (e) {\n 321                                                     console.error(\'[UploadManager] Vector removal failure:\', e);\n 322                                                 }\n 323                                             }}\n 324                                             className={selectedFileId === item.id ? \'border-primary/30 bg-primary/[0.03] ring-1 ring-primary/10\' : \'\'}\n 325                                         />\n 326                                         <div className="flex items-center gap-2 pl-4">\n 327                                             <div className="h-px w-3 bg-primary/20" />\n 328                                             <Select\n 329                                                 value={item.type}\n 330                                                 onValueChange={(v: ExternalContextType) => {\n 331                                                     try {\n 332                                                         updateProject(p => p.updateExternalContextType(index, v));\n 333                                                     } catch (e) {\n 334                                                         console.error(\'[UploadManager] Type classification failure:\', e);\n 335                                                     }\n 336                                                 }}\n 337                                             >\n 338                                                 <SelectTrigger className="h-6 w-auto min-w-[100px] border-none bg-primary/5 hover:bg-primary/10 text-[8px] font-black uppercase tracking-widest text-primary/60 transition-all px-2.5 rounded-lg focus:ring-0">\n 339                                                     <SelectValue />\n 340                                                 </SelectTrigger>\n 341                                                 <SelectContent className="rounded-xl border-primary/10 
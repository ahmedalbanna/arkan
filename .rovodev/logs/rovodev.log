Project.updateChapter(data.chapterId, (chapter) => chapter.withProps({ sections: newChapter.sections.map(s => s.toProperties()) }));\n 234         }\n 235         return currentProject;\n 236       });\n 237       refetchUser();\n 238       toast({ title: 'Chapter Generated', description: 'The AI has generated the content for the chapter.' });\n 239     },\n 240     onError: (error: any) => toast({ title: 'Chapter Generation Error', description: error.message, variant: 'destructive' }),\n 241   });\n 242 \n 243   const generateProjectMutation = useMutation({\n 244     mutationKey: ['generateProjectContent'],\n 245     mutationFn: async ({ project, selectedSectionIds }: { project: Project; selectedSectionIds: Set<string> }) => {\n 246       if (!user) throw new Error('User not found.');\n 247       if (selectedSectionIds.size === 0) throw new Error('No sections were selected for generation.');\n 248 \n 249       const { startBulk, stopBulk, incrementProgress } = useGenerationUIStore.getState();\n 250       startBulk(selectedSectionIds.size);\n 251 \n 252       try {\n 253         for (const sectionId of selectedSectionIds) {\n 254           if (useGenerationUIStore.getState().abortRequested) {\n 255             useGenerationUIStore.getState().cancelGeneration(sectionId);\n 256             toast({ title: 'Generation Stopped', description: 'Bulk generation was canceled by user.' });\n 257             break;\n 258           }\n 259           await generateSectionMutation.mutateAsync(sectionId);\n 260           incrementProgress();\n 261         }\n 262       } finally {\n 263         stopBulk();\n 264       }\n 265     },\n 266     onSuccess: () => {\n 267         if (!useGenerationUIStore.getState().abortRequested) {\n 268             toast({ title: 'Project Build Complete', description: 'All selected sections have been successfully generated.' });\n 269         }\n 270     },\n 271     onError: (error: Error) => toast({ title: 'Project Build Failed', description: erro
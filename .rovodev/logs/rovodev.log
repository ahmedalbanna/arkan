n\nsrc/modules/admin/application/: (COLLAPSED)\n\nsrc/modules/admin/domain/: (COLLAPSED)\n\nsrc/modules/admin/infrastructure/: (COLLAPSED)\n\nsrc/modules/ai-content/:\n\nsrc/modules/ai-content/adapters/: (COLLAPSED)\n\nsrc/modules/ai-content/application/: (COLLAPSED)\n\nsrc/modules/ai-content/domain/: (COLLAPSED)\n\nsrc/modules/ai-content/infrastructure/: (COLLAPSED)\n\nsrc/modules/ai/:\nindex.ts\n\nsrc/modules/ai/adapters/: (COLLAPSED)\n\nsrc/modules/ai/application/: (COLLAPSED)\n\nsrc/modules/ai/domain/: (COLLAPSED)\n\nsrc/modules/ai/infrastructure/: (COLLAPSED)\n\nsrc/modules/billing/:\n\nsrc/modules/billing/adapters/: (COLLAPSED)\n\nsrc/modules/billing/application/: (COLLAPSED)\n\nsrc/modules/billing/domain/: (COLLAPSED)\n\nsrc/modules/billing/infrastructure/: (COLLAPSED)\n\nsrc/modules/projects/:\n\nsrc/modules/projects/adapters/: (COLLAPSED)\n\nsrc/modules/projects/application/: (COLLAPSED)\n\nsrc/modules/projects/domain/: (COLLAPSED)\n\nsrc/modules/projects/infrastructure/: (COLLAPSED)\n\nsrc/modules/rag/:\n\nsrc/modules/rag/adapters/: (COLLAPSED)\n\nsrc/modules/rag/application/: (COLLAPSED)\n\nsrc/modules/rag/domain/: (COLLAPSED)\n\nsrc/modules/rag/infrastructure/: (COLLAPSED)\n\nsrc/modules/templates/:\n\nsrc/modules/templates/adapters/: (COLLAPSED)\n\nsrc/modules/templates/application/: (COLLAPSED)\n\nsrc/modules/templates/domain/: (COLLAPSED)\n\nsrc/modules/templates/infrastructure/: (COLLAPSED)\n\nsrc/modules/users/:\n\nsrc/modules/users/adapters/: (COLLAPSED)\n\nsrc/modules/users/application/: (COLLAPSED)\n\nsrc/modules/users/domain/: (COLLAPSED)\n\nsrc/modules/users/infrastructure/: (COLLAPSED)\n\nstorage/:\n\nstorage/uploads/:\n\nstorage/uploads/payment_proofs/:\n\nstorage/uploads/payment_proofs/admin-user-id/: (COLLAPSED)\n</workspace>", "timestamp": "2026-04-03T05:05:50.531086+00:00", "dynamic_ref": null, "part_kind": "system-prompt"}

t-[9px] font-black uppercase tracking-[0.25em] text-muted-foreground/70 flex-1 group-hover/section:text-primary/80 transition-colors\\">\\n          {title}\\n        </span>\\n\\n        {/* Action HUD */}\\n        {actions ? (\\n            <div className=\\"flex items-center gap-1 shrink-0\\">\\n                {actions}\\n            </div>\\n        ) : (\\n            <MoreHorizontal className=\\"h-3 w-3 text-muted-foreground/20 group-hover/section:text-primary/30 transition-colors\\" />\\n        )}\\n      </button>\\n\\n      {/* Animated Content Slot */}\\n      <AnimatePresence initial={false}>\\n        {isOpen && (\\n          <motion.div\\n            key=\\"section-body\\"\\n            initial={{ height: 0, opacity: 0 }}\\n            animate={{ height: \'auto\', opacity: 1 }}\\n            exit={{ height: 0, opacity: 0 }}\\n            transition={{ duration: 0.4, ease: [0.22, 1, 0.36, 1] }}\\n            className=\\"overflow-hidden\\"\\n          >\\n            <div className=\\"p-4 flex flex-col gap-4 relative\\">\\n              {/* Subtle vertical architectural line */}\\n              <div className=\\"absolute left-3.5 inset-y-0 w-px bg-primary/[0.03]\\" aria-hidden />\\n              \\n              <div className=\\"relative z-10\\">\\n                {children}\\n              </div>\\n            </div>\\n          </motion.div>\\n        )}\\n      </AnimatePresence>\\n    </div>\\n  );\\n}\\n","overwrite":true}', 'logfire.msg': 'running tool: create_file', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span'}

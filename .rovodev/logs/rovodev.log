nsparent hover:bg-muted/10\'\n  98         )}\n  99         onDoubleClick={handleStartEdit}\n 100       >\n 101         {/* Drag handle — Pulse icon on hover */}\n 102         <div\n 103           {...attributes}\n 104           {...listeners}\n 105           className="p-0.5 transition-all duration-300 opacity-0 group-hover/item:opacity-40 cursor-grab active:cursor-grabbing hover:opacity-100"\n 106         >\n 107           <GripVertical className="h-3.5 w-3.5" />\n 108         </div>\n 109 \n 110         {/* Node Identity + Label */}\n 111         <div\n 112           className="flex-1 flex items-center gap-2.5 min-w-0"\n 113           onClick={(e) => {\n 114             e.stopPropagation();\n 115             onActivate();\n 116           }}\n 117         >\n 118           {isChapter && !isEditing && (\n 119             <button\n 120               onClick={(e) => {\n 121                 e.stopPropagation();\n 122                 onToggleExpand?.();\n 123               }}\n 124               className="p-1 hover:bg-primary/10 rounded-lg transition-all active:scale-90"\n 125             >\n 126               {isExpanded ? (\n 127                 <ChevronDown className="h-3.5 w-3.5" />\n 128               ) : (\n 129                 <ChevronRight className="h-3.5 w-3.5 text-primary/40" />\n 130               )}\n 131             </button>\n 132           )}\n 133 \n 134           {/* Status Dot — Architectural state indicator */}\n 135           {!isEditing && (\n 136             <div\n 137               className={cn(\n 138                 \'h-1.5 w-1.5 rounded-full shrink-0 transition-colors duration-500\',\n 139                 hasContent ? \'bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.4)]\' : \'bg-amber-500/40\'\n 140               )}\n 141             />\n 142           )}\n 143 \n 144           {/* Technical Index */}\n 145           {!isEditing && (\n 146             <span\n 147               className={cn(\n 148                 \'text-[9px] font-black tabul
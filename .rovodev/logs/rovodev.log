  28 \\n  29 const initialSelection: SelectionState = {\\n  30   isBold: false,\\n  31   isItalic: false,\\n  32   isStrike: false,\\n  33   isBulletList: false,\\n  34   isOrderedList: false,\\n  35   isBlockquote: false,\\n  36   isCodeBlock: false,\\n  37   activeHeading: null,\\n  38   activeFontSize: null,\\n  39   activeColor: null,\\n  40   textAlign: \'left\',\\n  41 };\\n  42 \\n  43 export const useEditorStore = create<EditorState>((set) => ({\\n  44   activeEditor: null,\\n  45   direction: \'ltr\',\\n  46   selection: initialSelection,\\n  47   \\n  48   setActiveEditor: (editor) => set({ activeEditor: editor }),\\n  49   setDirection: (dir) => set({ direction: dir }),\\n  50   \\n  51   updateSelectionState: (editor) => {\\n  52     if (!editor) return;\\n  53     \\n  54     set({\\n  55       selection: {\\n  56         isBold: editor.isActive(\'bold\'),\\n  57         isItalic: editor.isActive(\'italic\'),\\n  58         isStrike: editor.isActive(\'strike\'),\\n  59         isBulletList: editor.isActive(\'bulletList\'),\\n  60         isOrderedList: editor.isActive(\'orderedList\'),\\n  61         isBlockquote: editor.isActive(\'blockquote\'),\\n  62         isCodeBlock: editor.isActive(\'codeBlock\'),\\n  63         activeHeading: editor.isActive(\'heading\', { level: 1 }) ? 1 : \\n  64                        editor.isActive(\'heading\', { level: 2 }) ? 2 : \\n  65                        editor.isActive(\'heading\', { level: 3 }) ? 3 : null,\\n  66         activeFontSize: editor.getAttributes(\'textStyle\').fontSize || null,\\n  67         activeColor: editor.getAttributes(\'textStyle\').color || null,\\n  68         textAlign: editor.isActive({ textAlign: \'center\' }) ? \'center\' :\\n  69                    editor.isActive({ textAlign: \'right\' }) ? \'right\' :\\n  70                    editor.isActive({ textAlign: \'justify\' }) ? \'justify\' : \'left\',\\n  71       }\\n  72     });\\n  73   },\\n  74 }));\\n  75 \\n````","Successfully opened 
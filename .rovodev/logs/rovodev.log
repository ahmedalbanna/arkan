ate: string, endDate: string): Promise<TransactionProperties[]> {\n    const startDateTime = new Date(startDate);\n    const endDateTime = new Date(endDate);\n\n    const result = await db\n        .select()\n        .from(transactions)\n        .where(\n            and(\n                gte(transactions.createdAt, startDateTime),\n                lte(transactions.createdAt, endDateTime)\n            )\n        )\n        .orderBy(desc(transactions.createdAt));\n\n    return result.map(doc => ({\n        id: doc.id?.toString(),\n        userId: doc.userId?.toString(),\n        type: doc.type,\n        amount: doc.amount?.toString(),\n        credits: doc.credits,\n        description: doc.description,\n        status: doc.status,\n        createdAt: doc.createdAt?.toISOString(),\n    } as TransactionProperties));\n}\n", 'tool_response': "Successfully replaced code in src/services/transactionService.ts:\n\n--- src/services/transactionService.ts\n+++ src/services/transactionService.ts\n@@ -114,11 +114,14 @@\n     return result.map(doc => ({\n         id: doc.id?.toString(),\n         userId: doc.userId?.toString(),\n-        type: doc.type,\n-        amount: doc.amount?.toString(),\n-        credits: doc.credits,\n-        description: doc.description,\n-        status: doc.status,\n-        createdAt: doc.createdAt?.toISOString(),\n+        planId: 'plan_' + doc.id?.toString(),\n+        planName: doc.description || 'Credit Purchase',\n+        credits: doc.credits || 0,\n+        price: doc.amount ? parseFloat(doc.amount.toString()) : 0,\n+        userName: '',\n+        userEmail: '',\n+        status: (doc.status as any) || 'verified',\n+        proofUrl: '',\n+        createdAt: doc.createdAt?.toISOString() || new Date().toISOString(),\n     } as TransactionProperties));\n }\n"}

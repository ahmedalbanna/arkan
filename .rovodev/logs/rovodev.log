2026-01-26 04:21:34.074 | DEBUG    | Model response tool call: {"tool_name": "find_and_replace_code", "args": "{\"file_path\": \"src/services/userService.ts\", \"find\": \"// @ts-nocheck\\n\\n\\n'use server';\\nimport type { UserProfile } from '@/lib/models';\\n\\nexport async function getUserProfile(id: string): Promise<UserProfile | null> {\\n    if (!id) return null;\\n    const userDoc = await adminDb.collection('users').doc(id).get();\\n    if (!userDoc.exists) {\\n        return null;\\n    }\\n    const data = userDoc.data();\\n    return { id: userDoc.id, ...data } as UserProfile;\\n}\\n\\nexport async function getPaginatedUsers({ limit, lastVisibleId }: { limit: number, lastVisibleId?: string }) {\\n    let query = adminDb.collection('users')\\n        .orderBy('createdAt', 'desc')\\n        .limit(limit + 1); // Fetch one extra to check for hasNextPage\\n\\n    if (lastVisibleId) {\\n        const lastDoc = await adminDb.collection('users').doc(lastVisibleId).get();\\n        if (lastDoc.exists) {\\n            query = query.startAfter(lastDoc);\\n        }\\n    }\\n\\n    const snapshot = await query.get();\\n    const users = snapshot.docs.slice(0, limit).map(doc => ({ id: doc.id, ...doc.data() })) as UserProfile[];\\n    const hasNextPage = snapshot.docs.length > limit;\\n    const newLastVisibleId = hasNextPage ? snapshot.docs[snapshot.docs.length - 2].id : null;\\n\\n    return { users, hasNextPage, lastVisibleId: newLastVisibleId };\\n}\\n\\nexport async function createUser(data: Omit<UserProfile, 'id' | 'createdAt' | 'updatedAt'> & { password?: string }): Promise<{ user: { uid: string, email?: string | undefined } }> {\\n    const { email, password, name, role, credits } = data;\\n\\n    const userRecord = await adminAuth.createUser({ email, password, displayName: name });\\n\\n    const newUserProfile: Omit<UserProfile, 'id'> = {\\n        name,\\n        email,\\n        credits: credits,\\n        role: role,\\n        createdAt: new Date().toISOString(),\\n        updatedAt: new Date().toISOString(),\\n        bio: '',\\n        profilePictureUrl: '',\\n        hasCompletedOnboarding: false,\\n        lastDailyCreditUpdate: new Date(0).toISOString(), // Set to epoch to ensure eligibility\\n    };\\n\\n    await adminDb.collection('users').doc(userRecord.uid).set(newUserProfile);\\n\\n    return { user: { uid: userRecord.uid, email: userRecord.email } };\\n}\\n\\nexport async function updateUser(userId: string, data: Partial<UserProfile>): Promise<UserProfile> {\\n    const updatePayload = {\\n        ...data,\\n        updatedAt: new Date().toISOString(),\\n    };\\n    await adminDb.collection('users').doc(userId).update(updatePayload);\\n    const updatedUser = await getUserProfile(userId);\\n    if (!updatedUser) throw new Error(\\\"Failed to refetch updated user profile.\\\");\\n    return updatedUser;\\n}\\n\\nexport async function deleteUser(userId: string) {\\n    await adminAuth.deleteUser(userId);\\n    await adminDb.collection('users').doc(userId).delete();\\n}\\n\\nexport async function resetUserPassword(userId: string, newPassword: string): Promise<void> {\\n    await adminAuth.updateUser(userId, { password: newPassword });\\n}\\n\\nexport async function deductUserCredits(userId: string, creditsToDeduct: number): Promise<number> {\\n    const userRef = adminDb.collection('users').doc(userId);\\n\\n    return await adminDb.runTransaction(async (transaction) => {\\n        const userDoc = await transaction.get(userRef);\\n        if (!userDoc.exists) {\\n            throw new Error(\\\"User not found\\\");\\n        }\\n\\n        const userData = userDoc.data() as UserProfile;\\n        let currentCredits = userData.credits ?? 0;\\n        const lastUpdate = userData.lastDailyCreditUpdate ? new Date(userData.lastDailyCreditUpdate).getTime() : 0;\\n        const twentyFourHours = 24 * 60 * 60 * 1000;\\n\\n        const updates: { [key: string]: any } = {};\\n\\n        // Check if it's time for a daily credit refresh\\n        if (Date.now() - lastUpdate > twentyFourHours) {\\n            if (currentCredits < 10) {\\n                currentCredits = 10;\\n                updates.credits = currentCredits;\\n            }\\n            updates.lastDailyCreditUpdate = new Date().toISOString();\\n        }\\n\\n        if (currentCredits < creditsToDeduct) {\\n            throw { status: 402, message: \\\"Insufficient credits. Please purchase more credits to continue.\\\" };\\n        }\\n\\n        const newBalance = currentCredits - creditsToDeduct;\\n        updates.credits = newBalance;\\n        updates.updatedAt = new Date().toISOString();\\n\\n        transaction.update(userRef, updates);\\n\\n        return newBalance;\\n    });\\n}\\n\\nexport async function addUserCredits(userId: string, creditsToAdd: number): Promise<void> {\\n    const userRef = adminDb.collection('users').doc(userId);\\n    await userRef.update({\\n        credits: FieldValue.increment(creditsToAdd),\\n        updatedAt: new Date().toISOString(),\\n    });\\n}\", \"replace\": \"// @ts-nocheck\\n\\n'use server';\\nimport type { UserProfile } from '@/lib/models';\\nimport { db } from '@/db';\\nimport { users } from '@/db/schema';\\nimport { eq, desc, gt } from 'drizzle-orm';\\nimport bcrypt from 'bcryptjs';\\n\\nexport async function getUserProfile(id: string | number): Promise<UserProfile | null> {\\n    if (!id) return null;\\n    \\n    const userId = typeof id === 'string' ? parseInt(id) : id;\\n    \\n    const result = await db\\n        .select()\\n        .from(users)\\n        .where(eq(users.id, userId));\\n\\n    if (result.length === 0) return null;\\n\\n    const user = result[0];\\n    return {\\n        id: user.id.toString(),\\n        name: user.name || '',\\n        email: user.email,\\n        role: user.role as any,\\n        credits: user.credits || 10,\\n        language: user.language || 'en',\\n        photoURL: user.photoURL || '',\\n        createdAt: user.createdAt?.toISOString() || new Date().toISOString(),\\n        updatedAt: user.updatedAt?.toISOString() || new Date().toISOString(),\\n        hasCompletedOnboarding: false,\\n        bio: '',\\n        profilePictureUrl: user.photoURL || '',\\n        lastDailyCreditUpdate: new Date(0).toISOString(),\\n        apiKeys: {},\\n    } as UserProfile;\\n}\\n\\nexport async function getPaginatedUsers({ limit, lastVisibleId }: { limit: number, lastVisibleId?: string }) {\\n    const lastId = lastVisibleId ? parseInt(lastVisibleId) : 0;\\n\\n    const result = await db\\n        .select()\\n        .from(users)\\n        .where(gt(users.id, lastId))\\n        .orderBy(desc(users.createdAt))\\n        .limit(limit + 1);\\n\\n    const userList = result.slice(0, limit).map(user => ({\\n        id: user.id.toString(),\\n        name: user.name || '',\\n        email: user.email,\\n        role: user.role,\\n        credits: user.credits || 10,\\n        language: user.language || 'en',\\n        photoURL: user.photoURL || '',\\n        createdAt: user.createdAt?.toISOString() || new Date().toISOString(),\\n        updatedAt: user.updatedAt?.toISOString() || new Date().toISOString(),\\n    } as any));\\n\\n    const hasNextPage = result.length > limit;\\n    const newLastVisibleId = hasNextPage ? result[limit - 1].id.toString() : null;\\n\\n    return { users: userList, hasNextPage, lastVisibleId: newLastVisibleId };\\n}\\n\\nexport async function createUser(data: Omit<UserProfile, 'id' | 'createdAt' | 'updatedAt'> & { password?: string }): Promise<{ user: { id?: number, uid?: string, email?: string } }> {\\n    const { email, password, name, role, credits } = data;\\n\\n    if (!email || !password) {\\n        throw new Error(\\\"Email and password are required\\\");\\n    }\\n\\n    // Hash password\\n    const hashedPassword = await bcrypt.hash(password, 10);\\n\\n    // Create user in PostgreSQL\\n    const result = await db\\n        .insert(users)\\n        .values({\\n            email,\\n            password: hashedPassword,\\n            name,\\n            role: role as 'user' | 'admin',\\n            credits: credits || 10,\\n            language: 'en',\\n        })\\n        .returning();\\n\\n    if (result.length === 0) {\\n        throw new Error(\\\"Failed to create user\\\");\\n    }\\n\\n    const newUser = result[0];\\n    return { user: { id: newUser.id, email: newUser.email } };\\n}\\n\\nexport async function updateUser(userId: string | number, data: Partial<UserProfile>): Promise<UserProfile> {\\n    const id = typeof userId === 'string' ? parseInt(userId) : userId;\\n\\n    const updateData: any = {\\n        ...data,\\n        updatedAt: new Date(),\\n    };\\n\\n    // Remove fields that shouldn't be updated directly\\n    delete updateData.id;\\n    delete updateData.createdAt;\\n\\n    await db\\n        .update(users)\\n        .set(updateData)\\n        .where(eq(users.id, id));\\n\\n    const updatedUser = await getUserProfile(id);\\n    if (!updatedUser) throw new Error(\\\"Failed to refetch updated user profile.\\\");\\n    return updatedUser;\\n}\\n\\nexport async function deleteUser(userId: string | number) {\\n    const id = typeof userId === 'string' ? parseInt(userId) : userId;\\n    \\n    await db\\n        .delete(users)\\n        .where(eq(users.id, id));\\n}\\n\\nexport async function resetUserPassword(userId: string | number, newPassword: string): Promise<void> {\\n    const id = typeof userId === 'string' ? parseInt(userId) : userId;\\n    \\n    const hashedPassword = await bcrypt.hash(newPassword, 10);\\n\\n    await db\\n        .update(users)\\n        .set({ password: hashedPassword })\\n        .where(eq(users.id, id));\\n}\\n\\nexport async function deductUserCredits(userId: string | number, creditsToDeduct: number): Promise<number> {\\n    const id = typeof userId === 'string' ? parseInt(userId) : userId;\\n\\n    const result = await db\\n        .select()\\n        .from(users)\\n        .where(eq(users.id, id));\\n\\n    if (result.length === 0) {\\n        throw new Error(\\\"User not found\\\");\\n    }\\n\\n    const user = result[0];\\n    let currentCredits = user.credits ?? 0;\\n    const lastUpdate = user.createdAt ? new Date(user.createdAt).getTime() : 0;\\n    const twentyFourHours = 24 * 60 * 60 * 1000;\\n\\n    // Check if it's time for a daily credit refresh\\n    if (Date.now() - lastUpdate > twentyFourHours) {\\n        if (currentCredits < 10) {\\n            currentCredits = 10;\\n        }\\n    }\\n\\n    if (currentCredits < creditsToDeduct) {\\n        throw { status: 402, message: \\\"Insufficient credits. Please purchase more credits to continue.\\\" };\\n    }\\n\\n    const newBalance = currentCredits - creditsToDeduct;\\n\\n    await db\\n        .update(users)\\n        .set({ \\n            credits: newBalance,\\n            updatedAt: new Date()\\n        })\\n        .where(eq(users.id, id));\\n\\n    return newBalance;\\n}\\n\\nexport async function addUserCredits(userId: string | number, creditsToAdd: number): Promise<void> {\\n    const id = typeof userId === 'string' ? parseInt(userId) : userId;\\n\\n    const result = await db\\n        .select()\\n        .from(users)\\n        .where(eq(users.id, id));\\n\\n    if (result.length === 0) {\\n        throw new Error(\\\"User not found\\\");\\n    }\\n\\n    const user = result[0];\\n    const newCredits = (user.credits || 0) + creditsToAdd;\\n\\n    await db\\n        .update(users)\\n        .set({ \\n            credits: newCredits,\\n            updatedAt: new Date()\\n        })\\n        .where(eq(users.id, id));\\n}\"}", "tool_call_id": "toolu_bdrk_01TLZeWEcJTghzdHKMDuA4pD", "id": null, "provider_details": null, "part_kind": "tool-call"}

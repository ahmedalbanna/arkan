r.id) {\n 314       onMoveItem(active.id.toString(), over.id.toString());\n 315     }\n 316   };\n 317 \n 318   if (!project) return null;\n 319 \n 320   const filteredChapters = useMemo(() => {\n 321     if (!searchQuery.trim()) return project.chapters as readonly Chapter[];\n 322 \n 323     const query = searchQuery.toLowerCase();\n 324     return (project.chapters as readonly Chapter[]).filter(chapter => {\n 325         const chapterMatches = chapter.title.toLowerCase().includes(query);\n 326         const sectionsMatch = chapter.sections.some(s => s.title.toLowerCase().includes(query));\n 327         return chapterMatches || sectionsMatch;\n 328     });\n 329   }, [project.chapters, searchQuery]);\n 330 \n 331   const allSortableIds = useMemo(() => {\n 332     const ids: string[] = [];\n 333     filteredChapters.forEach(c => {\n 334       ids.push(c.id);\n 335       if (expandedChapters.has(c.id) || searchQuery.trim()) {\n 336         c.sections.forEach(s => {\n 337             if (!searchQuery.trim() || s.title.toLowerCase().includes(searchQuery.toLowerCase()) || c.title.toLowerCase().includes(searchQuery.toLowerCase())) {\n 338                 ids.push(s.id);\n 339             }\n 340         });\n 341       }\n 342     });\n 343     return ids;\n 344   }, [filteredChapters, expandedChapters, searchQuery]);\n 345 \n 346   return (\n 347     <AnimatePresence>\n 348       {isVisible && (\n 349         <motion.div\n 350           initial={{ opacity: 0, x: -20, scale: 0.95 }}\n 351           animate={{ opacity: 1, x: 0, scale: 1 }}\n 352           exit={{ opacity: 0, x: -20, scale: 0.95 }}\n 353           className=\"absolute top-4 left-4 z-50 w-72 max-h-[calc(100%-2rem)] overflow-hidden flex flex-col bg-background/60 backdrop-blur-2xl border border-primary/10 rounded-2xl shadow-[0_8px_40px_rgba(0,0,0,0.1)] transition-all duration-500\"\n 354         >\n 355           {/* Header */}\n 356           <div className=\"px-4 py-3 border-b border-primary/10 space-y-3 bg
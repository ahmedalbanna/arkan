     private readonly timeoutMs: number = 120_000; // 2 minutes\n  29 \n  30     constructor() {\n  31         this.webhookUrl = process.env.N8N_AI_WEBHOOK_URL || \'\';\n  32         if (!this.webhookUrl) {\n  33             console.error(\'[N8nAiService] N8N_AI_WEBHOOK_URL is missing. Orchestration is disabled.\');\n  34         } else if (!this.webhookUrl.startsWith(\'http\')) {\n  35             console.error(\'[N8nAiService] N8N_AI_WEBHOOK_URL is invalid. Must be a full URL.\');\n  36         }\n  37     }\n  38 \n  39     // ──────────────────────────────────────────────\n  40     // Core HTTP bridge to n8n\n  41     // ──────────────────────────────────────────────\n  42 \n  43     private async callN8n<T>(payload: Record<string, unknown>): Promise<Result<T, AiError>> {\n  44         const startTime = performance.now();\n  45         const action = String(payload.action || \'unknown\');\n  46         \n  47         try {\n  48             const controller = new AbortController();\n  49             const timeout = setTimeout(() => controller.abort(), this.timeoutMs);\n  50 \n  51             const response = await fetch(this.webhookUrl, {\n  52                 method: \'POST\',\n  53                 headers: { \'Content-Type\': \'application/json\' },\n  54                 body: JSON.stringify(payload),\n  55                 signal: controller.signal,\n  56             });\n  57 \n  58             clearTimeout(timeout);\n  59 \n  60             const duration = (performance.now() - startTime).toFixed(2);\n  61 \n  62             if (!response.ok) {\n  63                 const text = await response.text();\n  64                 console.error(`[N8nAiService] ${action} failed (${duration}ms): ${response.status}`);\n  65                 return Result.fail(AiError.generationFailed(`n8n responded with ${response.status}: ${text}`));\n  66             }\n  67 \n  68             const data = await response.json() as Record<string, unknown>;\n  69 \n  70             if (data.success === false) {\n  71                 console.error(`[N8nAiService] ${action} business error (${duration}ms): ${data.error}`);\n  72                 return Result.fail(AiError.generationFailed(String(data.error || \'n8n returned an unsuccessful response\')));\n  73             }\n  74 \n  75             console.log(`[N8nAiService] ${action} success (${duration}ms)`);\n  76             return Result.ok(data as T);\n  77         } catch (error: unknown) {\n  78             const duration = (performance.now() - startTime).toFixed(2);\n  79             const message = error instanceof Error ? error.message : String(error);\n  80             \n  81             console.error(`[N8nAiService] ${action} system error (${duration}ms): ${message}`);\n  82 \n  83             if (message.includes(\'abort\') || message.includes(\'timeout\')) {\n  84                 return Result.fail(AiError.generationFailed(\'n8n request timed out after 2 minutes\'));\n  85             }\n  86             return Result.fail(AiError.generationFailed(message));\n  87         }\n  88     }\n  89 \n  90     // ──────────────────────────────────────────────\n  91     // IAiService implementation\n  92     // ──────────────────────────────────────────────\n  93 \n  94     /**\n  95      * Sends a text generation request to the n8n Arkan AI Agent.\n  96      */\n  97     async generateText(prompt: string, options?: unknown): Promise<Result<string, AiError>> {\n  98         const result = await this.callN8n<{ text: string }>({\n  99             action: \'generateText\',\n 100             prompt,\n 101             options,\n 102         });\n 103 \n 104         if (!result.isSuccess) return Result.fail(result.error!);\n 105         const text = result.getValue()?.text;\n 106         if (typeof text !== \'string\') {\n 107             return Result.fail(AiError.generationFailed(\'n8n response missing "text" field\'));\n 108         }\n 109         return Result.ok(this.cleanAiOutput(text));\n 110     }\n 111 \n 112     /**\n 113      * Maps specific flowNames to n8n specialized agents.\n 114      * When a flow is listed here, it will be executed via n8n instead of locally.\n 115      * This allows gradual migration of specific flows to n8n agents.\n 116      */\n 117     private readonly N8N_FLOW_MAP: Record<string, string> = {\n 118         // Writing Tools\n 119         \'summarize\': \'summarize\',\n 120         \'summarizer\': \'summarize\',\n 121         \'grammar-checker\': \'grammarCheck\',\n 122         \'paraphrase\': \'paraphrase\',\n 123         \'paraphraser\': \'paraphrase\',\n 124         \'humanize\': \'humanize\',\n 125         \'translator\': \'translate\',\n 126         \'translate-text\': \'translate\',\n 127         \'write-document\': \'writeDocument\',\n 128         \'manipulate-text\': \'manipulateText\',\n 129         \'text-stylist\': \'textStyleTune\',\n 130         \n 131         // Analysis Tools\n 132         \'ai-detector\': \'detectAi\',\n 133         \'bias-checker\': \'biasCheck\',\n 134         \'fact-checker\': \'factCheck\',\n 135         \'plagiarism-checker\': \'plagiarismCheck\',\n 136         \'sentence-structure-checker\': \'sentenceStructureCheck\',\n 137         \n 138         // Academic Tools\n 139         \'ai-researcher\': \'aiResearch\',\n 140         \'lecture-generator\': \'generateLecture\',\n 141         \'generate-citation\': \'generateCitation\',\n 142         \'literature-review-generator\': \'generateLitReview\',\n 143         \'generate-quiz\': \'quiz\',\n 144         \'solve-assignments\': \'solveAssignments\',\n 145         \'theoretical-lecture\': \'generateTheoreticalLecture\',\n 146         \n 147         // Generation Tools\n 148         \'generate-ideas\': \'generateIdeas\',\n 149         \'generate-toc\': \'generateTOC\',\n 150         \'generate-ui-description\': \'generateUIDescription\',\n 151         \'generate-session-plan\': \'generateSessionPlan\',\n 152         \'generate-project-blue
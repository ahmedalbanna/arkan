2026-04-04 09:00:39.255 | 655960 (655960) | DEBUG    | Processing tool event with attributes: {'gen_ai.tool.name': 'expand_code_chunks', 'gen_ai.tool.call.id': 'call_bRDTgo2JuplP9Dfi7x1BNDmt', 'tool_arguments': '{"file_path":"src/modules/ai-content/adapters/components/builder/outline/SidebarOutlineManager.tsx","line_ranges":[[0,260]]}', 'logfire.msg': 'running tool: expand_code_chunks', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span', 'tool_response': 'Successfully expanded code chunks in src/modules/ai-content/adapters/components/builder/outline/SidebarOutlineManager.tsx:\n\n````tsx\n   0 \'use client\';\n   1 \n   2 import React, { useMemo, useState, useEffect } from \'react\';\n   3 import { \n   4   DndContext, \n   5   closestCenter, \n   6   KeyboardSensor, \n   7   PointerSensor, \n   8   useSensor, \n   9   useSensors,\n  10   DragEndEvent,\n  11 } from \'@dnd-kit/core\';\n  12 import { \n  13   SortableContext, \n  14   sortableKeyboardCoordinates, \n  15   verticalListSortingStrategy\n  16 } from \'@dnd-kit/sortable\';\n  17 import { Search, X, Plus } from \'lucide-react\';\n  18 import { Input } from \'@/components/ui/input\';\n  19 import { Button } from \'@/components/ui/button\';\n  20 import { ScrollArea } from \'@/components/ui/scroll-area\';\n  21 import { useBuilderStore } from \'@/hooks\';\n  22 import { Chapter } from \'@/modules/ai-content/domain/entities/Chapter\';\n  23 import { Section } from \'@/modules/ai-content/domain/entities/Section\';\n  24 import { SortableOutlineItem } from \'./SortableOutlineItem\';\n  25 import { useOutlineOperations } from \'./useOutlineOperations\';\n  26 \n  27 /**\n  28  * SidebarOutlineManager — A docked structural navigator for the side panel.\n  29  * Refactored to use shared outline primitives and consolidated project logic.\n  30  */\n  31 \n  32 interface SidebarOutlineManagerProps {\n  33   activeChapterId: string | null;\n  34   selectedSectionIds: string[];\n  35   onActiveChapterChange: (id: string | null) => void;\n  36   onActiveSectionChange: (id: string | null, multiSelect?: boolean) => void;\n  37 }\n  38 \n  39 export function SidebarOutlineManager({\n  40   activeChapterId,\n  41   selectedSectionIds,\n  42   onActiveChapterChange,\n  43   onActiveSectionChange,\n  44 }: SidebarOutlineManagerProps) {\n  45   const { project, syncProjectStructure } = useBuilderStore(state => ({\n  46     project: state.project,\n  47     syncProjectStructure: state.syncProjectStructure,\n  48   }));\n  49 \n  50   const {\n  51     handleMoveItem,\n  52     handleUpdateTitle,\n  53     handleDeleteItem,\n  54     handleAddChapter,\n  55     handleAddSection,\n  56     handleDuplicateItem,\n  57     handleCopyItem,\n  58     handlePasteItem,\n  59     undo\n  60   } = useOutlineOperations(project);\n  61 \n  62   // Sync structural cache on mount\n  63   useEffect(() => {\n  64     syncProjectStructure();\n  65   }, [syncProjectStructure]);\n  66 \n  67   const [expandedChapters, setExpandedChapters] = useState<Set<string>>(new Set());\n  68   const [searchQuery, setSearchQuery] = useState(\'\');\n  69 \n  70   const sensors = useSensors(\n  71     useSensor(PointerSensor, { activationConstraint: { distance: 8 } }),\n  72     useSensor(KeyboardSensor, { coordinateGetter: sortableKeyboardCoordinates })\n  73   );\n  74 \n  75   // Integrated Keyboard Logic for Sidebar\n  76   useEffect(() => {\n  77     const handleKeyDown = (e: KeyboardEvent) => {\n  78       const isMod = e.metaKey || e.ctrlKey;\n  79       const activeId = activeChapterId || (selectedSectionIds.length > 0 ? selectedSectionIds[0] : null);\n  80       const isChapter = !!activeChapterId;\n  81 \n  82       if (isMod && e.key === \'z\') {\n  83         e.preventDefault();\n  84         undo();\n  85       }\n  86 \n  87       if (!activeId) return;\n  88 \n  89       if (isMod && e.key === \'d\') {\n  90         e.preventDefault();\n  91         handleDuplicateItem(activeId, isChapter);\n  92       }\n  93       if (isMod && e.key === \'c\') {\n  94         e.preventDefault();\n  95         handleCopyItem(activeId, isChapter);\n  96       }\n  97       if (isMod && e.key === \'v\') {\n  98         e.preventDefault();\n  99         handlePasteItem(activeId, isChapter);\n 100       }\n 101     };\n 102 \n 103     window.addEventListener(\'keydown\', handleKeyDown);\n 104     return () => window.removeEventListener(\'keydown\', handleKeyDown);\n 105   }, [activeChapterId, selectedSectionIds, undo, handleDuplicateItem, handleCopyItem, handlePasteItem]);\n 106 \n 107   const toggleChapter = (id: string) => {\n 108     setExpandedChapters(prev => {\n 109       const next = new Set(prev);\n 110       if (next.has(id)) next.delete(id);\n 111       else next.add(id);\n 112       return next;\n 113     });\n 114   };\n 115 \n 116   const handleItemClick = (id: string, isChapter: boolean) => {\n 117     if (isChapter) {\n 118       onActiveChapterChange(id);\n 119     } else {\n 120       onActiveSectionChange(id);\n 121     }\n 122     setTimeout(() => {\n 123       const element = document.getElementById(`item-${id}`);\n 124       if (element) element.scrollIntoView({ behavior: \'smooth\', block: \'start\' });\n 125     }, 100);\n 126   };\n 127 \n 128   const handleDragEnd = (event: DragEndEvent) => {\n 129     const { active, over } = event;\n 130     if (over && active.id !== over.id) {\n 131       handleMoveItem(active.id.toString(), over.id.toString());\n 132     }\n 133   };\n 134 \n 135   if (!project) return null;\n 136 \n 137   // Optimized Search for High-Density Sidebar\n 138   const filteredChapters = useMemo(() => {\n 139     if (!searchQuery.trim()) return project.chapters as readonly Chapter[];\n 140     const query = searchQuery.toLowerCase();\n 141     return (project.chapters as readonly Chapter[]).filter(chapter => {\n 142       return (\n 143         chapter.title.toLowerCase().includes(query) ||\n 144         chapter.sections.some(s => s.title.toLowerCase().includes(query))\n 145       );\n 146     });\n 147   }, [project.chapters, searchQuery]);\n 148 \n 149   const allSortableIds = useMemo(() => {\n 150     const ids: string[] = [];\n 151     filteredChapters.forEach(c => {\n 152       ids.push(c.id);\n 153       if (expandedChapters.has(c.id) || searchQuery.trim()) {\n 154         c.sections.forEach(s => {\n 155           if (\n 156             !searchQuery.trim() ||\n 157             s.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n 158             c.title.toLowerCase().includes(searchQuery.toLowerCase())\n 159           ) {\n 160             ids.push(s.id);\n 161           }\n 162         });\n 163       }\n 164     });\n 165     return ids;\n 166   }, [filteredChapters, expandedChapters, searchQuery]);\n 167 \n 168   return (\n 169     <div className="flex flex-col h-full gap-4">\n 170       {/* Sidebar HUD Header */}\n 171       <div className="space-y-3">\n 172         <div className="flex items-center justify-between">\n 173           <div className="flex items-center gap-2">\n 174             <div className="h-1 w-1 rounded-full bg-primary/40 shadow-[0_0_8px_rgba(var(--primary),0.4)]" />\n 175             <h3 className="text-[10px] font-black uppercase tracking-[0.2em] text-primary/80">\n 176               Nav Structure\n 177             </h3>\n 178           </div>\n 179           <div className="flex items-center gap-3">\n 180             <span className="text-[8px] font-bold text-muted-foreground/30 uppercase tracking-widest tabular-nums">\n 181               {project.sections.length} Units\n 182             </span>\n 183             <Button\n 184               variant="ghost"\n 185               size="icon"\n 186               className="h-6 w-6 rounded-lg bg-primary/5 text-primary/60 border border-primary/10 hover:bg-primary/10 transition-all hover:scale-105"\n 187               onClick={(e) => {\n 188                 e.stopPropagation();\n 189                 handleAddChapter();\n 190               }}\n 191             >\n 192               <Plus className="h-3.5 w-3.5" />\n 193             </Button>\n 194           </div>\n 195         </div>\n 196 \n 197         {/* Dense Search HUD */}\n 198         <div className="relative group/search">\n 199           <Input\n 200             value={searchQuery}\n 201             onChange={(e) => setSearchQuery(e.target.value)}\n 202             placeholder="SCAN OUTLINE..."\n 203             className="h-8 pl-8 pr-8 text-[9px] bg-muted/5 border-primary/5 focus-visible:ring-primary/10 focus-visible:border-primary/20 rounded-xl transition-all font-bold uppercase tracking-widest"\n 204           />\n 205           <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 h-3 w-3 text-muted-foreground/30 group-focus-within/search:text-primary transition-colors" />\n 206           {searchQuery && (\n 207             <button\n 208               onClick={() => setSearchQuery(\'\')}\n 209               className="absolute right-2.5 top-1/2 -translate-y-1/2 hover:text-primary transition-colors text-muted-foreground/40"\n 210             >\n 211               <X className="h-3 w-3" />\n 212             </button>\n 213           )}\n 214         </div>\n 215       </div>\n 216 \n 217       {/* Main Navigator List — Independent ScrollArea */}\n 218       <ScrollArea className="flex-1 min-h-0 -mx-1 px-1">\n 219         <DndContext\n 220           sensors={sensors}\n 221           collisionDetection={closestCenter}\n 222           onDragEnd={handleDragEnd}\n 223         >\n 224           <SortableContext items={allSortableIds} strategy={verticalListSortingStrategy}>\n 225             {filteredChapters.map((chapter, cIdx) => (\n 226               <SortableOutlineItem\n 227                 key={chapter.id}\n 228                 id={chapter.id}\n 229                 index={cIdx}\n 230                 title={chapter.title}\n 231                 isActive={activeChapterId === chapter.id}\n 232                 isChapter={true}\n 233                 isExpanded={expandedChapters.has(chapter.id) || !!searchQuery.trim()}\n 234                 hasContent={chapter.sections.some((s: Section) => !!s.content)}\n 235                 onActivate={() => handleItemClick(chapter.id, true)}\n 236                 onToggleExpand={() => toggleChapter(chapter.id)}\n 237                 onUpdateTitle={(newTitle) => handleUpdateTitle(chapter.id, newTitle, true)}\n 238                 onDelete={() => handleDeleteItem(chapter.id, true)}\n 239               >\n 240                 {(chapter.sections as Section[])\n 241                   .filter(\n 242                     s =>\n 243                       !searchQuery.trim() ||\n 244                       s.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n 245                       chapter.title.toLowerCase().includes(searchQuery.toLowerCase())\n 246                   )\n 247                   .map((section, sIdx) => (\n 248                     <SortableOutlineItem\n 249                       key={section.id}\n 250                       id={section.id}\n 251                       index={sIdx}\n 252                       title={section.title}\n 253                       isActive={selectedSectionIds.includes(section.id)}\n 254                       hasContent={!!section.content}\n 255                       onActivate={() => handleItemClick(section.id, false)}\n 256                       onUpdateTitle={(newTitle) => handleUpdateTitle(section.id, newTitle, false)}\n 257                       onDelete={() => handleDeleteItem(section.id, false)}\n 258                     />\n 259                   ))}\n 260                 {!searchQuery && (\n 261                   <div\n 262                     className="ml-4 mt-1 mb-2 px-2 py-1.5 flex items-center gap-2 rounded-xl border border-dashed border-primary/10 bg-primary/[0.01] hover:bg-primary/[0.03] transition-all cursor-pointer group/add active:scale-[0.98]"\n 263                     onClick={(e) => {\n 264                       e.stopPropagation();\n 265                       handleAddSection(chapter.id);\n 266                     }}\n 267                   >\n 268                     <Plus className="h-3 w-3 text-primary/30 group-hover/add:text-primary transition-colors" />\n 269                     <span className="text-[9px] font-black uppercase tracking-[0.2em] text-primary/30 group-hover/add:text-primary transition-colors">\n 270                       Integrate Node\n 271                     </span>\n 272                   </div>\n 273                 )}\n 274               </SortableOutlineItem>\n 275             ))}\n 276           </SortableContext>\n 277         </DndContext>\n 278       </ScrollArea>\n 279     </div>\n 280   );\n 281 }\n 282 \n````'}

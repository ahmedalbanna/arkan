,\n            type: \'generate\',\n          },\n          {\n            name: \'llama3.1:latest\',\n            type: \'generate\',\n          },\n        ],\n        serverAddress: process.env.OLLAMA_BASE_URL || "http://localhost:11434",\n      }),\n    ],\n  });\n\n  if (process.env.NODE_ENV !== \'production\') {\n    globalForAi.ai = aiInstance;\n  }\n}\n\nexport const ai = aiInstance;\n\n// Re-export constants from domain\nexport * from "../../domain/constants/AiModels";\n', 'tool_response': "Successfully replaced code in src/modules/ai/infrastructure/services/Genkit.ts:\n\n--- src/modules/ai/infrastructure/services/Genkit.ts\n+++ src/modules/ai/infrastructure/services/Genkit.ts\n@@ -24,11 +24,11 @@\n             type: 'generate',\n           },\n           {\n-            name: 'phi3:mini-4k',\n+            name: 'phi4-mini:latest',\n             type: 'generate',\n           },\n           {\n-            name: 'llama3.1:latest',\n+            name: 'llama2:7b',\n             type: 'generate',\n           },\n         ],\n"}

                   } catch (e) {\n 132                         console.error(\'[UploadManager] Update Persistence Failure:\', e);\n 133                         toast({ title: "Sync Error", description: "Failed to incorporate source vector into project manifest.", variant: \'destructive\' });\n 134                     }\n 135                 };\n 136 \n 137                 if (file.type.startsWith(\'text/\') || file.name.endsWith(\'.md\')) {\n 138                     reader.readAsText(file);\n 139                 } else {\n 140                     reader.readAsDataURL(file);\n 141                 }\n 142             });\n 143         } catch (error) {\n 144             console.error(\'[UploadManager] Ingestion pipeline failure:\', error);\n 145             toast({ title: "Pipeline Crash", description: "The ingestion core encountered an unrecoverable error.", variant: \'destructive\' });\n 146         } finally {\n 147             setIsLoading(false);\n 148         }\n 149     }, [updateProject, project, toast, t]);\n 150 \n 151     const { getRootProps, getInputProps, isDragActive } = useDropzone({\n 152         onDrop,\n 153         multiple: true,\n 154         accept: {\n 155             \'application/pdf\': [\'.pdf\'],\n 156             \'application/msword\': [\'.doc\'],\n 157             \'application/vnd.openxmlformats-officedocument.wordprocessingml.document\': [\'.docx\'],\n 158             \'text/plain\': [\'.txt\'],\n 159             \'text/markdown\': [\'.md\'],\n 160             \'image/jpeg\': [\'.jpeg\', \'.jpg\'],\n 161             \'image/png\': [\'.png\'],\n 162             \'image/webp\': [\'.webp\'],\n 163         }\n 164     });\n 165 \n 166     const handleAddPastedText = useCallback(() => {\n 167         if (!textInput.trim() || !textFileName.trim() || !updateProject) return;\n 168 \n 169         try {\n 170             updateProject(p => p.addExternalContext({\n 171                 fileName: `${textFileName.trim()}.md`,\n 172                 c
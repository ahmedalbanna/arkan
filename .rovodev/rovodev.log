- Scroll snap alignment\\n\\n**Usage Example:**\\n```tsx\\nimport { useScrollToTop, ScrollToTopButton } from \'@/components/ui/scroll-utilities\';\\n\\nconst MyComponent = () => {\\n  const scrollRef = useRef<HTMLDivElement>(null);\\n  const { scrollToTop } = useScrollToTop(scrollRef);\\n  \\n  return (\\n    <>\\n      <ScrollArea>\\n        <div ref={scrollRef} className=\\"scroll-smooth\\">\\n          {/* Content */}\\n        </div>\\n      </ScrollArea>\\n      <ScrollToTopButton containerRef={scrollRef} />\\n    </>\\n  );\\n};\\n```"}', 'logfire.msg': 'running tool: find_and_replace_code', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span'}

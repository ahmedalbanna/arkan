2026-01-23 23:26:47.493 | DEBUG    | Processing tool event with attributes: {'gen_ai.tool.name': 'delete_file', 'gen_ai.tool.call.id': 'toolu_bdrk_01ERGLYgWZjq4N3C5nEpbn7K', 'tool_arguments': '{"file_path": "tmp_rovodev_test_converter.ts"}', 'logfire.msg': 'running tool: delete_file', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span', 'original_content': '/**\n * Temporary test file for the new markdown-to-docx converter\n */\n\nimport { convertMarkdownToDocxExternal, markdownToDocx, projectToDocx } from \'./src/lib/markdown-to-docx-external\';\n\n// Test data\nconst testMarkdown = `# Test Document\n\nThis is a **bold** text and this is *italic* text.\n\n## Section 1\n\nHere\'s a simple list:\n\n- Item 1\n- Item 2\n- Item 3\n\n## Section 2\n\n### Subsection 2.1\n\n1. First ordered item\n2. Second ordered item\n3. Third ordered item\n\n### Subsection 2.2\n\n> This is a blockquote\n> It can span multiple lines\n\n## Code Example\n\n\\`\\`\\`typescript\nconst hello = () => {\n  console.log("Hello, World!");\n};\n\\`\\`\\`\n\n## Table Example\n\n| Header 1 | Header 2 |\n|----------|----------|\n| Cell 1   | Cell 2   |\n| Cell 3   | Cell 4   |\n\n---\n\n## Links and Images\n\n[Visit OpenAI](https://openai.com)\n\nEOF\n`;\n\nconst testProject = {\n  name: \'Test Project\',\n  projectDescription: \'This is a test project for the markdown-to-docx converter\',\n  projectType: \'Academic Research\',\n  specialization: \'Computer Science\',\n  teamMembers: [\'Student 1\', \'Student 2\'],\n  supervisor: \'Dr. Test Professor\',\n  university: \'Test University\',\n  course: \'Advanced Topics in Computer Science\',\n  educationalLevel: \'Master Degree\',\n  content: [\n    {\n      title: \'Chapter 1\',\n      sections: [\n        {\n          title: \'Introduction\',\n          content: \'This is the introduction section with some **formatted** text.\'\n        },\n        {\n          title: \'Background\',\n          content: \'Here is the background information.\'\n        }\n      ]\n    },\n    {\n      title: \'Chapter 2\',\n      sections: [\n        {\n          title: \'Methodology\',\n          content: \'This chapter describes the methodology.\'\n        }\n      ]\n    }\n  ]\n};\n\nasync function runTests() {\n  console.log(\'🧪 Testing new markdown-to-docx converter...\\n\');\n\n  try {\n    // Test 1: Simple markdown\n    console.log(\'Test 1: Converting simple markdown...\');\n    const result1 = await markdownToDocx(testMarkdown);\n    console.log(`✅ Simple markdown conversion successful. Size: ${result1 instanceof Buffer ? result1.length : (result1 as Blob).size} bytes\\n`);\n  } catch (error) {\n    console.error(\'❌ Test 1 failed:\', error);\n  }\n\n  try {\n    // Test 2: Project object\n    console.log(\'Test 2: Converting project object to DOCX...\');\n    const result2 = await projectToDocx(testProject);\n    console.log(`✅ Project conversion successful. Size: ${result2 instanceof Buffer ? result2.length : (result2 as Blob).size} bytes\\n`);\n  } catch (error) {\n    console.error(\'❌ Test 2 failed:\', error);\n  }\n\n  try {\n    // Test 3: Direct conversion with options\n    console.log(\'Test 3: Converting with custom options...\');\n    const result3 = await convertMarkdownToDocxExternal(testMarkdown);\n    console.log(`✅ Direct conversion successful. Size: ${result3 instanceof Buffer ? result3.length : (result3 as Blob).size} bytes\\n`);\n  } catch (error) {\n    console.error(\'❌ Test 3 failed:\', error);\n  }\n\n  console.log(\'🎉 All tests completed!\');\n}\n\n// Run tests if executed directly\nif (require.main === module) {\n  runTests().catch(error => {\n    console.error(\'Fatal error:\', error);\n    process.exit(1);\n  });\n}\n\nexport { runTests };\n', 'tool_response': 'Successfully deleted tmp_rovodev_test_converter.ts.'}

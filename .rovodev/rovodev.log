ntent: string): Section {\\n 147     let updatedMetadata = createEditedMetadata(this.metadata as SectionMetadata);\\n 148     updatedMetadata = updateContentStatistics(updatedMetadata, content);\\n 149     \\n 150     // Save version history\\n 151     if (this.content && this.content !== content) {\\n 152       updatedMetadata = addVersionToHistory(updatedMetadata, this.content);\\n 153     }\\n 154     \\n 155     return this.with({ \\n 156       content,\\n 157       metadata: updatedMetadata \\n 158     });\\n 159   }\\n 160 \\n 161   /**\\n 162    * Update content and refresh statistics\\n 163    */\\n 164   public updateContent(content: string, editedByUser: boolean = false): Section {\\n 165     if (editedByUser) {\\n 166       return this.markAsEdited(content);\\n 167     }\\n 168     \\n 169     // Just update content and statistics without changing status\\n 170     let updatedMetadata = { ...(this.metadata as SectionMetadata) };\\n 171     updatedMetadata = updateContentStatistics(updatedMetadata, content);\\n 172     updatedMetadata.lastModifiedAt = new Date().toISOString();\\n 173     \\n 174     return this.with({ \\n 175       content,\\n 176       metadata: updatedMetadata \\n 177     });\\n 178   }\\n 179 \\n 180   /**\\n 181    * Get current generation status\\n 182    */\\n 183   public getStatus(): SectionStatus {\\n 184     return (this.metadata as SectionMetadata)?.status || SectionStatus.DRAFT;\\n 185   }\\n 186 \\n 187   /**\\n 188    * Check if section has been generated\\n 189    */\\n 190   public isGenerated(): boolean {\\n 191     const status = this.getStatus();\\n 192     return status === SectionStatus.GENERATED || status === SectionStatus.EDITED;\\n 193   }\\n 194 \\n 195   /**\\n 196    * Check if section is currently being generated\\n 197    */\\n 198   public isGenerating(): boolean {\\n 199     return this.getStatus() === SectionStatus.GENERATING;\\n 200   }\\n 201 \\n 202   /**\\n 203    * Get AI model used for generation\\n 204    */\\n 205   public getAiModel(): string | undefined {\\n 206     return (this.metadata as SectionMetadata)?.aiModel;\\n 207   }\\n 208 \\n 209   /**\\n 210    * Get word count from metadata\\n 211    */\\n 212   public getWordCount(): number {\\n 213     return (this.metadata as SectionMetadata)?.wordCount || 0;\\n 214   }\\n 215 \\n 216   /**\\n 217    * Get estimated read time\\n 218    */\\n 219   public getReadTime(): number {\\n 220     return (this.metadata as SectionMetadata)?.estimatedReadTime || 0;\\n 221   }\\n 222 \\n 223   /**\\n 224    * Get generation timestamp\\n 225    */\\n 226   public getGeneratedAt(): string | undefined {\\n 227     return (this.metadata as SectionMetadata)?.generatedAt;\\n 228   }\\n 229 \\n 230   /**\\n 231    * Get number of generation attempts\\n 232    */\\n 233   public getGenerationAttempts(): number {\\n 234     return (this.metadata as SectionMetadata)?.generationAttempts || 0;\\n 235   }\\n 236 \\n 237   public buildSystemPrompt(): string {\\n 238     const personas = this.behaviors.filter(b => b.type === \'persona\').map(b => b.name);\\n 239     const behaviorInstructions = this.behaviors.filter(b => b.type === \'behavior\').map(b => b.name);\\n 240 \\n 241     let systemPrompt = \'You are an advanced AI assistant tailored for academic and technical writing.\';\\n 242 \\n 243     if (personas.length > 0) {\\n 244       systemPrompt += `\\\\n\\\\n**ROLE / PERSONA:**\\\\nAdopt the persona of: ${personas.join(\', \')}. Write with the authority, vocabulary, and perspective of this role.`;\\n 245     }\\n 246 \\n 247     if (this.controls.tone) {\\n 248       systemPrompt += `\\\\nMaintain a **${this.controls.tone}** tone throughout.`;\\n 249     }\\n 250 \\n 251     const allRules = [\\n 252       ...this.rules,\\n 253       ...behaviorInstructions,\\n 254       this.controls.language !== \'default\' ? `Output must be in ${this.controls.language}.` : null,\\n 255     ].filter(Boolean) as string[];\\n 256 \\n 257     if (allRules.length > 0) {\\n 258       systemPrompt += `\\\\n\\\\n**MANDATORY RULES:**\\\\n${allRules.map(r => `- ${r}`).join(\'\\\\n\')}`;\\n 259     }\\n 260 \\n 261     if (this.guidelines.length > 0) {\\n 262         systemPrompt += `\\\\n\\\\n**GUIDELINES (Follow these recommendations):**\\\\n${this.guidelines.map(g => `- ${g}`).join(\'\\\\n\')}`;\\n 263     }\\n 264 \\n 265     if (this.constraints.length > 0) {\\n 266       systemPrompt += `\\\\n\\\\n**CONSTRAINTS (DO NOT DO):**\\\\n${this.constraints.map(c => `- ${c}`).join(\'\\\\n\')}`;\\n 267     }\\n 268 \\n 269     // Output Format Specifics\\n 270     if (this.type === \'diagram\') {\\n 271       systemPrompt += `\\\\n\\\\nOutput ONLY valid PlantUML code inside \\\\`\\\\`\\\\`plantuml blocks. Do not add conversational text.`;\\n 272     } else if (this.type === \'code\') {\\n 273       systemPrompt += `\\\\n\\\\nFocus on producing high-quality, documented code snippets.`;\\n 274     }\\n 275 \\n 276     return systemPrompt;\\n 277   }\\n 278 \\n 279   public buildActionPrompt(): string {\\n 280     const formalityMap: { [key: number]: string } = { 0: \'very informal and casual\', 33: \'balanced and neutral\', 67: \'formal and professional\', 100: \'very formal and academic\' };\\n 281     const complexityMap: { [key: number]: string } = { 0: \'very simple and easy to understand\', 33: \'clear and straightforward\', 67: \'detailed and technical\', 100: \'highly complex and expert-level\' };\\n 282 \\n 283     let instructions: string[] = [];\\n 284     const formality = this.controls.formality > 67 ? formalityMap[100] : this.controls.formality > 33 ? formalityMap[67] : this.controls.formality > 0 ? formalityMap[33] : formalityMap[0];\\n 285     instructions.push(`The formality should be ${formality}.`);\\n 286 \\n 287     const complexity = this.controls.complexity > 67 ? complexityMap[100] : this.controls.complexity > 33 ? complexityMap[67] : this.controls.complexity > 0 ? complexityMap[33] : complexityMap[0];\\n 288     instructions.push(`The complexity should be ${complexity}.`);\\n 289 \\n 290     if (this.controls.tone) instructions.push(`The tone should be ${this.controls.tone}.`);\\n 291     if (this.controls.wordCount) instructions.push(`Aim for a word count of approximately ${this.controls.wordCount} words.`);\\n 292 \\n 293     if (this.controls.outputStyle.diagram && this.controls.diagramType) {\\n 294         instructions.push(`The output must include a PlantUML diagram of type \'${this.controls.diagramType}\'.`);\\n 295     }\\n 296     if (this.controls.outputStyle.code && this.controls.programmingLanguage) {\\n 297         instructions.push(`The code blocks should be in ${this.controls.programmingLanguage}.`);\\n 298     }\\n 299     if (this.controls.outputStyle.table && this.controls.tableCaption) {\\n 300         instructions.push(`If a table is generated, it must have the caption: \\"${this.controls.tableCaption}\\".`);\\n 301     }\\n 302     if (this.controls.outputStyle.heading && this.controls.includedHeadings && this.controls.includedHeadings.length > 0) {\\n 303         instructions.push(`The heading should cover the following topics: ${this.controls.includedHeadings.join(\', \')}.`);\\n 304     }\\n 305 \\n 306     if (this.controls.language && this.controls.language !== \'default\') {\\n 307         instructions.push(`The output language must be ${this.controls.language}.`);\\n 308     }\\n 309     \\n 310     if (this.controls.outputStyle.includeCitations && this.controls.citationStyle) {\\n 311         instructions.push(`Use ${this.controls.citationStyle} citation style.`);\\n 312     }\\n 313 \\n 314     const enabledStyles = Object.entries(this.controls.outputStyle).filter(([key, value]) => value && key !== \'includeCitations\').map(([key]) => key);\\n 315     if (enabledStyles.length > 0) instructions.push(`The output should primarily include the following elements: ${enabledStyles.join(\', \')}.`);\\n 316     \\n 317     const additionalInstructions = `\\\\n\\\\n**Additional Instructions:**\\\\n${instructions.join(\' \')}`;\\n 318 \\n 319     return `${this.prompt}${additionalInstructions}`;\\n 320   }\\n 321 \\n 322   public getContextAsRecord(project: Project): Record<string, string> {\\n 323       if (!this.context?.sections) return {};\\n 324       const contextRecord: Record<string, string> = {};\\n 325       for (const sectionId of Object.keys(this.context.sections)) {\\n 326           const section = project.getSection(sectionId);\\n 327           if (section?.content) {\\n 328               contextRecord[section.title] = section.content;\\n 329           }\\n 330       }\\n 331       return contextRecord;\\n 332   }\\n 333 \\n 334   public getExternalContextAsArray(project: Project): { fileName: string; content: string; type: string }[] {\\n 335       if (!this.context?.externalContext) return [];\\n 336       const externalContextArray = [];\\n 337       for (const fileId of Object.keys(this.context.externalContext)) {\\n 338           const file = project.externalContext?.find(f => f.id === fileId);\\n 339           if (file) {\\n 340               externalContextArray.push({\\n 341                   fileName: file.fileName,\\n 342                   content: file.content,\\n 343                   type: this.context.externalContext[fileId]!,\\n 344               });\\n 345           }\\n 346       }\\n 347       return externalContextArray;\\n 348   }\\n 349 \\n 350   public toStateObject(): SectionProperties {\\n 351     return {\\n 352       id: this.id,\\n 353       title: this.title,\\n 354       type: this.type,\\n 355       content: this.content,\\n 356       prompt: this.prompt,\\n 357       rules: [...this.rules],\\n 358       guidelines: [...this.guidelines],\\n 359       constraints: [...this.constraints],\\n 360       behaviors: [...this.behaviors],\\n 361       controls: this.controls,\\n 362       context: this.context,\\n 363       metadata: this.metadata,\\n 364     };\
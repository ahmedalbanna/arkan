    </CollapsibleTrigger>\\n        <CollapsibleContent className=\\"flex-shrink-0\\">\\n          <div className=\\"p-4 border-t bg-muted/30 space-y-2\\">\\n            <div className=\\"flex items-center gap-2 text-sm\\">\\n              <Lightbulb className=\\"h-4 w-4 text-yellow-500 flex-shrink-0\\" />\\n              <span className=\\"font-semibold\\">Suggestion:</span>\\n              <span className=\\"text-muted-foreground\\">{suggestion}</span>\\n            </div>\\n            {project?.meta.updated && (\\n              <div className=\\"flex items-center gap-2 text-sm\\">\\n                <History className=\\"h-4 w-4 text-blue-500 flex-shrink-0\\" />\\n                <span className=\\"font-semibold\\">Last operation:</span>\\n                <span className=\\"text-muted-foreground\\">\\n                  Project updated {formatDistanceToNow(new Date(project.meta.updated), { addSuffix: true })}\\n                </span>\\n              </div>\\n            )}\\n          </div>\\n        </CollapsibleContent>\\n      </Collapsible>\\n\\n      {/* Content Area - Main scrollable content */}\\n      <CardContent className=\\"flex-1 flex flex-col p-0 bg-slate-200 dark:bg-slate-900/50 overflow-hidden relative\\">\\n        <ScrollIndicator containerRef={scrollContainerRef} />\\n        <ScrollArea className=\\"flex-1\\">\\n          <div ref={scrollContainerRef} className=\\"py-4 px-4 scroll-smooth\\">\\n            {renderContent()}\\n          </div>\\n        </ScrollArea>\\n        <ScrollToTopButton \\n          containerRef={scrollContainerRef}\\n          className=\\"bottom-8\\"\\n        />\\n      </CardContent>\\n    </Card>\\n  );"}', 'logfire.msg': 'running tool: find_and_replace_code', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span', 'original_content': '\'use client\';\n\nimport { A4Page } from \'@/components/shared/A4Page\';\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardTitle\n} from \'@/components/ui/card\';\nimport { ScrollArea } from \'@/components/ui/scroll-area\';\nimport { useLocalization } from \'@/context/LocalizationContext\';\nimport { useBuilderStore } from \'@/hooks\';\nimport { formatDistanceToNow } from \'date-fns\';\nimport { BookOpenCheck, Bot, Brush, ChevronDown, FileText, FileVideo, History, LayoutList, Lightbulb, ArrowUp } from \'lucide-react\';\nimport { useState, useRef } from \'react\';\nimport { CoverPage } from \'../shared/CoverPage\';\nimport { Button } from \'../ui/button\';\nimport { Collapsible, CollapsibleContent, CollapsibleTrigger } from \'../ui/collapsible\';\nimport { FileContentViewer } from \'./file-manager/FileContentViewer\';\nimport MarkdownEditor from \'./MarkdownEditor\';\nimport { TableOfContentForm } from \'./TableOfContentForm\';\nimport { ScrollToTopButton, ScrollIndicator } from \'../ui/scroll-utilities\';\n\nconst ReportSteps = () => {\n  const { t } = useLocalization();\n\n  const steps = [\n    {\n      icon: <FileVideo className="h-6 w-6 text-primary" />,\n      title: "1. Customize Cover Page",\n      description: "Click on the text on the cover page to edit your project\'s title, description, and author details directly."\n    },\n    {\n      icon: <LayoutList className="h-6 w-6 text-primary" />,\n      title: "2. Insert Table of Contents",\n      description: "Use the \'Add Chapter\' button or paste a structure in the \'Generation Tools\' to create your document\'s outline."\n    },\n    {\n      icon: <Bot className="h-6 w-6 text-primary" />,\n      title: "3. AI Generate Project Template",\n      description: "Apply a pre-defined template to structure your report and generate content for all sections with a single click."\n    },\n    {\n      icon: <Brush className="h-6 w-6 text-primary" />,\n      title: "4. Customize Generation Tools",\n      description: "For each section, expand it to edit the AI prompt, add guidelines, and select context from other sections or files."\n    },\n    {\n      icon: <BookOpenCheck className="h-6 w-6 text-primary" />,\n      title: "5. View Chapter and Section",\n      description: "Generate content by clicking the \'Generate\' button on any section and review the results as they appear in the editor."\n    }\n  ];\n\n  return (\n    <div className="p-8">\n      <div className="text-center mb-10">\n        <h3 className="text-xl font-semibold font-headline">{t(\'builder.reportGenerator.emptyStateTitle\')}</h3>\n        <p className="text-muted-foreground">{t(\'builder.reportGenerator.emptyStateDesc\')}</p>\n      </div>\n      <div className="space-y-6">\n        {steps.map((step, index) => (\n          <div key={index} className="flex items-start gap-4">\n            <div className="flex-shrink-0 bg-primary/10 p-3 rounded-full">\n              {step.icon}\n            </div>\n            <div>\n              <h4 className="font-semibold">{step.title}</h4>\n              <p className="text-sm text-muted-foreground">{step.description}</p>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  )\n}\n\ninterface ReportResultsProps {\n  activePanelKey: string;\n}\n\nconst ReportResults = ({ activePanelKey }: ReportResultsProps) => {\n  const { t } = useLocalization();\n  const { project, version, updateProjectFromMarkdown, selectedFileId } = useBuilderStore();\n  const [isSuggestionVisible, setIsSuggestionVisible] = useState(true);\n  const scrollContainerRef = useRef<HTMLDivElement>(null);\n\n  const handleContentChange = (newMarkdown: string) => {\n    updateProjectFromMarkdown(newMarkdown);\n  };\n\n  const hasContent = project?.content && project.content.length > 0;\n\n  // Logic for suggestions\n  const getSuggestion = () => {\n    if (!project || !project.sections) return "Start by adding a chapter or applying a template.";\n    const emptySection = project.sections.find(s => !s.content);\n    if (emptySection) {\n      return `Suggestion: Try generating the "${emptySection.title}" section next.`;\n    }\n    return "All sections have content. You can now review or export your document.";\n  };\n  const suggestion = getSuggestion();\n\n  const renderContent = () => {\n    switch (activePanelKey) {\n      case \'settings\':\n        return <CoverPage project={project} />;\n      case \'templates\':\n        return (\n          <A4Page>\n            <TableOfContentForm />\n          </A4Page>\n        );\n      case \'files\': {\n        const selectedFile = project?.externalContext.find(f => f.id === selectedFileId);\n\n        if (!selectedFile) {\n          return (\n            <A4Page>\n              <div className="p-8 text-center text-muted-foreground h-full flex flex-col justify-center items-center">\n                <FileText className="mx-auto h-16 w-16 mb-4" />\n                <h3 className="text-xl font-semibold font-headline text-foreground">File Content Viewer</h3>\n                <p className="mt-2">When you select a file from the manager, its content will be displayed here for review and analysis.</p>\n              </div>\n            </A4Page>\n          );\n        }\n\n        return (\n          <A4Page>\n            <FileContentViewer fileName={selectedFile.fileName} content={selectedFile.content} />\n          </A4Page>\n        );\n      }\n      case \'generate\':\n      default:\n        if (hasContent) {\n          return (\n            <A4Page>\n              <MarkdownEditor\n                key={version} // Re-mount editor when version changes\n                content={project?.fullMarkdownContent || \'\'}\n                onChange={handleContentChange}\n              />\n            </A4Page>\n          )\n        }\n        return (\n          <div className="max-w-[210mm] mx-auto my-4">\n            <ReportSteps />\n          </div>\n        )\n    }\n  }\n\n  return (\n    <Card className="h-full flex flex-col overflow-hidden">\n      <Collapsible open={isSuggestionVisible} onOpenChange={setIsSuggestionVisible} className="border-b">\n        <CollapsibleTrigger asChild>\n          <div className="flex items-center justify-between p-4 cursor-pointer hover:bg-muted/50">\n            <div>\n              <CardTitle className="font-headline text-lg">\n                {t(\'builder.reportGenerator.resultsTitle\')}\n              </CardTitle>\n              <CardDescription className="text-xs">\n                {t(\'builder.reportGenerator.resultsDesc\')}\n              </CardDescription>\n            </div>\n            <Button variant="ghost" size="sm" className="shrink-0">\n              <ChevronDown className={`h-4 w-4 transition-transform ${isSuggestionVisible ? \'\' : \'-rotate-90\'}`} />\n              <span className="sr-only">Toggle suggestions</span>\n            </Button>\n          </div>\n        </CollapsibleTrigger>\n        <CollapsibleContent>\n          <div className="p-4 border-t bg-muted/30 space-y-2">\n            <div className="flex items-center gap-2 text-sm">\n              <Lightbulb className="h-4 w-4 text-yellow-500" />\n              <span className="font-semibold">Suggestion:</span>\n              <span className="text-muted-foreground">{suggestion}</span>\n            </div>\n            {project?.meta.updated && (\n              <div className="flex items-center gap-2 text-sm">\n                <History className="h-4 w-4 text-blue-500" />\n                <span className="font-semibold">Last operation:</span>\n                <span className="text-muted-foreground">\n                  Project updated {formatDistanceToNow(new Date(project.meta.updated), { addSuffix: true })}\n                </span>\n              </div>\n            )}\n          </div>\n        </CollapsibleContent>\n      </Collapsible>\n\n      <CardContent className="flex-grow flex flex-col p-0 bg-slate-200 dark:bg-slate-900/50 min-h-0 relative">\n        <ScrollIndicator containerRef={scrollContainerRef} />\n        <ScrollArea className="flex-grow">\n          <div ref={scrollContainerRef} className="py-4 scroll-smooth">\n            {renderContent()}\n          </div>\n        </ScrollArea>\n        <ScrollToTopButton \n          containerRef={scrollContainerRef}\n          className="bottom-8"\n        />\n      </CardContent>\n    </Card>\n  );\n};\n\nexport default ReportResults;\n', 'tool_response': 'Successfully replaced code in src/components/report-mode/ReportResults.tsx:\n\n--- src/components/report-mode/ReportResults.tsx\n+++ src/components/report-mode/ReportResults.tsx\n@@ -155,11 +155,12 @@\n   }\n \n   return (\n-    <Card className="h-full flex flex-col overflow-hidden">\n-      <Collapsible open={isSuggestionVisible} onOpenChange={setIsSuggestionVisible} className="border-b">\n+    <Card className="h-full w-full flex flex-col overflow-hidden border">\n+      {/* Header with Collapsible Suggestions */}\n+      <Collapsible open={isSuggestionVisible} onOpenChange={setIsSuggestionVisible} className="border-b flex-shrink-0">\n         <CollapsibleTrigger asChild>\n-          <div className="flex items-center justify-between p-4 cursor-pointer hover:bg-muted/50">\n-            <div>\n+          <div className="flex items-center justify-between p-4 cursor-pointer hover:bg-muted/50 transition-colors">\n+            <div className="flex-1">\n               <CardTitle className="font-headline text-lg">\n                 {t(\'builder.reportGenerator.resultsTitle\')}\n               </CardTitle>\n@@ -173,16 +174,16 @@\n             </Button>\n           </div>\n         </CollapsibleTrigger>\n-        <CollapsibleContent>\n+        <CollapsibleContent className="flex-shrink-0">\n           <div className="p-4 border-t bg-muted/30 space-y-2">\n             <div className="flex items-center gap-2 text-sm">\n-              <Lightbulb className="h-4 w-4 text-yellow-500" />\n+              <Lightbulb className="h-4 w-4 text-yellow-500 flex-shrink-0" />\n               <span className="font-semibold">Suggestion:</span>\n               <span className="text-muted-foreground">{suggestion}</span>\n             </div>\n             {project?.meta.updated && (\n               <div className="flex items-center gap-2 text-sm">\n-                <History className="h-4 w-4 text-blue-500" />\n+                <History className="h-4 w-4 text-blue-500 flex-shrink-0" />\n                 <span className="font-semibold">Last operation:</span>\n                 <span className="text-muted-foreground">\n                   Project updated {formatDistanceToNow(new Date(project.meta.updated), { addSuffix: true })}\n@@ -193,10 +194,11 @@\n         </CollapsibleContent>\n       </Collapsible>\n \n-      <CardContent className="flex-grow flex flex-col p-0 bg-slate-200 dark:bg-slate-900/50 min-h-0 relative">\n+      {/* Content Area - Main scrollable content */}\n+      <CardContent className="flex-1 flex flex-col p-0 bg-slate-200 dark:bg-slate-900/50 overflow-hidden relative">\n         <ScrollIndicator containerRef={scrollContainerRef} />\n-        <ScrollArea className="flex-grow">\n-          <div ref={scrollContainerRef} className="py-4 scroll-smooth">\n+        <ScrollArea className="flex-1">\n+          <div ref={scrollContainerRef} className="py-4 px-4 scroll-smooth">\n             {renderContent()}\n           </div>\n         </ScrollArea>\n'}

deCount, setNodes]\\n  );\\n\\n  const saveFlow = useCallback(() => {\\n    const flowData = {\\n      nodes,\\n      edges,\\n      name: \'My Flow\',\\n      createdAt: new Date().toISOString(),\\n    };\\n    console.log(\'Saving flow:\', flowData);\\n    // TODO: Implement save logic\\n  }, [nodes, edges]);\\n\\n  const executeFlow = useCallback(() => {\\n    console.log(\'Executing flow with nodes:\', nodes, \'edges:\', edges);\\n    // TODO: Implement execution logic\\n  }, [nodes, edges]);\\n\\n  return (\\n    <div className=\\"h-full w-full bg-slate-50 dark:bg-slate-900\\">\\n      <div className=\\"h-full flex flex-col\\">\\n        {/* Toolbar */}\\n        <div className=\\"bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 p-4 flex items-center justify-between\\">\\n          <h1 className=\\"text-xl font-bold\\">Flow Builder</h1>\\n          <div className=\\"flex items-center gap-2\\">\\n            <Dialog>\\n              <DialogTrigger asChild>\\n                <Button variant=\\"outline\\" size=\\"sm\\">\\n                  <Plus className=\\"w-4 h-4 mr-2\\" />\\n                  Add Node\\n                </Button>\\n              </DialogTrigger>\\n              <DialogContent>\\n                <DialogHeader>\\n                  <DialogTitle>Add Node to Flow</DialogTitle>\\n                </DialogHeader>\\n                <FlowNodePanel onAddNode={addNode} />\\n              </DialogContent>\\n            </Dialog>\\n            <Button\\n              variant=\\"outline\\"\\n              size=\\"sm\\"\\n              onClick={saveFlow}\\n            >\\n              <Save className=\\"w-4 h-4 mr-2\\" />\\n              Save\\n            </Button>\\n            <Button\\n              size=\\"sm\\"\\n              onClick={executeFlow}\\n              className=\\"bg-green-600 hover:bg-green-700\\"\\n            >\\n              <Play className=\\"w-4 h-4 mr-2\\" />\\n              Execute\\n            </Button>\\n          </div>\\n        </div>\\n\\n        {/* Flow Canvas */}\\n        <div className=\\"flex-1\\">\\n          <ReactFlow\\n            nodes={nodes}\\n            edges={edges}\\n            onNodesChange={onNodesChange}\\n            onEdgesChange={onEdgesChange}\\n            onConnect={onConnect}\\n            fitView\\n          >\\n            <Background />\\n            <Controls />\\n            <MiniMap />\\n          </ReactFlow>\\n        </div>\\n\\n        {/* Info Panel */}\\n        <div className=\\"bg-white dark:bg-slate-800 border-t border-slate-200 dark:border-slate-700 p-4\\">\\n          <div className=\\"grid grid-cols-3 gap-4 text-sm\\">\\n            <div>\\n              <span className=\\"text-slate-600 dark:text-slate-400\\">Nodes:</span>\\n              <span className=\\"ml-2 font-semibold\\">{nodes.length}</span>\\n            </div>\\n            <div>\\n              <span className=\\"text-slate-600 dark:text-slate-400\\">Connections:</span>\\n              <span className=\\"ml-2 font-semibold\\">{edges.length}</span>\\n            </div>\\n            <div>\\n              <span className=\\"text-slate-600 dark:text-slate-400\\">Status:</span>\\n              <span className=\\"ml-2 font-semibold text-yellow-600\\">Ready</span>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n}\\n"}', 'logfire.msg': 'running tool: create_file', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span', 'original_content': '', 'tool_response': 'Successfully created /teamspace/studios/this_studio/arkan/dynamic-flows-studio/src/components/builder/FlowBuilder.tsx.'}

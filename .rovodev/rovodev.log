alScrollContainer />` - Performance optimization for large lists (1000+ items)\\n\\n*CSS Classes:*\\n- `scroll-smooth` - Enables smooth scrolling behavior\\n- `scroll-touch` - Mobile momentum scrolling (iOS native feel)\\n- `scroll-snap-container` / `scroll-snap-item` - Scroll snap alignment\\n\\n**Usage Example:**\\n```tsx\\nimport { useScrollToTop, ScrollToTopButton } from '@/components/ui/scroll-utilities';\\n\\nconst MyComponent = () => {\\n  const scrollRef = useRef<HTMLDivElement>(null);\\n  const { scrollToTop } = useScrollToTop(scrollRef);\\n  \\n  return (\\n    <>\\n      <ScrollArea>\\n        <div ref={scrollRef} className=\\\"scroll-smooth\\\">\\n          {/* Content */}\\n        </div>\\n      </ScrollArea>\\n      <ScrollToTopButton containerRef={scrollRef} />\\n    </>\\n  );\\n};\\n```\"}", "tool_call_id": "toolu_bdrk_0114MhQ69ooowknH7JPyBsU8", "id": null, "provider_details": null, "part_kind": "tool-call"}

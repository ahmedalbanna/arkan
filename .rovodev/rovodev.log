uirement\n  42   const wordCount = section.controls?.wordCount || 0;\n  43   if (wordCount > 1500) complexityScore += 3;\n  44   else if (wordCount > 800) complexityScore += 2;\n  45   else if (wordCount > 400) complexityScore += 1;\n  46 \n  47   // Factor 2: Number of guidelines\n  48   const guidelinesCount = section.guidelines?.length || 0;\n  49   if (guidelinesCount > 5) complexityScore += 2;\n  50   else if (guidelinesCount > 2) complexityScore += 1;\n  51 \n  52   // Factor 3: Complexity control\n  53   const complexity = section.controls?.complexity || 50;\n  54   if (complexity > 80) complexityScore += 3;\n  55   else if (complexity > 60) complexityScore += 2;\n  56   else if (complexity > 40) complexityScore += 1;\n  57 \n  58   // Factor 4: Context dependencies\n  59   const contextCount = (section.context?.length || 0) + (section.externalContext?.length || 0);\n  60   if (contextCount > 5) complexityScore += 2;\n  61   else if (contextCount > 2) complexityScore += 1;\n  62 \n  63   // Factor 5: Behaviors complexity\n  64   const behaviorsCount = section.behaviors?.length || 0;\n  65   if (behaviorsCount > 3) complexityScore += 1;\n  66 \n  67   // Factor 6: Section type\n  68   if (section.type === 'diagram' || section.type === 'table') {\n  69     complexityScore += 2; // Structured content is more complex\n  70   }\n  71 \n  72   // Map score to complexity level\n  73   if (complexityScore >= 9) return SectionComplexity.EXPERT;\n  74   if (complexityScore >= 6) return SectionComplexity.COMPLEX;\n  75   if (complexityScore >= 3) return SectionComplexity.MEDIUM;\n  76   return SectionComplexity.SIMPLE;\n  77 }\n  78 \n  79 /**\n  80  * Select the appropriate model configuration for a section\n  81  */\n  82 export function selectModelForSection(section: Section): ModelConfig {\n  83   const complexity = assessSectionComplexity(section);\n  84   const config = MODEL_CONFIGS[complexity];\n  85   \n  86   logger.info(`Selected model: ${config.model} (complexity: ${complexity}, section: ${section.title})`);\n  87   \n  88   return config;\n  89 }\n  90 \n  91 /**\n  92  * Get model config by complexity level (for testing or manual selection)\n  93  */\n  94 export function getModelConfig(complexity: SectionComplexity): ModelConfig {\n  95   return MODEL_CONFIGS[complexity];\n  96 }\n  97 \n  98 /**\n  99  * Override model selection with custom configuration\n 100  * Useful for testing or user preferences\n 101  */\n 102 export function createCustomModelConfig(\n 103   modelName?: string,\n 104   temperature?: number,\n 105   maxTokens?: number\n 106 ): ModelConfig {\n 107   return {\n 108     model: modelName || MODEL_CONFIGS[SectionComplexity.MEDIUM].model,\n 109     temperature: temperature ?? 0.4,\n 110     maxTokens: maxTokens ?? 2000,\n 111   };\n 112 }\n 113 \n````"}

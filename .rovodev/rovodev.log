         <FileText className="mx-auto h-16 w-16 mb-4" />\n 120                 <h3 className="text-xl font-semibold font-headline text-foreground">File Content Viewer</h3>\n 121                 <p className="mt-2">When you select a file from the manager, its content will be displayed here for review and analysis.</p>\n 122               </div>\n 123             </A4Page>\n 124           );\n 125         }\n 126 \n 127         return (\n 128           <A4Page>\n 129             <FileContentViewer fileName={selectedFile.fileName} content={selectedFile.content} />\n 130           </A4Page>\n 131         );\n 132       }\n 133       case \'generate\':\n 134       default:\n 135         if (hasContent) {\n 136           return (\n 137             <A4Page>\n 138               <MarkdownEditor\n 139                 key={version} // Re-mount editor when version changes\n 140                 content={project?.fullMarkdownContent || \'\'}\n 141                 onChange={handleContentChange}\n 142               />\n 143             </A4Page>\n 144           )\n 145         }\n 146         return (\n 147           <div className="max-w-[210mm] mx-auto my-4">\n 148             <ReportSteps />\n 149           </div>\n 150         )\n 151     }\n 152   }\n 153 \n 154   return (\n 155     <Card className="h-full flex flex-col overflow-hidden">\n 156       <Collapsible open={isSuggestionVisible} onOpenChange={setIsSuggestionVisible} className="border-b">\n 157         <CollapsibleTrigger asChild>\n 158           <div className="flex items-center justify-between p-4 cursor-pointer hover:bg-muted/50">\n 159             <div>\n 160               <CardTitle className="font-headline text-lg">\n 161                 {t(\'builder.reportGenerator.resultsTitle\')}\n 162               </CardTitle>\n 163               <CardDescription className="text-xs">\n 164                 {t(\'builder.reportGenerator.resultsDesc\')}\n 165               </CardDescription>\n 166             </div>\n 167             <Button variant="ghost" size="sm" className="shrink-0">\n 168               <ChevronDown className={`h-4 w-4 transition-transform ${isSuggestionVisible ? \'\' : \'-rotate-90\'}`} />\n 169               <span className="sr-only">Toggle suggestions</span>\n 170             </Button>\n 171           </div>\n 172         </CollapsibleTrigger>\n 173         <CollapsibleContent>\n 174           <div className="p-4 border-t bg-muted/30 space-y-2">\n 175             <div className="flex items-center gap-2 text-sm">\n 176               <Lightbulb className="h-4 w-4 text-yellow-500" />\n 177               <span className="font-semibold">Suggestion:</span>\n 178               <span className="text-muted-foreground">{suggestion}</span>\n 179             </div>\n 180             {project?.meta.updated && (\n 181               <div className="flex items-center gap-2 text-sm">\n 182                 <History className="h-4 w-4 text-blue-500" />\n 183                 <span className="font-semibold">Last operation:</span>\n 184                 <span className="text-muted-foreground">\n 185                   Project updated {formatDistanceToNow(new Date(project.meta.updated), { addSuffix: true })}\n 186                 </span>\n 187               </div>\n 188             )}\n 189           </div>\n 190         </CollapsibleContent>\n 191       </Collapsible>\n 192 \n 193       <CardContent className="flex-grow flex flex-col p-0 bg-slate-200 dark:bg-slate-900/50 min-h-0">\n 194         <ScrollArea className="flex-grow">\n 195           <div className="py-4">\n 196             {renderContent()}\n 197           </div>\n 198         </ScrollArea>\n 199       </CardContent>\n 200     </Card>\n 201   );\n 202 };\n 203 \n 204 export default ReportResults;\n 205 \n````'}

baseStyles: IStylesOptions = {\\n    paragraphStyles: [\\n      {\\n        id: 'Caption',\\n        name: 'Caption',\\n        basedOn: 'Normal',\\n        next: 'Normal',\\n        quickFormat: true,\\n        run: { size: 18, italics: true, color: '595959' },\\n        paragraph: {\\n          alignment: AlignmentType.CENTER,\\n          spacing: { before: 120, after: 240 },\\n        },\\n      },\\n    ],\\n  };\\n\\n  if (!customStyles) {\\n    return baseStyles;\\n  }\\n\\n  // Merge custom styles with defaults\\n  const mergedStyles = { ...customStyles };\\n  const customParaStyles = customStyles.paragraphStyles || [];\\n  \\n  // Check if Caption style already exists\\n  const captionExists = customParaStyles.some(style => style.id === 'Caption');\\n  if (!captionExists) {\\n    mergedStyles.paragraphStyles = [...customParaStyles, ...(baseStyles.paragraphStyles || [])];\\n  }\\n\\n  return mergedStyles;\\n}\\n\\n/**\\n * Generates markdown string from project content\\n */\\nfunction generateMarkdownFromContent(content: ProjectContent | any[]): string {\\n  if (!content || !Array.isArray(content)) return '';\\n\\n  return content\\n    .map(item => {\\n      // Check if item has sections (Chapter-like)\\n      if (item.sections && Array.isArray(item.sections)) {\\n        const chapterContent = `# ${item.title || ''}`;\\n        const sectionsContent = item.sections\\n          .map((section: any) => `## ${section.title || ''}\\\\n\\\\n${section.content || ''}`)\\n          .join('\\\\n\\\\n');\\n        return `${chapterContent}\\\\n\\\\n${sectionsContent}`;\\n      } else {\\n        // Section-like\\n        return `# ${item.title || ''}\\\\n\\\\n${item.content || ''}`;\\n      }\\n    })\\n    .join('\\\\n\\\\n<!-- slide-break -->\\\\n\\\\n');\\n}\\n\\n/**\\n * Creates a professional cover page as markdown and converts it to DOCX elements\\n */\\nasync function createProfessionalCoverPageMarkdown(project: any): Promise<string> {\\n  const isArabic = /[\\\\u0600-\\\\u06FF]/.test(project.name || '');\\n  const dateLocale = isArabic ? 'ar-SA' : 'en-US';\\n  const formattedDate = new Date().toLocaleDateString(dateLocale, {\\n    year: 'numeric',\\n    month: 'long',\\n    day: 'numeric',\\n  });\\n\\n  const currentYear = new Date().getFullYear();\\n  const academicYear = `${currentYear}-${currentYear + 1}`;\\n  const yearLabel = isArabic ? '\u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u062f\u0631\u0627\u0633\u064a' : 'Academic Year';\\n\\n  let coverMarkdown = '';\\n\\n  // Title\\n  if (project.name) {\\n    coverMarkdown += `# ${project.name}\\\\n\\\\n`;\\n  }\\n\\n  // Description\\n  if (project.projectDescription) {\\n    coverMarkdown += `**${project.projectDescription}**\\\\n\\\\n`;\\n  }\\n\\n  // Project metadata\\n  if (project.projectType || project.specialization) {\\n    coverMarkdown += '---\\\\n\\\\n';\\n    if (project.projectType) {\\n      coverMarkdown += `**${isArabic ? '\u0646\u0648\u0639 \u0627\u0644\u0645\u0634\u0631\u0648\u0639' : 'Project Type'}:** ${project.projectType}\\\\n\\\\n`;\\n    }\\n    if (project.specialization) {\\n      coverMarkdown += `**${isArabic ? '\u0627\u0644\u062a\u062e\u0635\u0635' : 'Specialization'}:** ${project.specialization}\\\\n\\\\n`;\\n    }\\n    coverMarkdown += '---\\\\n\\\\n';\\n  }\\n\\n  // Team members\\n  if (project.teamMembers && project.teamMembers.length > 0) {\\n    coverMarkdown += `## ${isArabic ? '\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0637\u0644\u0627\u0628' : 'Prepared by'}\\\\n\\\\n`;\\n    project.teamMembers.forEach((member: string) => {\\n      coverMarkdown += `- ${member}\\\\n`;\\n    });\\n    coverMarkdown += '\\\\n';\\n  }\\n\\n  // Supervisor\\n  if (project.supervisor) {\\n    coverMarkdown += `## ${isArabic ? '\u0625\u0634\u0631\u0627\u0641' : 'Supervised by'}\\\\n\\\\n`;\\n    coverMarkdown += `${project.supervisor}\\\\n\\\\n`;\\n  }\\n\\n  // Institution information\\n  if (project.university || project.course || project.educationalLevel) {\\n    coverMarkdown += '---\\\\n\\\\n';\\n    if (project.university) {\\n      coverMarkdown += `**${project.university}**\\\\n\\\\n`;\\n    }\\n    if (project.course) {\\n      coverMarkdown += `*${project.course}*\\\\n\\\\n`;\\n    }\\n    if (project.educationalLevel) {\\n      coverMarkdown += `${project.educationalLevel}\\\\n\\\\n`;\\n    }\\n    coverMarkdown += '---\\\\n\\\\n';\\n  }\\n\\n  // Date and academic year\\n  coverMarkdown += `${formattedDate}\\\\n\\\\n`;\\n  coverMarkdown += `${yearLabel} ${academicYear}\\\\n\\\\n`;\\n\\n  return coverMarkdown;\\n}\\n\\n/**\\n * Converts markdown to DOCX using remark-docx external library\\n * Supports both raw markdown strings and Project objects\\n */\\nexport async function convertMarkdownToDocxExternal(\\n  markdownOrProject: string | Project | any,\\n  optionsOrFileName?: (ConversionOptions & { selectedContent?: ProjectContent }) | string,\\n  optionsForMarkdown?: ConversionOptions\\n): Promise<Buffer | Blob> {\\n  try {\\n    // Input validation\\n    if (!markdownOrProject) {\\n      throw new Error('Input is required: provide either a Project object or markdown string');\\n    }\\n\\n    let finalMarkdown: string;\\n    let finalOptions: ConversionOptions = {};\\n    let finalStyles: IStylesOptions;\\n\\n    // Determine input type\\n    if (typeof markdownOrProject === 'string') {\\n      // Handle raw markdown string\\n      finalMarkdown = markdownOrProject;\\n      finalOptions = optionsForMarkdown || {};\\n\\n      if (typeof finalMarkdown !== 'string' || finalMarkdown.trim().length === 0) {\\n        throw new Error('Invalid markdown: must be a non-empty string');\\n      }\\n    } else if (typeof markdownOrProject === 'object' && markdownOrProject !== null && 'content' in markdownOrProject) {\\n      // Handle Project object\\n      const project = markdownOrProject;\\n      finalOptions = (optionsOrFileName as (ConversionOptions & { selectedContent?: ProjectContent })) || {};\\n\\n      // Get content to export\\n      const contentToExport = finalOptions.selectedContent || project.content;\\n      if (!contentToExport || contentToExport.length === 0) {\\n        throw new Error('Project has no content to export');\\n      }\\n\\n      // Generate markdown from project content\\n      try {\\n        const contentMarkdown = generateMarkdownFromContent(contentToExport);\\n        if (!contentMarkdown || contentMarkdown.trim().length === 0) {\\n          throw new Error('Generated markdown is empty');\\n        }\\n\\n        // Generate cover page markdown\\n        let coverPageMarkdown = '';\\n        try {\\n          coverPageMarkdown = await createProfessionalCoverPageMarkdown(project);\\n        } catch (error) {\\n          console.error('Failed to generate cover page markdown:', error);\\n        }\\n\\n        // Combine cover page with content\\n        finalMarkdown = coverPageMarkdown ? `${coverPageMarkdown}\\\\n\\\\n---\\\\n\\\\n${contentMarkdown}` : contentMarkdown;\\n\\n        // Extract and append footnotes if available\\n        const fullProjectMarkdown = project.fullMarkdownContent || '';\\n        const footnoteRegex = /^\\\\[\\\\^.+?\\\\]:.+$/gm;\\n        const footnoteDefinitions = fullProjectMarkdown.match(footnoteRegex);\\n\\n        if (footnoteDefinitions && footnoteDefinitions.length > 0) {\\n          finalMarkdown += '\\\\n\\\\n' + footnoteDefinitions.join('\\\\n');\\n        }\\n      } catch (error) {\\n        throw new Error(\\n          `Failed to generate markdown from project: ${error instanceof Error ? error.message : 'Unknown error'}`\\n        );\\n      }\\n    } else {\\n      throw new Error('Invalid input: must be either a markdown string or Project object');\\n    }\\n\\n    // Process PlantUML diagrams if present\\n    try {\\n      finalMarkdown = processPlantUml(finalMarkdown);\\n    } catch (error) {\\n      console.warn('Failed to process PlantUML diagrams:', error);\\n      // Continue without PlantUML processing\\n    }\\n\\n    // Parse markdown using unified + remark\\n    let ast: Root;\\n    try {\\n      ast = unified()\\n        .use(remarkParse)\\n        .use(remarkGfm)\\n        .parse(finalMarkdown) as Root;\\n    } catch (error) {\\n      throw new Error(`Failed to parse markdown: ${error instanceof Error ? error.message : 'Unknown error'}`);\\n    }\\n\\n    // Get styles configuration\\n    finalStyles = getDefaultStyles(finalOptions.styles);\\n\\n    // Convert AST to DOCX using remark-docx\\n    let docxDocument: Document;\\n    try {\\n      // remarkDocx processes the AST and returns a Document\\n      const remarkDocxPlugin = remarkDocx();\\n      \\n      // Use the unified processor with remark-docx plugin\\n      const processor = unified()\\n        .use(remarkParse)\\n        .use(remarkGfm)\\n        .use(remarkDocxPlugin);\\n\\n      // Process the markdown to get DOCX document\\n      const result = await processor.process(finalMarkdown);\\n\\n      // Extract the DOCX document from the result\\n      docxDocument = result.result as unknown as Document;\\n\\n      if (!docxDocument) {\\n        throw new Error('Failed to generate DOCX document from remark-docx plugin');\\n      }\\n\\n      // Apply custom styles and numbering to document if needed\\n      if (docxDocument.styles !== finalStyles) {\\n        docxDocument.styles = finalStyles;\\n      }\\n\\n      if (!docxDocument.numbering) {\\n        docxDocument.numbering = DEFAULT_NUMBERING;\\n      }\\n    } catch (error) {\\n      throw new Error(`Failed to convert markdown to DOCX: ${error instanceof Error ? error.message : 'Unknown error'}`);\\n    }\\n\\n    // Pack DOCX document to Buffer or Blob\\n    try {\\n      if (typeof window === 'undefined') {\\n        // Server-side: return Buffer\\n        return await Packer.toBuffer(docxDocument);\\n      } else {\\n        // Client-side: return Blob\\n        return await Packer.toBlob(docxDocument);\\n      }\\n   
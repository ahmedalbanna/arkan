              bold: true,\n 379                     color: \'2C3E50\'\n 380                 })\n 381             ]\n 382         }),\n 383         new Paragraph({\n 384             alignment: AlignmentType.CENTER,\n 385             spacing: { before: 120, after: 480 },\n 386             bidirectional: isArabic,\n 387             children: [\n 388                 new TextRun({\n 389                     text: `${yearLabel} ${academicYear}`,\n 390                     size: 22,\n 391                     italics: true,\n 392                     color: \'7F8C8D\'\n 393                 })\n 394             ]\n 395         })\n 396     );\n 397     \n 398     return coverPageElements;\n 399 }\n 400 \n 401 // Overload for Project object or plain project data\n 402 export async function convertMarkdownToWord(\n 403   project: Project | any,\n 404   options?: ConversionOptions & { selectedContent?: ProjectContent }\n 405 ): Promise<Buffer | Blob>;\n 406 \n 407 // Overload for markdown string\n 408 export async function convertMarkdownToWord(\n 409   markdown: string,\n 410   fileName: string,\n 411   options?: ConversionOptions\n 412 ): Promise<Buffer | Blob>;\n 413 \n 414 /**\n 415  * Converts a Project object (or plain project data) or a raw markdown string to a styled .docx file.\n 416  * This is the main server-side function for DOCX generation.\n 417  * \n 418  * Note: Accepts both Project instances and plain project data objects to support\n 419  * server-side rendering where client components cannot be instantiated.\n 420  */\n 421 export async function convertMarkdownToWord(\n 422   projectOrMarkdown: Project | any | string,\n 423   optionsOrFileName?: (ConversionOptions & { selectedContent?: ProjectContent }) | string,\n 424   optionsForMarkdown: ConversionOptions = {}\n 425 ): Promise<Buffer | Blob> {\n 426   try {\n 427     // Input validation\n 428     if (!projectOrMarkdown) {\n 429       throw new Error(\'Input is required: provide either a Project object or markdown string\');\n 430     }\n 431 \n 432     // Check if input is a Project-like object (either instance or plain object)\n 433     if (typeof projectOrMarkdown === \'object\' && projectOrMarkdown !== null && \'content\' in projectOrMarkdown) {\n 434       // Handle Project object or plain project data\n 435       const project = projectOrMarkdown as any;\n 436       const options = (optionsOrFileName as (ConversionOptions & { selectedContent?: ProjectContent })) || {};\n 437       const { styles, selectedContent, coverPageMarkdown: explicitCoverPage } = options;\n 438 \n 439       const finalStyles: IStylesOptions = {\n 440         ...styles,\n 441         paragraphStyles: [...(styles?.paragraphStyles || [])],\n 442       };\n 443 \n 444       const captionStyleExists = finalStyles.paragraphStyles!.some(style => style.id === \'Caption\');\n 445       if (!captionStyleExists) {\n 446         (finalStyles.paragraphStyles as any).push({\n 447           id: \'Caption\',\n 448           name: \'Caption\',\n 449           basedOn: \'Normal\',\n 450           next: \'Normal\',\n 451           quickFormat: true,\n 452           run: { size: 18, italics: true, color: \'595959\' },\n 453           paragraph: {\n 454             alignment: AlignmentType.CENTER,\n 455             spacing: { before: 120, after: 240 },\n 456           },\n 457         });\n 458       }\n 459 \n 460       // Validate project has content\n 461       const contentToExport = selectedContent || project.content;\n 462       if (!contentToExport || contentToExport.length === 0) {\n 463         throw new Error(\'Project has no content to export\');\n 464       }\n 465     \n 466     // Generate markdown safely\n 467     let markdown: string;\n 468     try {\n 469       markdown = generateMarkdownFromContent(contentToExport);\n 470       if (!markdown || markdown.trim().length === 0) {\n 471         throw new Error(\'Generated markdown is empty\');\n 472       }\n 473     } catch (error) {\n 474       throw new Error(`Failed to generate markdown from content: ${error instanceof Error ? error.message : \'Unknown error\'}`);\n 475     }\n 476 \n 477     const fullProjectMarkdown = project.fullMarkdownContent || \'\';\n 478 \n 479     // Extract footnotes safely\n 480     const footnoteRegex = /^\\[\\^.+?\\]:.+$/gm;\n 481     const footnoteDefinitions = fullProjectMarkdown.match(footnoteRegex);\n 482 \n 483     let finalMarkdown = markdown;\n 484     if (footnoteDefinitions && footnoteDefinitions.length > 0) {\n 485       finalMarkdown += \'\\n\\n\' + footnoteDefinitions.join(\'\\n\');\n 486     }\n 487 \n 488     // Create DOCX content with error handling\n 489     let docxObjects: DocxObject[];\n 490     let docxFootnotes: any;\n 491     try {\n 492       const result = await createDocxContent(finalMarkdown, options);\n 493       docxObjects = result.docxObjects;\n 494       docxFootnotes = result.docxFootnotes;\n 495       \n 496       if (!docxObjects || docxObjects.length === 0) {\n 497         console.warn(\'No DOCX objects generated from markdown\');\n 498       }\n 499     } catch (error) {\n 500       throw new Error(`Failed to create DOCX content: ${error instanceof Error ? error.message : \'Unknown error\'}`);\n 501     }\n 502 \n 503     // Generate professional cover page using direct docx API\n 504     let coverPageDocxObjects: DocxObject[] = [];\n 505     \n 506     if (!explicitCoverPage) {\n 507       // Use the new professional cover page generator\n 508       try {\n 509         const coverPageParagraphs = await createProfessionalCoverPage(project, options);\n 510         coverPageDocxObjects = coverPageParagraphs as any[];\n 511       } catch (error) {\n 512         console.error(\'Failed to generate professional cover page:\', error);\n 513         // Fallback to empty cover page\n 514         coverPageDocxObjects = [];\n 515       }\n 516     } else {\n 517       // Use explicit cover page markdown if provided\n 518       try {\n 519         const { docxObjects: convertedCoverPageObjects } = await createDocxContent(explicitCoverPage, options);\n 520         coverPageDocxObjects = convertedCoverPageObjects || [];\n 521       } catch (error) {\n 522         console.error(\'Failed to generate cover page from markdown:\', error);\n 523         coverPageDocxObjects = [];\n 524       }\n 525     }\n 526 \n 527     // Prepare headers and footers\n 528     const { headerConfiguration, footerConfiguration } = prepareHeadersAndFooters(options);\n 529     \n 530     // Build document sections\n 531     let sections;\n 532     try {\n 533       sections = await buildDocumentSections(docxObjects, coverPageDocxObjects, options, headerConfiguration, footerConfiguration);\n 534       if (!sections || sections.length === 0) {\n 535         throw new Error(\'No sections generated for document\');\n 536       }\n 537     } catch (error) {\n 538       throw new Error(`Failed to build document sections: ${error instanceof Error ? error.message : \'Unknown error\'}`);\n 539     }\n 540 \n 541     // Create final document\n 542     let doc;\n 543     try {\n 544       doc = new Document({\n 545         styles: finalStyles,\n 546         numbering: numbering,\n 547         footnotes: docxFootnotes,\n 548         sections: sections,\n 549       });\n 550     } catch (error) {\n 551       throw new Error(`Failed to create DOCX document: ${error instanceof Error ? error.message : \'Unknown error\'}`);\n 552     }\n 553 \n 554     // Pack document\n 555     try {\n 556       if (typeof window === \'undefined\') {\n 557         return await Packer.toBuffer(doc);\n 558       } else {\n 559         return await Packer.toBlob(doc);\n 560       }\n 561     } catch (error) {\n 562       throw new Error(`Failed to pack DOCX document: ${error instanceof Error ? error.message : \'Unknown error\'}`);\n 563     }\n 564   } else {\n 565       // Handle markdown string\n 566       const markdown = projectOrMarkdown;\n 567       \n 568       // Validate markdown\n 569       if (typeof markdown !== \'string\' || markdown.trim().length === 0) {\n 570         throw new Error(\'Invalid markdown: must be a non-empty string\');\n 571       }\n 572       \n 573       const options = optionsForMarkdown || {};\n 574       const { styles } = options;\n 575 \n 576       const finalStyles: IStylesOptions = {\n 577         ...styles,\n 578         paragraphStyles: [...(styles?.paragraphStyles || [])],\n 579       };\n 580 \n 581       const captionStyleExists = finalStyles.paragraphStyles!.some(style => style.id === \'Caption\');\n 582       if (!captionStyleExists) {\n 583           (finalStyles.paragraphStyles as any).push({\n 584               id: \'Caption\',\n 585               name: \'Caption\',\n 586               basedOn: \'Normal\',\n 587               next: \'Normal\',\n 588               quickFormat: true,\n 589               run: { size: 18, italics: true, color: \'595959\' },\n 590               paragraph: {\n 591                   alignment: AlignmentType.CENTER,\n 592                   spacing: { before: 120, after: 240 },\n 593               },\n 594           });\n 595       }\n 596 \n 597       // Create DOCX content with error handling\n 598       let docxObjects: DocxObject[];\n 599       let docxFootnotes: any;\n 600       try {\n 601         const result = await createDocxContent(markdown, options);\n 602         docxObjects = result.docxObjects;\n 603         docxFootnotes = result.docxFootnotes;\n 604         \n 605         if (!docxObjects || docxObjects.length === 0) {\n 606           throw new Error(\'No content generated from markdown\');\n 607         }\n 608       } catch (error) {\n 609         throw new Error(`Failed to create DOCX content from markdown: ${error instanceof Error ? error.message : \'Unknown error\'}`);\n 610       }\n 611 \n 612       const { headerConfiguration, footerConfiguration } = prepareHeadersAndFooters(options);\n 613       \n 614       // Build document sections\n 615       let sections;\n 616       try {\n 617         sections = await buildDocumentSections(docxObjects, [], options, headerConfiguration, footerConfiguration);\n 618         if (!sections || sections.length === 0) {\n 619           throw new Error(\'No sections generated for document\');\n 620         }\n 621       } catch (error) {\n 622         throw new Error(`Failed to build document sections: ${error instanceof Error ? error.message : \'Unknown error\'}`);\n 623       }\n 624 \n 625       // Create final document\n 626       let doc;\n 627       try {\n 628         doc = new Document({\n 629           styles: finalStyles,\n 630           numbering: numbering,\n 631           footnotes: docxFootnotes,\n 632           sections: sections,\n 633         });\n 634       } catch (error) {\n 635         throw new Error(`Failed to create DOCX document: ${error instanceof Error ? error.message : \'Unknown error\'}`);\n 636       }\n 637 \n 638       // Pack document\n 639       try {\n 640         if (typeof window === \'undefined\') {\n 641           return await Packer.toBuffer(doc);\n 642         } else {\n 643           return await Packer.toBlob(doc);\n 644         }\n 645       } catch (error) {\n 646         throw new Error(`Failed to pack DOCX document: ${error instanceof Error ? error.message : \'Unknown error\'}`);\n 647       }\n 648     }\n 649   } catch (error) {\n 650     // Top-level error handler\n 651     console.error(\'Error in convertMarkdownToWord:\', error);\n 652     throw new Error(`Document conversion failed: ${error instanceof Error ? error.message : \'Unknown error occurred\'}`);\n 653   }\n 654 }\n 655 \n````'}

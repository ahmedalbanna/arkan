eration prompt/instructions */\n  prompt?: string;\n  \n  /** Writing rules to enforce */\n  rules?: string[];\n  \n  /** Writing guidelines to follow */\n  guidelines?: string[];\n  \n  /** Writing constraints/restrictions */\n  constraints?: string[];\n  \n  /** AI behaviors and personas */\n  behaviors?: Behavior[];\n  \n  /** Generation control settings (formality, complexity, etc.) */\n  controls?: Partial<GenerationControlState>;\n  \n  /** Context references (other sections, external files) */\n  context?: Partial<SectionContext>;\n  \n  /** Section metadata (status, statistics, history) */\n  metadata?: Record<string, any>;\n}\n\n/**\n * Section Model\n * \n * Immutable class representing a section within a chapter or project.\n * Sections are the atomic content units that can be AI-generated or manually edited.\n * \n * @example\n * ```typescript\n * // Create new section\n * const section = new Section({\n *   title: \'Introduction\',\n *   type: \'report\',\n *   prompt: \'Write an introduction about AI\',\n * });\n * \n * // Mark as generating\n * const generating = section.markAsGenerating();\n * \n * // Update with generated content\n * const generated = section.markAsGenerated(\'gemma-2b\', \'Generated content...\');\n * ```\n */\nexport class Section {\n  public readonly id: string;\n  public readonly title: string;\n  public readonly type: SectionType;\n  public readonly content: string;\n  public readonly prompt: string;\n  public readonly rules: readonly string[];\n  public readonly guidelines: readonly string[];\n  public readonly constraints: readonly string[];\n  public readonly behaviors: readonly Behavior[];\n  public readonly controls: GenerationControlState;\n  public readonly context: SectionContext;\n  public readonly metadata: Readonly<Record<string, any>>;\n\n  /**\n   * Creates a new Section instance\n   * \n   * @param props - Section properties\n   */\n  constructor(props: SectionProperties) {\n    this.id = props.id || uuidv4();\n  
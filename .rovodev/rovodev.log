  this.guidelines = props.guidelines ?? [];\n    this.constraints = props.constraints ?? [];\n    this.behaviors = props.behaviors ?? [];\n    \n    // Initialize metadata with defaults if not provided\n    this.metadata = props.metadata ? {\n      ...defaultSectionMetadata,\n      ...props.metadata,\n    } : { ...defaultSectionMetadata };\n\n    this.controls = {\n      ...defaultControls,\n      ...props.controls,\n      outputStyle: {\n        ...defaultControls.outputStyle,\n        ...(props.controls?.outputStyle || {}),\n      },\n    };\n\n    this.context = {\n      sections: props.context?.sections ?? {},\n      externalContext: props.context?.externalContext ?? {},\n    };\n  }\n\n  /**\n   * Creates a new Section instance with updated properties (immutable update)\n   * \n   * @param props - Partial properties to update\n   * @returns New Section instance with merged properties\n   * \n   * @example\n   * ```typescript\n   * const updated = section.with({ \n   *   title: \'Updated Title\',\n   *   content: \'New content\' \n   * });\n   * ```\n   */\n  public with(props: Partial<SectionProperties>): Section {\n    return new Section({ ...this.toStateObject(), ...props });\n  }\n\n  /**\n   * Marks section as currently being generated by AI\n   * \n   * Updates status to GENERATING and increments attempt counter.\n   * \n   * @returns New Section instance with updated metadata\n   * \n   * @example\n   * ```typescript\n   * const generating = section.markAsGenerating();\n   * console.log(generating.getStatus()); // \'generating\'\n   * ```\n   */\n  public markAsGenerating(): Section {\n    const updatedMetadata = createGeneratingMetadata(this.metadata as SectionMetadata);\n    return this.with({ metadata: updatedMetadata });\n  }\n\n  /**\n   * Marks section as successfully generated by AI\n   * \n   * Updates status to GENERATED, stores AI model info, updates content statistics,\n   * and saves previous version to history.\n   * \n   * @param aiModel - Name of AI model used (e.g., \'gemma-2b\', \'llama3-8b\')\n   * @param content - Generated content\n   * @returns New Section instance with updated content and metadata\n   * \n   * @example\n   * ```typescript\n   * const generated = section.markAsGenerated(\'gemma-2b\', \'AI generated content...\');\n   * console.log(generated.getAiModel()); // \'gemma-2b\'\n   * console.log(generated.getWordCount()); // calculated from content\n   * ```\n   */\n  public markAsGenerated(aiModel: string, content: string): Section {\n    let updatedMetadata = createGeneratedMetadata(this.metadata as SectionMetadata, aiModel);\n    updatedMetadata = updateContentStatistics(updatedMetadata, content);\n    \n    // Save version history if content changed\n    if (this.content && this.content !== content) {\n      updatedMetadata = addVersionToHistory(updatedMetadata, this.content);\n    }\n    \n    return this.with({ \n      content,\n      metadata: updatedMetadata \n    });\n  }\n\n  /**\n   * Mark section as failed generation\n   */\n  public markAsFailed(): Section {\n    const updatedMetadata = createFailedMetadata(this.metadata as SectionMetadata);\n    return this.with({ metadata: updatedMetadata });\n  }\n\n  /**\n   * Mark section as manually edited\n   */\n  public markAsEdited(content: string): Section {\n    let updatedMetadata = createEditedMetadata(this.metadata as SectionMetadata);\n    updatedMetadata = updateContentStatistics(updatedMetadata, content);\n    \n    // Save version history\n    if (this.content && this.content !== content) {\n      updatedMetadata = addVersionToHistory(updatedMetadata, this.content);\n    }\n    \n    return this.with({ \n      content,\n      metadata: updatedMetadata \n    });\n  }\n\n  /**\n   * Update content and refresh statistics\n   */\n  public updateContent(content: string, editedByUser: boolean = false): Section {\n    if (editedByUser) {\n      return this.markAsEdited(content);\n    }\n    \n    // Just update content and statistics without changing status\n    let updatedMetadata = { ...(this.metadata as SectionMetadata) };\n    updatedMetadata = updateContentStatistics(updatedMetadata, content);\n    updatedMetadata.lastModifiedAt = new Date().toISOString();\n    \n    return this.with({ \n      content,\n      metadata: updatedMetadata \n    });\n  }\n\n  /**\n   * Get current generation status\n   */\n  public getStatus(): SectionStatus {\n    return (this.metadata as SectionMetadata)?.status || SectionStatus.DRAFT;\n  }\n\n  /**\n   * Check if section has been generated\n   */\n  public isGenerated(): boolean {\n    const status = this.getStatus();\n    return status === SectionStatus.GENERATED || status === SectionStatus.EDITED;\n  }\n\n  /**\n   * Check if section is currently being generated\n   */\n  public isGenerating(): boolean {\n    return this.getStatus() === SectionStatus.GENERATING;\n  }\n\n  /**\n   * Get AI model used for generation\n   */\n  public getAiModel(): string | undefined {\n    return (this.metadata as SectionMetadata)?.aiModel;\n  }\n\n  /**\n   * Get word count from metadata\n   */\n  public getWordCount(): number {\n    return (this.metadata as SectionMetadata)?.wordCount || 0;\n  }\n\n  /**\n   * Get estimated read time\n   */\n  public getReadTime(): number {\n    return (this.metadata as SectionMetadata)?.estimatedReadTime || 0;\n  }\n\n  /**\n   * Get generation timestamp\n   */\n  public getGeneratedAt(): string | undefined {\n    return (this.metadata as SectionMetadata)?.generatedAt;\n  }\n\n  /**\n   * Get number of generation attempts\n   */\n  public getGenerationAttempts(): number {\n    return (this.metadata as SectionMetadata)?.generationAttempts || 0;\n  }\n\n  public buildSystemPrompt(): string {\n    const personas = this.behaviors.filter(b => b.type === \'persona\').map(b => b.name);\n    const behaviorInstructions = this.behaviors.filter(b => b.type === \'behavior\').map(b => b.name);\n\n    let systemPrompt = \'You are an advanced AI assistant tailored for academic and technical writing.\';\n\n    if (personas.length > 0) {\n      systemPrompt += `\\n\\n**ROLE / PERSONA:**\\nAdopt the persona of: ${personas.join(\', \')}. Write with the authority, vocabulary, and perspective of this role.`;\n    }\n\n    if (this.controls.tone) {\n      systemPrompt += `\\nMaintain a **${this.controls.tone}** tone throughout.`;\n    }\n\n    const allRules = [\n      ...this.rules,\n      ...behaviorInstructions,\n      this.controls.language !== \'default\' ? `Output must be in ${this.controls.language}.` : null,\n    ].filter(Boolean) as string[];\n\n    if (allRules.length > 0) {\n      systemPrompt += `\\n\\n**MANDATORY RULES:**\\n${allRules.map(r => `- ${r}`).join(\'\\n\')}`;\n    }\n\n    if (this.guidelines.length > 0) {\n        systemPrompt += `\\n\\n**GUIDELINES (Follow these recommendations):**\\n${this.guidelines.map(g => `- ${g}`).join(\'\\n\')}`;\n    }\n\n    if (this.constraints.length > 0) {\n      systemPrompt += `\\n\\n**CONSTRAINTS (DO NOT DO):**\\n${this.constraints.map(c => `- ${c}`).join(\'\\n\')}`;\n    }\n\n    // Output Format Specifics\n    if (this.type === \'diagram\') {\n      systemPrompt += `\\n\\nOutput ONLY valid PlantUML code inside \\`\\`\\`plantuml blocks. Do not add conversational text.`;\n    } else if (this.type === \'code\') {\n      systemPrompt += `\\n\\nFocus on producing high-quality, documented code snippets.`;\n    }\n\n    return systemPrompt;\n  }\n\n  public buildActionPrompt(): string {\n    const formalityMap: { [key: number]: string } = { 0: \'very informal and casual\', 33: \'balanced and neutral\', 67: \'formal and professional\', 100: \'very formal and academic\' };\n    const complexityMap: { [key: number]: string } = { 0: \'very simple and easy to understand\', 33: \'clear and straightforward\', 67: \'detailed and technical\', 100: \'highly complex and expert-level\' };\n\n    let instructions: string[] = [];\n    const formality = this.controls.formality > 67 ? formalityMap[100] : this.controls.formality > 33 ? formalityMap[67] : this.controls.formality > 0 ? formalityMap[33] : formalityMap[0];\n    instructions.push(`The formality should be ${formality}.`);\n\n    const complexity = this.controls.complexity > 67 ? complexityMap[100] : this.controls.complexity > 33 ? complexityMap[67] : this.controls.complexity > 0 ? complexityMap[33] : complexityMap[0];\n    instructions.push(`The complexity should be ${complexity}.`);\n\n    if (this.controls.tone) instructions.push(`The tone should be ${this.controls.tone}.`);\n    if (this.controls.wordCount) instructions.push(`Aim for a word count of approximately ${this.controls.wordCount} words.`);\n\n    if (this.controls.outputStyle.diagram && this.controls.diagramType) {\n        instructions.push(`The output must include a PlantUML diagram of type \'${this.controls.diagramType}\'.`);\n    }\n    if (this.controls.outputStyle.code && this.controls.programmingLanguage) {\n        instructions.push(`The code blocks should be in ${this.controls.programmingLanguage}.`);\n    }\n    if (this.controls.outputStyle.table && this.controls.tableCaption) {\n        instructions.push(`If a table is generated, it must have the caption: "${this.controls.tableCaption}".`);\n    }\n    if (this.controls.outputStyle.heading && this.controls.includedHeadings && this.controls.includedHeadings.length > 0) {\n        instructions.push(`The heading should cover the following topics: ${this.controls.includedHeadings.join(\', \')}.`);\n    }\n\n    if (this.controls.language && this.controls.language !== \'default\') {\n        instructions.push(`The output language must be ${this.controls.language}.`);\n    }\n    \n    if (this.controls.outputStyle.includeCitations && this.controls.citationStyle) {\n        instructions.push(`Use ${this.controls.citationStyle} citation style.`);\n    }\n\n    const enabledStyles = Object.entries(this.controls.outputStyle).filter(([key, value]) => value && key !=
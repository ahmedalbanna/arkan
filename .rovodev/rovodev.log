 been generated or edited\\n   * \\n   * @returns True if status is GENERATED or EDITED\\n   */\\n  public isGenerated(): boolean {\\n    const status = this.getStatus();\\n    return status === SectionStatus.GENERATED || status === SectionStatus.EDITED;\\n  }\\n\\n  /**\\n   * Checks if section is currently being generated\\n   * \\n   * @returns True if status is GENERATING\\n   */\\n  public isGenerating(): boolean {\\n    return this.getStatus() === SectionStatus.GENERATING;\\n  }\\n\\n  /**\\n   * Gets AI model name used for generation\\n   * \\n   * @returns AI model name (e.g., \'gemma-2b\') or undefined\\n   */\\n  public getAiModel(): string | undefined {\\n    return (this.metadata as SectionMetadata)?.aiModel;\\n  }\\n\\n  /**\\n   * Gets word count from content statistics\\n   * \\n   * @returns Number of words in content\\n   */\\n  public getWordCount(): number {\\n    return (this.metadata as SectionMetadata)?.wordCount || 0;\\n  }\\n\\n  /**\\n   * Gets estimated reading time in minutes\\n   * \\n   * Calculated based on average reading speed (200 words/minute).\\n   * \\n   * @returns Estimated read time in minutes\\n   */\\n  public getReadTime(): number {\\n    return (this.metadata as SectionMetadata)?.estimatedReadTime || 0;\\n  }\\n\\n  /**\\n   * Gets generation timestamp\\n   * \\n   * @returns ISO datetime string when section was generated, or undefined\\n   */\\n  public getGeneratedAt(): string | undefined {\\n    return (this.metadata as SectionMetadata)?.generatedAt;\\n  }\\n\\n  /**\\n   * Gets number of generation attempts\\n   * \\n   * @returns Total attempts made to generate this section\\n   */\\n  public getGenerationAttempts(): number {\\n    return (this.metadata as SectionMetadata)?.generationAttempts || 0;\\n  }"}', 'logfire.msg': 'running tool: find_and_replace_code', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "ge
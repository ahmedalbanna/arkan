iledMetadata,\n  addVersionToHistory,\n  SectionStatus,\n} from \'@/types/section-metadata\';\n\nexport const SectionPropertiesSchema = z.object({\n  id: z.string().optional(),\n  title: z.string(),\n  type: SectionTypeSchema,\n  content: z.string().optional(),\n  prompt: z.string().optional(),\n  rules: z.array(z.string()).optional(),\n  guidelines: z.array(z.string()).optional(),\n  constraints: z.array(z.string()).optional(),\n  behaviors: z.array(BehaviorSchema).optional(),\n  controls: GenerationControlStateSchema.partial().optional(),\n  context: SectionContextSchema.partial().optional(),\n  metadata: z.record(z.any()).optional(),\n});\n\n\n/**\n * Section Properties Interface\n * \n * Defines the structure for creating or updating a Section instance.\n */\nexport interface SectionProperties {\n  /** Unique identifier (UUID v4). Auto-generated if not provided. */\n  id?: string;\n  \n  /** Section title/heading */\n  title: string;\n  \n  /** Section type (report, diagram, code, etc.) */\n  type: SectionType;\n  \n  /** Section content in Markdown format */\n  content?: string;\n  \n  /** Generation prompt/instructions */\n  prompt?: string;\n  \n  /** Writing rules to enforce */\n  rules?: string[];\n  \n  /** Writing guidelines to follow */\n  guidelines?: string[];\n  \n  /** Writing constraints/restrictions */\n  constraints?: string[];\n  \n  /** AI behaviors and personas */\n  behaviors?: Behavior[];\n  \n  /** Generation control settings (formality, complexity, etc.) */\n  controls?: Partial<GenerationControlState>;\n  \n  /** Context references (other sections, external files) */\n  context?: Partial<SectionContext>;\n  \n  /** Section metadata (status, statistics, history) */\n  metadata?: Record<string, any>;\n}\n\n/**\n * Section Model\n * \n * Immutable class representing a section within a chapter or project.\n * Sections are the atomic content units that can be AI-generated or manually edited.\n * \n * @example\n * ```typescript\n * // Create new
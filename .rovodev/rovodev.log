      }\\n    } catch (error) {\\n      throw new Error(`Failed to pack DOCX document: ${error instanceof Error ? error.message : \'Unknown error\'}`);\\n    }\\n  } catch (error) {\\n    // Top-level error handler\\n    console.error(\'Error in convertMarkdownToDocxExternal:\', error);\\n    throw new Error(\\n      `DOCX conversion failed: ${error instanceof Error ? error.message : \'Unknown error occurred\'}`\\n    );\\n  }\\n}\\n\\n/**\\n * Converts markdown string directly to DOCX buffer/blob\\n * Convenience function for simple use cases\\n */\\nexport async function markdownToDocx(markdown: string, options?: ConversionOptions): Promise<Buffer | Blob> {\\n  return convertMarkdownToDocxExternal(markdown, undefined, options);\\n}\\n\\n/**\\n * Converts a Project object to DOCX buffer/blob\\n * Convenience function for project-based conversion\\n */\\nexport async function projectToDocx(\\n  project: Project | any,\\n  options?: ConversionOptions & { selectedContent?: ProjectContent }\\n): Promise<Buffer | Blob> {\\n  return convertMarkdownToDocxExternal(project, options);\\n}\\n"}', 'logfire.msg': 'running tool: create_file', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span'}

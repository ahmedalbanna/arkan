{
    "mcpServers": {
        "firebase": {
            "command": "npx",
            "args": [
                "-y",
                "firebase-tools@latest",
                "experimental:mcp"
            ]
        },
        "next-devtools": {
            "command": "npx",
            "args": [
                "-y",
                "next-devtools-mcp@latest"
            ]
        },
        "genkit": {
            "command": "npx",
            "args": [
                "genkit",
                "mcp"
            ],
            "cwd": ".",
            "timeout": 30000,
            "trust": false
        }
    }
}

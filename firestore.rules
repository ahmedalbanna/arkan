firestore
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get the user's role from their profile document
    function getUserRole(userId) {
      // Ensure the user document exists and has a role field
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow a logged-in user to read their OWN profile
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Allow logged-in admins to read ALL user profiles
      allow read: if isAuthenticated() && getUserRole(request.auth.uid) == 'admin';

      // Allow a logged-in user to update their OWN profile
      // Prevent users from changing their role or adding/removing critical fields
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && request.resource.data.keys().hasAll(['name', 'email', 'bio', 'profilePictureUrl', 'credits', 'createdAt', 'updatedAt', 'role']) // Ensure all expected fields are present
                   && request.resource.data.size() == 8 // Ensure no extra fields are added (adjust number based on your UserProfile interface size)
                   && request.resource.data.role == resource.data.role; // Prevent changing role

      // Allow logged-in admins to update ANY user profile (including role)
      allow write: if isAuthenticated() && getUserRole(request.auth.uid) == 'admin';


      // Prevent client-side creation of user documents. Signup is handled via API.
      allow create: if false;
    }

    // Rules for a hypothetical 'transactions' collection
    // Adjust collection name if yours is different
    match /transactions/{transactionId} {
      // Only allow logged-in admins to read transaction data
      allow read: if isAuthenticated() && getUserRole(request.auth.uid) == 'admin';

      // Only allow logged-in admins to create or update transactions.
      // Transaction processing (creation/verification/rejection) should happen via secure server-side logic.
      allow write: if isAuthenticated() && getUserRole(request.auth.uid) == 'admin';
    }

    // Default rule: Deny all access to any other documents or collections
    // unless explicitly allowed by a more specific rule above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

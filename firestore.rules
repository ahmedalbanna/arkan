
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin
    function isAdmin() {
      // Get the user's profile from the 'users' collection using their UID
      // and check if their role is 'admin'.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if the request is from a logged-in user
    function isSignedIn() {
      return request.auth != null;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Any authenticated user can create their own profile document.
      allow create: if isSignedIn();

      // Only the user themselves or an admin can read the user's profile.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      // The user can update their own profile, but not change their role or credits.
      // Admins can update any field.
      allow update: if isSignedIn() && 
                    ((request.auth.uid == userId && !('role' in request.resource.data) && !('credits' in request.resource.data)) || isAdmin());

      // Only admins can delete users.
      allow delete: if isAdmin();
    }

    // Rules for collections that are only accessible by admins
    match /{collection}/{docId} {
      // Admins have full access to these collections.
      allow read, write, delete: if isAdmin() &&
                                  (collection == 'agents' || 
                                   collection == 'features' || 
                                   collection == 'transactions' ||
                                   collection == 'agent_generations');
    }

    // Rules for the 'templates' collection and its subcollections
    match /templates/{docId}/{subcollection}/{templateKey} {
        // Any authenticated user can read templates (e.g., for exporting).
        allow read: if isSignedIn();
        // Only admins can write (create/update/delete) templates.
        allow write: if isAdmin();
    }
  }
}

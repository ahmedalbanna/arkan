rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can only read and write to their own user document.
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
    }
    
    // Public read for features, only admins can write.
    match /features/{featureId} {
        allow read: if request.auth != null;
        allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Agents can be read by any authenticated user.
    // Only admins can modify agent configurations.
    match /agents/{agentId} {
        allow read: if request.auth != null;
        allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Templates can be read by any authenticated user.
    // Only admins can modify templates.
    match /templates/{templateType}/{templateId} {
        allow read: if request.auth != null;
        allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Transaction requests can be created by any authenticated user for themselves.
    // Only admins can read or update transactions.
    match /transactions/{transactionId} {
        allow read: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow create: if request.auth.uid == request.resource.data.userId;
        allow update: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Projects can be created by any authenticated user for themselves.
    // They can only read, update, or delete their own projects.
    match /projects/{projectId} {
      allow read, update, delete: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == request.resource.data.userId;
    }
    
    // Generation logs can only be read by admins.
    match /agent_generations/{logId} {
      allow read: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // Writes are handled server-side by cloud functions, so no client write access is needed.
      allow write: if false;
    }
  }
}

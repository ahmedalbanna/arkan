{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      "$uid": {
        ".indexOn": ["email"]
      }
    },
    "projects": {
      "$uid": {
        ".indexOn": "meta/updated"
      }
    },
    "jobs": {
      "$jobId": {
        ".read": "root.child('jobs/' + $jobId + '/userId').val() === auth.uid",
        ".write": false
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid",
        "$notificationId": {
          ".validate": "newData.hasChildren(['title', 'description', 'createdAt', 'isRead'])"
        }
      }
    },
    "userConversations": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid",
        "$conversationId": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "conversations": {
      "$conversationId": {
        ".read": "root.child('userConversations/' + auth.uid + '/' + $conversationId).exists()",
        ".write": "root.child('userConversations/' + auth.uid + '/' + $conversationId).exists()",
        ".indexOn": ["updatedAt"]
      }
    },
    "messages": {
      "$conversationId": {
        ".read": "root.child('userConversations/' + auth.uid + '/' + $conversationId).exists()",
        ".write": "root.child('userConversations/' + auth.uid + '/' + $conversationId).exists()",
        "$messageId": {
          ".validate": "newData.hasChildren(['senderId', 'content', 'timestamp', 'role']) && newData.child('senderId').val() === auth.uid"
        }
      }
    },
    "deviceTokens": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid",
        "$token": {
          ".validate": "newData.isString()"
        }
      }
    }
  }
}

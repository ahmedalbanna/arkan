{
  "info": {
    "name": "Dynamic Flow System API",
    "description": "Complete API collection for Dynamic Flow System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "user-123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Flow Management",
      "item": [
        {
          "name": "List Flows",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/flows?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "flows"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "status",
                  "value": "active",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Create Flow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"test-flow-1\",\n  \"name\": \"Test Flow\",\n  \"description\": \"A test flow for demonstration\",\n  \"version\": \"1.0.0\",\n  \"status\": \"draft\",\n  \"tags\": [\"test\", \"demo\"],\n  \"inputSchema\": {\n    \"type\": \"zod\",\n    \"fields\": [\n      {\n        \"name\": \"topic\",\n        \"type\": \"string\",\n        \"label\": \"Topic\",\n        \"required\": true\n      }\n    ],\n    \"required\": true\n  },\n  \"outputSchema\": {\n    \"type\": \"zod\",\n    \"fields\": [\n      {\n        \"name\": \"result\",\n        \"type\": \"string\",\n        \"label\": \"Result\",\n        \"required\": true\n      }\n    ],\n    \"required\": true\n  },\n  \"steps\": [\n    {\n      \"id\": \"step-1\",\n      \"name\": \"Format Output\",\n      \"type\": \"format\",\n      \"config\": {\n        \"type\": \"format\",\n        \"template\": \"Topic: {{topic}}\",\n        \"format\": \"text\",\n        \"outputVariable\": \"result\"\n      }\n    }\n  ],\n  \"config\": {\n    \"timeout\": 60000\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/flows",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "flows"]
            }
          }
        },
        {
          "name": "Get Flow",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/flows/test-flow-1",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "flows", "test-flow-1"]
            }
          }
        },
        {
          "name": "Update Flow",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Test Flow\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/flows/test-flow-1?changeDescription=Updated name and status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "flows", "test-flow-1"],
              "query": [
                {
                  "key": "changeDescription",
                  "value": "Updated name and status"
                }
              ]
            }
          }
        },
        {
          "name": "List Flow Versions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/flows/test-flow-1/versions",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "flows", "test-flow-1", "versions"]
            }
          }
        },
        {
          "name": "Rollback Flow Version",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"1.0.0\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/flows/test-flow-1/versions",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "flows", "test-flow-1", "versions"]
            }
          }
        },
        {
          "name": "Delete Flow",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/flows/test-flow-1",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "flows", "test-flow-1"]
            }
          }
        }
      ]
    },
    {
      "name": "Prompt Management",
      "item": [
        {
          "name": "List Prompts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/prompts?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "prompts"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Create Prompt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"test-prompt-1\",\n  \"name\": \"Test Prompt\",\n  \"description\": \"A test prompt\",\n  \"version\": \"1.0.0\",\n  \"template\": \"Generate content about {{topic}} in {{language}}\",\n  \"variables\": [\n    {\n      \"name\": \"topic\",\n      \"label\": \"Topic\",\n      \"type\": \"string\",\n      \"required\": true\n    },\n    {\n      \"name\": \"language\",\n      \"label\": \"Language\",\n      \"type\": \"string\",\n      \"required\": true,\n      \"defaultValue\": \"English\"\n    }\n  ],\n  \"outputFormat\": {\n    \"type\": \"text\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/prompts",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "prompts"]
            }
          }
        },
        {
          "name": "Get Prompt",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/prompts/test-prompt-1",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "prompts", "test-prompt-1"]
            }
          }
        },
        {
          "name": "Update Prompt",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/prompts/test-prompt-1",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "prompts", "test-prompt-1"]
            }
          }
        },
        {
          "name": "Delete Prompt",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/prompts/test-prompt-1",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "prompts", "test-prompt-1"]
            }
          }
        }
      ]
    },
    {
      "name": "Execution",
      "item": [
        {
          "name": "Execute Flow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flowId\": \"test-flow-1\",\n  \"input\": {\n    \"topic\": \"Artificial Intelligence\"\n  },\n  \"includeTrace\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/flows/execute",
              "host": ["{{baseUrl}}"],
              "path": ["flows", "execute"]
            }
          }
        },
        {
          "name": "Test Flow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flow\": {\n    \"id\": \"test-flow\",\n    \"name\": \"Test\",\n    \"version\": \"1.0.0\",\n    \"status\": \"active\",\n    \"inputSchema\": {\n      \"type\": \"zod\",\n      \"fields\": [{\"name\": \"text\", \"type\": \"string\", \"required\": true}],\n      \"required\": true\n    },\n    \"outputSchema\": {\n      \"type\": \"zod\",\n      \"fields\": [{\"name\": \"result\", \"type\": \"string\", \"required\": true}],\n      \"required\": true\n    },\n    \"steps\": [\n      {\n        \"id\": \"step-1\",\n        \"name\": \"Format\",\n        \"type\": \"format\",\n        \"config\": {\n          \"type\": \"format\",\n          \"template\": \"Output: {{text}}\",\n          \"format\": \"text\",\n          \"outputVariable\": \"result\"\n        }\n      }\n    ],\n    \"config\": {},\n    \"metadata\": {\n      \"createdAt\": \"2026-01-14T00:00:00.000Z\",\n      \"updatedAt\": \"2026-01-14T00:00:00.000Z\",\n      \"createdBy\": \"test\",\n      \"updatedBy\": \"test\"\n    }\n  },\n  \"input\": {\n    \"text\": \"Hello World\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/flows/test",
              "host": ["{{baseUrl}}"],
              "path": ["flows", "test"]
            }
          }
        }
      ]
    },
    {
      "name": "Tools",
      "item": [

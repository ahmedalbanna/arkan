# -----------------------------------------------------------------------------
# Firebase App Hosting Environment Variables
# https://firebase.google.com/docs/app-hosting/configure-backend#env-vars
# -----------------------------------------------------------------------------
# GCLOUD_PROJECT_ID - The ID of the backing Google Cloud project.
# __FIREBASE_APP_ID - The ID of the associated Firebase app.
# __FIREBASE_PROJECT_ID - The ID of the associated Firebase project.
# __FIREBASE_LOCATION - The location of the backend.

# Development Configuration
NODE_ENV=development
PORT=9002

# Qdrant Vector Database Configuration
# Copy this to .env.local and update as needed

# ============================================
# Vector Store Configuration
# ============================================
VECTOR_STORE_PROVIDER=qdrant
EMBEDDING_DIMENSION=768

# ============================================
# Qdrant Settings
# ============================================
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=arkan_vectors
# QDRANT_API_KEY=  # Uncomment for Qdrant Cloud

# ============================================
# Ollama Embedding Service
# ============================================
OLLAMA_BASE_URL=http://185.190.140.93:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ============================================
# Optional: Performance Tuning
# ============================================
# QDRANT_BATCH_SIZE=100
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# RAG_DEFAULT_TOP_K=5
# RAG_DEFAULT_MIN_SCORE=0.5

# ============================================
# Firebase Emulator Configuration
# ============================================
# Set to 'true' to use Firebase Emulators for local development
USE_FIREBASE_EMULATOR=false
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Emulator Ports (must match firebase.json)
#FIRESTORE_EMULATOR_HOST=localhost:8030
#FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
#FIREBASE_DATABASE_EMULATOR_HOST=localhost:9030
#FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Emulator UI
FIREBASE_EMULATOR_UI_PORT=4000

# Firebase Project Configuration (for emulators)
GCLOUD_PROJECT=docudec
#FIREBASE_DATABASE_EMULATOR_HOST=localhost:9030


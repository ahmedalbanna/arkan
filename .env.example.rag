# ============================================
# RAG (Retrieval-Augmented Generation) Configuration
# ============================================

# Ollama Server Address
# This should point to your Ollama server running the embedding models
OLLAMA_SERVER_ADDRESS="http://localhost:11434"

# Required Ollama Models:
# 1. nomic-embed-text (for embeddings)
#    Install: ollama pull nomic-embed-text
#
# 2. gemma:2b (for text generation - already configured)
#    Install: ollama pull gemma:2b

# Vector Store Configuration
# Currently using Firestore + in-memory storage
# For production, consider:
# - Pinecone (https://www.pinecone.io/)
# - Qdrant (https://qdrant.tech/)
# - Weaviate (https://weaviate.io/)

# RAG Settings (optional - these are defaults in code)
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# RAG_TOP_K=5
# RAG_MIN_SIMILARITY=0.5

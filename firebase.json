{
  "database": {
    "rules": "database.rules.json"
  },

  "emulators": {
    "auth": {
      "port": 9099
    },
    "database": {
      "port": 9030
    },

    "firestore": {
      "port": 8030
    },

    "hosting": {
      "port": 5000
    },
    "singleProjectMode": true,
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "public": ".next",
    "rewrites": [
      {
        "function": "nextjsApp",
        "source": "**"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}

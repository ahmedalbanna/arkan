{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:models": "jest models/",
    "test:components": "jest components/",
    "test:hooks": "jest hooks/",
    "test:ai": "jest ai/",
    "test:security": "jest security/",
    "test:integration": "jest integration/",
    "test:all": "jest --coverage --verbose",
    "test:report": "node scripts/test-coverage.js",
    "test:ci": "npm run test:coverage && npm run test:report",
    "seed:firestore": "tsx src/lib/db/seed.ts",
    "seed:templates": "tsx src/lib/db/seed-templates.ts",
    "seed:categories": "tsx src/lib/db/seed-agent-categories.ts",
    "seed:sections": "tsx src/lib/db/seed-sections.ts",
    "seed:agents": "tsx scripts/seed-agents.ts",
    "migration:apply": "node scripts/apply-migration.js apply",
    "migration:restore": "node scripts/apply-migration.js restore",
    "migration:test": "node scripts/apply-migration.js test",
    "migration:check": "npm run lint && npm run typecheck",
    "migration:full": "npm run migration:check && npm run migration:apply && npm run test",
    "migration:rollback": "npm run migration:restore && npm run test",
    "analyze": "ANALYZE=true npm run build",
    "docs:generate": "node scripts/generate-component-docs.js generate",
    "docs:update": "node scripts/generate-component-docs.js update",
    "docs:clean": "node scripts/generate-component-docs.js clean",
    "docs:check-links": "markdown-link-check docs/**/*.md",
    "docs:quality-check": "npm run docs:check-links && npm run docs:generate",
    "docs:serve": "npx serve docs -p 3001",
    "docs:build": "npm run docs:generate && npm run docs:quality-check"
  },

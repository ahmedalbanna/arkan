{
  "name": "generate-report-section-rag",
  "description": "Generates report sections with RAG (Retrieval Augmented Generation)",
  "category": "rag-enhanced",
  "tags": [
    "rag",
    "report",
    "section",
    "retrieval"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {
      "sectionTitle": {
        "type": "string",
        "description": "Section title"
      },
      "sectionType": {
        "type": "string",
        "description": "Type of section"
      },
      "requirements": {
        "type": "string",
        "description": "Section requirements"
      },
      "retrievalQuery": {
        "type": "string",
        "description": "Query for RAG retrieval"
      }
    },
    "required": [
      "sectionTitle",
      "requirements"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "section": {
        "type": "string",
        "description": "Generated section with RAG context"
      }
    },
    "required": [
      "section"
    ]
  },
  "steps": [
    {
      "id": "step_1",
      "name": "Retrieve Context",
      "type": "retrieve",
      "config": {
        "query": "{{retrievalQuery}}",
        "topK": 5,
        "minScore": 0.7,
        "outputKey": "ragContext"
      }
    },
    {
      "id": "step_2",
      "name": "Generate Section",
      "type": "generate",
      "config": {
        "model": "gemini-2.0-flash-exp",
        "temperature": 0.6,
        "maxTokens": 4096,
        "systemPrompt": "You are an academic writer. Generate report sections using provided context. Cite sources appropriately. Output markdown.",
        "userPromptTemplate": "**Section:** {{sectionTitle}}\n**Type:** {{sectionType}}\n**Requirements:** {{requirements}}\n\n**Context:**\n{{ragContext}}",
        "outputKey": "section"
      },
      "outputMapping": {
        "section": "{{section}}"
      }
    }
  ],
  "version": 1,
  "isActive": true,
  "metadata": {
    "migrationDate": "2026-01-14T07:24:32.307Z",
    "sourceFile": "src/ai/flows/generate-report-section-rag.ts",
    "migrationType": "phase5",
    "originalComplexity": "complex"
  }

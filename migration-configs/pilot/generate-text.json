{
  "name": "generate-text",
  "version": 1,
  "description": "A text generation AI agent that creates text based on a given prompt",
  "category": "text-generation",
  "tags": ["text", "generation", "creative", "simple"],
  "isActive": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string",
        "description": "The text generation prompt"
      }
    },
    "required": ["prompt"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "generatedText": {
        "type": "string",
        "description": "The generated text output"
      }
    },
    "required": ["generatedText"]
  },
  "steps": [
    {
      "id": "step_1",
      "name": "Generate Text",
      "type": "generate",
      "config": {
        "model": "gemini-2.0-flash-exp",
        "temperature": 0.9,
        "maxTokens": 2048,
        "systemPrompt": "You are a writing assistant. Generate text based on the following prompt.\n\nOutput ONLY the generated text. Do NOT wrap it in JSON or any other format.",
        "userPromptTemplate": "**Prompt:** {{prompt}}",
        "outputKey": "generatedText"
      },
      "outputMapping": {
        "generatedText": "{{output}}"
      }
    }
  ],
  "metadata": {
    "migrationDate": "2026-01-14",
    "sourceFile": "src/ai/flows/generate-text.ts",
    "migrationType": "pilot",
    "originalComplexity": "simple"
  }
}
